+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntitySelector;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import net.minecraft.world.phys.shapes.CollisionContext;
+import net.minecraft.world.phys.shapes.VoxelShape;
+import net.raphimc.viabedrock.api.model.CollisionContact;
+import net.raphimc.viabedrock.api.model.MovementCollisionQuery;
+import net.raphimc.viabedrock.api.model.MovementCollisionWorld;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Function;
+
+/** The native movement request gathers once, including the native step and inset regions. */
+public final class PhysicalCollisions {
+    private static final ThreadLocal<Move> CURRENT = new ThreadLocal<>();
+
+    private PhysicalCollisions() {}
+
+    public static Vec3 collide(final Entity actor, final Vec3 requested, final Function<Vec3, Vec3> original) {
+        final PhysicalCollisionCache cache = PhysicalReplayContext.collisions(actor);
+        if (cache == null) return original.apply(requested);
+        final Position3f motion = position(requested);
+        final Position3f capped = MovementCollisionQuery.cap(motion);
+        // Preserve precise Java contact boundaries unless the native request actually hits its motion cap.
+        final Vec3 effective = capped == motion ? requested : new Vec3(capped.x(), capped.y(), capped.z());
+        final Move previous = CURRENT.get();
+        CURRENT.set(new Move(actor, cache, MovementCollisionQuery.bounds(box(actor.getBoundingBox()), capped, actor.maxUpStep())));
+        try {
+            // Native captures a collision request even when its resulting displacement is zero.
+            collect(actor.level());
+            return original.apply(effective);
+        } finally {
+            if (previous == null) CURRENT.remove();
+            else CURRENT.set(previous);
+        }
+    }
+
+    public static boolean active(final Entity actor) {
+        final Move move = CURRENT.get();
+        return move != null && move.actor == actor;
+    }
+
+    public static List<VoxelShape> collect(final Level level) {
+        final Move move = CURRENT.get();
+        return move != null && move.actor.level() == level ? move.cache.gather(move.query, region -> fetch(move.actor, region)) : null;
+    }
+
+    private static List<PhysicalCollisionCache.Shape> fetch(final Entity actor, final CollisionContact.Box region) {
+        final Level level = actor.level();
+        final AABB bounds = box(region);
+        final List<PhysicalCollisionCache.Shape> boxes = new ArrayList<>();
+        for (var collider : level.getEntities(actor, bounds.inflate(1E-7), EntitySelector.NO_SPECTATORS.and(actor::canCollideWith))) {
+            boxes.add(PhysicalCollisionCache.Shape.actor(collider));
+        }
+        MovementCollisionWorld.unloaded(region, (x, z) -> loaded(level, x, z), shape -> boxes.add(PhysicalCollisionCache.Shape.fixed(box(shape))));
+        final var below = MovementCollisionWorld.belowWorld(region, level.getMinY());
+        if (below != null) boxes.add(PhysicalCollisionCache.Shape.fixed(box(below)));
+        final var context = CollisionContext.of(actor);
+        final var position = new BlockPos.MutableBlockPos();
+        MovementCollisionWorld.blocks(region, level.getMinY(), level.getMaxY(), (x, z) -> loaded(level, x >> 4, z >> 4), (x, y, z) -> {
+            position.set(x, y, z);
+            final var block = level.getBlockState(position);
+            copy(block.getCollisionShape(level, position, context).move(x, y, z), boxes);
+        });
+        final var border = level.getWorldBorder();
+        if (border.isInsideCloseToBorder(actor, bounds)) copy(border.getCollisionShape(), boxes);
+        return boxes;
+    }
+
+    private static boolean loaded(final Level level, final int x, final int z) {
+        return level.getChunkSource().getChunk(x, z, ChunkStatus.FULL, false) != null;
+    }
+
+    private static void copy(final VoxelShape shape, final List<PhysicalCollisionCache.Shape> target) {
+        shape.forAllBoxes((minX, minY, minZ, maxX, maxY, maxZ) -> target.add(PhysicalCollisionCache.Shape.fixed(new AABB(minX, minY, minZ, maxX, maxY, maxZ))));
+    }
+
+    static Position3f position(final Vec3 position) {
+        return new Position3f((float) position.x, (float) position.y, (float) position.z);
+    }
+
+    private static AABB box(final CollisionContact.Box box) {
+        return new AABB(box.minX(), box.minY(), box.minZ(), box.maxX(), box.maxY(), box.maxZ());
+    }
+
+    private static CollisionContact.Box box(final AABB box) {
+        return new CollisionContact.Box((float) box.minX, (float) box.minY, (float) box.minZ, (float) box.maxX, (float) box.maxY, (float) box.maxZ);
+    }
+
+    private record Move(Entity actor, PhysicalCollisionCache cache, CollisionContact.Box query) {}
+}
