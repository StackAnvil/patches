+    @Shadow @Final private static EntityDataAccessor<Boolean> DATA_ID_PADDLE_LEFT;
+    @Shadow @Final private static EntityDataAccessor<Boolean> DATA_ID_PADDLE_RIGHT;
+    @Shadow @Final private static EntityDataAccessor<Integer> DATA_ID_BUBBLE_TIME;
+
+    @Override
+    public void captureBoatPhysics(final PhysicalState.Builder state) {
+        final var data = ((AbstractBoat) (Object) this).getEntityData();
+        state.capture(Field.PADDLE_LEFT, data.get(DATA_ID_PADDLE_LEFT), value -> data.set(DATA_ID_PADDLE_LEFT, value));
+        state.capture(Field.PADDLE_RIGHT, data.get(DATA_ID_PADDLE_RIGHT), value -> data.set(DATA_ID_PADDLE_RIGHT, value));
+        state.capture(Field.BUBBLE_TIME, data.get(DATA_ID_BUBBLE_TIME), value -> data.set(DATA_ID_BUBBLE_TIME, value));
+        state.capture(Field.PADDLE_POSITION_LEFT, this.paddlePositions[0], value -> this.paddlePositions[0] = value);
+        state.capture(Field.PADDLE_POSITION_RIGHT, this.paddlePositions[1], value -> this.paddlePositions[1] = value);
+        state.capture(Field.OUT_OF_CONTROL_TICKS, this.outOfControlTicks, value -> this.outOfControlTicks = value);
+        state.capture(Field.DELTA_ROTATION, this.deltaRotation, value -> this.deltaRotation = value);
+        state.capture(Field.INPUT_LEFT, this.inputLeft, value -> this.inputLeft = value);
+        state.capture(Field.INPUT_RIGHT, this.inputRight, value -> this.inputRight = value);
+        state.capture(Field.INPUT_UP, this.inputUp, value -> this.inputUp = value);
+        state.capture(Field.INPUT_DOWN, this.inputDown, value -> this.inputDown = value);
+        state.capture(Field.WATER_LEVEL, this.waterLevel, value -> this.waterLevel = value);
+        state.capture(Field.LAND_FRICTION, this.landFriction, value -> this.landFriction = value);
+        state.capture(Field.STATUS, this.status, value -> this.status = value);
+        state.capture(Field.OLD_STATUS, this.oldStatus, value -> this.oldStatus = value);
+        state.capture(Field.LAST_YD, this.lastYd, value -> this.lastYd = value);
+        state.capture(Field.IS_ABOVE_BUBBLE_COLUMN, this.isAboveBubbleColumn, value -> this.isAboveBubbleColumn = value);
+        state.capture(Field.BUBBLE_COLUMN_DIRECTION_IS_DOWN, this.bubbleColumnDirectionIsDown, value -> this.bubbleColumnDirectionIsDown = value);
+        state.capture(Field.BUBBLE_MULTIPLIER, this.bubbleMultiplier, value -> this.bubbleMultiplier = value);
+        state.capture(Field.BUBBLE_ANGLE, this.bubbleAngle, value -> this.bubbleAngle = value);
+        state.capture(Field.BUBBLE_ANGLE_O, this.bubbleAngleO, value -> this.bubbleAngleO = value);
+    }
+
+    @Override
+    public float angularVelocity() {
+        return this.deltaRotation;
+    }
+
+    @Override
