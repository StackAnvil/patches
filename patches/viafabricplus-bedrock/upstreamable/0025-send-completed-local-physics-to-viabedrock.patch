+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement;
+
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.world.level.block.Blocks;
+
+/** Target 1.26.51 climbing stages, before collision and after ordinary gravity. */
+public final class BedrockClimbingPhysics {
+
+    private static final float CLIMB_SPEED = 0.2F;
+
+    private BedrockClimbingPhysics() {
+    }
+
+    public static boolean applies(final LocalPlayer player) {
+        if (!BedrockInputPermissions.isBedrockConnection() || player.getAbilities().flying
+                || player.isSpectator() || player.isFallFlying() || player.isSwimming()
+                || player.isInWater() || player.isInLava() || !player.onClimbable()) {
+            return false;
+        }
+        final var state = player.getInBlockState();
+        return state.is(Blocks.LADDER) || state.is(Blocks.VINE)
+                || state.is(Blocks.TWISTING_VINES) || state.is(Blocks.TWISTING_VINES_PLANT)
+                || state.is(Blocks.WEEPING_VINES) || state.is(Blocks.WEEPING_VINES_PLANT);
+    }
+
+    public static double beforeMovement(final double verticalMotion, final boolean jumping, final boolean sneaking) {
+        if (jumping) {
+            return CLIMB_SPEED;
+        }
+        return sneaking && verticalMotion < 0 ? 0 : Math.max(verticalMotion, -CLIMB_SPEED);
+    }
+
+    public static double afterGravity(final double verticalMotion, final boolean horizontalCollision) {
+        return horizontalCollision ? CLIMB_SPEED : verticalMotion;
+    }
+
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/movement/BedrockCollisionContacts.java b/src/main/java/com/viaversion/viafabricplus/bedrock/movement/BedrockCollisionContacts.java
new file mode 100644
index 0000000..cf98df7
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/movement/BedrockCollisionContacts.java
@@ -0,0 +1,102 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement;
+
+import net.minecraft.core.Direction;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.shapes.Shapes;
+import net.minecraft.world.phys.shapes.VoxelShape;
+import net.raphimc.viabedrock.api.model.CollisionContact;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+public final class BedrockCollisionContacts {
+
+    private static final double CONTACT_EPSILON = 0.000001F;
+
+    private BedrockCollisionContacts() {
+    }
+
+    public static double collide(final VoxelShape shape, final Direction.Axis axis, final AABB box, final double distance) {
+        if (distance == 0 || shape.isEmpty()) {
+            return distance;
+        }
+        final AxisCollision collision = new AxisCollision(axis, box, distance);
+        shape.forAllBoxes(collision);
+        return collision.distance;
+    }
+
+    public static boolean canFallAtLeast(final Player player, final double x, final double z, final double distance) {
+        final AABB body = player.getBoundingBox().move(x, 0, z);
+        final AABB probe = new AABB(body.minX, body.minY - distance - Shapes.EPSILON, body.minZ,
+                body.maxX, body.minY, body.maxZ);
+        return canFallAtLeast(player.level().getCollisions(player, probe), body, distance);
+    }
+
+    static boolean canFallAtLeast(final Iterable<VoxelShape> shapes, final AABB body, final double distance) {
+        final double requested = -distance;
+        for (final VoxelShape shape : shapes) {
+            if (collide(shape, Direction.Axis.Y, body, requested) != requested) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static CollisionContact.Box nativeBox(final AABB box) {
+        return new CollisionContact.Box((float) box.minX, (float) box.minY, (float) box.minZ, (float) box.maxX, (float) box.maxY, (float) box.maxZ);
+    }
+
+    private static final class AxisCollision implements Shapes.DoubleLineConsumer {
+
+        private final Direction.Axis axis;
+        private final AABB box;
+        private final CollisionContact.Box moving;
+        private final Position3f probe;
+        private double distance;
+
+        private AxisCollision(final Direction.Axis axis, final AABB box, final double distance) {
+            this.axis = axis;
+            this.box = box;
+            this.moving = nativeBox(box);
+            this.distance = distance;
+            // Find the native contact face independently of rounding the Java request to float.
+            final float direction = distance > 0 ? Float.MAX_VALUE : -Float.MAX_VALUE;
+            this.probe = switch (axis) {
+                case X -> new Position3f(direction, 0F, 0F);
+                case Y -> new Position3f(0F, direction, 0F);
+                case Z -> new Position3f(0F, 0F, direction);
+            };
+        }
+
+        @Override
+        public void consume(final double minX, final double minY, final double minZ,
+                            final double maxX, final double maxY, final double maxZ) {
+            if (this.distance == 0) {
+                return;
+            }
+            final Position3f clipped = CollisionContact.clip(new CollisionContact.Box((float) minX, (float) minY, (float) minZ,
+                    (float) maxX, (float) maxY, (float) maxZ), this.moving, this.probe);
+            if (clipped == this.probe) {
+                return;
+            }
+            final double gap = this.distance > 0 ? switch (this.axis) {
+                case X -> minX - this.box.maxX;
+                case Y -> minY - this.box.maxY;
+                case Z -> minZ - this.box.maxZ;
+            } : switch (this.axis) {
+                case X -> maxX - this.box.minX;
+                case Y -> maxY - this.box.minY;
+                case Z -> maxZ - this.box.minZ;
+            };
+            // Native stores a rounded box after clipping. Java retains double bounds, so
+            // applying the native float gap can put it through the contact face.
+            final double contact = Math.abs(gap) <= CONTACT_EPSILON ? 0 : gap;
+            this.distance = this.distance > 0 ? Math.min(this.distance, Math.max(0, contact))
+                    : Math.max(this.distance, Math.min(0, contact));
+        }
+    }
+}
