@@ -0,0 +1,140 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.function.BiPredicate;
+import java.util.function.BiConsumer;
+import java.util.function.Consumer;
+import java.util.function.UnaryOperator;
+
+/** Owned physical component values. Setters are typed at capture; mutable values are copied on both boundaries. */
+public final class PhysicalState {
+    private final Object owner;
+    private final Map<Enum<?>, Value<?>> values;
+
+    private PhysicalState(final Object owner, final Map<Enum<?>, Value<?>> values) {
+        this.owner = owner;
+        this.values = Collections.unmodifiableMap(new LinkedHashMap<>(values));
+    }
+
+    public static Builder builder(final Object owner) {
+        return new Builder(owner);
+    }
+
+    public void restore() {
+        this.values.values().forEach(Value::restore);
+    }
+
+    /** Keep only changes arriving between completed physics and the next capture, not old predicted motion. */
+    public Changes changesSince(final PhysicalState previous) {
+        if (this.owner != previous.owner || !this.values.keySet().equals(previous.values.keySet())) {
+            throw new IllegalArgumentException("Physical states belong to different actors or component layouts");
+        }
+        final List<Runnable> changes = new ArrayList<>();
+        this.values.forEach((key, value) -> {
+            if (value.reconcile != null && !value.sameValue(previous.values.get(key))) {
+                changes.add(value.changeFrom(previous.values.get(key)));
+            }
+        });
+        return new Changes(changes);
+    }
+
+    public static final class Changes {
+        private final List<Runnable> values;
+
+        private Changes(final List<Runnable> values) {
+            this.values = List.copyOf(values);
+        }
+
+        public void apply() {
+            this.values.forEach(Runnable::run);
+        }
+
+        public boolean isEmpty() {
+            return this.values.isEmpty();
+        }
+    }
+
+    public static final class Builder {
+        private final Object owner;
+        private final Map<Enum<?>, Value<?>> values = new LinkedHashMap<>();
+        private final Map<Enum<?>, Value<?>> lateValues = new LinkedHashMap<>();
+
+        private Builder(final Object owner) {
+            this.owner = Objects.requireNonNull(owner);
+        }
+
+        /** This component has its own authoritative command journal and must not be admitted twice. */
+        public <T> Builder snapshot(final Enum<?> key, final T value, final Consumer<T> setter) {
+            return this.capture(key, value, setter, UnaryOperator.identity(), Objects::equals, null);
+        }
+
+        public <T> Builder capture(final Enum<?> key, final T value, final Consumer<T> setter) {
+            return this.capture(key, value, setter, UnaryOperator.identity(), Objects::equals);
+        }
+
+        public <T> Builder capture(final Enum<?> key, final T value, final Consumer<T> setter,
+                                  final UnaryOperator<T> copy, final BiPredicate<T, T> equality) {
+            return this.capture(key, value, setter, copy, equality, (previous, next) -> setter.accept(next));
+        }
+
+        public <T> Builder capture(final Enum<?> key, final T value, final Consumer<T> setter,
+                                  final UnaryOperator<T> copy, final BiPredicate<T, T> equality,
+                                  final BiConsumer<T, T> reconcile) {
+            return this.add(key, value, setter, copy, equality, reconcile, false);
+        }
+
+        public <T> Builder captureLate(final Enum<?> key, final T value, final Consumer<T> setter) {
+            return this.captureLate(key, value, setter, (previous, next) -> setter.accept(next));
+        }
+
+        public <T> Builder captureLate(final Enum<?> key, final T value, final Consumer<T> setter, final BiConsumer<T, T> reconcile) {
+            return this.add(key, value, setter, UnaryOperator.identity(), Objects::equals, reconcile, true);
+        }
+
+        public <T> Builder snapshotLate(final Enum<?> key, final T value, final Consumer<T> setter) {
+            return this.add(key, value, setter, UnaryOperator.identity(), Objects::equals, null, true);
+        }
+
+        private <T> Builder add(final Enum<?> key, final T value, final Consumer<T> setter, final UnaryOperator<T> copy,
+                               final BiPredicate<T, T> equality, final BiConsumer<T, T> reconcile, final boolean late) {
+            if (this.values.containsKey(key) || this.lateValues.containsKey(key)) {
+                throw new IllegalArgumentException("Duplicate physical component: " + key);
+            }
+            (late ? this.lateValues : this.values).put(key, new Value<>(copy.apply(value), setter, copy, equality, reconcile));
+            return this;
+        }
+
+        public PhysicalState build() {
+            final Map<Enum<?>, Value<?>> ordered = new LinkedHashMap<>(this.values);
+            ordered.putAll(this.lateValues);
+            return new PhysicalState(this.owner, ordered);
+        }
+    }
+
+    private record Value<T>(T value, Consumer<T> setter, UnaryOperator<T> copy, BiPredicate<T, T> equality, BiConsumer<T, T> reconcile) {
+        private void restore() {
+            this.setter.accept(this.copy.apply(this.value));
+        }
+
+        @SuppressWarnings("unchecked")
+        private Runnable changeFrom(final Value<?> previous) {
+            return () -> this.reconcile.accept(this.copy.apply((T) previous.value), this.copy.apply(this.value));
+        }
+
+        @SuppressWarnings("unchecked")
+        private boolean sameValue(final Value<?> other) {
+            // A component key has one type within one actor's capture layout.
+            return this.equality.test(this.value, (T) other.value);
+        }
+    }
+}
