+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/florianreuth/viafabricplus-bedrock
+ * Copyright (C) 2023-2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.viaversion.viafabricplus.bedrock.lan;
+
+import io.netty.buffer.ByteBuf;
+import java.nio.charset.StandardCharsets;
+
+/** Repairs the length field on client-hosted LAN answers that omit trailing SDP attributes. */
+public final class NetherNetConnectResponse {
+
+    private static final int HEADER_LENGTH = Long.BYTES + Integer.BYTES;
+
+    private NetherNetConnectResponse() {
+    }
+
+    public static int repairLength(final ByteBuf packet) {
+        final int start = packet.readerIndex();
+        if (packet.readableBytes() < HEADER_LENGTH) {
+            return 0;
+        }
+
+        final int declaredLength = packet.getIntLE(start + Long.BYTES);
+        final int availableLength = packet.readableBytes() - HEADER_LENGTH;
+        if (declaredLength < 0 || declaredLength >= availableLength) {
+            return 0;
+        }
+
+        final int bodyStart = start + HEADER_LENGTH;
+        final String declared = packet.toString(bodyStart, declaredLength, StandardCharsets.UTF_8);
+        if (!declared.startsWith("CONNECTRESPONSE ")) {
+            return 0;
+        }
+
+        final String omitted = packet.toString(bodyStart + declaredLength,
+            availableLength - declaredLength, StandardCharsets.UTF_8);
+        if (!omitted.contains("a=ice-ufrag:") || !omitted.contains("a=ice-pwd:")
+            || !omitted.contains("a=fingerprint:") || !omitted.contains("a=setup:")) {
+            return 0;
+        }
+
+        packet.setIntLE(start + Long.BYTES, availableLength);
+        return availableLength - declaredLength;
+    }
+
+}
