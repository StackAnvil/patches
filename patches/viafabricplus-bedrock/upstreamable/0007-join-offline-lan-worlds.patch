@@ -0,0 +1,199 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/florianreuth/viafabricplus-bedrock
+ * Copyright (C) 2023-2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.viaversion.viafabricplus.bedrock.screen;
+
+import com.viaversion.viafabricplus.bedrock.lan.BedrockLanAddress;
+import com.viaversion.viafabricplus.bedrock.lan.BedrockLanDiscovery;
+import com.viaversion.viafabricplus.bedrock.lan.BedrockLanWorld;
+import com.viaversion.viafabricplus.bedrock.lan.BedrockLanWorld.AuthMode;
+import com.viaversion.viafabricplus.bedrock.protocoltranslator.network.BedrockConnectionUtil;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.screen.base.VFPScreen;
+import com.viaversion.viafabricplus.screen.base.list.VFPListEntry;
+import com.viaversion.viafabricplus.screen.base.list.VFPTextEntry;
+import java.util.Comparator;
+import java.util.List;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.network.chat.Component;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.jspecify.annotations.NonNull;
+
+/** LAN worlds use direct discovery and are available without an Xbox account. */
+public final class BedrockLanScreen extends VFPScreen {
+
+    public static final Component TITLE = Component.translatable("screen.viafabricplus.bedrock_lan");
+
+    private static final int SECONDARY_COLOR = 0xFFB8B8B8;
+    private List<BedrockLanWorld> worlds = List.of();
+    private boolean scanning;
+    private boolean scanFailed;
+    private int scanGeneration;
+    private SlotList list;
+    private Button joinButton;
+    private Button loginButton;
+    private Button refreshButton;
+    private AuthMode authMode = AuthMode.SELF_SIGNED;
+    private BedrockLanWorld selectedWorld;
+
+    public BedrockLanScreen() {
+        super(TITLE, true);
+    }
+
+    @Override
+    protected void init() {
+        this.list = this.addRenderableWidget(new SlotList(this.minecraft, this.width, this.height, 87, FOOTER_HEIGHT,
+            (this.font.lineHeight + 2) * 3));
+        this.addRenderableOnly((graphics, mouseX, mouseY, delta) -> this.renderScreenTitle(graphics));
+        this.joinButton = Button.builder(Component.translatable("bedrock_lan.viafabricplus.join"), _ -> this.join()).build();
+        this.loginButton = Button.builder(Component.empty(), _ -> this.toggleLogin()).build();
+        this.refreshButton = Button.builder(Component.translatable("bedrock_lan.viafabricplus.refresh"), _ -> this.scan()).build();
+        this.addFooter(this.joinButton, this.loginButton, this.refreshButton);
+        super.init();
+        if (this.scanGeneration == 0) {
+            this.scan();
+        }
+    }
+
+    @Override
+    public void tick() {
+        super.tick();
+        final BedrockLanWorld world = this.selected();
+        if (world != this.selectedWorld) {
+            this.selectedWorld = world;
+            this.authMode = this.preferredMode(world);
+        }
+        final boolean accountPresent = ViaFabricPlusBedrock.impl().account().get() != null;
+        final boolean canJoin = world != null && world.compatible(ProtocolConstants.BEDROCK_PROTOCOL_VERSION)
+            && !world.full() && Minecraft.getInstance().getConnection() == null
+            && (this.authMode == AuthMode.SELF_SIGNED
+                && (world.transport() == BedrockLanWorld.Transport.RAKNET || world.acceptsSelfSignedAuth())
+                || this.authMode == AuthMode.ONLINE && accountPresent
+                    && (world.transport() == BedrockLanWorld.Transport.RAKNET || world.acceptsOnlineAuth()));
+        this.joinButton.active = canJoin;
+        this.loginButton.active = world != null && (world.transport() == BedrockLanWorld.Transport.RAKNET
+            || accountPresent && world.acceptsOnlineAuth() && world.acceptsSelfSignedAuth());
+        this.loginButton.setMessage(Component.translatable(world != null && world.transport() == BedrockLanWorld.Transport.RAKNET
+            && this.authMode == AuthMode.ONLINE && !accountPresent ? "bedrock_lan.viafabricplus.try_offline_login"
+            : this.authMode == AuthMode.SELF_SIGNED ? "bedrock_lan.viafabricplus.offline_login"
+                : "bedrock_lan.viafabricplus.xbox_login"));
+        this.refreshButton.active = !this.scanning;
+    }
+
+    private void scan() {
+        if (this.scanning) {
+            return;
+        }
+        this.scanning = true;
+        this.scanFailed = false;
+        final int generation = ++this.scanGeneration;
+        BedrockLanDiscovery.discover().whenCompleteAsync((results, error) -> {
+            if (generation != this.scanGeneration) {
+                return;
+            }
+            this.scanning = false;
+            this.scanFailed = error != null;
+            if (error == null) {
+                this.worlds = results.stream().filter(world -> world.compatible(ProtocolConstants.BEDROCK_PROTOCOL_VERSION))
+                    .sorted(Comparator.comparing(BedrockLanWorld::name, String.CASE_INSENSITIVE_ORDER)).toList();
+            } else {
+                ViaFabricPlusBedrock.impl().logger().warn("Could not scan for Bedrock LAN worlds", error);
+            }
+            if (Minecraft.getInstance().gui.screen() == this) {
+                this.rebuildWidgets();
+            }
+        }, Minecraft.getInstance());
+        this.rebuildWidgets();
+    }
+
+    private BedrockLanWorld selected() {
+        return this.list != null && this.list.getFocused() instanceof WorldEntry entry ? entry.world : null;
+    }
+
+    private AuthMode preferredMode(final BedrockLanWorld world) {
+        if (world == null || world.transport() == BedrockLanWorld.Transport.RAKNET) {
+            return AuthMode.ONLINE;
+        }
+        if (world.acceptsSelfSignedAuth()) {
+            return AuthMode.SELF_SIGNED;
+        }
+        return AuthMode.ONLINE;
+    }
+
+    private void toggleLogin() {
+        this.authMode = this.authMode == AuthMode.ONLINE ? AuthMode.SELF_SIGNED : AuthMode.ONLINE;
+    }
+
+    private void join() {
+        final BedrockLanWorld world = this.selected();
+        if (world != null && this.joinButton.active) {
+            BedrockConnectionUtil.connectLan(new BedrockLanAddress(world, this.authMode));
+        }
+    }
+
+    private final class SlotList extends ActionList {
+
+        private SlotList(final Minecraft minecraft, final int width, final int height, final int top,
+                         final int bottom, final int entryHeight) {
+            super(minecraft, width, height, top, bottom, entryHeight);
+            if (BedrockLanScreen.this.worlds.isEmpty()) {
+                this.addEntry(new VFPTextEntry(Component.translatable(BedrockLanScreen.this.scanning
+                    ? "bedrock_lan.viafabricplus.scanning" : BedrockLanScreen.this.scanFailed
+                        ? "bedrock_lan.viafabricplus.scan_failed" : "bedrock_lan.viafabricplus.empty")));
+            } else {
+                BedrockLanScreen.this.worlds.forEach(world -> this.addEntry(new WorldEntry(world)));
+            }
+        }
+
+        @Override
+        protected boolean activate(final VFPListEntry entry) {
+            if (entry instanceof WorldEntry) {
+                BedrockLanScreen.this.join();
+                return true;
+            }
+            return false;
+        }
+
+        @Override
+        public int getRowWidth() {
+            return Math.min(352, this.width - 20);
+        }
+
+    }
+
+    private static final class WorldEntry extends VFPListEntry {
+
+        private final BedrockLanWorld world;
+
+        private WorldEntry(final BedrockLanWorld world) {
+            this.world = world;
+        }
+
+        @Override
+        public @NonNull Component getNarration() {
+            return Component.literal(this.world.name() + ", " + this.world.version() + ", "
+                + this.world.players() + "/" + this.world.maxPlayers());
+        }
+
+        @Override
+        public void mappedRender(final GuiGraphicsExtractor graphics, final int entryWidth, final int entryHeight) {
+            final Font font = Minecraft.getInstance().font;
+            final String players = this.world.players() + "/" + this.world.maxPlayers();
+            final String transport = this.world.transport() == BedrockLanWorld.Transport.NETHERNET ? "NetherNet" : "RakNet";
+            final String details = transport + "  •  " + this.world.version() + "  •  " + this.world.responder().getAddress().getHostAddress();
+            graphics.text(font, font.plainSubstrByWidth(this.world.name(), entryWidth - font.width(players) - 22),
+                SLOT_MARGIN, SLOT_MARGIN + 1, -1);
+            graphics.text(font, players, entryWidth - font.width(players) - SLOT_MARGIN, SLOT_MARGIN + 1, -1);
+            graphics.text(font, font.plainSubstrByWidth(details, entryWidth - SLOT_MARGIN * 2),
+                SLOT_MARGIN, SLOT_MARGIN + font.lineHeight + 4, SECONDARY_COLOR);
+        }
+
+    }
+
+}
