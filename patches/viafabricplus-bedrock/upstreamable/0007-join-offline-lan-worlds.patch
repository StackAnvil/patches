+package com.viaversion.viafabricplus.bedrock.lan;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.nio.charset.StandardCharsets;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+final class NetherNetConnectResponseTest {
+
+    @Test
+    void includesOmittedSdpAttributesInConnectResponseLength() {
+        final String declared = "CONNECTRESPONSE 42 v=0\r\na=candidate:1 1 udp 1 192.168.1.2 5000 typ host\r\n";
+        final String omitted = "a=ice-ufrag:test\r\na=ice-pwd:password\r\na=fingerprint:sha-256 00:11\r\na=setup:active\r\n";
+        final ByteBuf packet = message(declared, omitted);
+        try {
+            assertEquals(omitted.length(), NetherNetConnectResponse.repairLength(packet));
+            assertEquals(declared.length() + omitted.length(), packet.getIntLE(Long.BYTES));
+        } finally {
+            packet.release();
+        }
+    }
+
+    @Test
+    void leavesUnrelatedAndCompleteSignalsAlone() {
+        final String candidate = "CANDIDATEADD 42 candidate:1 1 udp 1 192.168.1.2 5000 typ host";
+        final ByteBuf unrelated = message(candidate, "a=ice-ufrag:test\r\na=ice-pwd:password\r\n"
+            + "a=fingerprint:sha-256 00:11\r\na=setup:active\r\n");
+        final ByteBuf complete = message("CONNECTRESPONSE 42 v=0\r\na=ice-ufrag:test\r\n", "");
+        try {
+            assertEquals(0, NetherNetConnectResponse.repairLength(unrelated));
+            assertEquals(candidate.length(), unrelated.getIntLE(Long.BYTES));
+            assertEquals(0, NetherNetConnectResponse.repairLength(complete));
+        } finally {
+            unrelated.release();
+            complete.release();
+        }
+    }
+
+    private static ByteBuf message(final String declared, final String omitted) {
+        final byte[] bytes = declared.getBytes(StandardCharsets.UTF_8);
+        return Unpooled.buffer().writeLongLE(0).writeIntLE(bytes.length).writeBytes(bytes)
+            .writeBytes(omitted.getBytes(StandardCharsets.UTF_8));
+    }
+
+}
