+
+/** A verified LAN reply and the connection details supplied by that reply. */
+public record BedrockLanWorld(Transport transport, InetSocketAddress responder, long networkId,
+                              String name, String version, int protocol, int players, int maxPlayers,
+                              boolean acceptsOnlineAuth, boolean acceptsSelfSignedAuth, @Nullable String nonce) {
+
+    public enum Transport {
+        NETHERNET, RAKNET
+    }
+
+    public enum AuthMode {
+        ONLINE, SELF_SIGNED
+    }
+
+    public boolean compatible(final int supportedProtocol) {
+        return this.protocol == supportedProtocol;
+    }
+
+    public boolean full() {
+        return this.maxPlayers > 0 && this.players >= this.maxPlayers;
+    }
+
+}
