+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(value = NetherNetDiscovery.class, remap = false)
+public abstract class MixinNetherNetDiscovery {
+
+    @WrapOperation(method = {"bind(I)V", "bind(Ljava/net/InetSocketAddress;)V"},
+        at = @At(value = "INVOKE", target = "Lio/netty/bootstrap/Bootstrap;handler(Lio/netty/channel/ChannelHandler;)Lio/netty/bootstrap/AbstractBootstrap;"))
+    private AbstractBootstrap<?, ?> receiveCompleteLanSignals(final Bootstrap bootstrap, final ChannelHandler handler,
+                                                                final Operation<AbstractBootstrap<?, ?>> original) {
+        bootstrap.option(ChannelOption.RCVBUF_ALLOCATOR, new FixedRecvByteBufAllocator(65_535));
+        return original.call(bootstrap, handler);
+    }
+
+    @Inject(method = "handleMessage", at = @At("HEAD"))
+    private void repairIncompleteConnectResponse(final ByteBuf packet, final long senderId,
+                                                 final InetSocketAddress sender, final CallbackInfo ci) {
+        final int addedBytes = NetherNetConnectResponse.repairLength(packet);
+        if (addedBytes > 0) {
+            ViaFabricPlusBedrock.impl().logger().warn("Repaired NetherNet LAN response with {} uncounted SDP bytes", addedBytes);
+        }
+    }
+
+}
