+
+package com.viaversion.viafabricplus.bedrock.lan;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.net.InetSocketAddress;
+import java.nio.charset.StandardCharsets;
+import java.util.HexFormat;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockLanDiscoveryTest {
+
+    private static final InetSocketAddress RESPONDER = new InetSocketAddress("127.0.0.1", 7551);
+
+    @Test
+    void decodesRetailLayoutSevenCapabilitiesAndNonce() {
+        final byte[] advertisement = advertisement(true, true, "example-nonce");
+        final BedrockLanWorld world = BedrockLanDiscovery.readNetherNetAdvertisement(advertisement, 42, RESPONDER);
+
+        assertNotNull(world);
+        assertEquals(BedrockLanWorld.Transport.NETHERNET, world.transport());
+        assertEquals(RESPONDER, world.responder());
+        assertEquals(42, world.networkId());
+        assertEquals(2193, world.protocol());
+        assertEquals(1, world.players());
+        assertEquals(8, world.maxPlayers());
+        assertTrue(world.acceptsOnlineAuth());
+        assertTrue(world.acceptsSelfSignedAuth());
+        assertEquals("example-nonce", world.nonce());
+    }
+
+    @Test
+    void rejectsUnverifiedOrTruncatedAdvertisements() {
+        final byte[] valid = advertisement(true, true, "example-nonce");
+        valid[0] = 6;
+        assertNull(BedrockLanDiscovery.readNetherNetAdvertisement(valid, 42, RESPONDER));
+        assertNull(BedrockLanDiscovery.readNetherNetAdvertisement(new byte[]{7, 50}, 42, RESPONDER));
+        assertNull(BedrockLanDiscovery.readNetherNetAdvertisement(advertisement(false, false, ""), 42, RESPONDER));
+    }
+
+    @Test
+    void acceptsOnlyACompleteRakNetPong() {
+        final byte[] magic = HexFormat.of().parseHex("00ffff00fefefefefdfdfdfd12345678");
+        final byte[] advertisement = "MCPE;World;2193;1.26.51;1;8;42;Level;Survival".getBytes(StandardCharsets.UTF_8);
+        final ByteBuf data = Unpooled.buffer();
+        try {
+            data.writeByte(0x1c).writeLong(0).writeLong(42).writeBytes(magic)
+                .writeShort(advertisement.length).writeBytes(advertisement);
+            final byte[] packet = new byte[data.readableBytes()];
+            data.readBytes(packet);
+            final BedrockLanWorld world = BedrockLanDiscovery.readRakNetResponse(packet, packet.length, RESPONDER);
+            assertNotNull(world);
+            assertEquals(BedrockLanWorld.Transport.RAKNET, world.transport());
+            assertEquals(2193, world.protocol());
+            assertFalse(world.acceptsOnlineAuth());
+            assertFalse(world.acceptsSelfSignedAuth());
+            assertNull(world.nonce());
+            assertNull(BedrockLanDiscovery.readRakNetResponse(packet, packet.length - 1, RESPONDER));
+        } finally {
+            data.release();
+        }
+    }
+
+    private static byte[] advertisement(final boolean online, final boolean selfSigned, final String nonce) {
+        final ByteBuf data = Unpooled.buffer();
+        try {
+            data.writeByte(7);
+            writeString(data, "World");
+            writeZigZag(data, 2193);
+            writeString(data, "1.26.51");
+            writeString(data, "Level");
+            writeZigZag(data, 1);
+            writeZigZag(data, 8);
+            writeZigZag(data, 1);
+            data.writeBoolean(false).writeBoolean(false).writeBoolean(online).writeBoolean(selfSigned);
+            writeString(data, nonce);
+            writeZigZag(data, 4);
+            final byte[] bytes = new byte[data.readableBytes()];
+            data.readBytes(bytes);
+            return bytes;
+        } finally {
+            data.release();
+        }
+    }
+
+    private static void writeString(final ByteBuf data, final String value) {
+        final byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        writeVarInt(data, bytes.length);
+        data.writeBytes(bytes);
+    }
+
+    private static void writeZigZag(final ByteBuf data, final int value) {
+        writeVarInt(data, value << 1 ^ value >> 31);
+    }
+
+    private static void writeVarInt(final ByteBuf data, int value) {
+        while ((value & ~0x7f) != 0) {
+            data.writeByte(value & 0x7f | 0x80);
+            value >>>= 7;
+        }
+        data.writeByte(value);
+    }
+
+}
