+import java.util.concurrent.TimeUnit;
+import org.cloudburstmc.netty.channel.nethernet.NetherNetConstants;
+import org.jetbrains.annotations.Nullable;
+
+/** Probes both Bedrock LAN transports without using an Xbox session. */
+public final class BedrockLanDiscovery {
+
+    private static final int NETHERNET_PORT = 7551;
+    private static final int RAKNET_PORT = 19132;
+    private static final int MAX_PACKET_SIZE = 8192;
+    private static final long SCAN_DURATION_NANOS = TimeUnit.SECONDS.toNanos(3);
+    private static final byte[] RAKNET_MAGIC = HexFormat.of().parseHex("00ffff00fefefefefdfdfdfd12345678");
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private BedrockLanDiscovery() {
+    }
+
+    public static CompletableFuture<List<BedrockLanWorld>> discover() {
+        final CompletableFuture<List<BedrockLanWorld>> netherNet = CompletableFuture.supplyAsync(() -> probe(true));
+        final CompletableFuture<List<BedrockLanWorld>> rakNet = CompletableFuture.supplyAsync(() -> probe(false));
+        return netherNet.thenCombine(rakNet, (first, second) -> {
+            final List<BedrockLanWorld> worlds = new ArrayList<>(first);
+            worlds.addAll(second);
+            return List.copyOf(worlds);
+        });
+    }
+
+    private static List<BedrockLanWorld> probe(final boolean netherNet) {
+        final Map<Long, BedrockLanWorld> worlds = new HashMap<>();
+        final int port = netherNet ? NETHERNET_PORT : RAKNET_PORT;
+        try (DatagramSocket socket = new DatagramSocket(0)) {
+            socket.setBroadcast(true);
+            socket.setSoTimeout(250);
+            final byte[] request = netherNet ? netherNetRequest() : rakNetRequest();
+            for (InetAddress target : broadcastAddresses()) {
+                socket.send(new DatagramPacket(request, request.length, target, port));
+            }
+            final long deadline = System.nanoTime() + SCAN_DURATION_NANOS;
+            while (System.nanoTime() < deadline) {
+                final DatagramPacket reply = new DatagramPacket(new byte[MAX_PACKET_SIZE], MAX_PACKET_SIZE);
+                try {
+                    socket.receive(reply);
+                } catch (SocketTimeoutException ignored) {
+                    continue;
+                }
+                final InetSocketAddress responder = new InetSocketAddress(reply.getAddress(), reply.getPort());
+                final BedrockLanWorld world = netherNet
+                    ? readNetherNetResponse(reply.getData(), reply.getLength(), responder)
+                    : readRakNetResponse(reply.getData(), reply.getLength(), responder);
+                if (world != null) {
+                    final BedrockLanWorld previous = worlds.get(world.networkId());
+                    if (previous == null || previous.responder().getAddress().isLoopbackAddress()
+                        && !world.responder().getAddress().isLoopbackAddress()) {
+                        worlds.put(world.networkId(), world);
+                    }
+                }
+            }
+        } catch (Exception ignored) {
+            // An unavailable interface or transport must not hide results from the other probe.
+        }
+        return List.copyOf(worlds.values());
+    }
+
+    private static Set<InetAddress> broadcastAddresses() throws IOException {
+        final Set<InetAddress> addresses = new HashSet<>();
+        addresses.add(InetAddress.getByName("127.0.0.1"));
+        final Enumeration<NetworkInterface> interfaces = NetworkInterface.getNetworkInterfaces();
+        while (interfaces != null && interfaces.hasMoreElements()) {
+            final NetworkInterface network = interfaces.nextElement();
+            if (!network.isUp() || network.isLoopback()) {
+                continue;
+            }
+            for (InterfaceAddress address : network.getInterfaceAddresses()) {
+                if (address.getAddress() instanceof Inet4Address && address.getBroadcast() != null) {
+                    addresses.add(address.getBroadcast());
+                }
+            }
+        }
+        return addresses;
+    }
+
+    private static byte[] netherNetRequest() throws Exception {
+        final ByteBuf data = Unpooled.buffer(18);
+        try {
+            data.writeShortLE(0).writeLongLE(RANDOM.nextLong()).writeZero(8);
+            return NetherNetConstants.encryptDiscoveryPacket(data);
+        } finally {
+            data.release();
+        }
+    }
+
+    private static byte[] rakNetRequest() {
+        final ByteBuf data = Unpooled.buffer(33);
+        try {
+            data.writeByte(1).writeLong(System.currentTimeMillis()).writeBytes(RAKNET_MAGIC).writeLong(RANDOM.nextLong());
+            final byte[] request = new byte[data.readableBytes()];
+            data.readBytes(request);
+            return request;
+        } finally {
+            data.release();
+        }
+    }
+
+    static @Nullable BedrockLanWorld readNetherNetResponse(final byte[] packet, final int length,
+                                                             final InetSocketAddress responder) {
+        if (length < 50 || length > MAX_PACKET_SIZE) {
+            return null;
+        }
+        final ByteBuf encrypted = Unpooled.wrappedBuffer(packet, 0, length);
+        try {
+            final ByteBuf response = NetherNetConstants.decryptDiscoveryPacket(encrypted);
+            if (response == null) {
+                return null;
+            }
+            try {
+                if (response.readableBytes() < 22 || response.readUnsignedShortLE() != 1) {
+                    return null;
+                }
+                final long networkId = response.readLongLE();
+                response.skipBytes(8);
+                final int hexLength = response.readIntLE();
+                if (networkId == 0 || hexLength < 2 || hexLength > 4096 || (hexLength & 1) != 0
+                    || response.readableBytes() != hexLength) {
+                    return null;
+                }
+                final byte[] hex = new byte[hexLength];
+                response.readBytes(hex);
+                final byte[] advertisement = HexFormat.of().parseHex(new String(hex, StandardCharsets.US_ASCII));
+                return readNetherNetAdvertisement(advertisement, networkId, responder);
+            } finally {
+                response.release();
+            }
+        } catch (Exception ignored) {
+            return null;
+        } finally {
+            encrypted.release();
+        }
+    }
+
+    static @Nullable BedrockLanWorld readNetherNetAdvertisement(final byte[] advertisement, final long networkId,
+                                                                 final InetSocketAddress responder) {
+        final ByteBuf data = Unpooled.wrappedBuffer(advertisement);
+        try {
+            // Layout 7 was captured from retail Bedrock 1.26.51. Older layouts do not advertise auth capability.
+            if (data.readUnsignedByte() != 7) {
+                return null;
+            }
+            final String motd = readString(data);
+            final int protocol = readZigZag(data);
+            final String version = readString(data);
+            final String levelName = readString(data);
+            final int players = readZigZag(data);
+            final int maxPlayers = readZigZag(data);
+            readZigZag(data); // game mode
+            readBoolean(data); // editor world
+            readBoolean(data); // hardcore
+            final boolean online = readBoolean(data);
+            final boolean selfSigned = readBoolean(data);
+            final String nonce = readString(data);
+            readZigZag(data); // connection type
+            if (data.isReadable() || protocol <= 0 || players < 0 || maxPlayers <= 0 || players > maxPlayers
+                || !online && !selfSigned) {
+                return null;
+            }
+            return new BedrockLanWorld(BedrockLanWorld.Transport.NETHERNET, responder, networkId,
+                levelName.isBlank() ? motd : levelName, version, protocol, players, maxPlayers,
+                online, selfSigned, nonce.isEmpty() ? null : nonce);
+        } catch (RuntimeException ignored) {
+            return null;
+        } finally {
+            data.release();
+        }
+    }
+
+    static @Nullable BedrockLanWorld readRakNetResponse(final byte[] packet, final int length,
+                                                         final InetSocketAddress responder) {
+        final ByteBuf data = Unpooled.wrappedBuffer(packet, 0, length);
+        try {
+            if (length < 37 || data.readUnsignedByte() != 0x1c) {
+                return null;
+            }
+            data.skipBytes(8);
+            final long networkId = data.readLong();
+            for (byte value : RAKNET_MAGIC) {
+                if (data.readByte() != value) {
+                    return null;
+                }
+            }
+            final int textLength = data.readUnsignedShort();
+            if (textLength < 5 || textLength > 1024 || data.readableBytes() != textLength) {
+                return null;
+            }
+            final String[] fields = data.readCharSequence(textLength, StandardCharsets.UTF_8).toString().split(";", -1);
+            if (fields.length < 6 || !fields[0].equals("MCPE")) {
+                return null;
+            }
+            final int protocol = Integer.parseInt(fields[2]);
+            final int players = Integer.parseInt(fields[4]);
+            final int maxPlayers = Integer.parseInt(fields[5]);
+            if (protocol <= 0 || players < 0 || maxPlayers <= 0 || players > maxPlayers) {
+                return null;
+            }
+            // RakNet pongs have no authentication capability or nonce fields. Both capability flags remain unknown.
+            return new BedrockLanWorld(BedrockLanWorld.Transport.RAKNET, responder, networkId,
+                fields[1], fields[3], protocol, players, maxPlayers, false, false, null);
+        } catch (RuntimeException ignored) {
+            return null;
+        } finally {
+            data.release();
+        }
+    }
+
+    private static boolean readBoolean(final ByteBuf data) {
+        final int value = data.readUnsignedByte();
+        if (value > 1) {
+            throw new IllegalArgumentException("Invalid LAN boolean");
+        }
+        return value == 1;
+    }
+
+    private static int readZigZag(final ByteBuf data) {
+        final int value = readVarInt(data);
+        return value >>> 1 ^ -(value & 1);
+    }
+
+    private static int readVarInt(final ByteBuf data) {
+        int result = 0;
+        for (int shift = 0; shift < 35; shift += 7) {
+            final int value = data.readUnsignedByte();
+            if (shift == 28 && (value & 0xF0) != 0) {
+                throw new IllegalArgumentException("LAN varint overflow");
+            }
+            result |= (value & 0x7F) << shift;
+            if ((value & 0x80) == 0) {
+                return result;
+            }
+        }
+        throw new IllegalArgumentException("LAN varint too long");
+    }
+
+    private static String readString(final ByteBuf data) {
+        final int length = readVarInt(data);
+        if (length < 0 || length > 256 || length > data.readableBytes()) {
+            throw new IllegalArgumentException("Invalid LAN string length");
+        }
+        return data.readCharSequence(length, StandardCharsets.UTF_8).toString();
+    }
+
+}
