+package com.viaversion.viafabricplus.bedrock.lan;
+
+import java.net.SocketAddress;
+
+/** Keeps discovery metadata and the chosen login mode with one connection attempt. */
+public final class BedrockLanAddress extends SocketAddress {
+
+    private final BedrockLanWorld world;
+    private final BedrockLanWorld.AuthMode authMode;
+
+    public BedrockLanAddress(final BedrockLanWorld world, final BedrockLanWorld.AuthMode authMode) {
+        this.world = world;
+        this.authMode = authMode;
+    }
+
+    public BedrockLanWorld world() {
+        return this.world;
+    }
+
+    public BedrockLanWorld.AuthMode authMode() {
+        return this.authMode;
+    }
+
+    @Override
+    public String toString() {
+        return this.world.responder().toString();
+    }
+
+}
