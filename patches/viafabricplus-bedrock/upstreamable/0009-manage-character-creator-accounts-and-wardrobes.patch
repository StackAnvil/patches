+    static JsonObject copyActiveRequest(final AccountWardrobe wardrobe, final int slotNumber) throws IOException {
+        requireEmptySlot(wardrobe, slotNumber);
+        if (wardrobe.activeSlot() < 1 || wardrobe.activeSlot() > wardrobe.slots().size()
+            || !wardrobe.slots().get(wardrobe.activeSlot() - 1).occupied()) {
+            throw new IOException("Select a saved character to copy first");
+        }
+        return editRequest(slotNumber, settingsForSlot(wardrobe, slotNumber),
+            wardrobe.slots().get(wardrobe.activeSlot() - 1).profile());
+    }
