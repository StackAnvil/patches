+            if (swatch.index < colors.size()) {
+                swatch.setRectangle(42, rowHeight, this.width / 2 - 150 + swatch.index % 6 * 48,
+                    this.colorGridTop() + swatch.index / 6 * (rowHeight + 4));
+                swatch.setMessage(Component.literal(colors.get(swatch.index)));
+                swatch.setTooltip(Tooltip.create(swatch.getMessage()));
