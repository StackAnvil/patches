+    private static byte[] archive(
+            final String id, final byte[] key, final byte[] fileKey, final byte[] data)
+            throws Exception {
+        final JsonObject manifest = new JsonObject(), header = new JsonObject();
+        header.addProperty("uuid", id);
+        manifest.add("header", header);
+        final JsonObject index = new JsonObject(), entry = new JsonObject();
+        entry.addProperty("path", "texture.png");
+        entry.addProperty("key", new String(fileKey, StandardCharsets.ISO_8859_1));
+        final JsonArray content = new JsonArray();
+        content.add(entry);
+        index.add("content", content);
+        final ByteArrayOutputStream contents = new ByteArrayOutputStream();
+        final byte[] prefix = new byte[256];
+        prefix[4] = (byte) 0xFC;
+        prefix[5] = (byte) 0xB9;
+        prefix[6] = (byte) 0xCF;
+        prefix[7] = (byte) 0x9B;
+        prefix[16] = (byte) id.length();
+        System.arraycopy(id.getBytes(StandardCharsets.UTF_8), 0, prefix, 17, id.length());
+        contents.write(prefix);
+        contents.write(encrypt(index.toString().getBytes(StandardCharsets.UTF_8), key));
+        final ByteArrayOutputStream output = new ByteArrayOutputStream();
+        try (final ZipOutputStream zip = new ZipOutputStream(output)) {
+            for (final var file :
+                    Map.of(
+                                    "manifest.json",
+                                    manifest.toString().getBytes(StandardCharsets.UTF_8),
+                                    "contents.json",
+                                    contents.toByteArray(),
+                                    "texture.png",
+                                    encrypt(data, fileKey))
+                            .entrySet()) {
+                zip.putNextEntry(new ZipEntry(file.getKey()));
+                zip.write(file.getValue());
+                zip.closeEntry();
+            }
+        }
+        return output.toByteArray();
+    }
+
+    private static byte[] encrypt(final byte[] data, final byte[] key) throws Exception {
+        final Cipher cipher = Cipher.getInstance("AES/CFB8/NoPadding");
+        cipher.init(
+                Cipher.ENCRYPT_MODE,
+                new SecretKeySpec(key, "AES"),
+                new IvParameterSpec(Arrays.copyOf(key, 16)));
+        return cipher.doFinal(data);
+    }
+}
