+final class BedrockClassicAccountTest {
+    private static final String PACK_ID = new UUID(12, 34).toString();
+    private static final String OLD_PACK_ID = new UUID(56, 78).toString();
+    private static final String CAPE_ID = new UUID(90, 12).toString();
+
+    @TempDir
+    Path directory;
+
+    @Test
+    void keepsNativeIdentityAndOriginalIndexWhenEarlierTexturesAreUnavailable() throws Exception {
+        final var skin = pack().skins().getFirst();
+        assertEquals(1, skin.index());
+        assertEquals(PACK_ID, skin.packId());
+        assertEquals(PACK_ID + "." + skin.index(), skin.recipeId());
+        assertEquals(PACK_ID + "_" + skin.localizationName(), skin.skinId());
+        assertNotEquals(skin.name(), skin.localizationName());
+        assertNotEquals(PACK_ID + "_serialization", skin.skinId());
+    }
+
+    @Test
+    void persistsPackIdentityAcrossReloadAndPresetSelectionAndClearsItOnImageImport() throws Exception {
+        final var pack = pack();
+        final var skin = pack.skins().getFirst();
+        final var store = store();
+        final var imported = store.importPackSkin("123", pack, skin, skin.slim());
+        assertEquals(skin.skinId(), imported.skinId());
+        assertEquals(imported.skinId(), store().load("123").skinId());
+        store.select("123", BedrockAppearanceStore.Selection.STEVE);
+        assertNotEquals(imported.skinId(), store.load("123").skinId());
+        store.select("123", BedrockAppearanceStore.Selection.CUSTOM);
+        assertEquals(imported.skinId(), store.load("123").skinData("").skinId());
+        store.setSlim("123", !skin.slim());
+        assertNotEquals(imported.skinId(), store.load("123").skinId());
+        store.setSlim("123", skin.slim());
+        assertEquals(imported.skinId(), store.load("123").skinId());
+        store.importSkinImage("123", new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB), skin.slim());
+        assertNotEquals(imported.skinId(), store().load("123").skinId());
+    }
+
+    @Test
+    void replacesClassicReferenceWhilePreservingPersonaColorsCapesEmotesAndSettings() throws Exception {
+        final var wardrobe = wardrobe();
+        final var skin = pack().skins().getFirst();
+        final var before = wardrobe.slots().getFirst().profile().deepCopy();
+        final var request = BedrockCharacterProfiles.classicSelectionRequest(wardrobe, 1, skin);
+        final var objects = request.getAsJsonArray("appearanceObjects");
+        final var settings = objects.get(0).getAsJsonObject().getAsJsonObject("personaAppearance");
+        final var edited = objects.get(1).getAsJsonObject().getAsJsonObject("personaAppearance");
+        assertEquals(wardrobe.settingsProfile().getAsJsonObject("personaCollection"), settings.getAsJsonObject("personaCollection"));
+        final var entries = edited.getAsJsonObject("personaCollection").getAsJsonArray("universalApp");
+        final var original = before.getAsJsonObject("personaCollection").getAsJsonArray("universalApp");
+        final var header = entries.get(0).getAsJsonObject();
+        assertTrue(header.get("skin").getAsBoolean());
+        assertEquals(skin.slim(), "slim".equals(header.get("cs_arm").getAsString()));
+        assertEquals(original.get(0).getAsJsonObject().get("arm"), header.get("arm"));
+        assertEquals(original.get(0).getAsJsonObject().get("skcol"), header.get("skcol"));
+        for (int index = 1; index < original.size() - 1; index++) assertEquals(original.get(index), entries.get(index));
+        assertEquals(skin.recipeId(), entries.get(entries.size() - 1).getAsJsonObject().get("id").getAsString());
+        assertEquals(before, wardrobe.slots().getFirst().profile());
+        assertEquals(wardrobe.slots().getFirst().arm(), newSlot(edited).arm());
+        assertTrue(newSlot(edited).classic());
+        assertEquals(skin.slim(), newSlot(edited).classicSlim());
+    }
