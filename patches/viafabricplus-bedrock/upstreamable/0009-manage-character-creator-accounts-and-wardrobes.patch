+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles.WardrobeItem;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import net.raphimc.minecraftauth.xbl.model.XblXstsToken;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockMarketplaceTransactionsTest {
+    private static final UUID OFFER = UUID.randomUUID();
+    private static final UUID PACK = UUID.randomUUID();
+
+    @Test
+    void readsOnlyMinecoinsAndPreservesZeroAndLargeBalances() throws Exception {
+        for (final long amount : List.of(0L, 320L, 4294967296L, Long.MAX_VALUE)) {
+            final var response = balances(amount);
+            final var other = new JsonObject();
+            other.addProperty("type", "PlayStationToken");
+            other.addProperty("amount", 900);
+            response.getAsJsonObject("result").getAsJsonArray("virtualCurrencyBalances").add(other);
+            assertEquals(amount, BedrockMarketplaceTransactions.parseMinecoins(response));
+        }
+    }
+
+    @Test
+    void rejectsMissingDuplicateAndInvalidMinecoinAmounts() {
+        assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.parseMinecoins(new JsonObject()));
+        final var missing = balances(10);
+        missing.getAsJsonObject("result").getAsJsonArray("virtualCurrencyBalances").get(0)
+                .getAsJsonObject().addProperty("type", "PlayStationToken");
+        assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.parseMinecoins(missing));
+        final var duplicate = balances(10);
+        final var values = duplicate.getAsJsonObject("result").getAsJsonArray("virtualCurrencyBalances");
+        values.add(values.get(0).deepCopy());
+        assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.parseMinecoins(duplicate));
+        for (final Number amount : List.of(-1, 0.5, new java.math.BigInteger("9223372036854775808"))) {
+            assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.parseMinecoins(balances(amount)));
+        }
+        final var text = balances(10);
+        text.getAsJsonObject("result").getAsJsonArray("virtualCurrencyBalances").get(0)
+                .getAsJsonObject().addProperty("amount", "10");
+        assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.parseMinecoins(text));
+    }
+
+    private static JsonObject balances(final Number amount) {
+        final var currency = new JsonObject();
+        currency.addProperty("type", "Minecoin");
+        currency.addProperty("amount", amount);
+        final var values = new JsonArray();
+        values.add(currency);
+        final var result = new JsonObject();
+        result.add("virtualCurrencyBalances", values);
+        final var response = new JsonObject();
+        response.add("result", result);
+        return response;
+    }
+
+    @Test
+    void constructsFreeClaimsAndPaidPurchasesWithTheConfirmedPrice() throws Exception {
+        for (final int price : List.of(0, 120)) {
+            final var item = item(price, false, true);
+            final UUID correlation = UUID.randomUUID();
+            final var request = BedrockMarketplaceTransactions.purchaseRequest(item, published(price), correlation);
+            assertEquals(item.id(), request.get("OfferId").getAsString());
+            assertEquals("", request.get("StoreId").getAsString());
+            assertEquals(Integer.toString(price), request.getAsJsonObject("VirtualCurrency").get("Amount").getAsString());
+            assertEquals("Minecoin", request.getAsJsonObject("VirtualCurrency").get("Type").getAsString());
+            assertEquals(correlation.toString(), request.getAsJsonObject("CustomTags").get("CorrelationId").getAsString());
+        }
+    }
+
+    @Test
+    void rejectsChangedPricesUnownedUnknownPricesAndAlreadyOwnedOffers() {
+        for (final int price : List.of(-1, 0, 121)) {
+            assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.purchaseRequest(
+                item(price, false, true), published(120), UUID.randomUUID()));
+        }
+        assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.purchaseRequest(
+            item(120, true, true), published(120), UUID.randomUUID()));
+        final var fractional = published(120);
+        fractional.getAsJsonObject("DisplayProperties").addProperty("price", 120.5);
+        assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.purchaseRequest(
+            item(120, false, true), fractional, UUID.randomUUID()));
+    }
+
+    @Test
+    void rejectsDifferentProductsPackIdentitiesAndContentTypes() {
+        final var changedId = published(0);
+        changedId.addProperty("Id", UUID.randomUUID().toString());
+        final var changedType = published(0);
+        changedType.addProperty("ContentType", "SkinPack");
+        final var changedPack = published(0);
+        changedPack.getAsJsonObject("DisplayProperties").getAsJsonArray("packIdentity")
+            .get(0).getAsJsonObject().addProperty("uuid", UUID.randomUUID().toString());
+        for (final var metadata : List.of(changedId, changedType, changedPack, new JsonObject())) {
+            assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.purchaseRequest(
+                item(0, false, true), metadata, UUID.randomUUID()));
+        }
+    }
+
+    @Test
+    void validatesThePurchasedOfferAndTransactionIds() throws Exception {
+        final var response = result(OFFER.toString(), "29");
+        BedrockMarketplaceTransactions.validatePurchase(item(0, false, true), response);
+        for (final var invalid : List.of(result(UUID.randomUUID().toString(), UUID.randomUUID().toString()),
+                result(OFFER.toString(), " "), new JsonObject())) {
+            assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.validatePurchase(item(0, false, true), invalid));
+        }
+        response.getAsJsonObject("result").getAsJsonArray("transactionIds").remove(0);
+        assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.validatePurchase(item(0, false, true), response));
+    }
+
+    @Test
+    void requiresAcquisitionBeforeRecipeMutationsButAllowsRemoval() throws Exception {
+        final var slot = BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final var settings = JsonParser.parseString("""
+            {"version":"0.1.0","personaCollection":{"universalApp":[
+             {"lastUsedPersonaSlot":"persona_profile_persona1"}]}}
+            """).getAsJsonObject();
+        final var wardrobe = new BedrockCharacterProfiles.AccountWardrobe(List.of(slot), 1, 1, settings);
+        for (final int price : List.of(0, 120)) {
+            final var locked = item(price, false, true);
+            assertFalse(locked.canEquip());
+            assertThrows(IOException.class, () -> BedrockCharacterProfiles.pieceChangeRequest(wardrobe, 1, List.of(locked), locked, false));
+            assertThrows(IOException.class, () -> BedrockCharacterProfiles.limbChangeRequest(wardrobe, 1, List.of(locked), locked, BedrockLimbSide.BOTH, false));
+            assertThrows(IOException.class, () -> BedrockCharacterProfiles.emoteChangeRequest(wardrobe, 1, List.of(locked), locked, 0, false));
+            assertThrows(IOException.class, () -> BedrockCharacterProfiles.capeChangeRequest(wardrobe, 1, List.of(locked), locked, false));
+        }
+        final var locked = item(120, false, true);
+        slot.profile().getAsJsonObject("personaCollection").getAsJsonArray("universalApp")
+            .add(JsonParser.parseString("{\"id\":\"" + PACK + "\"}"));
+        assertDoesNotThrow(() -> BedrockCharacterProfiles.pieceChangeRequest(wardrobe, 1, List.of(locked), locked, true));
+        assertTrue(item(0, false, false).canEquip());
+        assertTrue(item(120, true, true).canEquip());
+    }
+
+    @Test
+    void serializesTheAccountIdentityAndPlayFabXboxTokenForStoreRedemption() throws Exception {
+        final String userId = Long.toUnsignedString(UUID.randomUUID().getMostSignificantBits() | 1);
+        final var token = new XblXstsToken(Long.MAX_VALUE, UUID.randomUUID().toString(), UUID.randomUUID().toString());
+        final UUID correlation = UUID.randomUUID();
+        final var request = BedrockMarketplaceTransactions.redemptionRequest(userId, token.getAuthorizationHeader(), correlation);
+        final var marketplace = request.getAsJsonObject("Redemption").getAsJsonObject("MarketplaceData");
+        assertEquals(userId, marketplace.get("userId").getAsString());
+        assertEquals(token.getAuthorizationHeader(), marketplace.getAsJsonObject("xboxAuthentication").get("XboxToken").getAsString());
+        assertEquals(correlation.toString(), request.getAsJsonObject("CustomTags").get("CorrelationId").getAsString());
+        assertFalse(request.has("OfferId"));
+        assertFalse(request.has("VirtualCurrency"));
+    }
+
+    @Test
+    void rejectsInvalidRedemptionCredentials() {
+        final var token = new XblXstsToken(Long.MAX_VALUE, UUID.randomUUID().toString(), UUID.randomUUID().toString());
+        for (final String user : List.of("", "0", "-1", "invalid", "18446744073709551616")) {
+            assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.redemptionRequest(user,
+                token.getAuthorizationHeader(), UUID.randomUUID()));
+        }
+        for (final String value : List.of("", "token", "XBL3.0 x=hash;", "XBL3.0 x=;token", "XBL3.0 x=hash;token\n")) {
+            assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.redemptionRequest("1", value, UUID.randomUUID()));
+        }
+    }
+
+    @Test
+    void preservesPartialRedemptionsAndAllowsNoNewTransactions() throws Exception {
+        final var response = JsonParser.parseString("""
+            {"result":{"succeeded":[{},{}],"failed":[{}],"transactionIds":[]}}
+            """).getAsJsonObject();
+        var result = BedrockMarketplaceTransactions.parseRedemption(response);
+        assertEquals(2, result.succeeded());
+        assertEquals(1, result.failed());
+        assertTrue(result.transactionIds().isEmpty());
+        response.getAsJsonObject("result").getAsJsonArray("transactionIds").add("29");
+        result = BedrockMarketplaceTransactions.parseRedemption(response);
+        assertEquals(List.of("29"), result.transactionIds());
+        final var immutable = result;
+        assertThrows(UnsupportedOperationException.class, () -> immutable.transactionIds().add("30"));
+    }
+
+    @Test
+    void rejectsMalformedRedemptionListsAndTransactionIds() {
+        for (final String body : List.of("{}", "{\"result\":{}}",
+            "{\"result\":{\"succeeded\":[],\"failed\":[]}}",
+            "{\"result\":{\"succeeded\":[false],\"failed\":[],\"transactionIds\":[]}}",
+            "{\"result\":{\"succeeded\":[],\"failed\":[false],\"transactionIds\":[]}}",
+            "{\"result\":{\"succeeded\":[],\"failed\":[],\"transactionIds\":[29]}}")) {
+            assertThrows(IOException.class, () -> BedrockMarketplaceTransactions.parseRedemption(
+                JsonParser.parseString(body).getAsJsonObject()));
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_XBOX_REDEMPTION", matches = ".+")
+    void matchesNativeStoreRedemptionAndItsSuccessfulResponse() throws Exception {
+        final var captured = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_XBOX_REDEMPTION"))))
+            .getAsJsonObject();
+        final var request = captured.getAsJsonObject("request");
+        final var marketplace = request.getAsJsonObject("Redemption").getAsJsonObject("MarketplaceData");
+        final var production = BedrockMarketplaceTransactions.redemptionRequest(marketplace.get("userId").getAsString(),
+            marketplace.getAsJsonObject("xboxAuthentication").get("XboxToken").getAsString(), UUID.randomUUID());
+        // Boolean comparison keeps private credentials out of assertion messages.
+        assertTrue(request.getAsJsonObject("Redemption").equals(production.getAsJsonObject("Redemption")));
+        final var result = BedrockMarketplaceTransactions.parseRedemption(captured.getAsJsonObject("response"));
+        assertTrue(result.succeeded() > 0);
+        assertEquals(0, result.failed());
+        assertTrue(result.transactionIds().isEmpty());
+    }
+
+    private static WardrobeItem item(final int price, final boolean owned, final boolean requiresRedeem) {
+        return new WardrobeItem(OFFER.toString(), "Item", "persona_hair", "", PACK.toString(), owned, price, requiresRedeem);
+    }
+
+    private static JsonObject published(final int price) {
+        final JsonObject metadata = new JsonObject();
+        metadata.addProperty("Id", OFFER.toString());
+        metadata.addProperty("ContentType", "PersonaDurable");
+        final var properties = JsonParser.parseString("{\"packIdentity\":[{\"type\":\"persona_piece\",\"uuid\":\"" + PACK + "\"}]}").getAsJsonObject();
+        properties.addProperty("price", price);
+        metadata.add("DisplayProperties", properties);
+        return metadata;
+    }
+
+    private static JsonObject result(final String offer, final String transaction) {
+        return JsonParser.parseString("{\"result\":{\"offerId\":\"" + offer
+            + "\",\"transactionIds\":[\"" + transaction + "\"]}}").getAsJsonObject();
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockOwnedSkinPacksTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockOwnedSkinPacksTest.java
