+        final var skin = pack.skins().getFirst();
+        final var request = BedrockCharacterProfiles.classicSelectionRequest(wardrobe(), 1, skin);
+        final var profile = request.getAsJsonArray("appearanceObjects").get(1).getAsJsonObject().getAsJsonObject("personaAppearance");
+        profile.getAsJsonObject("personaCollection").getAsJsonArray("universalApp").get(0).getAsJsonObject().addProperty("cs_arm", "wide");
+        final var prepared = new BedrockCharacterProfiles.PreparedClassicCharacter(newSlot(profile), pack, skin);
+        final var wire = prepared.skinData();
+        assertFalse(wire.persona());
+        assertEquals(skin.skinId(), wire.skinId());
+        assertEquals(0xFF226688, wire.skinData().getRGB(0, 0));
+        final var imported = prepared.importInto(store(), "123");
+        assertEquals(wire.skinId(), imported.skinId());
+        assertFalse(imported.effectiveSlim());
+        assertNull(imported.persona());
+        assertTrue(store().usesAccountCharacter("123", prepared.slot()));
+        store().setSlim("123", true);
+        assertFalse(store().usesAccountCharacter("123", prepared.slot()));
+    }
