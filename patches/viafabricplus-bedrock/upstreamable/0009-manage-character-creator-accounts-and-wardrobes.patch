+    static JsonObject classicSelectionRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                              final BedrockClassicSkinPack.Skin skin) throws IOException {
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size() || skin.skinId().isBlank() || skin.index() < 0) {
+            throw new IOException("Invalid account skin selection");
+        }
+        final JsonObject edited = wardrobe.slots().get(slotNumber - 1).profile().deepCopy();
+        final JsonObject collection = object(edited, "personaCollection");
+        final JsonArray entries = array(collection, "universalApp");
+        if (entries.isEmpty() || !entries.get(0).isJsonObject() || !entries.get(0).getAsJsonObject().has("skin")) {
+            throw new IOException("Create a character before selecting an account skin");
+        }
+        final JsonObject header = entries.get(0).getAsJsonObject();
+        header.addProperty("skin", true);
+        header.addProperty("cs_arm", skin.slim() ? "slim" : "wide");
+        edited.addProperty("version", "0.1.0");
+        final JsonArray retained = new JsonArray();
+        for (final var entry : entries) {
+            if (!entry.isJsonObject() || !CLASSIC_ID.matcher(string(entry.getAsJsonObject(), "id")).matches()) {
+                retained.add(entry.deepCopy());
+            }
+        }
+        final JsonObject selected = new JsonObject();
+        selected.addProperty("id", skin.recipeId());
+        retained.add(selected);
+        collection.add("universalApp", retained);
+        return editRequest(slotNumber, settingsForSlot(wardrobe, slotNumber), edited);
+    }
