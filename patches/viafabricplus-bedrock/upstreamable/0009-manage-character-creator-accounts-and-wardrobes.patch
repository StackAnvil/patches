+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles.AccountWardrobe;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles.Category;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles.ColorTarget;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles.WardrobeItem;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.EnumSet;
+import java.util.List;
+
+final class BedrockCharacterColorsTest {
+    @Test
+    void selectsTheSameSwatchForNativeRgbAndArgbRecipeColors() {
+        for (final var target : ColorTarget.values()) {
+            final var palette = target.palette();
+            for (int index = 0; index < palette.size(); index++) {
+                final var color = palette.get(index);
+                assertEquals(index, target.paletteIndex(color));
+                assertEquals(index, target.paletteIndex(color.toUpperCase(java.util.Locale.ROOT)));
+                assertEquals(index, target.paletteIndex("#" + color.substring(3)));
+                assertEquals(index, target.paletteIndex("#" + color.substring(3).toUpperCase(java.util.Locale.ROOT)));
+                assertEquals(-1, target.paletteIndex("#00" + color.substring(3)));
+            }
+        }
+    }
+
+    @Test
+    void leavesAbsentInvalidTransparentAndUnlistedColorsWithoutASelectedSwatch() {
+        for (final var target : ColorTarget.values()) {
+            assertEquals(-1, target.paletteIndex(null));
+            for (final var color : List.of("", "#0", "#00000000", "#123", "#1234567", "#gg1234", "#ff010203")) {
+                assertEquals(-1, target.paletteIndex(color));
+            }
+        }
+    }
+
+    @Test
+    void initializesOnlyTheSelectedChannelWhenTheEquippedPieceHasNoTintGroup() throws Exception {
+        for (final var target : ColorTarget.values()) {
+            if (target == ColorTarget.SKIN) continue;
+            final var wardrobe = wardrobe();
+            final var original = wardrobe.slots().getFirst().profile();
+            final var piece = original.getAsJsonObject("personaCollection")
+                    .getAsJsonArray("universalApp").get(1).getAsJsonObject();
+            piece.remove("col");
+            final var before = original.deepCopy();
+            final var color = target.palette().getFirst();
+            final var request = BedrockCharacterProfiles.colorChangeRequest(
+                    wardrobe, 1, target, color, List.of(colorItem(target)));
+            final var expected = before.deepCopy();
+            final var colors = new JsonArray(4);
+            for (int channel = 0; channel < 4; channel++)
+                colors.add(channel == target.channel() ? color : "#0");
+            expected.getAsJsonObject("personaCollection").getAsJsonArray("universalApp")
+                    .get(1).getAsJsonObject().add("col", colors);
+            assertEquals(expected, request.getAsJsonArray("appearanceObjects")
+                    .get(1).getAsJsonObject().getAsJsonObject("personaAppearance"));
+            assertEquals(before, original);
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PERSONA_FIRST_TINT", matches = ".+")
+    void matchesInitialAndExistingTintGroupsExecutedFromTheNativeEditor() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(
+                Path.of(System.getenv("STACKANVIL_PERSONA_FIRST_TINT")))).getAsJsonObject();
+        final var covered = EnumSet.noneOf(ColorTarget.class);
+        final var created = EnumSet.noneOf(ColorTarget.class);
+        for (final var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var targets = switch (row.get("pieceType").getAsInt()) {
+                case 3 -> List.of(ColorTarget.SKIN);
+                case 11 -> List.of(ColorTarget.FACIAL_HAIR);
+                case 12 -> List.of(ColorTarget.MOUTH);
+                case 13 -> List.of(ColorTarget.IRIS, ColorTarget.EYEBROWS, ColorTarget.SCLERA);
+                case 14 -> List.of(ColorTarget.HAIR);
+                default -> throw new AssertionError("Unknown native piece type");
+            };
+            final var color = row.get("color").getAsString();
+            for (final var target : targets) {
+                final int channel = target == ColorTarget.SKIN ? 0 : target.channel();
+                if (channel != row.get("channel").getAsInt() || !target.palette().contains(color)) continue;
+                final var wardrobe = wardrobe();
+                final var piece = wardrobe.slots().getFirst().profile()
+                        .getAsJsonObject("personaCollection").getAsJsonArray("universalApp").get(1).getAsJsonObject();
+                if (row.get("present").getAsBoolean()) piece.add("col", row.getAsJsonArray("before").deepCopy());
+                else piece.remove("col");
+                final var request = BedrockCharacterProfiles.colorChangeRequest(
+                        wardrobe, 1, target, color, List.of(colorItem(target)));
+                final var entries = request.getAsJsonArray("appearanceObjects").get(1).getAsJsonObject()
+                        .getAsJsonObject("personaAppearance").getAsJsonObject("personaCollection").getAsJsonArray("universalApp");
+                if (target == ColorTarget.SKIN) {
+                    assertEquals(row.getAsJsonArray("after").get(0), entries.get(0).getAsJsonObject().get("skcol"));
+                } else {
+                    assertEquals(row.getAsJsonArray("after"), entries.get(1).getAsJsonObject().getAsJsonArray("col"));
+                }
+                covered.add(target);
+                if (!row.get("present").getAsBoolean()) created.add(target);
+            }
+        }
+        assertEquals(EnumSet.allOf(ColorTarget.class), covered);
+        assertEquals(EnumSet.allOf(ColorTarget.class), created);
+    }
+
+    @Test
+    void changesMouthAndFacialHairWithoutChangingOtherChannelsOrProfiles() throws Exception {
+        for (final var category : List.of(Category.MOUTHS, Category.FACIAL_HAIRS)) {
+            final var target = category.colorTargets().getFirst();
+            final var wardrobe = wardrobe();
+            final var item = item(category);
+            final var original = wardrobe.slots().getFirst().profile().deepCopy();
+            final var expected = original.deepCopy();
+            final var colors =
+                    expected.getAsJsonObject("personaCollection")
+                            .getAsJsonArray("universalApp")
+                            .get(category == Category.MOUTHS ? 1 : 2)
+                            .getAsJsonObject()
+                            .getAsJsonArray("col");
+            final var color = target.palette().get(2);
+            colors.set(target.channel(), new JsonPrimitive(color));
+            final var request =
+                    BedrockCharacterProfiles.colorChangeRequest(
+                            wardrobe, 1, target, color, List.of(item));
+            final var objects = request.getAsJsonArray("appearanceObjects");
+            assertEquals(
+                    expected,
+                    objects.get(1).getAsJsonObject().getAsJsonObject("personaAppearance"));
+            assertEquals(
+                    wardrobe.settingsProfile(),
+                    objects.get(0).getAsJsonObject().getAsJsonObject("personaAppearance"));
+            assertEquals(original, wardrobe.slots().getFirst().profile());
+        }
+    }
+
+    @Test
+    void rejectsWrongPieceCategoriesAndColorsOutsideTheSelectedPalette() {
+        final var wardrobe = wardrobe();
+        assertThrows(
+                IOException.class,
+                () ->
+                        BedrockCharacterProfiles.colorChangeRequest(
+                                wardrobe,
+                                1,
+                                ColorTarget.MOUTH,
+                                ColorTarget.MOUTH.palette().getFirst(),
+                                List.of(item(Category.FACIAL_HAIRS))));
+        assertThrows(
+                IOException.class,
+                () ->
+                        BedrockCharacterProfiles.colorChangeRequest(
+                                wardrobe,
+                                1,
+                                ColorTarget.FACIAL_HAIR,
+                                ColorTarget.FACIAL_HAIR.palette().getFirst(),
+                                List.of(item(Category.MOUTHS))));
+        final var hairOnly =
+                ColorTarget.HAIR.palette().stream()
+                        .filter(color -> !ColorTarget.MOUTH.palette().contains(color))
+                        .findFirst()
