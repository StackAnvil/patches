+    private static void requireEmptySlot(final AccountWardrobe wardrobe, final int slotNumber) throws IOException {
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size()
+            || wardrobe.slots().get(slotNumber - 1).occupied()) {
+            throw new IOException("Choose an empty character slot");
+        }
+    }
+
+    static JsonObject deleteRequest(final AccountWardrobe wardrobe, final int slotNumber) throws IOException {
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size()
+            || !wardrobe.slots().get(slotNumber - 1).occupied()) {
+            throw new IOException("Choose a saved character to delete");
+        }
+        final JsonObject edited = wardrobe.slots().get(slotNumber - 1).profile().deepCopy();
+        final JsonArray entries = array(object(edited, "personaCollection"), "universalApp");
+        if (entries.isEmpty() || !entries.get(0).isJsonObject() || !entries.get(0).getAsJsonObject().has("skin")) {
+            throw new IOException("This character has no base appearance");
+        }
+        final JsonObject base = entries.get(0).getAsJsonObject().deepCopy();
+        while (!entries.isEmpty()) {
+            entries.remove(0);
+        }
+        entries.add(base);
+        int activeSlot = wardrobe.activeSlot();
+        if (activeSlot == slotNumber) {
+            activeSlot = wardrobe.slots().stream().filter(slot -> slot.number() != slotNumber && slot.occupied())
+                .mapToInt(Slot::number).findFirst().orElseThrow(() -> new IOException("Keep one saved character before deleting this one"));
+        }
+        final JsonObject settings = activeSlot == wardrobe.activeSlot()
+            ? wardrobe.settingsProfile() : settingsForSlot(wardrobe, activeSlot);
+        final JsonObject request = editRequest(slotNumber, settings, edited);
+        request.getAsJsonArray("appearanceObjects").get(0).getAsJsonObject()
+            .getAsJsonObject("personaAppearance").addProperty("offlineUpdate", true);
+        return request;
+    }
+
+    private static JsonObject settingsForSlot(final AccountWardrobe wardrobe, final int slotNumber) throws IOException {
+        final JsonObject settings = wardrobe.settingsProfile().deepCopy();
+        final JsonArray settingsEntries = array(object(settings, "personaCollection"), "universalApp");
+        if (settingsEntries.isEmpty() || !settingsEntries.get(0).isJsonObject()) {
+            throw new IOException("Bedrock account settings have no active slot");
+        }
+        settingsEntries.get(0).getAsJsonObject().addProperty("lastUsedPersonaSlot", "persona_profile_persona" + slotNumber);
+        return settings;
+    }
