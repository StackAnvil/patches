+
+    @Override
+    public void renderTitle(final GuiGraphicsExtractor graphics) {
+        super.renderTitle(graphics);
+        graphics.centeredText(this.font, this.title, this.width / 2, 32, -1);
+    }
+
+    @Override
+    public void extractRenderState(
+            final @NonNull GuiGraphicsExtractor graphics,
+            final int mouseX,
+            final int mouseY,
+            final float delta) {
+        super.extractRenderState(graphics, mouseX, mouseY, delta);
+        final int width = Math.min(360, this.width - 24);
+        graphics.textWithWordWrap(
+                this.font, this.status, (this.width - width) / 2, 54, width, ACCENT_COLOR);
+    }
+
+    @Override
+    public void removed() {
+        this.request++;
+        if (this.downloading) this.status = Component.empty();
+        this.downloading = false;
+        this.loading = false;
+        super.removed();
+    }
+
+    private boolean current(final int request) {
+        return request == this.request
+                && this.minecraft.gui.screen() == this
+                && this.accountId.equals(
+                        BedrockAppearanceStore.accountId(
+                                ViaFabricPlusBedrock.impl().account().get()));
+    }
+
+    private void loadItems() {
+        if (this.account == null || this.loading || this.downloading) return;
+        final int request = ++this.request;
+        this.loading = true;
+        this.status = Component.translatable("bedrock_marketplace.viafabricplus.synchronizing");
+        this.updateControls();
+        BedrockMarketplaceTransactions.redeemXbox(this.account).whenComplete((result, error) ->
+                this.minecraft.schedule(() -> {
+                    if (!this.current(request)) return;
+                    final Component purchaseStatus;
+                    if (error != null) {
+                        purchaseStatus = Component.translatable("bedrock_marketplace.viafabricplus.sync_failed");
+                        ViaFabricPlusBedrock.impl().logger().warn("Could not synchronize Microsoft Store purchases", error);
+                    } else {
+                        purchaseStatus = result.failed() == 0 ? null
+                            : Component.translatable("bedrock_marketplace.viafabricplus.sync_partial", result.failed());
+                    }
+                    this.wallet.refresh();
+                    this.loadCatalog(request, purchaseStatus);
+                }));
+    }
+
+    private void loadCatalog(final int request, final @Nullable Component purchaseStatus) {
+        this.status = purchaseStatus == null
+            ? Component.translatable("bedrock_owned_skin_packs.viafabricplus.loading") : purchaseStatus;
+        BedrockOwnedSkinPacks.list(this.account)
+                .whenComplete(
+                        (items, error) ->
+                                this.minecraft.schedule(
+                                        () -> {
+                                            if (!this.current(request)) return;
+                                            this.loading = false;
+                                            if (error != null) {
+                                                this.status =
+                                                        Component.translatable(
+                                                                "bedrock_owned_skin_packs.viafabricplus.load_failed");
+                                                ViaFabricPlusBedrock.impl()
+                                                        .logger()
+                                                        .warn(
+                                                                "Could not load account skin packs",
+                                                                error);
+                                            } else {
+                                                this.items = items;
+                                                this.selected =
+                                                        items.stream()
+                                                                .filter(
+                                                                        item ->
+                                                                                item.equals(
+                                                                                        this
+                                                                                                .selected))
+                                                                .findFirst()
+                                                                .orElse(null);
+                                                this.packs.populate();
+                                                this.status = purchaseStatus != null ? purchaseStatus :
+                                                        items.isEmpty()
+                                                                ? Component.translatable(
+                                                                        "bedrock_owned_skin_packs.viafabricplus.empty")
+                                                                : Component.empty();
+                                            }
+                                            this.updateControls();
+                                        }));
+        this.updateControls();
+    }
+
+    private void openSelected() {
+        if (this.account == null || this.selected == null || this.downloading || this.loading) return;
+        final int request = ++this.request;
+        final Item selected = this.selected;
+        this.downloading = true;
+        this.status = Component.translatable("bedrock_dressing_room.viafabricplus.loading_pack");
+        this.updateControls();
+        BedrockOwnedSkinPacks.load(this.account, selected)
+                .whenComplete(
+                        (pack, error) ->
+                                this.minecraft.schedule(
+                                        () -> {
+                                            if (!this.current(request)) return;
+                                            this.downloading = false;
+                                            if (!selected.equals(this.selected))
+                                                this.status = Component.empty();
+                                            else if (error != null) {
+                                                this.status =
+                                                        Component.translatable(
+                                                                "bedrock_owned_skin_packs.viafabricplus.download_failed");
+                                                ViaFabricPlusBedrock.impl()
+                                                        .logger()
+                                                        .warn(
+                                                                "Could not download the selected"
+                                                                        + " skin pack",
+                                                                error);
+                                            } else {
+                                                this.status = Component.empty();
+                                                new BedrockClassicSkinPackScreen(
+                                                                this.dressingRoom, pack, selected)
+                                                        .open(this);
+                                            }
+                                            this.updateControls();
+                                        }));
+    }
+
+    private void updateControls() {
+        if (this.open != null)
+            this.open.active = this.selected != null && !this.downloading && !this.loading && this.account != null;
+        if (this.refresh != null)
+            this.refresh.active = this.account != null && !this.downloading && !this.loading;
+    }
+
+    private final class PackList extends ObjectSelectionList<PackEntry> {
+        private PackList() {
+            super(
+                    BedrockOwnedSkinPacksScreen.this.minecraft,
+                    Math.min(360, BedrockOwnedSkinPacksScreen.this.width - 24),
+                    Math.max(36, BedrockOwnedSkinPacksScreen.this.height - 112),
+                    72,
+                    36);
+            this.setX((BedrockOwnedSkinPacksScreen.this.width - this.getWidth()) / 2);
+        }
+
+        @Override
+        public int getRowWidth() {
+            return this.getWidth() - 12;
+        }
+
+        private void populate() {
+            final Item selected = BedrockOwnedSkinPacksScreen.this.selected;
+            this.clearEntries();
+            for (final Item item : BedrockOwnedSkinPacksScreen.this.items) {
+                final var entry = new PackEntry(item);
+                this.addEntry(entry);
+                if (item.equals(selected)) this.setSelected(entry);
+            }
+        }
+
+        @Override
+        public void setSelected(final @Nullable PackEntry entry) {
+            super.setSelected(entry);
+            BedrockOwnedSkinPacksScreen.this.selected = entry == null ? null : entry.item;
+            BedrockOwnedSkinPacksScreen.this.updateControls();
+        }
+    }
+
+    private final class PackEntry extends ObjectSelectionList.Entry<PackEntry> {
+        private final Item item;
+
+        private PackEntry(final Item item) {
+            this.item = item;
+        }
+
+        @Override
+        public void extractContent(
+                final GuiGraphicsExtractor graphics,
+                final int mouseX,
+                final int mouseY,
+                final boolean hovered,
+                final float delta) {
+            final int left = BedrockOwnedSkinPacksScreen.this.packs.getRowLeft() + 4;
+            final int width = BedrockOwnedSkinPacksScreen.this.packs.getRowWidth() - 8;
+            graphics.text(
+                    BedrockOwnedSkinPacksScreen.this.font,
+                    BedrockOwnedSkinPacksScreen.this.font.plainSubstrByWidth(
+                            this.item.name(), width),
+                    left,
+                    this.getY() + 5,
+                    -1);
+            graphics.text(
+                    BedrockOwnedSkinPacksScreen.this.font,
+                    BedrockOwnedSkinPacksScreen.this.font.plainSubstrByWidth(
+                            this.item.creator(), width),
+                    left,
+                    this.getY() + 18,
+                    0xFFAAAAAA);
+        }
+
+        @Override
+        public boolean mouseClicked(final MouseButtonEvent click, final boolean doubled) {
+            BedrockOwnedSkinPacksScreen.this.packs.setSelected(this);
+            if (doubled) BedrockOwnedSkinPacksScreen.this.openSelected();
+            return true;
+        }
+
+        @Override
+        public Component getNarration() {
+            return Component.literal(this.item.name());
+        }
+    }
+}
