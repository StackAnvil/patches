index 0000000..df29078
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAssembler.java
@@ -0,0 +1,193 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import net.raphimc.viabedrock.protocol.model.SkinData.AnimationData;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Binds locally composed body layers and equipped geometry to native animated texture groups. */
+final class BedrockPersonaAssembler {
+    private BedrockPersonaAssembler() {}
+
+    static BedrockPersonaModel.Converted assemble(
+            final BedrockPersonaModel.Converted preview,
+            final BedrockCharacterProfiles.Slot slot,
+            final Map<String, BedrockMarketplaceAssets.Pack> packs)
+            throws IOException {
+        if (packs.isEmpty()) return preview;
+        final var skinColor = BedrockPersonaTint.skinColor(slot, packs);
+        final var composed = BedrockPersonaFace.assemble(preview, slot, packs);
+        final JsonObject geometry = JsonParser.parseString(composed.geometry()).getAsJsonObject();
+        final JsonArray models = geometry.getAsJsonArray("minecraft:geometry");
+        final JsonObject patch = JsonParser.parseString(composed.resourcePatch()).getAsJsonObject();
+        final JsonObject bindings = patch.getAsJsonObject("geometry");
+        final Map<Integer, BedrockPersonaAnimationAtlas> atlases = new LinkedHashMap<>();
+        final List<Surface> surfaces = new ArrayList<>();
+        final List<AnimationData> animations = new ArrayList<>();
+        for (final var animation : composed.animations()) {
+            if (animation.type() == 1) {
+                animations.add(animation);
+                continue;
+            }
+            final int type = animation.type(), size = type == 3 ? 128 : 32;
+            final String binding = binding(type), identifier = bindings.get(binding).getAsString();
+            JsonObject model = null;
+            for (int index = models.size() - 1; index >= 0; index--) {
+                final JsonObject candidate = models.get(index).getAsJsonObject();
+                if (candidate
+                        .getAsJsonObject("description")
+                        .get("identifier")
+                        .getAsString()
+                        .equals(identifier)) {
+                    model = candidate;
+                    models.remove(index);
+                    break;
+                }
+            }
+            if (model == null)
+                throw new IOException("An animated persona texture is missing its model");
+            final var atlas =
+                    atlases.computeIfAbsent(
+                            type, ignored -> new BedrockPersonaAnimationAtlas(size));
+            final var tile = atlas.add(identifier, animation.image(), (int) animation.frames());
+            surfaces.add(new Surface(model, tile, type, 3, false));
+        }
+        for (final var pack : packs.values()) {
+            final var geometries = BedrockPersonaSources.geometries(pack);
+            final var equipped = BedrockPersonaProfile.recipes(pack, slot);
+            final List<JsonObject> recipes =
+                    equipped.isEmpty() ? List.of(new JsonObject()) : equipped;
+            for (final var asset :
+                    BedrockPersonaSources.read(
+                            pack,
+                            source ->
+                                    source.has("geometry")
+                                            && source.has("animated")
+                                            && source.get("animated").getAsBoolean()
+                                            && BedrockPersonaProfile.matches(source, slot)
+                                            && recipes.stream()
+                                                    .anyMatch(
+                                                            recipe ->
+                                                                    BedrockPersonaGeometry.includes(
+                                                                            source,
+                                                                            side(recipe))))) {
+                for (final var recipe : recipes) {
+                    final JsonObject source = asset.source();
+                    final int sideMask = side(recipe);
+                    if (!BedrockPersonaGeometry.includes(source, sideMask)) continue;
+                    final int size = asset.image().getWidth(), type = size == 32 ? 2 : 3;
+                    BedrockPersonaAnimationAtlas.validate(
+                            asset.image(), asset.frames(), type == 2 ? 32 : 128);
+                    final var atlas =
+                            atlases.computeIfAbsent(
+                                    type, ignored -> new BedrockPersonaAnimationAtlas(size));
+                    final var tile =
+                            atlas.add(
+                                    pack.id()
+                                            + "/"
+                                            + source.get("texture").getAsString()
+                                            + "/"
+                                            + recipe,
+                                    BedrockPersonaTint.apply(
+                                            asset,
+                                            BedrockPersonaTint.palette(
+                                                    asset, slot, recipe, skinColor)),
+                                    asset.frames());
+                    final JsonObject model = geometries.get(source.get("geometry").getAsString());
+                    if (model == null)
+                        throw new IOException("A persona animation is missing its geometry");
+                    surfaces.add(new Surface(model, tile, type, sideMask, true));
+                }
+            }
+        }
+        if (surfaces.isEmpty()) return composed;
+        final Map<String, JsonObject> body = new LinkedHashMap<>();
+        models.get(0)
+                .getAsJsonObject()
+                .getAsJsonArray("bones")
+                .forEach(
+                        element -> {
+                            final JsonObject bone = element.getAsJsonObject();
+                            body.put(bone.get("name").getAsString(), bone);
+                        });
+        for (final var entry : atlases.entrySet()) {
+            final int type = entry.getKey();
+            final var atlas = entry.getValue();
+            final Map<String, JsonObject> animated = new LinkedHashMap<>();
+            for (final var bone : body.values()) {
+                final JsonObject pose = bone.deepCopy();
+                pose.remove("poly_mesh");
+                pose.remove("cubes");
+                animated.put(pose.get("name").getAsString(), pose);
+            }
+            for (final var surface : surfaces) {
+                if (surface.type() != type) continue;
+                for (final var element : surface.geometry().getAsJsonArray("bones")) {
+                    if (!BedrockPersonaGeometry.includes(
+                            surface.geometry(), element.getAsJsonObject(), surface.sideMask()))
+                        continue;
+                    final JsonObject incoming =
+                            BedrockPersonaGeometry.canonical(element.getAsJsonObject());
+                    final String name = incoming.get("name").getAsString();
+                    if (!incoming.has("cubes") && !incoming.has("poly_mesh")) continue;
+                    if (surface.replacesStatic() && body.containsKey(name)) {
+                        body.get(name).remove("poly_mesh");
+                        body.get(name).remove("cubes");
+                    }
+                    BedrockPersonaGeometry.mapUvs(
+                            incoming,
+                            surface.tile().image().getWidth(),
+                            surface.tile().height(),
+                            surface.tile().x(),
+                            0,
+                            atlas.width(),
+                            atlas.height());
+                    BedrockPersonaGeometry.merge(animated, incoming);
+                }
+            }
+            final String identifier = "geometry.persona." + binding(type);
+            final JsonObject model = new JsonObject(), description = new JsonObject();
+            description.addProperty("identifier", identifier);
+            description.addProperty("texture_width", atlas.width());
+            description.addProperty("texture_height", atlas.height());
+            model.add("description", description);
+            final JsonArray bones = new JsonArray();
+            animated.values().forEach(bones::add);
+            model.add("bones", bones);
+            models.add(model);
+            bindings.addProperty(binding(type), identifier);
+            animations.add(new AnimationData(atlas.image(), type, atlas.frames(), 0));
+        }
+        return new BedrockPersonaModel.Converted(
+                composed.atlas(), geometry.toString(), patch.toString(), List.copyOf(animations));
+    }
+
+    private static int side(final JsonObject recipe) {
+        return recipe.has("id")
+                ? BedrockLimbSide.fromRecipe(recipe.get("id").getAsString()).mask()
+                : 3;
+    }
+
+    private static String binding(final int type) {
+        return type == 2 ? "animated_32x32" : "animated_128x128";
+    }
+
+    private record Surface(
+            JsonObject geometry,
+            BedrockPersonaAnimationAtlas.Tile tile,
+            int type,
+            int sideMask,
+            boolean replacesStatic) {}
+}
