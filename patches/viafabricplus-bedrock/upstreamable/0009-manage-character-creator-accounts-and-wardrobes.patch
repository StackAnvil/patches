@@ -0,0 +1,156 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import net.raphimc.viabedrock.protocol.model.SkinData.AnimationData;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/** Composes equipped face layers and binds the extracted head and hat meshes to their strip. */
+final class BedrockPersonaFace {
+    private BedrockPersonaFace() {}
+
+    static BedrockPersonaModel.Converted assemble(
+            final BedrockPersonaModel.Converted preview,
+            final BedrockCharacterProfiles.Slot slot,
+            final Map<String, BedrockMarketplaceAssets.Pack> packs)
+            throws IOException {
+        final var skinColor = BedrockPersonaTint.skinColor(slot, packs);
+        final List<Layer> layers = new ArrayList<>();
+        final Map<String, JsonObject> meshes = new LinkedHashMap<>();
+        int size = 32, frames = 1;
+        for (final var pack : packs.values()) {
+            final var recipes = BedrockPersonaProfile.recipes(pack, slot);
+            for (final var texture :
+                    BedrockPersonaSources.read(
+                            pack,
+                            source ->
+                                    source.has("use_face_uv")
+                                            && source.get("use_face_uv").getAsBoolean()
+                                            && BedrockPersonaProfile.matches(source, slot))) {
+                if (recipes.size() != 1)
+                    throw new IOException("A face piece has an ambiguous recipe");
+                final int height = texture.image().getHeight() / texture.frames();
+                if (texture.image().getWidth() != height)
+                    throw new IOException("A persona face source must contain square frames");
+                size = Math.max(size, height);
+                frames = Math.max(frames, texture.frames());
+                final String type = texture.metadata().get("piece_type").getAsString();
+                layers.add(
+                        new Layer(
+                                texture,
+                                BedrockPersonaTint.palette(
+                                        texture, slot, recipes.getFirst(), skinColor),
+                                BedrockPersonaSources.order(type)));
+            }
+            for (final var file : pack.files().entrySet()) {
+                if (!file.getKey().endsWith(".meta.json")) continue;
+                final JsonObject meta =
+                        JsonParser.parseString(new String(file.getValue(), StandardCharsets.UTF_8))
+                                .getAsJsonObject();
+                if (!meta.has("piece_type")
+                        || !"persona_body".equals(meta.get("piece_type").getAsString())) continue;
+                final var geometries = BedrockPersonaSources.geometries(pack);
+                for (final var entry : meta.getAsJsonArray("geometry_sources")) {
+                    final JsonObject source = entry.getAsJsonObject();
+                    if (!source.has("is_face")
+                            || !source.get("is_face").getAsBoolean()
+                            || !BedrockPersonaProfile.matches(source, slot)) continue;
+                    final JsonObject model = geometries.get(source.get("geometry").getAsString());
+                    if (model == null)
+                        throw new IOException("The character is missing its face geometry");
+                    for (final var bone : model.getAsJsonArray("bones")) {
+                        final JsonObject mesh = bone.getAsJsonObject().deepCopy();
+                        final String name = mesh.get("name").getAsString().toLowerCase(Locale.ROOT);
+                        mesh.addProperty("name", name);
+                        if (mesh.has("parent"))
+                            mesh.addProperty(
+                                    "parent",
+                                    mesh.get("parent").getAsString().toLowerCase(Locale.ROOT));
+                        if (meshes.putIfAbsent(name, mesh) != null)
+                            throw new IOException("The character has conflicting face meshes");
+                    }
+                }
+            }
+        }
+        if (layers.isEmpty()) return preview;
+        if (meshes.isEmpty())
+            throw new IOException("The character is missing its base face geometry");
+        if (size > 1024 || (long) size * size * frames > 4 * 1024 * 1024)
+            throw new IOException("The assembled face texture is too large");
+        layers.sort(Comparator.comparingInt(Layer::order));
+        final BufferedImage strip =
+                new BufferedImage(size, size * frames, BufferedImage.TYPE_INT_ARGB);
+        for (final var layer : layers) {
+            final var texture = layer.texture();
+            final int sourceSize = texture.image().getWidth();
+            for (int frame = 0; frame < frames; frame++)
+                for (int y = 0; y < size; y++) {
+                    final int sy =
+                            (int) (((y + 0.5F) / size) * sourceSize)
+                                    + frame % texture.frames() * sourceSize;
+                    for (int x = 0; x < size; x++) {
+                        final int sx = (int) (((x + 0.5F) / size) * sourceSize);
+                        strip.setRGB(
+                                x,
+                                frame * size + y,
+                                BedrockPersonaTint.blend(
+                                        strip.getRGB(x, frame * size + y),
+                                        texture.image().getRGB(sx, sy),
+                                        texture.tintMap() == null
+                                                ? 0
+                                                : texture.tintMap().getRGB(sx, sy),
+                                        layer.palette().authored(),
+                                        layer.palette().selected()));
+                    }
+                }
+        }
+        final JsonObject document = JsonParser.parseString(preview.geometry()).getAsJsonObject();
+        final JsonArray models = document.getAsJsonArray("minecraft:geometry");
+        final JsonArray bones = new JsonArray();
+        for (final var entry : models.get(0).getAsJsonObject().getAsJsonArray("bones")) {
+            final JsonObject bodyBone = entry.getAsJsonObject(), pose = bodyBone.deepCopy();
+            final String name = bodyBone.get("name").getAsString();
+            pose.remove("poly_mesh");
+            pose.remove("cubes");
+            if (meshes.containsKey(name)) {
+                bones.add(meshes.remove(name));
+                bodyBone.remove("poly_mesh");
+                bodyBone.remove("cubes");
+            } else bones.add(pose);
+        }
+        meshes.values().forEach(bones::add);
+        final String identifier = "geometry.persona.face";
+        final JsonObject model = new JsonObject(), description = new JsonObject();
+        description.addProperty("identifier", identifier);
+        description.addProperty("texture_width", size);
+        description.addProperty("texture_height", size);
+        model.add("description", description);
+        model.add("bones", bones);
+        models.add(model);
+        final JsonObject patch = JsonParser.parseString(preview.resourcePatch()).getAsJsonObject();
+        patch.getAsJsonObject("geometry").addProperty("animated_face", identifier);
+        final List<AnimationData> animations = new ArrayList<>(preview.animations());
+        animations.add(new AnimationData(strip, 1, frames, frames == 2 ? 1 : 0));
+        return new BedrockPersonaModel.Converted(
+                preview.atlas(), document.toString(), patch.toString(), List.copyOf(animations));
+    }
+
+    private record Layer(
+            BedrockPersonaSources.Texture texture, BedrockPersonaTint.Palette palette, int order) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaGeometry.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaGeometry.java
new file mode 100644
index 0000000..50306ff
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaGeometry.java
@@ -0,0 +1,202 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonPrimitive;
+
+import java.io.IOException;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/** Maps source UVs and joins surfaces while retaining the equipped skeleton's pose. */
+final class BedrockPersonaGeometry {
+    private BedrockPersonaGeometry() {}
+
+    static boolean includes(final JsonObject source, final int sideMask) {
+        if (!source.has("side")) return true;
+        return switch (source.get("side").getAsString()) {
+            case "left" -> (sideMask & 1) != 0;
+            case "right" -> (sideMask & 2) != 0;
+            default -> true;
+        };
+    }
+
+    static boolean includes(final JsonObject geometry, final JsonObject bone, final int sideMask)
+            throws IOException {
+        if (sideMask == 3) return true;
+        final Map<String, JsonObject> bones = new LinkedHashMap<>();
+        for (final var element : geometry.getAsJsonArray("bones")) {
+            final JsonObject node = element.getAsJsonObject();
+            bones.put(node.get("name").getAsString().toLowerCase(Locale.ROOT), node);
+        }
+        String name = bone.get("name").getAsString().toLowerCase(Locale.ROOT);
+        final Set<String> visited = new HashSet<>();
+        while (name != null) {
+            if (!visited.add(name))
+                throw new IOException("A persona piece has a cyclic bone hierarchy");
+            if (name.startsWith("left")) return (sideMask & 1) != 0;
+            if (name.startsWith("right")) return (sideMask & 2) != 0;
+            final JsonObject node = bones.get(name);
+            name =
+                    node != null && node.has("parent")
+                            ? node.get("parent").getAsString().toLowerCase(Locale.ROOT)
+                            : null;
+        }
+        return true;
+    }
+
+    static JsonObject canonical(final JsonObject source) {
+        final JsonObject bone = source.deepCopy();
+        bone.addProperty("name", bone.get("name").getAsString().toLowerCase(Locale.ROOT));
+        if (bone.has("parent"))
+            bone.addProperty("parent", bone.get("parent").getAsString().toLowerCase(Locale.ROOT));
+        return bone;
+    }
+
+    static void merge(final Map<String, JsonObject> bones, final JsonObject incoming)
+            throws IOException {
+        final String name = incoming.get("name").getAsString();
+        final JsonObject target = bones.get(name);
+        if (target == null) {
+            bones.put(name, incoming);
+            return;
+        }
+        if (target.has("parent")
+                && incoming.has("parent")
+                && !target.get("parent").equals(incoming.get("parent")))
+            throw new IOException("Persona surfaces have conflicting bone parents");
+        for (final var entry : incoming.entrySet()) {
+            final String property = entry.getKey();
+            if (property.equals("cubes")) {
+                if (!target.has(property)) target.add(property, new JsonArray());
+                incoming.getAsJsonArray(property).forEach(target.getAsJsonArray(property)::add);
+            } else if (property.equals("poly_mesh")) {
+                if (!target.has(property)) target.add(property, entry.getValue());
+                else join(target.getAsJsonObject(property), entry.getValue().getAsJsonObject());
+            } else if (property.equals("locators")) {
+                if (!target.has(property)) target.add(property, new JsonObject());
+                for (final var locator : entry.getValue().getAsJsonObject().entrySet())
+                    if (!target.getAsJsonObject(property).has(locator.getKey()))
+                        target.getAsJsonObject(property).add(locator.getKey(), locator.getValue());
+            } else if (!target.has(property)) target.add(property, entry.getValue());
+        }
+    }
+
+    private static void join(final JsonObject target, final JsonObject incoming)
+            throws IOException {
+        if (!target.get("normalized_uvs").equals(incoming.get("normalized_uvs")))
+            throw new IOException("Persona polygon meshes have incompatible UV coordinates");
+        final String[] attributes = {"positions", "normals", "uvs"};
+        final int[] offsets = new int[attributes.length];
+        for (int index = 0; index < attributes.length; index++) {
+            final String attribute = attributes[index];
+            offsets[index] = target.getAsJsonArray(attribute).size();
+        }
+        final JsonArray polygons = polygons(target);
+        for (final var element : polygons(incoming)) {
+            final JsonArray polygon = element.getAsJsonArray();
+            for (final var vertex : polygon) {
+                final JsonArray indices = vertex.getAsJsonArray();
+                if (indices.size() != offsets.length)
+                    throw new IOException("Invalid persona polygon indices");
+                for (int index = 0; index < offsets.length; index++)
+                    indices.set(
+                            index,
+                            new JsonPrimitive(indices.get(index).getAsInt() + offsets[index]));
+            }
+            polygons.add(polygon);
+        }
+        target.add("polys", polygons);
+        for (final String attribute : attributes)
+            incoming.getAsJsonArray(attribute).forEach(target.getAsJsonArray(attribute)::add);
+        if (incoming.has("average_normals") && incoming.get("average_normals").getAsBoolean())
+            target.addProperty("average_normals", true);
+    }
+
+    private static JsonArray polygons(final JsonObject mesh) throws IOException {
+        final var value = mesh.get("polys");
+        if (value.isJsonArray()) return value.getAsJsonArray().deepCopy();
+        final int size =
+                switch (value.getAsString()) {
+                    case "tri_list" -> 3;
+                    case "quad_list" -> 4;
+                    default -> throw new IOException("Unknown persona polygon topology");
+                };
+        final int count = mesh.getAsJsonArray("positions").size();
+        if (count % size != 0
+                || mesh.getAsJsonArray("normals").size() != count
+                || mesh.getAsJsonArray("uvs").size() != count)
+            throw new IOException("Invalid persona polygon topology");
+        final JsonArray result = new JsonArray();
+        for (int start = 0; start < count; start += size) {
+            final JsonArray polygon = new JsonArray();
+            for (int offset = 0; offset < size; offset++) {
+                final JsonArray indices = new JsonArray();
+                for (int index = 0; index < 3; index++) indices.add(start + offset);
+                polygon.add(indices);
+            }
+            result.add(polygon);
+        }
+        return result;
+    }
+
+    static void mapUvs(
+            final JsonObject bone,
+            final int width,
+            final int height,
+            final int x,
+            final int y,
+            final int atlasSize)
+            throws IOException {
+        mapUvs(bone, width, height, x, y, atlasSize, atlasSize);
+    }
+
+    static void mapUvs(
+            final JsonObject bone,
+            final int width,
+            final int height,
+            final int x,
+            final int y,
+            final int atlasWidth,
+            final int atlasHeight)
+            throws IOException {
+        if (bone.has("cubes"))
+            for (final var element : bone.getAsJsonArray("cubes")) {
+                final JsonObject cube = element.getAsJsonObject();
+                if (!cube.has("uv")) continue;
+                if (cube.get("uv").isJsonArray()) offset(cube.getAsJsonArray("uv"), x, y);
+                else
+                    for (final var face : cube.getAsJsonObject("uv").entrySet())
+                        offset(face.getValue().getAsJsonObject().getAsJsonArray("uv"), x, y);
+            }
+        if (!bone.has("poly_mesh")) return;
+        final JsonObject mesh = bone.getAsJsonObject("poly_mesh");
+        final boolean normalized =
+                mesh.has("normalized_uvs") && mesh.get("normalized_uvs").getAsBoolean();
+        for (final var element : mesh.getAsJsonArray("uvs")) {
+            final JsonArray uv = element.getAsJsonArray();
+            final float u = uv.get(0).getAsFloat(), v = uv.get(1).getAsFloat();
+            uv.set(0, new JsonPrimitive((x + u * (normalized ? width : 1)) / atlasWidth));
+            uv.set(
+                    1,
+                    new JsonPrimitive(
+                            1F - (y + height - v * (normalized ? height : 1)) / atlasHeight));
+        }
+        mesh.addProperty("normalized_uvs", true);
+    }
+
+    private static void offset(final JsonArray uv, final int x, final int y) throws IOException {
+        if (uv == null || uv.size() != 2)
+            throw new IOException("A persona cube has invalid UV coordinates");
+        uv.set(0, new JsonPrimitive(uv.get(0).getAsFloat() + x));
+        uv.set(1, new JsonPrimitive(uv.get(1).getAsFloat() + y));
+    }
+}
