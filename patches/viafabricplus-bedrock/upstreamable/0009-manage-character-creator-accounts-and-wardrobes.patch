+                                assembled.atlas()),
+                        net.raphimc.viabedrock.protocol.types.primitive.ImageType.getImageData(
+                                decoded.skinData()));
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    private static List<Vertex> vertices(
+            final Map<String, JsonObject> bones,
+            final int atlasSize,
+            final int x,
+            final int y,
+            final int width,
+            final int height) {
+        final JsonObject model = new JsonObject(),
+                description = new JsonObject(),
+                document = new JsonObject();
+        description.addProperty("identifier", "geometry.test");
+        description.addProperty("texture_width", atlasSize);
+        description.addProperty("texture_height", atlasSize);
+        model.add("description", description);
+        final JsonArray array = new JsonArray();
+        for (final String name : List.of("root", "waist", "body", "cape"))
+            if (bones.containsKey(name)) array.add(bones.get(name));
+        model.add("bones", array);
+        final JsonArray models = new JsonArray();
+        models.add(model);
+        document.add("minecraft:geometry", models);
+        final var geometry = BedrockGeometryModel.fromJson(document.toString()).getFirst();
+        final var animated = BedrockGeometry.animatedModel(geometry, Map.of());
+        ModelPart part = animated.model().root();
+        final PoseStack pose = new PoseStack();
+        for (final String name : List.of("root", "waist", "body", "cape", "cube_0")) {
+            if (!part.hasChild(name)) continue;
+            part = part.getChild(name);
+            part.translateAndRotate(pose);
+        }
+        final List<Vertex> result = new ArrayList<>();
+        for (final var polygon : part.getRandomCube(RandomSource.create()).polygons)
+            for (final var vertex : polygon.vertices()) {
+                final var position =
+                        pose.last()
+                                .pose()
+                                .transformPosition(
+                                        new Vector3f(vertex.x(), vertex.y(), vertex.z()).div(16))
+                                .mul(16);
+                position.y = 24 - position.y;
+                final var normal = pose.last().normal().transform(new Vector3f(polygon.normal()));
+                normal.y = -normal.y;
+                result.add(
+                        new Vertex(
+                                position,
+                                normal,
+                                (vertex.u() * atlasSize - x) / width,
+                                (vertex.v() * atlasSize - y) / height));
+            }
+        return result;
+    }
+
+    private static Vector3f vector(final JsonArray vector) {
+        return new Vector3f(
+                vector.get(0).getAsFloat(), vector.get(1).getAsFloat(), vector.get(2).getAsFloat());
+    }
+
+    private record Vertex(Vector3f position, Vector3f normal, float u, float v) {}
+}
