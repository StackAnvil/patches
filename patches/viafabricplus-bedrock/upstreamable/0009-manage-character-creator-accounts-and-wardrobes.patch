+    private static Map<Starter, JsonObject> loadStarterCharacters() {
+        final Map<Starter, JsonObject> characters = new EnumMap<>(Starter.class);
+        final var input = BedrockCharacterProfiles.class.getResourceAsStream(
+            "/assets/viafabricplus-bedrock/character-presets.json");
+        if (input == null) {
+            throw new IllegalStateException("The Bedrock starter character catalog is missing");
+        }
+        try (var reader = new InputStreamReader(input, StandardCharsets.UTF_8)) {
+            final JsonObject catalog = JsonParser.parseReader(reader).getAsJsonObject();
+            for (final JsonElement element : catalog.getAsJsonArray("presets")) {
+                final JsonObject preset = element.getAsJsonObject();
+                final Starter starter = Starter.valueOf(string(preset, "name").toUpperCase(Locale.ROOT));
+                final JsonObject recipe = new JsonObject();
+                recipe.add("version", catalog.get("version").deepCopy());
+                final JsonObject collection = new JsonObject();
+                collection.add("universalApp", preset.getAsJsonArray("appearance").deepCopy());
+                recipe.add("personaCollection", collection);
+                characters.put(starter, recipe);
+            }
+        } catch (IOException e) {
+            throw new IllegalStateException("Could not load the Bedrock starter characters", e);
+        }
+        if (characters.size() != Starter.values().length) {
+            throw new IllegalStateException("The Bedrock starter character catalog is incomplete");
+        }
+        return Map.copyOf(characters);
+    }
