+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry")
+                        .get(0)
+                        .getAsJsonObject()
+                        .getAsJsonArray("bones")
+                        .get(1)
+                        .getAsJsonObject()
+                        .has("cubes"));
+    }
+
+    private static byte[] strip(final int frames) throws Exception {
+        final BufferedImage image = new BufferedImage(32, frames * 32, BufferedImage.TYPE_INT_ARGB);
+        for (int frame = 0; frame < frames; frame++)
+            image.setRGB(0, frame * 32, 0xFF000001 + frame);
+        final ByteArrayOutputStream output = new ByteArrayOutputStream();
+        ImageIO.write(image, "png", output);
+        return output.toByteArray();
+    }
+}
