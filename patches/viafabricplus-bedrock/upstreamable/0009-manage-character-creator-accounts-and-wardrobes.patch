+    public static CompletableFuture<AccountWardrobe> changeColor(final BedrockAuthManager account, final int slotNumber,
+                                                                  final String expectedProfileHash, final ColorTarget target,
+                                                                  final String color, final List<WardrobeItem> categoryItems) {
+        return load(account).thenCompose(current -> {
+            try {
+                colorChangeRequest(current, slotNumber, target, color, categoryItems);
+                final Slot slot = current.slots().get(slotNumber - 1);
+                if (!slot.profileHash().equals(expectedProfileHash))
+                    throw new IOException("This character changed on your account. Refresh before editing it");
+                return loadColorTargets(account, slot, List.of(target), categoryItems);
+            } catch (IOException e) {
+                return CompletableFuture.<List<ColorTarget>>failedFuture(e);
+            }
+        }).thenCompose(available -> {
+            if (!available.contains(target))
+                return CompletableFuture.failedFuture(new IOException("The equipped character piece does not allow this color change"));
+            // Asset acquisition can take time. Read and check the profile again immediately before saving.
+            return updateProfile(account, slotNumber, expectedProfileHash,
+                current -> colorChangeRequest(current, slotNumber, target, color, categoryItems));
+        });
+    }
