+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+
+/** Resolves classic pack dependencies from the licensed game package when needed. */
+public final class BedrockClassicAssets {
+    private BedrockClassicAssets() {}
+
+    public static CompletableFuture<BedrockClassicSkinPack> load(
+            final Path path) {
+        return load(source -> BedrockClassicSkinPack.read(path, source));
+    }
+
+    static CompletableFuture<BedrockClassicSkinPack> loadAccount(
+            final String name, final Map<String, byte[]> files) {
+        return load(source -> BedrockClassicSkinPack.readAccountPack(name, files, source));
+    }
+
+    private static CompletableFuture<BedrockClassicSkinPack> load(
+            final PackReader reader) {
+        return CompletableFuture.supplyAsync(
+                () -> {
+                    final BedrockClassicModel.ModelSource source =
+                            new BedrockClassicModel.ModelSource() {
+                                private BedrockBuiltinAssets.Contents library;
+
+                                @Override
+                                public JsonObject find(final String identifier) throws IOException {
+                                    if (this.library == null)
+                                        this.library = BedrockBuiltinAssets.load();
+                                    return this.library.model(identifier);
+                                }
+                            };
+                    try {
+                        final BedrockClassicSkinPack pack = reader.read(source);
+                        for (final var skin : pack.skins())
+                            if (!skin.options().animations().isEmpty())
+                                BedrockActorAnimation.read(
+                                        BedrockBuiltinAssets.load().library(),
+                                        skin.options());
+                        return pack;
+                    } catch (Exception e) {
+                        throw new CompletionException(e);
+                    }
+                });
+    }
+
+    @FunctionalInterface
+    private interface PackReader {
+        BedrockClassicSkinPack read(BedrockClassicModel.ModelSource source) throws IOException;
+    }
+
+    public static CompletableFuture<BedrockActorAnimation> animations(
+            final BedrockClassicOptions options) {
+        return CompletableFuture.supplyAsync(
+                () -> {
+                    try {
+                        return BedrockActorAnimation.read(
+                                BedrockBuiltinAssets.load().library(), options);
+                    } catch (Exception e) {
+                        throw new CompletionException(e);
+                    }
+                });
+    }
+}
