+    private static CompletableFuture<AccountWardrobe> updateProfile(final BedrockAuthManager account, final int slotNumber,
+                                                                     final String expectedProfileHash, final ProfileEdit edit) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                if (slotNumber < 1 || slotNumber > 5) {
+                    throw new IOException("Character slot is out of range");
+                }
+                final AccountWardrobe current = loadNow(account);
+                if (!current.slots().get(slotNumber - 1).profileHash().equals(expectedProfileHash)) {
+                    throw new IOException("This character changed on your account. Refresh before editing it");
+                }
+                final JsonObject requestBody = edit.apply(current);
+                final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+                final HttpRequest request = HttpRequest.newBuilder(APPEARANCE)
+                    .timeout(Duration.ofSeconds(15))
+                    .header("Authorization", authorization)
+                    .header("session-id", UUID.randomUUID().toString())
+                    .header("Content-Type", "application/json")
+                    .header("Accept", "application/json")
+                    .PUT(HttpRequest.BodyPublishers.ofString(requestBody.toString())).build();
+                final JsonObject hashes = object(object(send(request), "result"), "profileHashes");
+                if (!hashes.has("PlayerProfileHash_personaProfile")
+                    || !hashes.has("PlayerProfileHash_personaProfile" + slotNumber)) {
+                    throw new IOException("Bedrock did not confirm the character edit");
+                }
+                final AccountWardrobe refreshed = parse(readProfiles(account));
+                final JsonObject expectedSettings = requestBody.getAsJsonArray("appearanceObjects").get(0)
+                    .getAsJsonObject().getAsJsonObject("personaAppearance").getAsJsonObject("personaCollection");
+                if (!expectedSettings.equals(refreshed.settingsProfile().getAsJsonObject("personaCollection"))) {
+                    throw new IOException("Bedrock did not save the active character slot");
+                }
+                final JsonObject expected = requestBody.getAsJsonArray("appearanceObjects").get(1)
+                    .getAsJsonObject().getAsJsonObject("personaAppearance").getAsJsonObject("personaCollection");
+                if (!expected.equals(refreshed.slots().get(slotNumber - 1).profile().getAsJsonObject("personaCollection"))) {
+                    throw new IOException("Bedrock did not save the character edit");
+                }
+                return refreshed;
+            } catch (Exception e) {
+                throw new IllegalStateException("Could not edit the Bedrock character", e);
+            }
+        });
+    }
