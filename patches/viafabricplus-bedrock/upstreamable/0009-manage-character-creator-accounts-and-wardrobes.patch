+    private static BedrockParticleAttachment particleAttachment(
+            final Appearance appearance, final Geometry geometry, final Avatar entity, final String name) {
+        final float partialTick = Minecraft.getInstance().getDeltaTracker().getGameTimeDeltaPartialTick(false);
+        final float yaw = net.minecraft.util.Mth.rotLerp(partialTick, entity.yBodyRotO, entity.yBodyRot);
+        final var position = entity.getPosition(partialTick);
+        final var locator = geometry == null ? null : geometry.locators().get(name);
+        final var world = locator == null || appearance.soundModel == null ? null
+                : appearance.soundModel.worldLocator(locator, position, yaw);
+        if (entity.isRemoved())
+            return BedrockParticleAttachment.registry(new net.minecraft.world.phys.Vec3(entity.xo, entity.yo, entity.zo),
+                    entity.position(), entity.yBodyRotO, entity.yBodyRot, partialTick, world);
+        return new BedrockParticleAttachment(position, yaw, world, entity.getBoundingBox(),
+                BedrockParticleQueries.actor(entity, BedrockActorState.state(entity.getUUID()), appearance.particleQueries));
+    }
+
+    private static net.minecraft.world.phys.Vec3 effectPosition(
+            final Appearance appearance, final Geometry geometry, final Avatar entity, final float bodyRot,
+            final String name) {
+        var position = entity.position();
+        final var locator = geometry == null ? null : geometry.locators().get(name);
+        final var local = locator == null || appearance.soundModel == null ? null : appearance.soundModel.locator(locator);
+        if (local != null) {
+            // Match the world model's X/Y flip, floor origin, pixel units, and body yaw.
+            local.set(-local.x, 24 - local.y, local.z).div(16)
