+                final var local = BedrockClassicSkinPack.read("local", files, _ -> null);
+                assertNull(local.cape(local.skins().getFirst()));
+                final var trusted = BedrockClassicSkinPack.readAccountPack("account", files, _ -> null);
+                assertEquals(root + "cape.png", trusted.skins().getFirst().cape());
+                assertEquals(0xFF336699, trusted.cape(trusted.skins().getFirst()).getRGB(0, 0));
+            }
+        }
+        for (final String reference : List.of("", "textures/", "absent.png", "x".repeat(1016) + "cape.png", "é".repeat(508) + "cape.png")) {
+            final var pack = BedrockClassicSkinPack.readAccountPack("account", files("", reference, png(64, 32, 0)), _ -> null);
+            assertNull(pack.cape(pack.skins().getFirst()));
+        }
+    }
+
+    @Test
+    void preservesBundledPixelsAndIdentityThroughStoreSelectionAndWireRoundTrips() throws IOException {
+        final var first = pack(0xFF336699);
+        final var second = pack(0xFF996633);
+        final var store = store();
+        final var imported = store.importPackSkin("123", first, first.skins().getFirst(), first.skins().getFirst().slim());
+        assertEquals(0xFF336699, imported.cape().getRGB(0, 0));
+        assertEquals(imported.capeId(), store().load("123").capeId());
+        assertNull(store.load("456").cape());
+        store.select("123", BedrockAppearanceStore.Selection.STEVE);
+        assertNull(store.load("123").cape());
+        store.select("123", BedrockAppearanceStore.Selection.CUSTOM);
+        assertEquals(imported.capeId(), store.load("123").capeId());
+        final var buffer = Unpooled.buffer();
+        try {
+            final var type = new SkinType();
+            type.write(buffer, store.load("123").skinData(""));
+            final var decoded = type.read(buffer);
+            assertEquals(imported.capeId(), decoded.capeId());
+            assertEquals(64, decoded.capeData().getWidth());
+            assertEquals(32, decoded.capeData().getHeight());
+            assertEquals(0xFF336699, decoded.capeData().getRGB(0, 0));
+        } finally { buffer.release(); }
+        final var replaced = store.importPackSkin("123", second, second.skins().getFirst(), second.skins().getFirst().slim());
+        assertEquals(0xFF996633, replaced.cape().getRGB(0, 0));
+        assertNotEquals(imported.capeId(), replaced.capeId());
+        store.importSkinImage("123", new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB), false);
+        assertNull(store.load("123").cape());
+    }
+
+    @Test
+    void keepsManualImportsSeparateAndRejectsBadCapesBeforeReplacingTheAppearance() throws IOException {
+        final var pack = pack(0xFF336699);
+        final var store = store();
+        final var before = store.importPackSkin("123", pack, pack.skins().getFirst(), pack.skins().getFirst().slim());
+        for (final byte[] data : List.of(png(32, 32, 0), new byte[]{0, 1, 2})) {
+            final var broken = BedrockClassicSkinPack.readAccountPack("account", files("", "cape.png", data), _ -> null);
+            assertThrows(IOException.class, () -> store.importPackSkin("123", broken, broken.skins().getFirst(), broken.skins().getFirst().slim()));
+            assertEquals(before.skinId(), store.load("123").skinId());
+            assertEquals(before.capeId(), store.load("123").capeId());
+        }
+        final Path manual = this.directory.resolve("manual.png");
+        java.nio.file.Files.write(manual, png(64, 32, 0xFF22CC44));
+        final var override = store.importCape("123", manual);
+        store.importPackSkin("123", pack, pack.skins().getFirst(), pack.skins().getFirst().slim());
+        assertEquals(override.capeId(), store.load("123").capeId());
+        assertEquals(0xFF22CC44, store.load("123").cape().getRGB(0, 0));
+        store.removeCape("123");
+        assertNull(store().load("123").cape());
+    }
+
+    private BedrockAppearanceStore store() {
+        return new BedrockAppearanceStore(this.directory.resolve("store"),
+                _ -> new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB));
+    }
+
+    private static BedrockClassicSkinPack pack(final int color) throws IOException {
+        return BedrockClassicSkinPack.readAccountPack("account", files("", "cape.png", png(64, 32, color)), _ -> null);
+    }
+
+    private static Map<String, byte[]> files(final String root, final String reference, final byte[] cape) throws IOException {
+        final var skin = new JsonObject();
+        skin.addProperty("geometry", "geometry.humanoid.custom");
+        skin.addProperty("texture", "skin.png");
+        skin.addProperty("cape", reference);
+        final var skins = new JsonArray();
+        skins.add(skin);
+        final var definitions = new JsonObject();
+        definitions.add("skins", skins);
+        final Map<String, byte[]> files = new HashMap<>();
+        files.put(root + "manifest.json", "{\"modules\":[{\"type\":\"skin_pack\"}]}".getBytes(StandardCharsets.UTF_8));
+        files.put(root + "skins.json", definitions.toString().getBytes(StandardCharsets.UTF_8));
+        files.put(root + "skin.png", png(64, 64, 0));
+        files.put(root + "cape.png", cape);
+        return files;
+    }
+
+    private static byte[] png(final int width, final int height, final int color) throws IOException {
+        final var image = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < height; y++) for (int x = 0; x < width; x++) image.setRGB(x, y, color);
+        final var bytes = new ByteArrayOutputStream();
+        ImageIO.write(image, "png", bytes);
+        return bytes.toByteArray();
+    }
+}
