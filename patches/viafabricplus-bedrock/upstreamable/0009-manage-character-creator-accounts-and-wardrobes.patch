+    @Test
+    void keepsEmoteWheelBeforeClassicReferenceAndReturnsToPersonaWhenEditingArms() throws Exception {
+        final var before = wardrobe();
+        final var skin = pack().skins().getFirst();
+        final var request = BedrockCharacterProfiles.classicSelectionRequest(before, 1, skin);
+        final var profile = request.getAsJsonArray("appearanceObjects").get(1).getAsJsonObject().getAsJsonObject("personaAppearance");
+        final var slot = newSlot(profile);
+        final var wardrobe = new BedrockCharacterProfiles.AccountWardrobe(List.of(slot), 1, before.profileVersion(), before.settingsProfile());
+        assertEquals("emote/e", BedrockCharacterProfiles.emoteIds(slot, List.of()).getFirst());
+        final var emote = new BedrockCharacterProfiles.WardrobeItem(new UUID(2, 3).toString(), "emote", "persona_emote", "",
+            new UUID(4, 5).toString(), true, 0, false);
+        final var edited = BedrockCharacterProfiles.emoteChangeRequest(wardrobe, 1, List.of(emote), emote, 3, false)
+            .getAsJsonArray("appearanceObjects").get(1).getAsJsonObject().getAsJsonObject("personaAppearance");
+        final var editedSlot = newSlot(edited);
+        assertTrue(editedSlot.classic());
+        final var ids = BedrockCharacterProfiles.emoteIds(editedSlot, List.of(emote));
+        assertEquals(4, ids.size());
+        assertTrue(emote.matches(ids.get(3)));
+        assertTrue(editedSlot.pieceIds().contains(skin.recipeId()));
+        final var persona = BedrockCharacterProfiles.armSizeChangeRequest(wardrobe, 1, "slim")
+            .getAsJsonArray("appearanceObjects").get(1).getAsJsonObject().getAsJsonObject("personaAppearance");
