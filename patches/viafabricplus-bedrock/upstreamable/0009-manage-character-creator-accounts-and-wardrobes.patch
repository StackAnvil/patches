+
+    private static BedrockMarketplaceAssets.Pack pack(
+            final String id,
+            final String meta,
+            final String geometry,
+            final Map<String, byte[]> files) {
+        final Map<String, byte[]> result = new LinkedHashMap<>(files);
+        result.put("piece.meta.json", meta.getBytes(StandardCharsets.UTF_8));
+        result.put("piece.geometry.json", geometry.getBytes(StandardCharsets.UTF_8));
+        return new BedrockMarketplaceAssets.Pack(id, result);
