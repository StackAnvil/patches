+                                        .getAsJsonObject()));
+        final var face =
+                assembled.animations().stream()
+                        .filter(animation -> animation.type() == 1)
+                        .findFirst()
+                        .orElseThrow();
+        final JsonObject nativeFace =
+                capture.getAsJsonArray("AnimatedImageData").asList().stream()
+                        .map(element -> element.getAsJsonObject())
+                        .filter(animation -> animation.get("Type").getAsInt() == 1)
+                        .findFirst()
+                        .orElseThrow();
+        final byte[] rgba = Base64.getDecoder().decode(nativeFace.get("Image").getAsString());
+        assertEquals(nativeFace.get("ImageWidth").getAsInt(), face.image().getWidth());
+        assertEquals(nativeFace.get("ImageHeight").getAsInt(), face.image().getHeight());
+        assertEquals(nativeFace.get("Frames").getAsInt(), face.frames());
+        assertEquals(nativeFace.get("AnimationExpression").getAsInt(), face.expression());
+        int offset = 0;
+        for (int y = 0; y < face.image().getHeight(); y++)
