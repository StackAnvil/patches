+        BedrockMarketplaceTransactions.redeemXbox(account).whenComplete((result, error) -> this.minecraft.execute(() -> {
+            if (ViaFabricPlusBedrock.impl().account().get() != account || this.minecraft.gui.screen() != this) {
+                this.loading = false;
+                this.purchaseStatus = null;
+                return;
+            }
+            if (error != null) {
+                this.purchaseStatus = Component.translatable("bedrock_marketplace.viafabricplus.sync_failed");
+                ViaFabricPlusBedrock.impl().logger().warn("Could not synchronize Microsoft Store purchases", error);
+            } else {
+                this.purchaseStatus = result.failed() == 0 ? null
+                    : Component.translatable("bedrock_marketplace.viafabricplus.sync_partial", result.failed());
+            }
+            this.wallet.refresh();
+            this.loadWardrobe(account);
+        }));
+    }
+
+    private void loadWardrobe(final BedrockAuthManager account) {
+        BedrockCharacterProfiles.load(account).whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+            this.loading = false;
+            if (this.minecraft.gui.screen() != this || ViaFabricPlusBedrock.impl().account().get() != account) {
+                return;
+            }
+            if (error != null) {
+                this.failed = true;
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock character slots", error);
+            } else {
+                if (this.wardrobe == null && loaded.activeSlot() > 0
+                    && loaded.activeSlot() <= loaded.slots().size()) {
+                    this.selectedSlot = loaded.activeSlot() - 1;
+                }
+                this.wardrobe = loaded;
+                try {
+                    final var appearance = ViaFabricPlusBedrock.impl().appearances()
+                        .load(BedrockAppearanceStore.accountId(account));
+                    this.characterSelected = loaded.activeSlot() > 0
+                        && ViaFabricPlusBedrock.impl().appearances().usesAccountCharacter(
+                            BedrockAppearanceStore.accountId(account), loaded.slots().get(loaded.activeSlot() - 1));
+                    if (appearance.selection() == Selection.PERSONA && !this.characterSelected) {
+                        ViaFabricPlusBedrock.impl().appearances()
+                            .select(BedrockAppearanceStore.accountId(account), Selection.STEVE);
+                        this.modelFailed = true;
+                    }
+                } catch (java.io.IOException e) {
+                    this.characterSelected = false;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not load selected Bedrock character model", e);
+                }
+                this.items = null;
+                this.loadedCategory = null;
+                this.itemsFailed = false;
+                this.updateControls();
+                this.loadAvatar(account);
+                if (this.view == View.WARDROBE) {
+                    this.loadCategory();
+                }
+            }
+        }));
+    }
