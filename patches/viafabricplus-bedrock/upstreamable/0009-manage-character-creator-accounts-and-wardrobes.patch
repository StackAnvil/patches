@@ -0,0 +1,120 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockMarketplaceAssets.Pack;
+
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Downloads owned and zero-price pieces using the current account's receipt keys. */
+final class BedrockPersonaAssets {
+    private BedrockPersonaAssets() {}
+
+    static Map<String, Pack> load(
+            final BedrockAuthManager account,
+            final BedrockPersonaProfile profile,
+            final BedrockCharacterProfiles.Slot slot,
+            final List<BedrockCharacterProfiles.WardrobeItem> catalog)
+            throws Exception {
+        final List<Reference> references =
+                new ArrayList<>(
+                        profile.pieces().stream()
+                                .filter(
+                                        piece ->
+                                                BedrockPersonaProfile.defaultType(piece.id())
+                                                                == null
+                                                        && !piece.productId().isEmpty())
+                                .map(
+                                        piece ->
+                                                catalog.stream()
+                                                        .filter(
+                                                                item ->
+                                                                        item.id()
+                                                                                        .equals(
+                                                                                                piece
+                                                                                                        .productId())
+                                                                                && item.packId()
+                                                                                        .equals(
+                                                                                                piece
+                                                                                                        .packId()))
+                                                        .findFirst()
+                                                        .map(Reference::from)
+                                                        .orElseGet(
+                                                                () ->
+                                                                        new Reference(
+                                                                                piece.packId(),
+                                                                                piece.productId(),
+                                                                                false)))
+                                .toList());
+        references.addAll(BedrockPersonaCape.references(slot, catalog));
+        final Map<String, Pack> packs = new LinkedHashMap<>(load(account, references));
+        if (profile.pieces().stream()
+                .anyMatch(piece -> BedrockPersonaProfile.defaultType(piece.id()) != null)) {
+            final var builtins = BedrockBuiltinAssets.load();
+            for (final var piece : profile.pieces())
+                if (BedrockPersonaProfile.defaultType(piece.id()) != null)
+                    packs.put(piece.id(), builtins.piece(piece.id()));
+        }
+        return Map.copyOf(packs);
+    }
+
+    static Map<String, Pack> load(
+            final BedrockAuthManager account, final List<Reference> references) throws Exception {
+        if (references.isEmpty()) return Map.of();
+        final Map<String, byte[]> keys = BedrockMarketplaceAssets.accountKeys(account);
+        final Map<String, Pack> packs = new LinkedHashMap<>();
+        for (final Reference piece : references) {
+            if (packs.containsKey(piece.packId())) continue;
+            final byte[] key = keys.get(piece.packId());
+            if (key == null && (!piece.zeroPrice() || keys.isEmpty())) continue;
+            final JsonObject item = BedrockMarketplaceAssets.published(account, piece.productId());
+            if (key == null && !freePersonaItem(item, piece)) continue;
+            final byte[] bytes = BedrockMarketplaceAssets.download(item, "personabinary");
+            packs.put(
+                    piece.packId(),
+                    BedrockMarketplaceAssets.decode(
+                            bytes, piece.packId(), key == null ? keys.values() : List.of(key)));
+        }
+        return Map.copyOf(packs);
+    }
+
+    static boolean freePersonaItem(final JsonObject item, final Reference reference)
+            throws IOException {
+        try {
+            if (!reference.zeroPrice()
+                    || !reference.productId().equals(item.get("Id").getAsString())
+                    || !"PersonaDurable".equals(item.get("ContentType").getAsString()))
+                return false;
+            final JsonObject properties = item.getAsJsonObject("DisplayProperties");
+            final var price = properties.get("price");
+            if (price == null
+                    || !price.isJsonPrimitive()
+                    || !price.getAsJsonPrimitive().isNumber()
+                    || price.getAsBigDecimal().signum() != 0) return false;
+            for (final var identity : properties.getAsJsonArray("packIdentity")) {
+                final var pack = identity.getAsJsonObject();
+                if ("persona_piece".equals(pack.get("type").getAsString())
+                        && reference.packId().equals(pack.get("uuid").getAsString())) return true;
+            }
+            return false;
+        } catch (RuntimeException e) {
+            throw new IOException("The persona catalog returned invalid item metadata", e);
+        }
+    }
+
+    record Reference(String packId, String productId, boolean zeroPrice) {
+        static Reference from(final BedrockCharacterProfiles.WardrobeItem item) {
+            return new Reference(item.packId(), item.id(), item.price() == 0);
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaBody.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaBody.java
