@@ -0,0 +1,87 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles.ColorTarget;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles.Slot;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles.WardrobeItem;
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Resolves color controls from equipped, loaded persona pieces. */
+final class BedrockPersonaColors {
+    private BedrockPersonaColors() {}
+
+    static List<ColorTarget> targets(final JsonObject metadata, final boolean loaded) throws IOException {
+        if (!loaded || !BedrockPersonaTint.allowsOverride(metadata)) return List.of();
+        return switch (metadata.has("piece_type") ? metadata.get("piece_type").getAsString() : "") {
+            case "persona_skin" -> List.of(ColorTarget.SKIN);
+            case "persona_hair" -> List.of(ColorTarget.HAIR);
+            case "persona_facial_hair" -> List.of(ColorTarget.FACIAL_HAIR);
+            case "persona_mouth" -> List.of(ColorTarget.MOUTH);
+            case "persona_eyes" -> List.of(ColorTarget.IRIS, ColorTarget.EYEBROWS, ColorTarget.SCLERA);
+            default -> List.of();
+        };
+    }
+
+    static List<ColorTarget> available(final List<ColorTarget> requested,
+                                      final Map<String, BedrockMarketplaceAssets.Pack> packs) throws IOException {
+        final Map<String, List<ColorTarget>> byType = new LinkedHashMap<>();
+        for (final var pack : packs.values()) {
+            for (final var metadata : BedrockPersonaSources.metadata(pack)) {
+                final String type = metadata.has("piece_type") ? metadata.get("piece_type").getAsString() : "";
+                if (requested.stream().noneMatch(target -> target.pieceType().equals(type))) continue;
+                final List<ColorTarget> targets = targets(metadata, true);
+                final List<ColorTarget> previous = byType.putIfAbsent(type, targets);
+                if (previous != null && !previous.equals(targets))
+                    throw new IOException("The equipped piece has ambiguous color controls");
+            }
+        }
+        return requested.stream().filter(target -> byType.values().stream().anyMatch(values -> values.contains(target))).toList();
+    }
+
+    static List<ColorTarget> load(final BedrockAuthManager account, final Slot slot,
+                                 final List<ColorTarget> requested, final List<WardrobeItem> catalog) throws IOException {
+        try {
+            final List<String> builtins = new ArrayList<>();
+            final List<BedrockPersonaAssets.Reference> references = new ArrayList<>();
+            final List<WardrobeItem> items = new ArrayList<>(catalog);
+            if (requested.contains(ColorTarget.SKIN) && slot.pieceIds().stream()
+                    .noneMatch(id -> "persona_skin".equals(BedrockPersonaProfile.defaultType(id.split("/", 2)[0]))))
+                items.addAll(BedrockCharacterProfiles.loadItems(account, BedrockCharacterProfiles.Category.BASES).join());
+            for (final String recipe : slot.pieceIds()) {
+                final String id = recipe.split("/", 2)[0];
+                final String builtinType = BedrockPersonaProfile.defaultType(id);
+                if (builtinType != null) {
+                    if (requested.stream().anyMatch(target -> target.pieceType().equals(builtinType))) builtins.add(id);
+                    continue;
+                }
+                final var item = items.stream().filter(candidate -> candidate.matches(recipe)).findFirst().orElse(null);
+                if (item != null && requested.stream().anyMatch(target -> target.pieceType().equals(item.type())))
+                    references.add(BedrockPersonaAssets.Reference.from(item));
+            }
+            final Map<String, BedrockMarketplaceAssets.Pack> packs = new LinkedHashMap<>(BedrockPersonaAssets.load(account, references));
+            if (!builtins.isEmpty()) {
+                final var contents = BedrockBuiltinAssets.load();
+                for (final String id : builtins) packs.put(id, contents.piece(id));
+            }
+            return available(requested, packs);
+        } catch (IOException e) {
+            throw e;
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IOException("Loading character color controls was interrupted", e);
+        } catch (Exception e) {
+            throw new IOException("Could not load character color controls", e);
+        }
+    }
+}
