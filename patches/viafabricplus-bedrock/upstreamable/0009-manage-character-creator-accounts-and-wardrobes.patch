@@ -0,0 +1,162 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpRequest;
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+
+/** Downloads account-owned classic packs through the native Store and receipt flow. */
+public final class BedrockOwnedSkinPacks {
+    private static final URI PAGE =
+            URI.create(
+                    "https://store.mktpl.minecraft-services.net/api/v2.0/layout/pages/MultiItemPage_PersonaSkinSelector");
+
+    private BedrockOwnedSkinPacks() {}
+
+    public static CompletableFuture<List<Item>> list(final BedrockAuthManager account) {
+        return CompletableFuture.supplyAsync(
+                () -> {
+                    try {
+                        final byte[] response =
+                                BedrockMarketplaceAssets.request(
+                                        HttpRequest.newBuilder(PAGE)
+                                                .header(
+                                                        "Authorization",
+                                                        account.getMinecraftSession()
+                                                                .getUpToDate()
+                                                                .getAuthorizationHeader())
+                                                .header("Content-Type", "application/json")
+                                                .header("Accept", "application/json")
+                                                .POST(
+                                                        HttpRequest.BodyPublishers.ofString(
+                                                                "{\"entitlements\":[],\"inventoryVersion\":\"\",\"listVersion\":\"\"}")),
+                                        2 * 1024 * 1024);
+                        return parse(
+                                JsonParser.parseString(new String(response, StandardCharsets.UTF_8))
+                                        .getAsJsonObject());
+                    } catch (Exception e) {
+                        throw new CompletionException(e);
+                    }
+                });
+    }
+
+    public static CompletableFuture<BedrockClassicSkinPack> load(
+            final BedrockAuthManager account, final Item selected) {
+        return CompletableFuture.supplyAsync(
+                        () -> {
+                            try {
+                                final var keys = BedrockMarketplaceAssets.accountKeys(account);
+                                final byte[] key = keys.get(selected.packId());
+                                if (key == null)
+                                    throw new IOException(
+                                            "This account has no content key for the selected skin"
+                                                + " pack");
+                                final JsonObject item =
+                                        BedrockMarketplaceAssets.published(
+                                                account, selected.productId());
+                                validatePublished(selected, item);
+                                return BedrockMarketplaceAssets.decode(
+                                        BedrockMarketplaceAssets.download(item, "skinbinary"),
+                                        selected.packId(),
+                                        List.of(key));
+                            } catch (Exception e) {
+                                throw new CompletionException(e);
+                            }
+                        })
+                .thenCompose(
+                        pack -> BedrockClassicAssets.loadAccount(selected.name(), pack.files()))
+                .thenApply(pack -> {
+                    if (pack.skins().stream().anyMatch(skin -> !selected.packId().equals(skin.packId()) || skin.skinId().isBlank())) {
+                        throw new CompletionException(new IOException("The downloaded skin pack has a different identity"));
+                    }
+                    return pack;
+                });
+    }
+
+    static List<Item> parse(final JsonObject response) throws IOException {
+        if (!response.has("result") || !response.get("result").isJsonObject())
+            throw new IOException("The Store returned an invalid skin-pack page");
+        final Map<String, Item> items = new LinkedHashMap<>();
+        collect(response.getAsJsonObject("result"), items);
+        return List.copyOf(items.values());
+    }
+
+    private static void collect(final JsonElement element, final Map<String, Item> items)
+            throws IOException {
+        if (element.isJsonArray()) {
+            for (final var child : element.getAsJsonArray()) collect(child, items);
+        } else if (element.isJsonObject()) {
+            final var object = element.getAsJsonObject();
+            final String ownership = string(object, "ownership");
+            if (("Owned".equalsIgnoreCase(ownership) || "Purchased".equalsIgnoreCase(ownership))
+                    && object.has("packIdentity")
+                    && object.get("packIdentity").isJsonArray()) {
+                for (final var identity : object.getAsJsonArray("packIdentity")) {
+                    if (!identity.isJsonObject()) continue;
+                    final var pack = identity.getAsJsonObject();
+                    if (!"skinpack".equals(string(pack, "type"))) continue;
+                    try {
+                        final String product = UUID.fromString(string(object, "id")).toString();
+                        final String id = UUID.fromString(string(pack, "uuid")).toString();
+                        final var item =
+                                new Item(
+                                        product,
+                                        id,
+                                        string(pack, "version"),
+                                        string(object, "title"),
+                                        string(object, "creatorName"));
+                        items.putIfAbsent(id, item);
+                    } catch (IllegalArgumentException e) {
+                        throw new IOException(
+                                "The Store returned an invalid skin-pack identity", e);
+                    }
+                }
+            }
+            for (final var entry : object.entrySet()) collect(entry.getValue(), items);
+        }
+    }
+
+    static void validatePublished(final Item selected, final JsonObject item) throws IOException {
+        if (!selected.productId().equals(string(item, "Id")))
+            throw new IOException("The skin-pack product changed. Refresh the pack list");
+        final var properties = item.getAsJsonObject("DisplayProperties");
+        if (properties != null
+                && properties.has("packIdentity")
+                && properties.get("packIdentity").isJsonArray()) {
+            for (final var element : properties.getAsJsonArray("packIdentity")) {
+                if (!element.isJsonObject()) continue;
+                final var identity = element.getAsJsonObject();
+                if ("skinpack".equals(string(identity, "type"))
+                        && selected.packId().equals(string(identity, "uuid"))
+                        && selected.version().equals(string(identity, "version"))) return;
+            }
+        }
+        throw new IOException("The skin-pack identity or version changed. Refresh the pack list");
+    }
+
+    private static String string(final JsonObject object, final String key) {
+        return object.has(key) && object.get(key).isJsonPrimitive()
+                ? object.get(key).getAsString()
+                : "";
+    }
+
+    public record Item(
+            String productId, String packId, String version, String name, String creator) {}
+}
