+
+import java.util.List;
+import java.util.UUID;
+import java.io.IOException;
+
+final class BedrockLimbSelectionTest {
+    @ParameterizedTest
+    @CsvSource({"ARMS, false", "ARMS, true", "LEGS, false", "LEGS, true"})
+    void resetsOneSideThenBothWithoutChangingOtherPieces(
+            final BedrockCharacterProfiles.Category category, final boolean free) throws Exception {
+        final var type = category == BedrockCharacterProfiles.Category.ARMS ? "persona_arms" : "persona_legs";
+        final var item = item(type, free);
+        final var other = item(type, !free);
+        final var base = BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE).profile();
+        final var both = change(base, List.of(item, other), item, BedrockLimbSide.BOTH, false);
+        final var equipped = piece(both, item, BedrockLimbSide.BOTH);
+        equipped.add("col", JsonParser.parseString("[\"#ff112233\",\"#0\",\"#0\",\"#0\"]"));
+        final var before = both.deepCopy();
+        final var wardrobe = new BedrockCharacterProfiles.AccountWardrobe(List.of(slot(both)), 1, 1, base);
+        assertTrue(BedrockCharacterProfiles.canResetLimb(slot(both), category, List.of(item, other), BedrockLimbSide.RIGHT));
+        final var left = reset(wardrobe, category, List.of(item, other), BedrockLimbSide.RIGHT);
+        assertTrue(BedrockCharacterProfiles.limbEquipped(slot(left), item, BedrockLimbSide.LEFT));
+        assertEquals(equipped.get("col"), piece(left, item, BedrockLimbSide.LEFT).get("col"));
+        assertFalse(BedrockCharacterProfiles.limbEquipped(slot(left), item, BedrockLimbSide.RIGHT));
+        assertEquals(before, both);
+        assertFalse(BedrockCharacterProfiles.canResetLimb(slot(left), category, List.of(item, other), BedrockLimbSide.RIGHT));
+
+        final var split = change(left, List.of(item, other), other, BedrockLimbSide.RIGHT, false);
+        final var splitWardrobe = new BedrockCharacterProfiles.AccountWardrobe(List.of(slot(split)), 1, 1, base);
+        final var restored = reset(splitWardrobe, category, List.of(item, other), BedrockLimbSide.BOTH);
+        assertEquals(base, restored);
+        assertFalse(BedrockCharacterProfiles.canResetLimb(slot(restored), category, List.of(item, other), BedrockLimbSide.BOTH));
+        assertThrows(IOException.class, () -> reset(splitWardrobe, BedrockCharacterProfiles.Category.HAIRS,
+            List.of(item, other), BedrockLimbSide.BOTH));
+        piece(both, item, BedrockLimbSide.BOTH).addProperty("id", item.packId() + "/unknown");
+        assertFalse(BedrockCharacterProfiles.canResetLimb(slot(both), category, List.of(item, other), BedrockLimbSide.RIGHT));
+        final var unsupported = new BedrockCharacterProfiles.AccountWardrobe(List.of(slot(both)), 1, 1, base);
+        assertThrows(IOException.class, () -> reset(unsupported, category, List.of(item, other), BedrockLimbSide.RIGHT));
+    }
+
+    private static JsonObject reset(final BedrockCharacterProfiles.AccountWardrobe wardrobe,
+                                    final BedrockCharacterProfiles.Category category,
+                                    final List<BedrockCharacterProfiles.WardrobeItem> items,
+                                    final BedrockLimbSide side) throws IOException {
+        return BedrockCharacterProfiles.limbResetRequest(wardrobe, 1, category, items, side)
+            .getAsJsonArray("appearanceObjects").get(1).getAsJsonObject().getAsJsonObject("personaAppearance");
+    }
+
+    @ParameterizedTest
+    @CsvSource({
+        "persona_arms, false, false", "persona_arms, false, true",
+        "persona_arms, true, false", "persona_arms, true, true",
+        "persona_legs, false, false", "persona_legs, false, true",
+        "persona_legs, true, false", "persona_legs, true, true"
+    })
+    void splitsBothSidesPreservesColorsAndKeepsIndependentEquips(
+            final String type, final boolean oldFree, final boolean nextFree) throws Exception {
+        final var old = item(type, oldFree);
+        final var next = item(type, nextFree);
+        final var category = List.of(old, next);
+        final var initial =
+                BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final var originalEntries = entries(initial.profile());
+        final var arm = new JsonObject();
+        arm.addProperty("id", old.packId() + (oldFree ? "/f" : ""));
+        arm.add("col", JsonParser.parseString("[\"#ff112233\",\"#0\",\"#0\",\"#0\"]"));
+        originalEntries.asList().add(originalEntries.size() - 4, arm);
+        final var before = initial.profile().deepCopy();
+        final var wardrobe =
+                new BedrockCharacterProfiles.AccountWardrobe(
+                        List.of(initial), 1, 1, new JsonObject());
+        assertTrue(BedrockCharacterProfiles.canEditLimbSides(wardrobe, initial, category, next));
+        final var changed = change(initial.profile(), category, next, BedrockLimbSide.RIGHT, false);
+        final var left = piece(changed, old, BedrockLimbSide.LEFT);
+        final var right = piece(changed, next, BedrockLimbSide.RIGHT);
+        assertEquals(old.packId() + (oldFree ? "/fl" : "/l"), id(left));
+        assertEquals(next.packId() + (nextFree ? "/fr" : "/r"), id(right));
+        assertEquals(arm.get("col"), left.get("col"));
+        assertEquals(arm.get("col"), right.get("col"));
+        assertEquals(before, initial.profile());
+        assertEquals(
+                originalEntries.get(originalEntries.size() - 4),
+                entries(changed).get(entries(changed).size() - 4));
+
+        final var both = change(changed, category, next, BedrockLimbSide.LEFT, false);
+        assertTrue(BedrockCharacterProfiles.limbEquipped(slot(both), next, BedrockLimbSide.BOTH));
+        assertEquals(
+                2,
+                entries(both).asList().stream()
+                        .filter(e -> next.matches(id(e.getAsJsonObject())))
+                        .count());
+        final var claims = BedrockPersonaProfile.from(slot(both), category).pieces();
+        assertEquals(
+                1,
+                claims.stream()
+                        .filter(
+                                p ->
+                                        p.type()
+                                                .equals(
+                                                        type.equals("persona_arms")
+                                                                ? "LeftArm"
+                                                                : "LeftLeg"))
+                        .count());
+        assertEquals(
+                1,
+                claims.stream()
+                        .filter(
+                                p ->
+                                        p.type()
+                                                .equals(
+                                                        type.equals("persona_arms")
+                                                                ? "RightArm"
+                                                                : "RightLeg"))
+                        .count());
+
+        final var removed = change(both, category, next, BedrockLimbSide.RIGHT, true);
+        assertTrue(
+                BedrockCharacterProfiles.limbEquipped(slot(removed), next, BedrockLimbSide.LEFT));
+        assertFalse(
+                BedrockCharacterProfiles.limbEquipped(slot(removed), next, BedrockLimbSide.RIGHT));
+        assertEquals(
+                piece(both, next, BedrockLimbSide.LEFT),
+                piece(removed, next, BedrockLimbSide.LEFT));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"persona_arms", "persona_legs"})
+    void replacesBothIndependentSidesInARecipeWithoutAnEmoteWheel(final String type)
+            throws Exception {
+        final var old = item(type);
+        final var next = item(type);
+        final var initial =
+                BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE)
+                        .profile();
+        final var data = entries(initial);
+        for (int i = 0; i < 4; i++) data.remove(data.size() - 1);
+        for (final var side : List.of(BedrockLimbSide.LEFT, BedrockLimbSide.RIGHT)) {
+            final var piece = new JsonObject();
+            piece.addProperty("id", side.recipe(old.packId()));
+            data.add(piece);
+        }
+        final var changed = change(initial, List.of(old, next), next, BedrockLimbSide.BOTH, false);
+        assertFalse(
+                entries(changed).asList().stream()
+                        .anyMatch(e -> old.matches(id(e.getAsJsonObject()))));
+        assertEquals(
+                next.packId(),
+                id(entries(changed).get(entries(changed).size() - 1).getAsJsonObject()));
+        assertTrue(
+                BedrockCharacterProfiles.limbEquipped(slot(changed), next, BedrockLimbSide.BOTH));
+    }
+
+    private static BedrockCharacterProfiles.WardrobeItem item(final String type) {
+        return item(type, false);
+    }
+
+    private static BedrockCharacterProfiles.WardrobeItem item(
+            final String type, final boolean free) {
+        return new BedrockCharacterProfiles.WardrobeItem(
+                UUID.randomUUID().toString(),
+                "",
+                type,
+                "",
+                UUID.randomUUID().toString(),
+                !free,
+                (free ? 0 : -1), false);
+    }
+
+    private static BedrockCharacterProfiles.Slot slot(final JsonObject profile) {
+        final var ids =
+                entries(profile).asList().stream()
+                        .map(e -> id(e.getAsJsonObject()))
+                        .filter(id -> !id.isEmpty())
+                        .toList();
+        return new BedrockCharacterProfiles.Slot(1, "wide", "#ffb37b62", ids, "", profile);
+    }
+
+    private static JsonObject change(
+            final JsonObject profile,
+            final List<BedrockCharacterProfiles.WardrobeItem> category,
+            final BedrockCharacterProfiles.WardrobeItem item,
+            final BedrockLimbSide side,
+            final boolean remove)
+            throws Exception {
+        final var settings = profile.deepCopy();
+        final var wardrobe =
+                new BedrockCharacterProfiles.AccountWardrobe(
+                        List.of(slot(profile)), 1, 1, settings);
+        return BedrockCharacterProfiles.limbChangeRequest(wardrobe, 1, category, item, side, remove)
+                .getAsJsonArray("appearanceObjects")
+                .get(1)
+                .getAsJsonObject()
+                .getAsJsonObject("personaAppearance");
+    }
+
+    private static JsonObject piece(
+            final JsonObject profile,
+            final BedrockCharacterProfiles.WardrobeItem item,
+            final BedrockLimbSide side) {
+        return entries(profile).asList().stream()
+                .map(e -> e.getAsJsonObject())
+                .filter(e -> item.matches(id(e)) && BedrockLimbSide.fromRecipe(id(e)) == side)
+                .findFirst()
+                .orElseThrow();
+    }
+
+    private static JsonArray entries(final JsonObject profile) {
+        return profile.getAsJsonObject("personaCollection").getAsJsonArray("universalApp");
+    }
+
+    private static String id(final JsonObject entry) {
+        return entry.has("id") ? entry.get("id").getAsString() : "";
+    }
+}
