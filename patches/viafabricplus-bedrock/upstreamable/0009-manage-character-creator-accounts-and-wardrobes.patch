+    private void acquireItem(final BedrockAuthManager account, final Category category, final WardrobeItem item) {
+        if (this.saving || this.loading || ViaFabricPlusBedrock.impl().account().get() != account) return;
+        this.saving = true;
+        this.acquiring = true;
+        this.acquisitionFailed = false;
+        this.editFailed = false;
+        this.updateControls();
+        BedrockMarketplaceTransactions.acquire(account, category, item).whenComplete((loaded, error) ->
+            this.minecraft.execute(() -> {
+                this.saving = false;
+                this.acquiring = false;
+                this.wallet.refresh();
+                if (ViaFabricPlusBedrock.impl().account().get() != account) return;
+                if (error != null) {
+                    this.acquisitionFailed = true;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not acquire Bedrock wardrobe item", error);
+                } else if (this.category == category) {
+                    this.items = loaded;
+                    this.loadedCategory = category;
+                    for (int index = 0; index < loaded.size(); index++) {
+                        if (loaded.get(index).id().equals(item.id())) {
+                            this.selectedItem = index;
+                            this.itemPage = index / this.pageSize();
+                            break;
+                        }
+                    }
+                }
+                if (this.minecraft.gui.screen() == this) this.updateControls();
+            }));
+    }
+
+    private void applyColor() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.wardrobe == null || this.saving || this.selectedColor < 0
+            || !this.availableColors.contains(this.colorTarget)) {
+            return;
+        }
+        final Slot slot = this.wardrobe.slots().get(this.selectedSlot);
+        this.saving = true;
+        this.editFailed = false;
+        this.acquisitionFailed = false;
+        this.updateControls();
+        BedrockCharacterProfiles.changeColor(account, slot.number(), slot.profileHash(), this.colorTarget,
+            this.palette().get(this.selectedColor), this.colorTarget == ColorTarget.SKIN ? List.of() : this.items)
+            .whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+                if (this.minecraft.gui.screen() != this) {
+                    return;
+                }
+                this.saving = false;
+                if (error != null) {
+                    this.editFailed = true;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not change Bedrock character color", error);
+                } else {
+                    this.wardrobe = loaded;
+                    if (loaded.activeSlot() == slot.number()) {
+                        this.loadAvatar(account);
+                        if (this.characterSelected) {
+                            this.refreshCharacter(account);
+                            return;
+                        }
+                    }
+                }
+                this.updateControls();
+            }));
+    }
+
+    private void selectSlot() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.wardrobe == null || this.saving) {
+            return;
+        }
+        final int slotNumber = this.selectedSlot + 1;
+        this.saving = true;
+        this.selectionFailed = false;
+        this.updateControls();
+        BedrockCharacterProfiles.selectSlot(account, slotNumber).whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+            if (this.minecraft.gui.screen() != this) {
+                return;
+            }
+            if (error != null) {
