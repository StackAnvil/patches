diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockBuiltinAssetsTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockBuiltinAssetsTest.java
new file mode 100644
index 0000000..52822d0
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockBuiltinAssetsTest.java
@@ -0,0 +1,112 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.Map;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockBuiltinAssetsTest {
+    @Test
+    void sharesBundledLibrariesWithoutAnAccountOrWritableCache() throws Exception {
+        final var assets = BedrockBuiltinAssets.load();
+        assertSame(assets, BedrockBuiltinAssets.load());
+        assertTrue(assets.library().packNames().size() >= 57);
+        assertNotNull(assets.model("geometry.humanoid"));
+        for (final String id : new String[] {
+                "4c8ae710-df2e-47cd-814d-cc7bf21a3d67", "9a469a61-c83b-4ba9-b507-bdbe64430582",
+                "ce5c0300-7f03-455d-aaf1-352e4927b54d", "17428c4c-3813-4ea1-b3a9-d6a32f83afca"}) {
+            final var animation = BedrockEmotes.read(assets.piece(id)).animation();
+            assertTrue(animation.length() > 0);
+            assertFalse(animation.playback().sample(0.1F, Map.of()).isEmpty());
+        }
+    }
+
+    @Test
+    void validatesArchiveBytesAndPreservesResourceContent() throws Exception {
+        final byte[] bytes = zip("library/vanilla/pixels", new byte[] {1, 2, 3});
+        final var manifest = manifest(bytes, 3);
+        final var files = BedrockBuiltinAssets.readFiles(manifest, "1.26.51", name -> new ByteArrayInputStream(bytes));
+        assertEquals(1, files.size());
+        assertArrayEquals(new byte[] {1, 2, 3}, files.values().iterator().next());
+        bytes[bytes.length - 1] ^= 1;
+        assertThrows(IOException.class, () -> BedrockBuiltinAssets.readFiles(manifest, "1.26.51",
+                name -> new ByteArrayInputStream(bytes)));
+    }
+
+    @Test
+    void rejectsWrongVersionsBeforeReadingArchives() throws Exception {
+        final var manifest = manifest(zip("pixels", new byte[] {1}), 1);
+        assertThrows(IOException.class, () -> BedrockBuiltinAssets.readFiles(manifest, "1.26.60", name -> {
+            throw new AssertionError("A mismatched bundle must not be loaded");
+        }));
+    }
+
+    @Test
+    void rejectsMissingArchivesAndIncorrectExpandedSizes() throws Exception {
+        final byte[] bytes = zip("pixels", new byte[] {1, 2, 3});
+        assertThrows(IOException.class, () -> BedrockBuiltinAssets.readFiles(manifest(bytes, 3), "1.26.51", name -> null));
+        assertThrows(IOException.class, () -> BedrockBuiltinAssets.readFiles(manifest(bytes, 2), "1.26.51",
+                name -> new ByteArrayInputStream(bytes)));
+        assertThrows(IOException.class, () -> BedrockBuiltinAssets.readFiles(manifest(bytes, 4), "1.26.51",
+                name -> new ByteArrayInputStream(bytes)));
+    }
+
+    @Test
+    void rejectsDuplicateResourcesAcrossArchives() throws Exception {
+        final byte[] bytes = zip("pixels", new byte[] {1});
+        final var manifest = manifest(bytes, 1);
+        final var archives = manifest.getAsJsonArray("archives");
+        final var second = archives.get(0).getAsJsonObject().deepCopy();
+        second.addProperty("name", "builtin-02.zip");
+        archives.add(second);
+        manifest.addProperty("files", 2);
+        manifest.addProperty("expandedBytes", 2);
+        assertThrows(IOException.class, () -> BedrockBuiltinAssets.readFiles(manifest, "1.26.51",
+                name -> new ByteArrayInputStream(bytes)));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"../pixels", "/pixels", "textures/../pixels", "textures\\pixels"})
+    void rejectsUnsafeResourcePaths(final String path) throws Exception {
+        final byte[] bytes = zip(path, new byte[] {1});
+        assertThrows(IOException.class, () -> BedrockBuiltinAssets.readFiles(manifest(bytes, 1), "1.26.51",
+                name -> new ByteArrayInputStream(bytes)));
+    }
+
+    private static JsonObject manifest(final byte[] bytes, final int size) {
+        final var manifest = new JsonObject();
+        manifest.addProperty("format", 1);
+        manifest.addProperty("version", "1.26.51.1");
+        manifest.addProperty("protocolVersion", "1.26.51");
+        manifest.addProperty("files", 1);
+        manifest.addProperty("expandedBytes", size);
+        final var archive = new JsonObject();
+        archive.addProperty("name", "builtin-01.zip");
+        archive.addProperty("sha256", BedrockBuiltinAssets.hash(bytes));
+        archive.addProperty("files", 1);
+        archive.addProperty("expandedBytes", size);
+        final var archives = new JsonArray();
+        archives.add(archive);
+        manifest.add("archives", archives);
+        return manifest;
+    }
+
+    private static byte[] zip(final String name, final byte[] contents) throws IOException {
+        final var output = new ByteArrayOutputStream();
+        try (var zip = new ZipOutputStream(output)) {
+            zip.putNextEntry(new ZipEntry(name));
+            zip.write(contents);
+            zip.closeEntry();
+        }
+        return output.toByteArray();
+    }
+}
