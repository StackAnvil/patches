+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_FREE_PERSONA_ASSETS", matches = ".+")
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_OFFICIAL_PERSONA", matches = ".+")
+    void assemblesUnownedFreeHairAndClothingWithAccountReceiptKeys() throws Exception {
+        final Path directory = Path.of(System.getenv("STACKANVIL_FREE_PERSONA_ASSETS"));
+        final var receipt =
