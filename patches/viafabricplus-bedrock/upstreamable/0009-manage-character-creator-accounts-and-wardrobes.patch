+                        .getAsJsonArray("minecraft:geometry");
+        for (final var bone : assembledModels.get(0).getAsJsonObject().getAsJsonArray("bones")) {
+            final JsonObject node = bone.getAsJsonObject();
+            if (node.get("name").getAsString().equals("head")
+                    || node.get("name").getAsString().equals("hat")) assertFalse(node.has("cubes"));
+        }
+        assertEquals(
+                2,
+                assembledModels.get(1).getAsJsonObject().getAsJsonArray("bones").asList().stream()
+                        .filter(element -> element.getAsJsonObject().has("poly_mesh"))
+                        .count());
+        assertTrue(
+                JsonParser.parseString(preview.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry")
+                        .get(0)
+                        .getAsJsonObject()
+                        .getAsJsonArray("bones")
+                        .get(3)
+                        .getAsJsonObject()
+                        .has("cubes"));
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaModelTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaModelTest.java
