@@ -0,0 +1,280 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Map;
+
+final class BedrockPersonaTintTest {
+    @Test
+    void matchesNativeChannelTransferAndWeightedMasks() {
+        final int[] authored = {0xFFCC9966, 0xFF406080, 0xFFF0F0E0, 0xFFFF7040};
+        final int[] selected = {0xFF5A3480, 0xFF362011, 0xFFEFEFEA, 0xFFB37B62};
+        // Numeric reference results from the target build's pixel compositor.
+        final int[][] cases = {
+            {0x00000000, 0xC386664C}, {0x00FF0000, 0xC348284E},
+            {0x0000FF00, 0xC3674021}, {0x000000FF, 0xC3826752},
+            {0xFF000000, 0xC3635E5B}, {0x80406080, 0xC36E5249},
+            {0xFFFFFFFF, 0xC3694B48}, {0x00808000, 0xC3533441}
+        };
+        for (final int[] test : cases)
+            assertEquals(
+                    test[1],
+                    BedrockPersonaTint.blend(0x60402010, 0xA0B09070, test[0], authored, selected));
+        assertEquals(
+                0x60402010,
+                BedrockPersonaTint.blend(0x60402010, 0x00B09070, 0xFFFFFFFF, authored, selected));
+        assertEquals(
+                BedrockPersonaTint.blend(0x60402010, 0xA0B09070, 0, authored, selected),
+                BedrockPersonaTint.blend(0x60402010, 0xA0B09070, 0xFFFFFFFF, authored, new int[4]));
+    }
+
+    @Test
+    void composesTranslucentHairOverTintedSkin() {
+        // Reference output from Bedrock 1.26.51.1's pixel compositor.
+        assertEquals(
+                0xFF98583D,
+                BedrockPersonaTint.blend(
+                        0xFFAF745B,
+                        0x99A03C12,
+                        0x00FF0000,
+                        new int[] {0xFF6D3923, 0, 0, 0},
+                        new int[] {0xFF6D3923, 0, 0, 0xFFB37D62}));
+    }
+
+    @Test
+    void bindsArgbRecipeColorsAndUsesSkinToneForEyelids() throws Exception {
+        final JsonObject metadata = new JsonObject(),
+                authored = new JsonObject(),
+                defaults = new JsonObject();
+        metadata.addProperty("piece_type", "persona_eyes");
+        authored.addProperty("r_color", "#CC9966");
+        authored.addProperty("a_color", "#FF7040");
+        defaults.addProperty("r_color", "#406080");
+        metadata.add("tint_base_color", authored);
+        metadata.add("tint_color", defaults);
+        final var texture =
+                new BedrockPersonaSources.Texture(
+                        new JsonObject(),
+                        metadata,
+                        new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB),
+                        null,
+                        1);
+        final var slot =
+                BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final JsonObject recipe = new JsonObject();
+        final var colors = new JsonArray();
+        for (final String color : new String[] {"#805A3480", "#0", "#EFEFEA", "#0"})
+            colors.add(color);
+        recipe.add("col", colors);
+        final var palette =
+                BedrockPersonaTint.palette(
+                        texture,
+                        slot,
+                        recipe,
+                        (int) Long.parseLong(slot.skinColor().substring(1), 16));
+        assertArrayEquals(new int[] {0xFFCC9966, 0, 0, 0xFFFF7040}, palette.authored());
+        assertArrayEquals(
+                new int[] {
+                    0x805A3480,
+                    0,
+                    0xFFEFEFEA,
+                    (int) Long.parseLong(slot.skinColor().substring(1), 16)
+                },
+                palette.selected());
+        colors.remove(3);
+        assertThrows(
+                IOException.class,
+                () ->
+                        BedrockPersonaTint.palette(
+                                texture,
+                                slot,
+                                recipe,
+                                (int) Long.parseLong(slot.skinColor().substring(1), 16)));
+    }
+
+    @Test
+    void fallsBackToAuthoredTintAndHonorsFixedColors() throws Exception {
+        final var slot =
+                BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final JsonObject metadata = new JsonObject(), recipe = new JsonObject();
+        metadata.addProperty("piece_type", "persona_hair");
+        metadata.addProperty("tint_base_color", "#406080");
+        final var texture = texture(metadata);
+        assertArrayEquals(
+                new int[] {0xFF406080, 0xFF406080, 0xFF406080, 0xFF765432},
+                BedrockPersonaTint.palette(texture, slot, recipe, 0xFF765432).selected());
+        metadata.addProperty("allow_tint_override", false);
+        metadata.addProperty("tint_color", "#807060");
+        recipe.add(
+                "col",
+                JsonParser.parseString(
+                        "[\"#FF102030\",\"#FF203040\",\"#FF304050\",\"#FF405060\"]"));
+        assertArrayEquals(
+                new int[] {0xFF807060, 0xFF807060, 0xFF807060, 0xFF765432},
+                BedrockPersonaTint.palette(texture, slot, recipe, 0xFF765432).selected());
+        metadata.addProperty("allow_tint_override", true);
+        assertArrayEquals(
+                new int[] {0xFF102030, 0xFF203040, 0xFF304050, 0xFF765432},
+                BedrockPersonaTint.palette(texture, slot, recipe, 0xFF765432).selected());
+        metadata.addProperty("allow_tint_override", 1);
+        assertThrows(
+                IOException.class,
+                () -> BedrockPersonaTint.palette(texture, slot, recipe, 0xFF765432));
+    }
+
+    @Test
+    void resolvesFixedSkinAlphaAndBypassesSkinAndCapeTintOverrides() throws Exception {
+        final var slot =
+                BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final String id =
+                slot.pieceIds().stream()
+                        .map(piece -> piece.split("/", 2)[0])
+                        .filter(
+                                piece ->
+                                        "persona_skin"
+                                                .equals(BedrockPersonaProfile.defaultType(piece)))
+                        .findFirst()
+                        .orElseThrow();
+        final JsonObject skin = new JsonObject();
+        skin.addProperty("piece_type", "persona_skin");
+        skin.addProperty("allow_tint_override", false);
+        skin.addProperty("tint_color", "#765432");
+        final var pack =
+                new BedrockMarketplaceAssets.Pack(
+                        id,
+                        Map.of("skin.meta.json", skin.toString().getBytes(StandardCharsets.UTF_8)));
+        assertEquals(0xFF765432, BedrockPersonaTint.skinColor(slot, Map.of(id, pack)));
+        assertArrayEquals(
+                new int[4],
+                BedrockPersonaTint.palette(texture(skin), slot, new JsonObject(), 0xFF765432)
+                        .selected());
+        skin.addProperty("allow_tint_override", true);
+        final int color = (int) Long.parseLong(slot.skinColor().substring(1), 16);
+        assertArrayEquals(
+                new int[] {color, color, color, color},
+                BedrockPersonaTint.palette(texture(skin), slot, new JsonObject(), 0xFF765432)
+                        .selected());
+        skin.addProperty("piece_type", "persona_capes");
+        assertArrayEquals(
+                new int[4],
+                BedrockPersonaTint.palette(texture(skin), slot, new JsonObject(), color)
+                        .selected());
+        assertNull(BedrockPersonaTint.skinColor(slot, Map.of()));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_TINT_SELECTION_RESULT", matches = ".+")
+    void matchesNativePaletteSelectionAcrossOverrideAndSkinDefaults() throws Exception {
+        final JsonObject fixture =
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(System.getenv("STACKANVIL_TINT_SELECTION_RESULT"))))
+                        .getAsJsonObject();
+        final var original =
+                BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final var slot =
+                new BedrockCharacterProfiles.Slot(
+                        original.number(),
+                        original.arm(),
+                        fixture.get("skinColor").getAsString(),
+                        original.pieceIds(),
+                        original.profileHash(),
+                        original.profile());
+        final String skinId =
+                slot.pieceIds().stream()
+                        .map(piece -> piece.split("/", 2)[0])
+                        .filter(
+                                piece ->
+                                        "persona_skin"
+                                                .equals(BedrockPersonaProfile.defaultType(piece)))
+                        .findFirst()
+                        .orElseThrow();
+        int checked = 0;
+        for (final var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final JsonObject skin = new JsonObject(),
+                    metadata = new JsonObject(),
+                    recipe = new JsonObject();
+            skin.addProperty("piece_type", "persona_skin");
+            skin.addProperty("allow_tint_override", row.get("skinAllowsOverride").getAsBoolean());
+            if (row.get("skinHasDefaultTint").getAsBoolean())
+                skin.add("tint_color", channels(fixture.getAsJsonArray("skinTint")));
+            final Map<String, BedrockMarketplaceAssets.Pack> packs =
+                    row.get("skinPresent").getAsBoolean()
+                            ? Map.of(
+                                    skinId,
+                                    new BedrockMarketplaceAssets.Pack(
+                                            skinId,
+                                            Map.of(
+                                                    "skin.meta.json",
+                                                    skin.toString()
+                                                            .getBytes(StandardCharsets.UTF_8))))
+                            : Map.of();
+            final String type =
+                    switch (row.get("pieceType").getAsInt()) {
+                        case 3 -> "persona_skin";
+                        case 7 -> "persona_top";
+                        case 11 -> "persona_facial_hair";
+                        case 12 -> "persona_mouth";
+                        case 13 -> "persona_eyes";
+                        case 14 -> "persona_hair";
+                        case 25 -> "persona_capes";
+                        default -> throw new AssertionError("Unknown native piece type");
+                    };
+            metadata.addProperty("piece_type", type);
+            metadata.addProperty("allow_tint_override", row.get("allowOverride").getAsBoolean());
+            metadata.add("tint_base_color", channels(fixture.getAsJsonArray("authored")));
+            if (row.get("hasDefaultTint").getAsBoolean())
+                metadata.add("tint_color", channels(fixture.getAsJsonArray("defaultTint")));
+            if (row.get("hasRecipe").getAsBoolean())
+                recipe.add("col", fixture.getAsJsonArray("recipe").deepCopy());
+            final var palette =
+                    BedrockPersonaTint.palette(
+                            texture(metadata),
+                            slot,
+                            recipe,
+                            BedrockPersonaTint.skinColor(slot, packs));
+            final int[] expected = new int[4];
+            for (int i = 0; i < 4; i++)
+                expected[i] =
+                        (int)
+                                Long.parseLong(
+                                        row.getAsJsonArray("selected")
+                                                .get(i)
+                                                .getAsString()
+                                                .substring(1),
+                                        16);
+            assertArrayEquals(expected, palette.selected(), row.toString());
+            checked++;
+        }
+        assertEquals(448, checked);
+    }
+
+    private static JsonObject channels(final JsonArray values) {
+        final var result = new JsonObject();
+        final String[] names = {"r_color", "g_color", "b_color", "a_color"};
+        for (int i = 0; i < 4; i++) result.add(names[i], values.get(i).deepCopy());
+        return result;
+    }
+
+    private static BedrockPersonaSources.Texture texture(final JsonObject metadata) {
+        return new BedrockPersonaSources.Texture(
+                new JsonObject(),
+                metadata,
+                new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB),
+                null,
+                1);
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPlayerAnimationsTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPlayerAnimationsTest.java
