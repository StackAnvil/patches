+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import java.io.IOException;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Assumptions;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+final class BedrockPlayerAnimationsTest {
+    private static BedrockActorAnimation animation() throws IOException {
+        return BedrockActorAnimation.read(new JsonObject(), Map.of(), new JsonObject(), new JsonObject(), "1.10.0");
+    }
+
+    @Test
+    void classicSkinGainsNativeBodyAndHandsWhenAssetsFinish() throws IOException {
+        final var pending = new CompletableFuture<BedrockActorAnimation>();
+        final var animations = new BedrockPlayerAnimations(pending);
+        assertNull(animations.firstPerson(null, false));
+        pending.complete(animation());
+        final var hand = animations.firstPerson(null, false);
+        assertNotNull(hand);
+        assertSame(hand, animations.firstPerson(null, false));
+        assertSame(hand, animations.body());
+        assertNotSame(hand, hand.fork());
+    }
+
+    @Test
+    void bundledClassicPlayerGraphProducesVisibleFirstPersonArmsWithoutServerOverrides() {
+        Assumptions.assumeTrue(BedrockPlayerAnimations.class.getResource("/assets/viafabricplus-bedrock/builtin/manifest.json") != null);
+        final var loaded = BedrockClassicAssets.animations(BedrockClassicOptions.EMPTY);
+        loaded.join();
+        final var animations = new BedrockPlayerAnimations(loaded);
+        final var hand = animations.firstPerson(null, false).fork();
+        final var pose = hand.sample(0, new BedrockActorAnimation.Frame(
+                Map.of("is_first_person", true, "get_equipped_item_name",
+                        (BedrockActorAnimation.Query) arguments -> ""), Map.of("is_first_person", 1F), Map.of("is_first_person", 1)), false, null, null);
+        assertNotNull(pose.get("rightarm"), pose.keySet().toString());
+        assertTrue(hand.visibility().specified());
+        assertTrue(hand.visibility().visible("rightArm"));
+        assertFalse(hand.visibility().visible("body"));
+        final var body = animations.body();
+        final var bodyPose = body.sample(0, new BedrockActorAnimation.Frame(
+                Map.of("is_first_person", false, "is_alive", true, "is_on_ground", true,
+                        "get_equipped_item_name", (BedrockActorAnimation.Query) arguments -> ""),
+                Map.of("is_first_person", 0F, "map_face_icon", 0F, "is_paperdoll", 0F)), false, null, null);
+        assertNotNull(bodyPose.get("rightarm"));
+        assertTrue(body.visibility().visible("body"), body.visibility().toString());
+        assertFalse(hand.visibility().visible("body"));
+        final var preview = body.fork();
+        preview.sample(0, new BedrockActorAnimation.Frame(Map.of("is_alive", true), Map.of("is_paperdoll", 1F)), false, null, null);
+        assertTrue(body.visibility().visible("body"), body.visibility().toString());
+    }
+
+    @Test
+    void javaHandOverridesCustomAndServerHandsWithoutDisablingBodyAnimations() throws IOException {
+        final var animations = new BedrockPlayerAnimations(CompletableFuture.completedFuture(animation()));
+        final var body = animations.body();
+        final var server = animation().playback();
+        assertNull(animations.firstPerson(body, true));
+        assertNull(animations.firstPerson(server, true));
+        assertSame(body, animations.body());
+        assertSame(server, animations.firstPerson(server, false));
+        assertSame(body, animations.firstPerson(null, false));
+    }
+
+    @Test
+    void serverHandsRemainAvailableWhileBundledAssetsArePendingOrFailed() throws IOException {
+        final var pending = new CompletableFuture<BedrockActorAnimation>();
+        final var animations = new BedrockPlayerAnimations(pending);
+        final var server = animation().playback();
+        assertSame(server, animations.firstPerson(server, false));
+        pending.completeExceptionally(new IOException());
+        assertSame(server, animations.firstPerson(server, false));
+        assertNull(animations.firstPerson(null, false));
+        assertNull(animations.firstPerson(server, true));
+    }
+}
