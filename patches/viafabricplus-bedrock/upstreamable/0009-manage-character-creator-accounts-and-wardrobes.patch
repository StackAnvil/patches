+package com.viaversion.viafabricplus.bedrock.screen;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockMarketplaceTransactions;
+import java.net.URI;
+import java.text.NumberFormat;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.TimeUnit;
+import net.minecraft.ChatFormatting;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.components.Tooltip;
+import net.minecraft.client.gui.screens.ConfirmLinkScreen;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.network.chat.Component;
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+/** Account wallet shared by the Dressing Room screens. Only its balance waits for the network. */
+final class BedrockMinecoinWallet {
+    private static final URI SHOP = URI.create("https://www.minecraft.net/en-us/marketplace/buy-minecoins");
+    private static final long REFRESH_INTERVAL = TimeUnit.SECONDS.toNanos(30);
+    private final Screen screen;
+    private final Button balance;
+    private final Button buy;
+    private final boolean compact;
+    private Component description = Component.empty();
+    private boolean hasBalance;
+    private BedrockAuthManager account;
+    private int request;
+    private boolean pending;
+    private boolean refreshAgain;
+    private boolean windowActive;
+    private long nextRefresh;
+
+    BedrockMinecoinWallet(final Screen screen) {
+        this.screen = screen;
+        final int width = Math.min(120, Math.max(24, (screen.width - 140) / 2 - 38));
+        this.compact = width < 90;
+        this.balance = Button.builder(Component.empty(), _ -> this.refresh())
+                .bounds(screen.width - width - 30, 4, width, 20)
+                .createNarration(_ -> this.description.copy()).build();
+        final Component buyTitle = Component.translatable("bedrock_marketplace.viafabricplus.buy_minecoins");
+        this.buy = Button.builder(Component.literal("+"), ConfirmLinkScreen.confirmLink(screen, SHOP))
+                .bounds(screen.width - 26, 4, 20, 20)
+                .tooltip(Tooltip.create(buyTitle))
+                .createNarration(_ -> Component.translatable("bedrock_marketplace.viafabricplus.buy_minecoins"))
+                .build();
+        this.windowActive = Minecraft.getInstance().isWindowActive();
+        this.refresh();
+    }
+
+    List<Button> buttons() {
+        return List.of(this.balance, this.buy);
+    }
+
+    void tick() {
+        final boolean active = Minecraft.getInstance().isWindowActive();
+        if (this.account != ViaFabricPlusBedrock.impl().account().get()
+                || active && (!this.windowActive || System.nanoTime() >= this.nextRefresh)) this.refresh();
+        this.windowActive = active;
+    }
+
+    void refresh() {
+        final BedrockAuthManager selected = ViaFabricPlusBedrock.impl().account().get();
+        if (this.account != selected) {
+            this.request++;
+            this.account = selected;
+            this.pending = false;
+            this.refreshAgain = false;
+            this.hasBalance = false;
+        }
+        this.nextRefresh = System.nanoTime() + REFRESH_INTERVAL;
+        this.buy.active = selected != null;
+        this.balance.active = selected != null;
+        if (selected == null) {
+            this.showBalance(Component.translatable("bedrock_marketplace.viafabricplus.wallet_sign_in"),
+                    Component.translatable("bedrock_marketplace.viafabricplus.wallet_sign_in_short"));
+            return;
+        }
+        if (this.pending) {
+            this.refreshAgain = true;
+            return;
+        }
+        this.pending = true;
+        final int request = ++this.request;
+        if (!this.hasBalance) this.showBalance(
+                Component.translatable("bedrock_marketplace.viafabricplus.wallet_loading"), Component.literal("..."));
+        BedrockMarketplaceTransactions.minecoins(selected).whenComplete((amount, error) ->
+                Minecraft.getInstance().execute(() -> {
+                    if (request != this.request || ViaFabricPlusBedrock.impl().account().get() != selected) return;
+                    this.pending = false;
+                    final Component label;
+                    final Component shortLabel;
+                    this.hasBalance = error == null;
+                    if (error == null) {
+                        final String count = NumberFormat.getIntegerInstance(Locale.ROOT).format(amount);
+                        shortLabel = Component.literal(count).withStyle(ChatFormatting.GOLD);
+                        label = Component.translatable("bedrock_marketplace.viafabricplus.wallet_balance",
+                                count).withStyle(ChatFormatting.GOLD);
+                    } else {
+                        label = Component.translatable("bedrock_marketplace.viafabricplus.wallet_failed");
+                        shortLabel = Component.literal("?");
+                        ViaFabricPlusBedrock.impl().logger().warn("Could not load the Minecoin balance", error);
+                    }
+                    this.showBalance(label, shortLabel);
+                    if (this.refreshAgain) {
+                        this.refreshAgain = false;
+                        this.refresh();
+                    }
+                }));
+    }
+    private void showBalance(final Component label, final Component shortLabel) {
+        this.description = label;
+        this.balance.setMessage(this.compact ? shortLabel : label);
+        this.balance.setTooltip(Tooltip.create(label.copy().append("\n").append(
+                Component.translatable("bedrock_marketplace.viafabricplus.wallet_refresh"))));
+    }
+}
