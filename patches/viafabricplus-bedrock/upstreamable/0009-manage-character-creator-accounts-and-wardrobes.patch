+                    }
+                    this.saving = false;
+                }
+                this.updateControls();
+            }));
+    }
+
+    private void deleteSelectedSlot() {
+        if (this.wardrobe != null && !this.wardrobe.slots().get(this.selectedSlot).occupied()) {
+            this.createCharacter(true, null);
+            return;
+        }
+        if (!this.confirmDelete) {
+            this.confirmDelete = true;
+            this.updateControls();
+            return;
+        }
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.wardrobe == null || this.saving) {
+            return;
