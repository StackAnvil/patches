+    void acceptsOnlyTrustedCapeReferencesAndUsesTheNativeBasename() throws IOException {
+        for (final String root : List.of("", "wrapped/")) {
+            for (final String reference : List.of("cape.png", "textures/cape.png", "textures\\cape.png", "../cape.png")) {
