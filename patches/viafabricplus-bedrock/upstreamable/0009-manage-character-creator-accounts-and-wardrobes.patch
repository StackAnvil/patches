+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+final class BedrockPersonaAnimationAtlasTest {
+    @Test
+    void rejectsUnsupportedSourceFramesAndOversizedCombinedStrips() throws Exception {
+        assertThrows(
+                IOException.class,
+                () -> BedrockPersonaAnimationAtlas.validate(image(32, 3), 3, 32));
+        assertThrows(
+                IOException.class,
+                () -> BedrockPersonaAnimationAtlas.validate(image(64, 2), 2, 32));
+        final var atlas = new BedrockPersonaAnimationAtlas(128);
+        atlas.add("first", image(128, 256), 256);
+        assertThrows(IOException.class, () -> atlas.add("second", image(128, 2), 2));
+        final var wide = new BedrockPersonaAnimationAtlas(32);
+        for (int tile = 0; tile < 32; tile++) wide.add(Integer.toString(tile), image(32, 1), 1);
+        assertThrows(IOException.class, () -> wide.add("overflow", image(32, 1), 1));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ANIMATION_PACKING_RESULT", matches = ".+")
+    void matchesNativePackingDimensionsAndRepeatedColumnPositions() throws Exception {
+        final var rows =
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(
+                                                System.getenv(
+                                                        "STACKANVIL_ANIMATION_PACKING_RESULT"))))
+                        .getAsJsonArray();
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            if (!row.get("accepted").getAsBoolean()) continue;
+            final int size = row.get("type").getAsInt() == 3 ? 128 : 32;
+            final var atlas = new BedrockPersonaAnimationAtlas(size);
+            final var columns = row.getAsJsonArray("columns");
+            for (int column = 0; column < columns.size(); column++) {
+                int frames = 1;
+                for (final var source : columns.get(column).getAsJsonArray())
+                    frames = Math.max(frames, source.getAsJsonArray().get(1).getAsInt());
+                final var image = image(size, frames);
+                for (int frame = 0; frame < frames; frame++)
+                    image.setRGB(0, frame * size, 0xFF000001 + frame);
+                atlas.add(Integer.toString(column), image, frames);
+            }
+            assertEquals(row.get("width").getAsInt(), atlas.width());
+            assertEquals(row.get("height").getAsInt(), atlas.image().getHeight());
+            assertEquals(row.get("frames").getAsInt(), atlas.frames());
+            for (int column = 0; column < columns.size(); column++) {
+                final int count =
+                        columns.get(column).getAsJsonArray().asList().stream()
+                                .mapToInt(source -> source.getAsJsonArray().get(1).getAsInt())
+                                .max()
+                                .orElseThrow();
+                for (int frame = 0; frame < atlas.frames(); frame++)
+                    assertEquals(
+                            0xFF000001 + frame % count,
+                            atlas.image().getRGB(column * size, frame * size));
+            }
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ANIMATION_VALIDATION_RESULT", matches = ".+")
+    void matchesNativeSourceDimensionAndFrameValidation() throws Exception {
+        final var rows =
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(
+                                                System.getenv(
+                                                        "STACKANVIL_ANIMATION_VALIDATION_RESULT"))))
+                        .getAsJsonArray();
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            final var image =
+                    new BufferedImage(
+                            row.get("width").getAsInt(),
+                            row.get("height").getAsInt(),
+                            BufferedImage.TYPE_INT_ARGB);
+            final int size = row.get("type").getAsInt() == 3 ? 128 : 32;
+            if (row.get("accepted").getAsBoolean())
+                assertDoesNotThrow(
+                        () ->
+                                BedrockPersonaAnimationAtlas.validate(
+                                        image, row.get("frames").getAsInt(), size));
+            else
+                assertThrows(
+                        IOException.class,
+                        () ->
+                                BedrockPersonaAnimationAtlas.validate(
+                                        image, row.get("frames").getAsInt(), size));
+        }
+    }
+
+    private static BufferedImage image(final int size, final int frames) {
+        return new BufferedImage(size, size * frames, BufferedImage.TYPE_INT_ARGB);
+    }
+}
