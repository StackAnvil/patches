@@ -0,0 +1,181 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Base64;
+import java.util.List;
+import java.util.UUID;
+
+final class BedrockOwnedSkinPacksTest {
+    @TempDir Path directory;
+
+    @Test
+    void keepsOnlyOwnedSkinPacksAndDeduplicatesRepeatedProducts() throws Exception {
+        final String product = UUID.randomUUID().toString(), pack = UUID.randomUUID().toString();
+        final JsonObject owned = item(product, pack, "Purchased", "skinpack");
+        final var rows = new com.google.gson.JsonArray();
+        rows.add(owned);
+        rows.add(owned.deepCopy());
+        rows.add(
+                item(
+                        UUID.randomUUID().toString(),
+                        UUID.randomUUID().toString(),
+                        "NotOwned",
+                        "skinpack"));
+        rows.add(
+                item(
+                        UUID.randomUUID().toString(),
+                        UUID.randomUUID().toString(),
+                        "Owned",
+                        "persona_piece"));
+        rows.add(
+                item(
+                        UUID.randomUUID().toString(),
+                        UUID.randomUUID().toString(),
+                        "Owned",
+                        "world_template"));
+        final var page = JsonParser.parseString("{\"result\":{\"layout\":[]}}").getAsJsonObject();
+        page.getAsJsonObject("result").getAsJsonArray("layout").add(rows);
+        final var selected = BedrockOwnedSkinPacks.parse(page);
+        assertEquals(
+                List.of(new BedrockOwnedSkinPacks.Item(product, pack, "1.0.0", "Pack", "Creator")),
+                selected);
+        owned.addProperty("id", "not-a-uuid");
+        assertThrows(IOException.class, () -> BedrockOwnedSkinPacks.parse(page));
+        assertThrows(IOException.class, () -> BedrockOwnedSkinPacks.parse(new JsonObject()));
+    }
+
+    @Test
+    void rejectsChangedProductsPackIdentitiesAndVersionsBeforeDownloading() throws Exception {
+        final String product = UUID.randomUUID().toString(), pack = UUID.randomUUID().toString();
+        final var selected =
+                new BedrockOwnedSkinPacks.Item(product, pack, "1.0.0", "Pack", "Creator");
+        final var published = new JsonObject();
+        published.addProperty("Id", product);
+        final var properties = new JsonObject();
+        properties.add(
+                "packIdentity", item(product, pack, "Owned", "skinpack").get("packIdentity"));
+        published.add("DisplayProperties", properties);
+        assertDoesNotThrow(() -> BedrockOwnedSkinPacks.validatePublished(selected, published));
+        final var identity = properties.getAsJsonArray("packIdentity").get(0).getAsJsonObject();
+        for (final String field : List.of("uuid", "version", "type")) {
+            final var original = identity.get(field);
+            identity.addProperty(field, "changed");
+            assertThrows(
+                    IOException.class,
+                    () -> BedrockOwnedSkinPacks.validatePublished(selected, published));
+            identity.add(field, original);
+        }
+        published.addProperty("Id", UUID.randomUUID().toString());
+        assertThrows(
+                IOException.class,
+                () -> BedrockOwnedSkinPacks.validatePublished(selected, published));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_CLASSIC_MARKETPLACE", matches = ".+")
+    void decryptsNativeOwnedDownloadsAndPreservesModelsThroughSelectionAndTransport()
+            throws Exception {
+        final Path fixture = Path.of(System.getenv("STACKANVIL_CLASSIC_MARKETPLACE"));
+        final var inventory = json(fixture.resolve("live-inventory.json"));
+        final var receipt =
+                JsonParser.parseString(
+                                new String(
+                                        Base64.getDecoder()
+                                                .decode(
+                                                        inventory
+                                                                .getAsJsonObject("result")
+                                                                .get("receipt")
+                                                                .getAsString()),
+                                        java.nio.charset.StandardCharsets.UTF_8))
+                        .getAsJsonObject();
+        final var keys = BedrockMarketplaceAssets.receiptKeys(receipt);
+        final var items =
+                BedrockOwnedSkinPacks.parse(json(fixture.resolve("live-classic-page.json")));
+        assertFalse(items.isEmpty());
+        final var store =
+                new BedrockAppearanceStore(
+                        this.directory,
+                        _ -> new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB));
+        int checked = 0;
+        for (final var item : items) {
+            final Path archive = fixture.resolve(item.packId() + ".zip");
+            if (!Files.exists(archive)) continue;
+            final var published =
+                    json(fixture.resolve("product-" + item.productId() + ".json"))
+                            .getAsJsonObject("data")
+                            .getAsJsonObject("Item");
+            BedrockOwnedSkinPacks.validatePublished(item, published);
+            final var decoded =
+                    BedrockMarketplaceAssets.decode(
+                            Files.readAllBytes(archive),
+                            item.packId(),
+                            List.of(keys.get(item.packId())));
+            final var pack = BedrockClassicSkinPack.read(item.name(), decoded.files(), _ -> null);
+            for (final var skin : pack.skins()) {
+                assertNotNull(skin.model());
+                final var image = pack.image(skin);
+                store.importSkinImage("fixture", image, skin.slim(), skin.model(), skin.options());
+                final var saved = store.load("fixture");
+                assertEquals(skin.model().geometry(), saved.classicModel().geometry());
+                final var expected =
+                        BedrockAppearanceStore.readTexture(decoded.files().get(skin.texture()));
+                assertEquals(expected.getWidth(), saved.skin().getWidth());
+                assertEquals(expected.getHeight(), saved.skin().getHeight());
+                assertArrayEquals(
+                        expected.getRGB(
+                                0,
+                                0,
+                                expected.getWidth(),
+                                expected.getHeight(),
+                                null,
+                                0,
+                                expected.getWidth()),
+                        saved.skin()
+                                .getRGB(
+                                        0,
+                                        0,
+                                        expected.getWidth(),
+                                        expected.getHeight(),
+                                        null,
+                                        0,
+                                        expected.getWidth()));
+                assertEquals(skin.model().geometry(), saved.skinData("").geometryData());
+                checked++;
+            }
+        }
+        assertEquals(2, checked);
+    }
+
+    private static JsonObject json(final Path path) throws IOException {
+        return JsonParser.parseString(Files.readString(path)).getAsJsonObject();
+    }
+
+    private static JsonObject item(
+            final String product, final String pack, final String ownership, final String type) {
+        final var result = new JsonObject();
+        result.addProperty("id", product);
+        result.addProperty("title", "Pack");
+        result.addProperty("creatorName", "Creator");
+        result.addProperty("ownership", ownership);
+        final var identity = new JsonObject();
+        identity.addProperty("type", type);
+        identity.addProperty("uuid", pack);
+        identity.addProperty("version", "1.0.0");
+        final var identities = new com.google.gson.JsonArray();
+        identities.add(identity);
+        result.add("packIdentity", identities);
+        return result;
+    }
+}
