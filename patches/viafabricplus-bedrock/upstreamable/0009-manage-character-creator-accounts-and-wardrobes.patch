+    private static JsonObject personaEditRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                                 final JsonObject edited) throws IOException {
+        final JsonArray entries = array(object(edited, "personaCollection"), "universalApp");
+        if (entries.isEmpty() || !entries.get(0).isJsonObject()) throw new IOException("This character has no base entry");
+        entries.get(0).getAsJsonObject().addProperty("skin", false);
+        return editRequest(wardrobe, slotNumber, edited);
+    }
+
+    private static JsonObject emptyEmote() {
+        final JsonObject entry = new JsonObject();
+        entry.addProperty("id", "/e");
+        return entry;
+    }
+
+    static JsonObject colorChangeRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                         final ColorTarget target, final String color,
+                                         final List<WardrobeItem> categoryItems) throws IOException {
+        final List<String> palette = target.palette();
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size() || !palette.contains(color)) {
+            throw new IOException("Invalid character color");
+        }
+        if (!wardrobe.slots().get(slotNumber - 1).occupied()) {
+            throw new IOException("Create a character before editing its colors");
+        }
+        final JsonObject edited = wardrobe.slots().get(slotNumber - 1).profile().deepCopy();
+        final JsonArray entries = array(object(edited, "personaCollection"), "universalApp");
+        if (entries.isEmpty() || !entries.get(0).isJsonObject()) {
+            throw new IOException("This character has no base appearance");
+        }
+        if (target == ColorTarget.SKIN) {
+            final JsonObject base = entries.get(0).getAsJsonObject();
+            if (!base.has("skcol")) {
+                throw new IOException("This character has no skin color");
+            }
+            base.addProperty("skcol", color);
+        } else {
+            final String type = target.pieceType;
+            if (categoryItems.isEmpty() || categoryItems.stream().anyMatch(item -> !type.equals(item.type()))) {
+                throw new IOException("Character color needs the matching piece category");
+            }
+            final int index = matchingPieceIndex(entries, categoryItems);
+            if (index < 0) {
+                throw new IOException("This character has no matching piece to tint");
+            }
+            final JsonObject piece = entries.get(index).getAsJsonObject();
+            final JsonArray colors;
+            if (piece.has("col")) {
+                colors = array(piece, "col");
+            } else {
+                // Native tint insertion starts with four transparent channels.
+                colors = new JsonArray(4);
+                for (int channel = 0; channel < 4; channel++) colors.add("#0");
+                piece.add("col", colors);
+            }
+            if (colors.size() != 4) {
+                throw new IOException("This character piece has no native color channels");
+            }
+            colors.set(target.channel(), new JsonPrimitive(color));
+        }
+        return personaEditRequest(wardrobe, slotNumber, edited);
+    }
+
+    private static JsonObject editRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                          final JsonObject edited) throws IOException {
+        return editRequest(slotNumber, wardrobe.settingsProfile(), edited);
+    }
+
+    private static JsonObject editRequest(final int slotNumber, final JsonObject settings,
+                                          final JsonObject edited) throws IOException {
+        final JsonArray objects = new JsonArray();
+        objects.add(appearanceObject("personaProfile", settings));
+        objects.add(appearanceObject("personaProfile" + slotNumber, edited));
+        final JsonObject request = new JsonObject();
+        request.add("appearanceObjects", objects);
+        return request;
+    }
+
+    private static int matchingPieceIndex(final JsonArray entries, final List<WardrobeItem> categoryItems) {
+        for (int index = 0; index < entries.size(); index++) {
+            if (!entries.get(index).isJsonObject()) {
+                continue;
+            }
+            final String id = string(entries.get(index).getAsJsonObject(), "id");
+            if (categoryItems.stream().anyMatch(item -> item.matches(id))) {
+                return index;
+            }
+        }
+        return -1;
+    }
+
+    private static JsonObject appearanceObject(final String name, final JsonObject profile) throws IOException {
+        if (!profile.has("version") || !profile.has("personaCollection")) {
+            throw new IOException("Bedrock character profile is incomplete");
+        }
+        final JsonObject appearance = new JsonObject();
+        appearance.add("version", profile.get("version").deepCopy());
+        appearance.add("personaCollection", profile.get("personaCollection").deepCopy());
+        final JsonObject object = new JsonObject();
+        object.addProperty("profileName", name);
+        object.add("personaAppearance", appearance);
+        return object;
+    }
