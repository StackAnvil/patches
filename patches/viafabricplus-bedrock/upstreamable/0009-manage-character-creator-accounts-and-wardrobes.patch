+    static Map<String, JsonObject> bones(final BedrockPersonaModel.Converted model) {
+        final Map<String, JsonObject> result = new LinkedHashMap<>();
+        for (final var bone :
+                JsonParser.parseString(model.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry")
+                        .get(0)
+                        .getAsJsonObject()
+                        .getAsJsonArray("bones")) {
+            final var node = bone.getAsJsonObject();
+            result.put(node.get("name").getAsString(), node);
+        }
+        return result;
+    }
