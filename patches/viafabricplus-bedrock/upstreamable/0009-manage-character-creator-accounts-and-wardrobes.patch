--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaCape.java
@@ -0,0 +1,227 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+
+import org.cube.converter.util.element.Direction;
+import org.cube.converter.util.element.Position3V;
+import org.cube.converter.util.element.UVMap;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/** Binds an entitled cape texture to the licensed cape model and the equipped body pivot. */
+record BedrockPersonaCape(
+        String packId,
+        BedrockPersonaSources.Texture texture,
+        JsonObject recipe,
+        BedrockCharacterProfiles.Slot slot) {
+    static List<BedrockPersonaAssets.Reference> references(
+            final BedrockCharacterProfiles.Slot slot,
+            final List<BedrockCharacterProfiles.WardrobeItem> catalog)
+            throws IOException {
+        final List<BedrockPersonaAssets.Reference> references = new ArrayList<>();
+        for (final String id : slot.pieceIds()) {
+            final var matches =
+                    catalog.stream()
+                            .filter(item -> "persona_capes".equals(item.type()) && item.matches(id))
+                            .toList();
+            if (matches.size() > 1)
+                throw new IOException("The equipped cape catalog entry is ambiguous");
+            if (!matches.isEmpty()) {
+                final var item = matches.getFirst();
+                references.add(BedrockPersonaAssets.Reference.from(item));
+            }
+        }
+        if (references.size() > 1)
+            throw new IOException("The character has more than one equipped cape");
+        return List.copyOf(references);
+    }
+
+    static BedrockPersonaCape read(
+            final BedrockCharacterProfiles.Slot slot,
+            final Map<String, BedrockMarketplaceAssets.Pack> packs)
+            throws IOException {
+        BedrockPersonaCape cape = null;
+        for (final var pack : packs.values()) {
+            if (BedrockPersonaSources.metadata(pack).stream()
+                    .noneMatch(
+                            metadata ->
+                                    "persona_capes"
+                                            .equals(metadata.get("piece_type").getAsString())))
+                continue;
+            final var textures =
+                    BedrockPersonaSources.read(
+                                    pack, source -> BedrockPersonaProfile.matches(source, slot))
+                            .stream()
+                            .filter(
+                                    texture ->
+                                            "persona_capes"
+                                                    .equals(
+                                                            texture.metadata()
+                                                                    .get("piece_type")
+                                                                    .getAsString()))
+                            .toList();
+            if (textures.isEmpty()) continue;
+            final var recipes = BedrockPersonaProfile.recipes(pack, slot);
+            if (cape != null || recipes.size() != 1 || textures.size() != 1)
+                throw new IOException("The equipped cape assets are ambiguous");
+            cape = new BedrockPersonaCape(pack.id(), textures.getFirst(), recipes.getFirst(), slot);
+        }
+        return cape;
+    }
+
+    BufferedImage image() throws IOException {
+        return BedrockPersonaTint.apply(
+                texture, BedrockPersonaTint.palette(texture, slot, recipe, 0));
+    }
+
+    void bind(
+            final Map<String, JsonObject> equipped,
+            final JsonObject library,
+            final int x,
+            final int y,
+            final int atlasSize)
+            throws IOException {
+        if (library == null) throw new IOException("The licensed game package has no cape model");
+        if (texture.frames() != 1)
+            throw new IOException("The cape needs animated texture assembly");
+        final var normalized = BedrockClassicModel.read("{}", "geometry.cape", name -> library);
+        final JsonObject model =
+                JsonParser.parseString(normalized.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry")
+                        .get(0)
+                        .getAsJsonObject();
+        final Map<String, JsonObject> source = new LinkedHashMap<>();
+        for (final var element : model.getAsJsonArray("bones")) {
+            final JsonObject bone = BedrockPersonaGeometry.canonical(element.getAsJsonObject());
+            source.put(bone.get("name").getAsString(), bone);
+        }
+        final JsonObject authoredBody = source.get("body"), body = equipped.get("body");
+        if (authoredBody == null || body == null || !source.containsKey("cape"))
+            throw new IOException("The cape model has no body attachment");
+        final float[] offset = new float[3];
+        for (int axis = 0; axis < 3; axis++)
+            offset[axis] = pivot(body, axis) - pivot(authoredBody, axis);
+        final JsonObject description = model.getAsJsonObject("description");
+        final float scaleU =
+                (float) texture.image().getWidth() / description.get("texture_width").getAsInt();
+        final float scaleV =
+                (float) texture.image().getHeight() / description.get("texture_height").getAsInt();
+        for (final var bone : source.values()) {
+            String ancestor = bone.get("name").getAsString();
+            while (!ancestor.equals("cape") && source.containsKey(ancestor)) {
+                final var parent = source.get(ancestor).get("parent");
+                ancestor = parent == null ? "" : parent.getAsString();
+            }
+            if (!ancestor.equals("cape")) continue;
+            final String name = bone.get("name").getAsString();
+            if (equipped.containsKey(name))
+                throw new IOException("The cape conflicts with an equipped bone");
+            if (!bone.has("parent") || !equipped.containsKey(bone.get("parent").getAsString()))
+                throw new IOException("The cape has an unavailable parent bone");
+            translate(bone.getAsJsonArray("pivot"), offset);
+            if (bone.has("locators"))
+                for (final var locator : bone.getAsJsonObject("locators").entrySet()) {
+                    final var value = locator.getValue();
+                    translate(
+                            value.isJsonArray()
+                                    ? value.getAsJsonArray()
+                                    : value.getAsJsonObject().getAsJsonArray("offset"),
+                            offset);
+                }
+            if (bone.has("poly_mesh"))
+                for (final var position :
+                        bone.getAsJsonObject("poly_mesh").getAsJsonArray("positions"))
+                    translate(position.getAsJsonArray(), offset);
+            if (bone.has("cubes"))
+                for (final var element : bone.getAsJsonArray("cubes")) {
+                    final var cube = element.getAsJsonObject();
+                    translate(cube.getAsJsonArray("origin"), offset);
+                    translate(cube.getAsJsonArray("pivot"), offset);
+                    scaleCubeUvs(cube, bone, scaleU, scaleV);
+                }
+            BedrockPersonaGeometry.mapUvs(
+                    bone, texture.image().getWidth(), texture.image().getHeight(), x, y, atlasSize);
+            equipped.put(name, bone);
+        }
+    }
+
+    private static float pivot(final JsonObject bone, final int axis) {
+        return bone.has("pivot") ? bone.getAsJsonArray("pivot").get(axis).getAsFloat() : 0;
+    }
+
+    private static void translate(final JsonArray position, final float[] offset)
+            throws IOException {
+        if (position == null) return;
+        if (position.size() != 3) throw new IOException("The cape model has an invalid position");
+        for (int axis = 0; axis < 3; axis++)
+            position.set(axis, new JsonPrimitive(position.get(axis).getAsFloat() + offset[axis]));
+    }
+
+    private static void scaleCubeUvs(
+            final JsonObject cube, final JsonObject bone, final float scaleU, final float scaleV)
+            throws IOException {
+        if (!cube.has("uv")) return;
+        if (cube.get("uv").isJsonArray()) {
+            final JsonArray size = cube.getAsJsonArray("size"), uv = cube.getAsJsonArray("uv");
+            if (size.size() != 3 || uv.size() != 2)
+                throw new IOException("The cape cube has invalid UV coordinates");
+            final boolean mirror =
+                    cube.has("mirror")
+                            ? cube.get("mirror").getAsBoolean()
+                            : bone.has("mirror") && bone.get("mirror").getAsBoolean();
+            final var box =
+                    UVMap.fromBoxUV(
+                            new Position3V(
+                                    size.get(0).getAsFloat(),
+                                    size.get(1).getAsFloat(),
+                                    size.get(2).getAsFloat()),
+                            new Float[] {uv.get(0).getAsFloat(), uv.get(1).getAsFloat()},
+                            mirror);
+            final JsonObject faces = new JsonObject();
+            for (final var direction : Direction.values()) {
+                final Float[] face = box.getUvMap().get(direction);
+                // Native box UVs reverse both axes on the top and only V on the bottom.
+                final boolean flipU = direction == Direction.UP;
+                final boolean flipV = direction == Direction.UP || direction == Direction.DOWN;
+                final float u = flipU ? face[2] : face[0], v = flipV ? face[3] : face[1];
+                final JsonObject mapped = new JsonObject();
+                mapped.add("uv", pair(u, v));
+                mapped.add(
+                        "uv_size",
+                        pair((flipU ? face[0] : face[2]) - u, (flipV ? face[1] : face[3]) - v));
+                faces.add(direction.name().toLowerCase(Locale.ROOT), mapped);
+            }
+            cube.add("uv", faces);
+        }
+        for (final var entry : cube.getAsJsonObject("uv").entrySet())
+            for (final String field : List.of("uv", "uv_size")) {
+                final var value = entry.getValue().getAsJsonObject().getAsJsonArray(field);
+                if (value == null || value.size() != 2)
+                    throw new IOException("The cape cube has invalid face UV coordinates");
+                value.set(0, new JsonPrimitive(value.get(0).getAsFloat() * scaleU));
+                value.set(1, new JsonPrimitive(value.get(1).getAsFloat() * scaleV));
+            }
+    }
+
+    private static JsonArray pair(final float u, final float v) {
+        final JsonArray pair = new JsonArray();
+        pair.add(u);
+        pair.add(v);
+        return pair;
+    }
+}
