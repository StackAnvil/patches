+    public record Slot(int number, String arm, String skinColor, List<String> pieceIds, String profileHash, JsonObject profile) {
+        public boolean occupied() {
+            return !this.pieceIds.isEmpty();
+        }
+
+        public boolean classic() {
+            final JsonArray entries = array(object(this.profile, "personaCollection"), "universalApp");
+            if (entries.isEmpty() || !entries.get(0).isJsonObject()) return false;
+            final JsonElement skin = entries.get(0).getAsJsonObject().get("skin");
+            return skin != null && skin.isJsonPrimitive() && skin.getAsJsonPrimitive().isBoolean() && skin.getAsBoolean();
+        }
+
+        public boolean classicSlim() {
+            final JsonArray entries = array(object(this.profile, "personaCollection"), "universalApp");
+            return !entries.isEmpty() && entries.get(0).isJsonObject()
+                && "slim".equals(string(entries.get(0).getAsJsonObject(), "cs_arm"));
+        }
+    }
