+    private void loadColors() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        final View origin = this.view == View.COLORS ? this.colorOrigin : this.view;
+        final Slot slot = this.wardrobe == null ? null : this.wardrobe.slots().get(this.selectedSlot);
+        final WardrobeItem item = this.items == null || this.items.isEmpty() ? null : this.items.get(this.selectedItem);
+        final List<ColorTarget> targets = origin == View.SLOTS ? List.of(ColorTarget.SKIN)
+            : origin == View.WARDROBE && item != null && slot != null && this.isEquipped(item, slot)
+                ? this.category.colorTargets() : List.of();
+        if (account == null || this.loading || slot == null || !slot.occupied() || targets.isEmpty()) {
+            this.colorContext = null;
+            this.availableColors = List.of();
+            this.colorsLoading = false;
+            this.colorRequest++;
+            return;
+        }
+        final ColorContext context = new ColorContext(account, slot.profileHash(), origin == View.SLOTS ? "" : item.packId(), targets);
+        if (context.equals(this.colorContext)) return;
+        this.colorContext = context;
+        this.availableColors = List.of();
+        this.colorsLoading = true;
+        final long request = ++this.colorRequest;
+        BedrockCharacterProfiles.loadColorTargets(account, slot, targets,
+            origin == View.SLOTS ? List.of() : this.items).whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+                if (request != this.colorRequest) return;
+                this.colorsLoading = false;
+                if (this.minecraft.gui.screen() != this
+                    || ViaFabricPlusBedrock.impl().account().get() != account) {
+                    this.colorContext = null;
+                    return;
+                }
+                if (error != null) {
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock character colors", error);
+                } else {
+                    this.availableColors = loaded;
+                }
+                this.updateControls();
+            }));
+    }
