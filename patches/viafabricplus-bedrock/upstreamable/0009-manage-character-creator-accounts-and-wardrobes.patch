+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockEmotes;
+import com.viaversion.viafabricplus.bedrock.render.BedrockPlayerSkins;
+import com.viaversion.viafabricplus.screen.base.VFPScreen;
+
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.components.PlayerSkinWidget;
+import net.minecraft.network.chat.Component;
+
+import org.jspecify.annotations.NonNull;
+
+import java.io.IOException;
+
+/** Plays a catalog emote on the account's active character without changing its recipe. */
+public final class BedrockEmotePreviewScreen extends VFPScreen {
+    private final BedrockCharacterProfiles.WardrobeItem item;
+    private BedrockPlayerSkins.Preview preview;
+    private BedrockEmotes.Emote emote;
+    private PlayerSkinWidget widget;
+    private Button replay;
+    private Button stop;
+    private boolean requested;
+    private boolean failed;
+    private long generation;
+
+    public BedrockEmotePreviewScreen(final BedrockCharacterProfiles.WardrobeItem item) {
+        super(Component.literal(item.name()), true);
+        this.item = item;
+    }
+
+    @Override
+    protected void init() {
+        super.init();
+        this.widget =
+                this.addRenderableWidget(
+                        new PlayerSkinWidget(
+                                180,
+                                Math.max(60, this.height - 110),
+                                this.minecraft.getEntityModels(),
+                                () -> this.preview == null ? null : this.preview.skin()));
+        this.widget.setX(this.width / 2 - 90);
+        this.widget.setY(55);
+        this.replay =
+                Button.builder(
+                                Component.translatable("bedrock_emote.viafabricplus.replay"),
+                                _ -> this.play())
+                        .build();
+        this.stop =
+                Button.builder(
+                                Component.translatable("bedrock_emote.viafabricplus.stop"),
+                                _ -> {
+                                    if (this.preview != null) this.preview.stop();
+                                })
+                        .build();
+        this.addFooter(this.replay, this.stop);
+        this.updateControls();
+        if (!this.requested) this.load();
+    }
+
+    private void load() {
+        this.requested = true;
+        final long generation = ++this.generation;
+        final var account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null) {
+            this.failed = true;
+            return;
+        }
+        BedrockEmotes.load(account, this.item)
+                .whenComplete(
+                        (emote, error) ->
+                                this.minecraft.execute(
+                                        () -> {
+                                            if (this.generation != generation
+                                                    || this.minecraft.gui.screen() != this) return;
+                                            if (error != null) this.fail(error);
+                                            else this.emote = emote;
+                                            this.play();
+                                        }));
+        BedrockCharacterProfiles.loadActiveModel(account)
+                .whenComplete(
+                        (character, error) ->
+                                this.minecraft.execute(
+                                        () -> {
+                                            if (this.generation != generation
+                                                    || this.minecraft.gui.screen() != this) return;
+                                            try {
+                                                if (error != null) this.fail(error);
+                                                else
+                                                    this.preview =
+                                                            BedrockPlayerSkins.preview(
+                                                                    character.skinData());
+                                            } catch (IOException e) {
+                                                this.fail(e);
+                                            }
+                                            this.play();
+                                        }));
+    }
+
+    private void fail(final Throwable error) {
+        this.failed = true;
+        ViaFabricPlusBedrock.impl()
+                .logger()
+                .warn("Could not prepare the Bedrock emote preview", error);
+    }
+
+    private void play() {
+        if (this.preview != null && this.emote != null) this.preview.play(this.emote.animation());
+        this.updateControls();
+    }
+
+    private void updateControls() {
+        this.widget.visible = this.preview != null;
+        this.replay.active = this.preview != null && this.emote != null;
+        this.stop.active = this.replay.active;
+    }
+
+    @Override
+    public void renderTitle(final GuiGraphicsExtractor graphics) {
+        super.renderTitle(graphics);
+        graphics.centeredText(this.font, this.title, this.width / 2, 32, -1);
+    }
+
+    @Override
+    public void extractRenderState(
+            final @NonNull GuiGraphicsExtractor graphics,
+            final int mouseX,
+            final int mouseY,
+            final float delta) {
+        super.extractRenderState(graphics, mouseX, mouseY, delta);
+        if (this.failed || this.preview == null || this.emote == null) {
+            graphics.centeredText(
+                    this.font,
+                    Component.translatable(
+                            this.failed
+                                    ? "bedrock_emote.viafabricplus.failed"
+                                    : "bedrock_emote.viafabricplus.loading"),
+                    this.width / 2,
+                    this.height - 52,
+                    ACCENT_COLOR);
+        }
+    }
+
+    @Override
+    public void removed() {
+        this.generation++;
+        this.requested = false;
+        this.emote = null;
+        if (this.preview != null) {
+            this.preview.close();
+            this.preview = null;
+        }
+        super.removed();
+    }
+}
