+
+    private void prepareCharacter(final BedrockAuthManager account) {
+        this.saving = true;
+        this.modelFailed = false;
+        this.updateControls();
+        final BedrockAppearanceStore store = ViaFabricPlusBedrock.impl().appearances();
+        final String accountId = BedrockAppearanceStore.accountId(account);
+        BedrockCharacterProfiles.loadActiveModel(account).whenComplete((prepared, error) -> this.minecraft.execute(() -> {
+            if (this.minecraft.gui.screen() != this || !accountId.equals(BedrockAppearanceStore.accountId(
+                    ViaFabricPlusBedrock.impl().account().get()))) {
+                return;
+            }
+            this.saving = false;
+            if (error != null) {
+                this.modelFailed = true;
