+                    this.characterSelected = true;
+                } catch (java.io.IOException e) {
+                    this.modelFailed = true;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not save the account character", e);
+                }
+            }
+            this.updateControls();
+        }));
+    }
+
+    private void refresh() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.loading || this.saving) {
+            return;
+        }
+        this.loading = true;
+        this.purchaseStatus = Component.translatable("bedrock_marketplace.viafabricplus.synchronizing");
