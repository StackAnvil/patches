+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.render;
+
+import com.llamalad7.mixinextras.injector.wrapmethod.WrapMethod;
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.viaversion.viafabricplus.bedrock.render.BedrockPlayerSkins;
+import net.minecraft.client.player.FirstPersonHandsAndItems;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.world.item.component.CustomData;
+import net.raphimc.viabedrock.protocol.rewriter.ItemDataRewriter;
+import net.raphimc.viabedrock.api.model.NativeHandItemState;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.Unique;
+
+@Mixin(FirstPersonHandsAndItems.class)
+public abstract class MixinBedrockHandItemLifecycle {
+    @Shadow private ItemStack mainHandItem;
+    @Shadow private ItemStack offHandItem;
+    @Shadow private float mainHandHeight;
+    @Shadow private float oMainHandHeight;
+    @Shadow private float offHandHeight;
+    @Shadow private float oOffHandHeight;
+
+    @Shadow
+    protected abstract boolean shouldInstantlyReplaceVisibleItem(ItemStack previous, ItemStack current, LocalPlayer player);
+
+    @WrapMethod(method = "tick")
+    private void tickNativeHands(final LocalPlayer player, final Operation<Void> original) {
+        if (!BedrockPlayerSkins.hasNativeFirstPersonAppearance(player)) {
+            original.call(player);
+            return;
+        }
+        final ItemStack main = player.getMainHandItem();
+        final ItemStack off = player.getOffhandItem();
+        final var mainState = NativeHandItemState.advance(this.mainHandHeight, this.classifyJavaReplacement(this.mainHandItem, main, player));
+        final var offState = NativeHandItemState.advance(this.offHandHeight, this.classifyJavaReplacement(this.offHandItem, off, player));
+        this.oMainHandHeight = mainState.previousHeight();
+        this.oOffHandHeight = offState.previousHeight();
+        this.mainHandHeight = mainState.height();
+        this.offHandHeight = offState.height();
+        if (mainState.replaceItem()) {
+            this.mainHandItem = main.copy();
+        }
+        if (offState.replaceItem()) {
+            this.offHandItem = off.copy();
+        }
+    }
+
+    @Unique
+    private NativeHandItemState.Replacement classifyJavaReplacement(final ItemStack previous, final ItemStack current, final LocalPlayer player) {
+        if (ItemStack.matches(previous, current)) {
+            return NativeHandItemState.Replacement.RETAIN;
+        }
+        final ItemStack previousVisual = javaComparisonStack(previous);
+        final ItemStack currentVisual = javaComparisonStack(current);
+        if (ItemStack.matches(previousVisual, currentVisual)) {
+            return NativeHandItemState.Replacement.UPDATE;
+        }
+        return this.shouldInstantlyReplaceVisibleItem(previousVisual, currentVisual, player)
+                ? NativeHandItemState.Replacement.UPDATE : NativeHandItemState.Replacement.ANIMATE;
+    }
+    @Unique
+    private static ItemStack javaComparisonStack(final ItemStack stack) {
+        final var custom = stack.get(DataComponents.CUSTOM_DATA);
+        if (custom == null) {
+            return stack;
+        }
+        final var tag = custom.copyTag();
+        if (!tag.contains(ItemDataRewriter.BEDROCK_STACK_TAG) && !tag.isEmpty()) {
+            return stack;
+        }
+        tag.remove(ItemDataRewriter.BEDROCK_STACK_TAG);
+        final ItemStack visual = stack.copy();
+        if (tag.isEmpty()) {
+            visual.remove(DataComponents.CUSTOM_DATA);
+        } else {
+            visual.set(DataComponents.CUSTOM_DATA, CustomData.of(tag));
+        }
+        return visual;
+    }
+}
