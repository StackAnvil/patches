+
+/** Minecraft-thread emote state. Downloads use native catalog and receipt data. */
+public final class BedrockEmotePlayback {
+    public static final KeyMapping KEY =
+            new KeyMapping(
+                    "key.viafabricplus-bedrock.emote",
+                    InputConstants.KEY_B,
+                    KeyMapping.Category.MULTIPLAYER);
+    private static final Map<UUID, Playing> PLAYING = new HashMap<>();
+    private static final Map<UUID, BedrockCharacterProfiles.WardrobeItem> ITEMS = new HashMap<>();
+    private static final Map<UUID, CompletableFuture<BedrockEmotes.Emote>> ASSETS = new LinkedHashMap<>();
+    private static final Map<UUID, List<UUID>> AVAILABLE = new HashMap<>();
+    private static final Map<UUID, Long> REQUESTS = new HashMap<>();
+    private static final Map<UUID, BedrockEmoteMessages.Repeat> ANNOUNCEMENTS = new HashMap<>();
+    private static final int MUTE_EMOTE_CHAT = 2;
+    private static List<String> names = List.of("", "", "", "");
+    private static List<String> wheel = List.of("", "", "", "");
+    private static BedrockAuthManager account;
+    private static volatile UserConnection connection;
+    private static long generation;
+    private static boolean loading;
+    private static boolean failed;
+    private static volatile boolean localEmoting;
+    private static UUID[] lastAdvertised;
+    private static final java.util.ArrayDeque<Pending> PENDING = new java.util.ArrayDeque<>();
+
+    private BedrockEmotePlayback() {}
+
+    public static void tick() {
+        final Minecraft minecraft = Minecraft.getInstance();
+        final UserConnection current = ViaFabricPlus.api().userConnection();
+        if (current != connection) {
+            BedrockSoundPlayback.stop();
+            BedrockParticlePlayback.stop();
+            PLAYING.clear();
+            AVAILABLE.clear();
+            REQUESTS.clear();
+            ANNOUNCEMENTS.clear();
+            connection = current;
+            PENDING.clear();
+            lastAdvertised = null;
+            localEmoting = false;
+        }
+        final BedrockAuthManager selected = ViaFabricPlusBedrock.impl().account().get();
+        if (selected != account) {
+            BedrockSoundPlayback.stop();
+            BedrockParticlePlayback.stop();
+            account = selected;
+            generation++;
+            ITEMS.clear();
+            ASSETS.clear();
+            PLAYING.clear();
+            wheel = List.of("", "", "", "");
+            names = List.of("", "", "", "");
+            REQUESTS.clear();
+            ANNOUNCEMENTS.clear();
+            loading = false;
+            failed = false;
+            if (account != null) refresh();
+        }
+        while (KEY.consumeClick()) {
+            if (current != null
+                    && current.has(EntityTracker.class)
+                    && minecraft.player != null
+                    && minecraft.gui.screen() == null)
+                minecraft.gui.setScreen(new BedrockEmoteWheelScreen());
+        }
+        PLAYING.entrySet().removeIf(entry -> entry.getValue().expired(System.nanoTime()));
+        if (minecraft.player != null) {
+            final var input = minecraft.player.input.keyPresses;
+            if (input.forward()
+                    || input.backward()
+                    || input.left()
+                    || input.right()
+                    || input.jump()
+                    || input.shift()
+                    || minecraft.options.keyAttack.isDown()
+                    || minecraft.options.keyUse.isDown())
+                PLAYING.remove(minecraft.player.getUUID());
+            localEmoting = PLAYING.containsKey(minecraft.player.getUUID());
+        } else localEmoting = false;
+        advertise();
+    }
+
+    public static void refresh() {
+        if (account == null || loading) return;
+        loading = true;
+        failed = false;
+        final long request = ++generation;
+        BedrockCharacterProfiles.load(account)
+                .thenCombine(
+                        BedrockCharacterProfiles.loadItems(
+                                account, BedrockCharacterProfiles.Category.EMOTES),
+                        (wardrobe, items) -> {
+                            if (wardrobe.activeSlot() < 1)
+                                return new AccountEmotes(items, List.of("", "", "", ""));
+                            final var slot = wardrobe.slots().get(wardrobe.activeSlot() - 1);
+                            return new AccountEmotes(
+                                    items, BedrockCharacterProfiles.emoteIds(slot, items));
+                        })
+                .whenComplete(
+                        (result, error) ->
+                                Minecraft.getInstance()
+                                        .execute(
+                                                () -> {
+                                                    if (request != generation) return;
+                                                    loading = false;
+                                                    failed = error != null;
+                                                    if (error != null) {
+                                                        ViaFabricPlusBedrock.impl()
+                                                                .logger()
+                                                                .warn(
+                                                                        "Could not load the Bedrock"
+                                                                                + " emote wheel",
+                                                                        error);
+                                                        return;
+                                                    }
+                                                    ITEMS.clear();
+                                                    for (final var item : result.items()) {
+                                                        if (!"persona_emote".equals(item.type())) continue;
+                                                        try {
+                                                            ITEMS.put(
+                                                                    UUID.fromString(item.packId()),
+                                                                    item);
+                                                        } catch (IllegalArgumentException ignored) {
+                                                            /* Built-in entries may have no pack UUID. */
+                                                        }
+                                                    }
+                                                    wheel = result.wheel();
+                                                    names =
+                                                            wheel.stream()
+                                                                    .map(
+                                                                            id ->
+                                                                                    result
+                                                                                            .items()
+                                                                                            .stream()
+                                                                                            .filter(
+                                                                                                    item ->
+                                                                                                            item
+                                                                                                                    .matches(
+                                                                                                                            id))
+                                                                                            .map(
+                                                                                                    BedrockCharacterProfiles
+                                                                                                                    .WardrobeItem
+                                                                                                            ::name)
+                                                                                            .findFirst()
+                                                                                            .orElse(
+                                                                                                    ""))
+                                                                    .toList();
+                                                    ASSETS.entrySet()
+                                                            .removeIf(
+                                                                    entry ->
+                                                                            entry.getValue()
+                                                                                    .isCompletedExceptionally());
+                                                    for (int index = 0; index < 4; index++) {
+                                                        final UUID id = wheelId(index);
+                                                        if (id != null)
+                                                            ASSETS.putIfAbsent(id, asset(id));
+                                                    }
+                                                    while (!PENDING.isEmpty()) {
+                                                        receive(PENDING.removeFirst());
+                                                    }
+                                                }));
+    }
+
+    private static CompletableFuture<BedrockEmotes.Emote> asset(final UUID id) {
+        final var cached = ASSETS.get(id);
+        if (cached != null) return cached;
+        if (BedrockEmotes.isBuiltin(id.toString())) {
+            final var future = BedrockEmotes.loadBuiltin(id);
+            ASSETS.put(id, future);
+            return future;
+        }
+        final var item = ITEMS.get(id);
+        if (account == null)
+            return CompletableFuture.failedFuture(
+                    new IllegalStateException("This emote has no available account asset"));
+        if (ASSETS.values().stream().filter(future -> !future.isDone()).count() >= 8)
+            return CompletableFuture.failedFuture(
+                    new IllegalStateException("Too many Bedrock emote downloads are pending"));
+        if (ASSETS.size() >= 128) {
+            final var entries = ASSETS.entrySet().iterator();
+            while (entries.hasNext()) {
+                final var entry = entries.next();
+                if (entry.getValue().isDone() && java.util.stream.IntStream.range(0, 4)
+                        .noneMatch(index -> entry.getKey().equals(wheelId(index)))) {
+                    entries.remove();
+                    break;
+                }
+            }
+            if (ASSETS.size() >= 128) return CompletableFuture.failedFuture(
+                    new IllegalStateException("Too many Bedrock emote downloads are pending"));
+        }
+        final var future = item == null ? BedrockEmotes.loadRemote(account, id) : BedrockEmotes.load(account, item);
+        ASSETS.put(id, future);
+        return future;
+    }
+
+    public static boolean isLocalEmoting(final UserConnection user) {
+        return user == connection && localEmoting;
+    }
+
+    private static void advertise() {
+        if (connection == null
+                || !connection.has(EntityTracker.class)
+                || connection.get(EntityTracker.class).getClientPlayer() == null) return;
+        final UUID[] ids =
+                java.util.stream.IntStream.range(0, 4)
+                        .filter(BedrockEmotePlayback::ready)
+                        .mapToObj(BedrockEmotePlayback::wheelId)
+                        .distinct()
+                        .toArray(UUID[]::new);
+        if (java.util.Arrays.equals(lastAdvertised, ids)
+                || lastAdvertised == null && ids.length == 0) return;
+        final var list = PacketWrapper.create(ServerboundBedrockPackets.EMOTE_LIST, connection);
+        list.write(
+                BedrockTypes.UNSIGNED_VAR_LONG,
+                connection.get(EntityTracker.class).getClientPlayer().runtimeId());
+        list.write(BedrockTypes.UUID_ARRAY, ids);
+        list.sendToServer(BedrockProtocol.class);
+        lastAdvertised = ids;
+    }
+
+    public static boolean unavailable(final int slot) {
+        final var future = ASSETS.get(wheelId(slot));
+        return future != null && future.isCompletedExceptionally();
+    }
+
+    public static List<String> wheelNames() {
+        return names;
+    }
+
+    public static boolean loading() {
+        return loading;
+    }
+
+    public static boolean failed() {
+        return failed;
+    }
+
+    public static boolean ready(final int slot) {
+        final var future = ASSETS.get(wheelId(slot));
+        return future != null && future.isDone() && !future.isCompletedExceptionally();
+    }
+
+    private static UUID wheelId(final int slot) {
+        final String id = wheel.get(slot).split("/", 2)[0];
+        try {
+            return UUID.fromString(id);
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+    }
+
+    public static void play(final int slot) {
+        final var minecraft = Minecraft.getInstance();
+        final var user = ViaFabricPlus.api().userConnection();
+        if (user == null || user != connection || minecraft.player == null || !ready(slot)) return;
+        final BedrockEmotes.Emote emote = ASSETS.get(wheelId(slot)).join();
+        final long ticks = (long) Math.ceil(emote.animation().length() * 20D);
+        final long runtimeId = user.get(EntityTracker.class).getClientPlayer().runtimeId();
+        advertise();
+        final var packet = PacketWrapper.create(ServerboundBedrockPackets.EMOTE, user);
+        packet.write(
+                BedrockTypes.EMOTE,
+                new EmoteData(
+                        runtimeId, emote.id(), ticks, user.get(AuthData.class).getXuid(), "", 0));
+        packet.sendToServer(BedrockProtocol.class);
+        start(minecraft.player.getUUID(), emote, System.nanoTime(), ticks);
+        announce(user, minecraft.player.getUUID(), emote, 0);
+        localEmoting = true;
+        minecraft.gui.setScreen(null);
+    }
+
+    public static void receive(
+            final UserConnection user,
+            final UUID player,
+            final UUID emote,
+            final long ticks,
+            final int flags) {
+        final Pending pending = new Pending(user, player, emote, System.nanoTime(), ticks, flags);
+        if (loading) {
+            if (PENDING.size() == 32) PENDING.removeFirst();
+            PENDING.addLast(pending);
+        } else receive(pending);
+    }
+
+    private static void receive(final Pending pending) {
+        if (pending.user() != connection) return;
+        final var advertised = AVAILABLE.get(pending.player());
+        if (advertised != null && !advertised.contains(pending.emote())) return;
+        final var local = Minecraft.getInstance().player;
+        if (local != null && local.getUUID().equals(pending.player())) return;
+        final long request = generation;
+        REQUESTS.put(pending.player(), pending.received());
+        PLAYING.remove(pending.player());
+        asset(pending.emote())
+                .whenComplete(
+                        (animation, error) ->
+                                Minecraft.getInstance()
+                                        .execute(
+                                                () -> {
+                                                    if (request != generation
+                                                            || pending.user() != connection
+                                                            || !java.util.Objects.equals(
+                                                                    REQUESTS.get(pending.player()),
+                                                                    pending.received())) return;
+                                                    REQUESTS.remove(pending.player());
+                                                    if (error != null) return;
+                                                    start(
+                                                            pending.player(),
+                                                            animation,
+                                                            pending.received(),
+                                                            pending.ticks());
+                                                    announce(
+                                                            pending.user(),
+                                                            pending.player(),
+                                                            animation,
+                                                            pending.flags());
+                                                }));
+    }
+
+    private static void announce(
+            final UserConnection user,
+            final UUID player,
+            final BedrockEmotes.Emote emote,
+            final int flags) {
+        final Minecraft minecraft = Minecraft.getInstance();
+        if ((flags & MUTE_EMOTE_CHAT) != 0
+                || user.get(GameSessionStorage.class).isEmoteChatMuted()
+                || ViaFabricPlusBedrock.impl().settings().muteEmoteChat().isActive()
+                || !minecraft.computeChatAbilities().canReceivePlayerMessages()
+                || minecraft.isBlocked(player)) return;
+        final var listed = user.get(PlayerListStorage.class).getPlayer(player);
+        final String name;
+        if (listed != null) name = listed.value();
+        else if (minecraft.player != null && minecraft.player.getUUID().equals(player))
+            name = minecraft.player.getName().getString();
+        else return;
+        final Boolean alternate =
+                ANNOUNCEMENTS
+                        .computeIfAbsent(player, _ -> new BedrockEmoteMessages.Repeat())
+                        .select(emote.id(), System.nanoTime() / 1_000_000);
+        if (alternate == null) return;
+        final String message =
+                emote.messages().message(minecraft.options.languageCode, alternate, name);
+        if (message.isEmpty()) return;
+        final var component =
+                ComponentSerialization.CODEC
+                        .parse(
+                                JsonOps.INSTANCE,
+                                JsonParser.parseString(TextUtil.stringToJson(message)))
+                        .getOrThrow();
+        minecraft.gui.chatListener().handleSystemMessage(component, false);
+    }
+
+    public static void available(
+            final UserConnection user, final UUID player, final UUID[] emotes) {
+        if (user != connection) return;
+        AVAILABLE.put(player, List.of(emotes));
+    }
+
+    public static void start(
+            final UUID player,
+            final BedrockEmotes.Emote emote,
+            final long received,
+            final long ticks) {
+        REQUESTS.remove(player);
+        final float duration = ticks > 0 ? ticks / 20F : Float.POSITIVE_INFINITY;
+        final Playing playing =
+                new Playing(emote.id(), emote.animation().playback(), received, duration, null);
+        if (!playing.expired(System.nanoTime())) PLAYING.put(player, playing);
+    }
+
+    public static boolean playing(final UUID player) {
+        return PLAYING.containsKey(player);
+    }
+
+    public static Map<String, BedrockBoneAnimation.Transform> sample(
+            final UUID player, final net.minecraft.world.phys.Vec3 position,
+            final Map<String, ?> queries, final boolean eventsEnabled,
+            final java.util.function.Consumer<BedrockAnimationSound> sounds,
+            final java.util.function.Consumer<BedrockAnimationParticle.Cue> particles) {
+        Playing playing = PLAYING.get(player);
+        final long now = System.nanoTime();
+        if (playing == null) return Map.of();
+        if (playing.expired(now)
+                || playing.origin() != null && playing.origin().distanceToSqr(position) > 0.0004) {
+            PLAYING.remove(player);
+            return Map.of();
+        }
+        if (playing.origin() == null) {
+            playing =
+                    new Playing(
+                            playing.id(),
+                            playing.animation(),
+                            playing.started(),
+                            playing.duration(),
+                            position);
+            PLAYING.put(player, playing);
+        }
+        final var pose =
+                playing.animation().sample((now - playing.started()) / 1_000_000_000F, queries, eventsEnabled, sounds, particles);
+        if (playing.animation().stopped()) PLAYING.remove(player);
+        return pose;
+    }
+
+    private record AccountEmotes(
+            List<BedrockCharacterProfiles.WardrobeItem> items, List<String> wheel) {}
+
+    private record Pending(
+            UserConnection user, UUID player, UUID emote, long received, long ticks, int flags) {}
+
+    private record Playing(
+            UUID id,
+            BedrockBoneAnimation.Playback animation,
+            long started,
+            float duration,
+            net.minecraft.world.phys.Vec3 origin) {
+        boolean expired(final long now) {
+            return this.animation.stopped()
+                    || (now - this.started) / 1_000_000_000D >= this.duration;
+        }
+    }
+}
