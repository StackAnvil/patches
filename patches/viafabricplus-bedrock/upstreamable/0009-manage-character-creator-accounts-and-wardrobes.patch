+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_CATALOG_EMOTE_ASSETS", matches = ".+")
+    void samplesHoverWithActorLifetimeIndependentOfEmoteElapsedTime() throws Exception {
+        final String packId = "a203a0d3-be55-2832-1a53-6012e4dc3ec2";
+        final Path directory = Path.of(System.getenv("STACKANVIL_CATALOG_EMOTE_ASSETS"), packId);
