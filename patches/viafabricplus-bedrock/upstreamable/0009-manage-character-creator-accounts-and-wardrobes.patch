+    @Test
+    void decodesOnlyThePackAuthorizedByTheReceipt() throws Exception {
+        final String id = UUID.randomUUID().toString();
+        final byte[] key = new byte[32], fileKey = new byte[32], data = new byte[8192];
+        new java.util.Random(17).nextBytes(key);
+        Arrays.fill(fileKey, (byte) 'a');
+        new java.util.Random(31).nextBytes(data);
+        final JsonObject receipt = new JsonObject(),
+                receiptData = new JsonObject(),
+                entitlement = new JsonObject();
+        final String entity = UUID.randomUUID().toString(), device = UUID.randomUUID().toString();
+        receipt.addProperty("EntityId", entity);
+        receiptData.addProperty("DeviceId", device);
+        receipt.add("ReceiptData", receiptData);
+        final byte[] wrapped = new byte[64];
+        for (int index = 0; index < key.length; index++)
+            wrapped[index * 2] = (byte) (key[index] ^ entity.charAt(index) ^ device.charAt(index));
+        entitlement.addProperty("PackId", id);
+        entitlement.addProperty("ContentKey", Base64.getEncoder().encodeToString(wrapped));
+        final JsonArray entitlements = new JsonArray();
+        entitlements.add(entitlement);
+        receipt.add("EntitlementReceipts", entitlements);
+        final var keys = BedrockMarketplaceAssets.receiptKeys(receipt);
+        assertArrayEquals(key, keys.get(id));
+        assertFalse(keys.containsKey(UUID.randomUUID().toString()));
+        final byte[] archive = archive(id, key, fileKey, data);
+        assertArrayEquals(
+                data,
+                BedrockMarketplaceAssets.decode(archive, id, List.of(keys.get(id)))
+                        .files()
