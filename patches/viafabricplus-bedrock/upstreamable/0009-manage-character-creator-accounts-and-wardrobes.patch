+        assertFalse(restored.classic());
+        assertEquals(slot.classicSlim(), restored.classicSlim());
+        assertTrue(restored.pieceIds().contains(skin.recipeId()));
+    }
+
+    private BedrockAppearanceStore store() {
+        return new BedrockAppearanceStore(this.directory, _ -> new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB));
+    }
+
+    private static BedrockCharacterProfiles.Slot newSlot(final JsonObject profile) throws Exception {
+        final var original = wardrobe();
+        final var entries = profile.getAsJsonObject("personaCollection").getAsJsonArray("universalApp");
+        final var ids = entries.asList().stream().filter(entry -> entry.isJsonObject() && entry.getAsJsonObject().has("id"))
+            .map(entry -> entry.getAsJsonObject().get("id").getAsString()).toList();
+        return new BedrockCharacterProfiles.Slot(1, original.slots().getFirst().arm(), original.slots().getFirst().skinColor(),
+            ids, "hash", profile);
+    }
+
+    private static BedrockCharacterProfiles.AccountWardrobe wardrobe() {
+        final var profile = JsonParser.parseString("""
+            {"version":"0.0.1","personaCollection":{"universalApp":[
+              {"arm":"wide","skcol":"#aabbcc","skin":false},
+              {"id":"persona-piece/d","col":["#123456","#0"]},
+              {"id":"cape"},{"id":"emote/e"},{"id":"/e"},{"id":"/e"},{"id":"/e"},{"id":"old"}]}}
+            """).getAsJsonObject();
+        final var entries = profile.getAsJsonObject("personaCollection").getAsJsonArray("universalApp");
+        entries.get(2).getAsJsonObject().addProperty("id", CAPE_ID);
+        entries.get(7).getAsJsonObject().addProperty("id", OLD_PACK_ID + ".0");
+        final var settings = JsonParser.parseString("""
+            {"version":"0.1.0","personaCollection":{"universalApp":[
+              {"lastUsedPersonaSlot":"persona_profile_persona1","id":"preserved","isTitleLocked":true}]}}
+            """).getAsJsonObject();
+        return new BedrockCharacterProfiles.AccountWardrobe(List.of(new BedrockCharacterProfiles.Slot(1, "wide", "#aabbcc",
+            List.of("persona-piece/d", CAPE_ID, "emote/e", OLD_PACK_ID + ".0"), "hash", profile)), 1, 1, settings);
+    }
+
+    private static BedrockClassicSkinPack pack() throws Exception {
+        final var manifest = new JsonObject();
+        final var header = new JsonObject();
+        header.addProperty("uuid", PACK_ID);
+        manifest.add("header", header);
+        final var module = new JsonObject();
+        module.addProperty("type", "skin_pack");
+        final var modules = new JsonArray();
+        modules.add(module);
+        manifest.add("modules", modules);
+        final var image = new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(0, 0, 0xFF226688);
+        final var png = new ByteArrayOutputStream();
+        ImageIO.write(image, "PNG", png);
+        return BedrockClassicSkinPack.read("pack", Map.of(
+            "manifest.json", manifest.toString().getBytes(StandardCharsets.UTF_8),
+            "skins.json", """
+                {"localization_name":"pack","serialize_name":"different","skins":[
+                  {"localization_name":"missing","geometry":"geometry.humanoid.custom","texture":"missing.png"},
+                  {"localization_name":"localized","serialize_name":"serialization",
+                   "geometry":"geometry.humanoid.customSlim","texture":"skin.png"}]}
+                """.getBytes(StandardCharsets.UTF_8),
+            "texts/en_US.lang", "skin.pack.localized=Display name".getBytes(StandardCharsets.UTF_8),
+            "skin.png", png.toByteArray()), _ -> null);
+    }
+}
