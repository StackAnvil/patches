+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import org.jspecify.annotations.Nullable;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Color transfer and atlas composition used by Bedrock 1.26.51 persona textures. */
+final class BedrockPersonaTint {
+    private static final float BYTE_SCALE = 1F / 255F;
+
+    private BedrockPersonaTint() {}
+
+    static @Nullable Integer skinColor(
+            final BedrockCharacterProfiles.Slot slot,
+            final Map<String, BedrockMarketplaceAssets.Pack> packs)
+            throws IOException {
+        JsonObject skin = null;
+        for (final var pack : packs.values()) {
+            if (BedrockPersonaProfile.recipes(pack, slot).isEmpty()) continue;
+            for (final var metadata : BedrockPersonaSources.metadata(pack)) {
+                if (!metadata.has("piece_type")
+                        || !"persona_skin".equals(metadata.get("piece_type").getAsString()))
+                    continue;
+                if (skin != null && !skin.equals(metadata))
+                    throw new IOException("The equipped skin tint assets are ambiguous");
+                skin = metadata;
+            }
+        }
+        if (skin == null) return null;
+        return allowsOverride(skin)
+                ? parseColor(slot.skinColor())
+                : channels(skin.get("tint_color"))[0];
+    }
+
+    static Palette palette(
+            final BedrockPersonaSources.Texture texture,
+            final BedrockCharacterProfiles.Slot slot,
+            final JsonObject recipe,
+            final @Nullable Integer skinColor)
+            throws IOException {
+        final JsonObject metadata = texture.metadata();
+        final int[] authored = channels(metadata.get("tint_base_color"));
+        final String type =
+                metadata.has("piece_type") ? metadata.get("piece_type").getAsString() : "";
+        final int[] selected;
+        if ("persona_capes".equals(type)) {
+            selected = new int[4];
+        } else if ("persona_skin".equals(type)) {
+            selected = new int[4];
+            if (allowsOverride(metadata))
+                java.util.Arrays.fill(selected, parseColor(slot.skinColor()));
+        } else {
+            final JsonElement tint = metadata.get("tint_color");
+            selected = tint == null || tint.isJsonNull() ? authored.clone() : channels(tint);
+            if (allowsOverride(metadata) && recipe.has("col")) {
+                final var colors = recipe.getAsJsonArray("col");
+                if (colors.size() != 4)
+                    throw new IOException("A persona piece has an incomplete tint group");
+                for (int i = 0; i < 4; i++) selected[i] = parseColor(colors.get(i).getAsString());
+            }
+            // Every non-skin, non-cape piece uses the equipped skin's red tint as its alpha tint.
+            if (skinColor != null) selected[3] = skinColor;
+        }
+        return new Palette(authored, selected);
+    }
+
+    static boolean allowsOverride(final JsonObject metadata) throws IOException {
+        final JsonElement value = metadata.get("allow_tint_override");
+        if (value == null || value.isJsonNull()) return true;
+        if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isBoolean())
+            throw new IOException("A persona piece has an invalid tint override flag");
+        return value.getAsBoolean();
+    }
+
+    static BufferedImage apply(final BedrockPersonaSources.Texture texture, final Palette palette) {
+        final BufferedImage source = texture.image(),
+                result =
+                        new BufferedImage(
+                                source.getWidth(), source.getHeight(), BufferedImage.TYPE_INT_ARGB);
+        final Map<Long, Integer> cache = new HashMap<>();
+        for (int y = 0; y < source.getHeight(); y++)
+            for (int x = 0; x < source.getWidth(); x++) {
+                final int pixel = source.getRGB(x, y),
+                        mask = texture.tintMap() == null ? 0 : texture.tintMap().getRGB(x, y);
+                final long key = (long) mask << 32 | Integer.toUnsignedLong(pixel);
+                Integer value = cache.get(key);
+                if (value == null) {
+                    value = blend(0, pixel, mask, palette.authored(), palette.selected());
+                    if (cache.size() < 16384) cache.put(key, value);
+                }
+                result.setRGB(x, y, value);
+            }
+        return result;
+    }
+
+    private static int[] channels(final JsonElement value) throws IOException {
+        final int[] result = new int[4];
+        if (value == null || value.isJsonNull()) return result;
+        if (value.isJsonPrimitive()) {
+            java.util.Arrays.fill(result, parseColor(value.getAsString()));
+        } else {
+            final String[] names = {"r_color", "g_color", "b_color", "a_color"};
+            final JsonObject object = value.getAsJsonObject();
+            for (int i = 0; i < names.length; i++)
+                if (object.has(names[i]))
+                    result[i] = parseColor(object.get(names[i]).getAsString());
+        }
+        return result;
+    }
+
+    static int parseColor(final String value) throws IOException {
+        if ("#0".equals(value)) return 0;
+        if (value == null || !value.matches("#[a-fA-F0-9]{6}(?:[a-fA-F0-9]{2})?"))
+            throw new IOException("A persona piece has an invalid tint color");
+        final int parsed = (int) Long.parseLong(value.substring(1), 16);
+        return value.length() == 7 ? parsed | 0xff000000 : parsed;
+    }
+
+    record Palette(int[] authored, int[] selected) {}
+
+    static int blend(
+            final int background,
+            final int source,
+            final int mask,
+            final int[] authored,
+            final int[] selected) {
+        if ((source >>> 24) == 0) return background;
+        final float[] weights = color(mask),
+                base = new float[4],
+                pixel = color(source),
+                under = color(background);
+        final float sum = weights[0] + weights[1] + weights[2] + weights[3];
+        final float divisor = sum <= 0 ? 1 : sum;
+        final float[][] originals = new float[4][];
+        for (int i = 0; i < 4; i++) originals[i] = color(authored[i]);
+        for (int component = 0; component < 4; component++)
+            base[component] =
+                    (originals[3][component] * weights[3]
+                                    + originals[2][component] * weights[2]
+                                    + originals[1][component] * weights[1]
+                                    + originals[0][component] * weights[0])
+                            / divisor;
+        final float[][] transferred = new float[4][];
+        for (int i = 0; i < 4; i++)
+            transferred[i] =
+                    weights[i] > 0 && selected[i] != 0
+                            ? transfer(pixel, base, color(selected[i]))
+                            : pixel;
+        final float remainder = Math.max(0, 1 - sum), total = remainder + sum;
+        final float[] result = new float[4];
+        for (int component = 0; component < 3; component++) {
+            final float tinted =
+                    (weights[3] * transferred[3][component]
+                                    + weights[2] * transferred[2][component]
+                                    + weights[1] * transferred[1][component]
+                                    + weights[0] * transferred[0][component]
+                                    + pixel[component] * remainder)
+                            / total;
+            result[component] = tinted * pixel[3] + under[component] * (1 - pixel[3]);
+        }
+        result[3] = under[3] * (1 - pixel[3]) + pixel[3];
+        return argb(result);
+    }
+
+    private static float[] transfer(
+            final float[] source, final float[] base, final float[] target) {
+        final float[] difference =
+                hsl(base[0] - source[0], base[1] - source[1], base[2] - source[2]);
+        final float[] reference = hsl(base[0], base[1], base[2]);
+        difference[1] *= smooth(reference[1]) * 0.5F + smooth(reference[0]) * 0.5F;
+        final float[] offset = rgb(difference);
+        final float[] sourceLch = lch(source), baseLch = lch(base), targetLch = lch(target);
+        final float lightness = (sourceLch[0] - baseLch[0]) + targetLch[0];
+        final float chroma = (sourceLch[1] - baseLch[1]) + targetLch[1];
+        final float hue = (sourceLch[2] - baseLch[2]) + targetLch[2];
+        final float[] perceptual = fromLch(lightness, chroma, hue);
+        final float brightness = (luma(source) - luma(base)) + 0.5F;
+        final float pale = smooth((target[0] + target[2] + target[1]) / 3F);
+        final float vivid = smooth(targetLch[1] / 133.8158721923828F);
+        final float[] result = new float[4];
+        for (int i = 0; i < 3; i++) {
+            final float contrast =
+                    brightness >= 0.5F
+                            ? 1 - (1 - target[i]) * ((1 - brightness) + (1 - brightness))
+                            : (brightness + brightness) * target[i];
+            result[i] =
+                    vivid * contrast
+                            + (1 - vivid)
+                                    * (perceptual[i] * pale + (1 - pale) * (target[i] - offset[i]));
+        }
+        // Transferred alpha is not used by the compositor. Source alpha controls the layer.
+        result[3] = source[3];
+        return result;
+    }
+
+    private static float luma(final float[] color) {
+        return color[2] * 0.114F + color[1] * 0.587F + color[0] * 0.299F;
+    }
+
+    private static float smooth(final float value) {
+        return (3 - (value + value)) * value * value;
+    }
+
+    private static float[] hsl(final float red, final float green, final float blue) {
+        final float min = Math.min(red, Math.min(green, blue)),
+                max = Math.max(red, Math.max(green, blue));
+        final float range = max - min, sum = min + max, lightness = 0.5F * sum;
+        if (range == 0) return new float[] {0, 0, lightness};
+        final float saturation = range / (lightness < 0.5F ? sum : 2 - sum);
+        final float r = ((max - red) / 6F + 0.5F * range) / range;
+        final float g = ((max - green) / 6F + 0.5F * range) / range;
+        final float b = ((max - blue) / 6F + 0.5F * range) / range;
+        final float hue =
+                blue == max ? (g - r) + 2F / 3F : green == max ? (r - b) + 1F / 3F : b - g;
+        return new float[] {wrap(hue), saturation, lightness};
+    }
+
+    private static float[] rgb(final float[] hsl) {
+        final float lightness = hsl[2], saturation = hsl[1];
+        if (saturation == 0) return new float[] {lightness, lightness, lightness};
+        final float high =
+                lightness >= 0.5F
+                        ? (lightness + saturation) - saturation * lightness
+                        : (saturation + 1) * lightness;
+        final float low = (lightness + lightness) - high;
+        return new float[] {
+            hue(low, high, hsl[0] + 1F / 3F),
+            hue(low, high, hsl[0]),
+            hue(low, high, hsl[0] - 1F / 3F)
+        };
+    }
+
+    private static float hue(final float low, final float high, float hue) {
+        hue = wrap(hue);
+        if (hue * 6 < 1) return (high - low) * 6 * hue + low;
+        if (hue + hue < 1) return high;
+        if (3 * hue < 2) return (2F / 3F - hue) * (high - low) * 6 + low;
+        return low;
+    }
+
+    private static float wrap(float hue) {
+        if (hue < 0) hue += 1;
+        if (hue > 1) hue -= 1;
+        return hue;
+    }
+
+    private static float[] lch(final float[] color) {
+        final float r = linear(color[0]), g = linear(color[1]), b = linear(color[2]);
+        final float x = lab(((b * 0.1805F + g * 0.3576F + r * 0.4124F) * 100) / 95.047F);
+        final float y = lab(((b * 0.0722F + g * 0.7152F + r * 0.2126F) * 100) / 100);
+        final float z = lab(((b * 0.9505F + g * 0.1192F + r * 0.0193F) * 100) / 108.883F);
+        final float a = (x - y) * 500, componentB = (y - z) * 200;
+        return new float[] {
+            116 * y - 16,
+            (float) Math.sqrt(componentB * componentB + a * a),
+            (float) Math.atan2(componentB, a)
+        };
+    }
+
+    private static float linear(final float color) {
+        return color <= 0.04045
+                ? color / 12.92F
+                : (float) Math.pow((color + 0.055F) / 1.055F, 2.4F);
+    }
+
+    private static float lab(final float value) {
+        return value <= 0.008856F ? value * 7.787F + 16F / 116F : (float) Math.pow(value, 1F / 3F);
+    }
+
+    private static float[] fromLch(final float lightness, final float chroma, final float hue) {
+        final float y = (lightness + 16) / 116;
+        final float x = ((float) Math.cos(hue) * chroma) / 500 + y;
+        final float z = y + ((float) Math.sin(hue) * chroma) / -200;
+        final float xx = (inverseLab(x) * 95.047F) / 100;
+        final float yy = (inverseLab(y) * 100) / 100;
+        final float zz = (inverseLab(z) * 108.883F) / 100;
+        return new float[] {
+            srgb(3.2406F * xx + -1.5372F * yy + -0.4986F * zz),
+            srgb(-0.9689F * xx + 1.8758F * yy + 0.0415F * zz),
+            srgb(yy * -0.204F + xx * 0.0557F + zz * 1.057F)
+        };
+    }
+
+    private static float inverseLab(final float value) {
+        final float cube = value * value * value;
+        return cube <= 0.008856F ? (-16F / 116F + value) / 7.787F : cube;
+    }
+
+    private static float srgb(final float color) {
+        return color <= 0.0031308
+                ? color * 12.92F
+                : (float) Math.pow(color, 1F / 2.4F) * 1.055F + -0.055F;
+    }
+
+    private static float[] color(final int argb) {
+        return new float[] {
+            (argb >>> 16 & 255) * BYTE_SCALE,
+            (argb >>> 8 & 255) * BYTE_SCALE,
+            (argb & 255) * BYTE_SCALE,
+            (argb >>> 24) * BYTE_SCALE
+        };
+    }
+
+    private static int argb(final float[] color) {
+        return channel(color[3]) << 24
+                | channel(color[0]) << 16
+                | channel(color[1]) << 8
+                | channel(color[2]);
+    }
+
+    private static int channel(final float value) {
+        return (int) (Math.min(1, Math.max(0, value)) * 255);
+    }
+}
