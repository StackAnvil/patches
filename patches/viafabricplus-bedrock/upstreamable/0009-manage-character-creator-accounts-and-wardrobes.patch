+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation;
+import java.lang.reflect.Modifier;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import net.minecraft.SharedConstants;
+import net.minecraft.client.renderer.entity.state.AvatarRenderState;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.entity.Avatar;
+import net.minecraft.world.entity.EquipmentSlot;
+import net.minecraft.world.entity.HumanoidArm;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class BedrockActorQuerySnapshotTest {
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void retainsFrameValuesAndActorIdentityWithoutKeepingTheAvatarAlive() throws Exception {
+        final var avatar = mock(Avatar.class);
+        final UUID uuid = UUID.randomUUID();
+        when(avatar.getUUID()).thenReturn(uuid);
+        when(avatar.getMainArm()).thenReturn(HumanoidArm.RIGHT);
+        when(avatar.getMainHandItem()).thenReturn(ItemStack.EMPTY);
+        when(avatar.getOffhandItem()).thenReturn(ItemStack.EMPTY);
+        when(avatar.getUseItem()).thenReturn(ItemStack.EMPTY);
+        when(avatar.getItemBySlot(any(EquipmentSlot.class))).thenReturn(ItemStack.EMPTY);
+        when(avatar.isInWater()).thenReturn(true);
+        when(avatar.getDeltaMovement()).thenReturn(new Vec3(.3, -.4, 0));
+        when(avatar.getX()).thenReturn(11.25);
+        when(avatar.getY()).thenReturn(-2.5);
+        when(avatar.getZ()).thenReturn(7.75);
+        avatar.xo = 10;
+        avatar.yo = -3;
+        avatar.zo = 8;
+        final var state = new AvatarRenderState();
+        state.rightHandItemStack = ItemStack.EMPTY;
+        state.leftHandItemStack = ItemStack.EMPTY;
+        state.ageInTicks = 40;
+        final var queries = BedrockPlayerSkins.actorQueries(avatar, state, .25F);
+        when(avatar.isInWater()).thenReturn(false);
+        when(avatar.getDeltaMovement()).thenReturn(Vec3.ZERO);
+        when(avatar.getX()).thenReturn(300D);
+        avatar.xo = 0;
+        assertEquals(true, queries.get("is_in_water"));
+        assertEquals(10F, queries.get("ground_speed"));
+        assertEquals(2F, queries.get("life_time"));
+        assertEquals(.25F, queries.get("frame_alpha"));
+        final var delta = (BedrockActorAnimation.Query) queries.get("position_delta");
+        assertEquals(1.25, delta.evaluate(List.of()));
+        assertEquals(1.25, delta.evaluate(List.of(0)));
+        assertEquals(.5, delta.evaluate(List.of(1)));
+        assertEquals(-.25, delta.evaluate(List.of(2)));
+        assertEquals(0D, delta.evaluate(List.of(3)));
+        assertEquals(BedrockActorState.spellColor(uuid, null),
+                ((BedrockActorAnimation.Query) queries.get("spellcolor")).evaluate(List.of()));
+        assertNoAvatarReference(queries, Collections.newSetFromMap(new IdentityHashMap<>()));
+    }
+
+    /** Inspect captured values directly; collection through System.gc() would make this lifecycle test flaky. */
+    private static void assertNoAvatarReference(final Object value, final Set<Object> visited) throws Exception {
+        if (value == null || !visited.add(value)) return;
+        assertFalse(value instanceof Avatar, "Cached queries must not retain their weak avatar key");
+        if (value instanceof Map<?, ?> map) {
+            for (final Object element : map.values()) assertNoAvatarReference(element, visited);
+        } else if (value instanceof Iterable<?> values) {
+            for (final Object element : values) assertNoAvatarReference(element, visited);
+        } else if (value.getClass().isSynthetic()) {
+            for (final var field : value.getClass().getDeclaredFields()) {
+                if (Modifier.isStatic(field.getModifiers()) || field.getType().isPrimitive()) continue;
+                field.setAccessible(true);
+                assertNoAvatarReference(field.get(value), visited);
+            }
+        }
+    }
+}
