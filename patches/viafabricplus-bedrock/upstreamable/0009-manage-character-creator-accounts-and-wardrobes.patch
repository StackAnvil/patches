+    static JsonObject pieceChangeRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                         final List<WardrobeItem> categoryItems, final WardrobeItem selectedItem,
+                                         final boolean remove) throws IOException {
+        if (!remove && !selectedItem.canEquip()) throw new IOException("Acquire this wardrobe item before equipping it");
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size() || !categoryItems.contains(selectedItem)) {
+            throw new IOException("Invalid character piece selection");
+        }
+        final Slot target = wardrobe.slots().get(slotNumber - 1);
+        if (!target.occupied()) {
+            throw new IOException("Create a character before editing its pieces");
+        }
+        final JsonObject edited = target.profile().deepCopy();
+        final JsonArray entries = array(object(edited, "personaCollection"), "universalApp");
+        final int existing = matchingPieceIndex(entries, categoryItems);
+        final String existingId = existing < 0 ? "" : string(entries.get(existing).getAsJsonObject(), "id");
+        if (remove) {
+            if (existing < 0 || !selectedItem.matches(existingId)) {
+                throw new IOException("This piece is not equipped in the selected character");
+            }
+            entries.remove(existing);
+        } else {
+            if (selectedItem.matches(existingId)) {
+                throw new IOException("This piece is already equipped");
+            }
+            JsonObject source = null;
+            for (final Slot slot : wardrobe.slots()) {
+                for (final JsonElement entry : array(object(slot.profile(), "personaCollection"), "universalApp")) {
+                    if (entry.isJsonObject() && selectedItem.matches(string(entry.getAsJsonObject(), "id"))) {
+                        source = entry.getAsJsonObject();
+                        break;
+                    }
+                }
+                if (source != null) {
+                    break;
+                }
+            }
+            if (source == null) {
+                source = presetPiece(selectedItem);
+            }
+            if (source == null) {
+                source = catalogRecipe(selectedItem);
+                if (existing >= 0 && entries.get(existing).getAsJsonObject().has("col")) {
+                    source.add("col", entries.get(existing).getAsJsonObject().get("col").deepCopy());
+                }
+            }
+            if (existing < 0) {
+                final int wheel = emoteStart(entries, List.of());
+                if (wheel < 0) {
+                    entries.add(source.deepCopy());
+                } else {
+                    final JsonArray reordered = new JsonArray();
+                    for (int index = 0; index <= entries.size(); index++) {
+                        if (index == wheel) {
+                            reordered.add(source.deepCopy());
+                        }
+                        if (index < entries.size()) {
+                            reordered.add(entries.get(index));
+                        }
+                    }
+                    object(edited, "personaCollection").add("universalApp", reordered);
+                }
+            } else {
+                entries.set(existing, source.deepCopy());
+            }
+        }
+        return personaEditRequest(wardrobe, slotNumber, edited);
+    }
+
+    static JsonObject limbChangeRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                       final List<WardrobeItem> categoryItems, final WardrobeItem selectedItem,
+                                       final BedrockLimbSide side, final boolean remove) throws IOException {
+        if (!remove && !selectedItem.canEquip()) throw new IOException("Acquire this wardrobe item before equipping it");
+        final String type = selectedItem.type();
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size() || !categoryItems.contains(selectedItem)
+            || !("persona_arms".equals(type) || "persona_legs".equals(type))
+            || categoryItems.stream().anyMatch(item -> !type.equals(item.type()))) {
+            throw new IOException("Invalid character limb selection");
+        }
+        final Slot slot = wardrobe.slots().get(slotNumber - 1);
+        if (!slot.occupied()) throw new IOException("Create a character before editing its limbs");
+        if (remove && !limbEquipped(slot, selectedItem, side)) {
+            throw new IOException("This piece is not equipped on the selected limbs");
+        }
+        final JsonObject edited = slot.profile().deepCopy();
+        final JsonArray entries = array(object(edited, "personaCollection"), "universalApp");
+        JsonObject source = null;
+        JsonElement previousColors = null;
+        for (final JsonElement element : entries) {
+            final JsonObject entry = element.getAsJsonObject();
+            final String id = string(entry, "id");
+            final boolean category = categoryItems.stream().anyMatch(item -> item.matches(id));
+            if (!category || remove && !selectedItem.matches(id)) {
+                continue;
+            }
+            if (selectedItem.matches(id)) source = entry.deepCopy();
+            final int mask = BedrockLimbSide.fromRecipe(id).mask();
+            if ((mask & side.mask()) != 0 && entry.has("col")) previousColors = entry.get("col");
+        }
+        final JsonArray kept = withoutLimbSide(entries,
+            id -> categoryItems.stream().anyMatch(item -> item.matches(id))
+                && (!remove || selectedItem.matches(id)), side);
+        if (!remove) {
+            if (source == null) source = recipeFor(wardrobe, selectedItem).deepCopy();
+            source.addProperty("id", side.recipe(string(source, "id")));
+            if (!source.has("col") && previousColors != null) source.add("col", previousColors.deepCopy());
+            final int wheel = emoteStart(kept, List.of());
+            kept.asList().add(wheel < 0 ? kept.size() : wheel, source);
+        }
+        object(edited, "personaCollection").add("universalApp", kept);
+        return personaEditRequest(wardrobe, slotNumber, edited);
+    }
+
+    static JsonObject limbResetRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                       final Category category, final List<WardrobeItem> items,
+                                       final BedrockLimbSide side) throws IOException {
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size()
+            || !canResetLimb(wardrobe.slots().get(slotNumber - 1), category, items, side)) {
+            throw new IOException("This character has no removable piece on the selected limbs");
+        }
+        final JsonObject edited = wardrobe.slots().get(slotNumber - 1).profile().deepCopy();
+        final JsonObject collection = object(edited, "personaCollection");
+        collection.add("universalApp", withoutLimbSide(array(collection, "universalApp"),
+            id -> items.stream().anyMatch(item -> item.matches(id)), side));
+        return personaEditRequest(wardrobe, slotNumber, edited);
+    }
+
+    private static JsonArray withoutLimbSide(final JsonArray entries, final Predicate<String> matches,
+                                             final BedrockLimbSide side) throws IOException {
+        final JsonArray kept = new JsonArray();
+        for (final JsonElement element : entries) {
+            final JsonObject entry = element.getAsJsonObject().deepCopy();
+            final String id = string(entry, "id");
+            if (!matches.test(id)) {
+                kept.add(entry);
+                continue;
+            }
+            final int remaining = BedrockLimbSide.fromRecipe(id).mask() & ~side.mask();
+            if (remaining != 0) {
+                entry.addProperty("id", BedrockLimbSide.fromMask(remaining).recipe(id));
+                kept.add(entry);
+            }
+        }
+        return kept;
+    }
+
+    static JsonObject emoteChangeRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                         final List<WardrobeItem> categoryItems, final WardrobeItem selectedItem,
+                                         final int wheelSlot, final boolean remove) throws IOException {
+        if (!remove && !selectedItem.canEquip()) throw new IOException("Acquire this wardrobe item before equipping it");
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size() || wheelSlot < 0 || wheelSlot >= 4
+            || !categoryItems.contains(selectedItem) || categoryItems.stream().anyMatch(item -> !"persona_emote".equals(item.type()))) {
+            throw new IOException("Invalid emote selection");
+        }
+        final Slot target = wardrobe.slots().get(slotNumber - 1);
+        if (!target.occupied()) {
+            throw new IOException("Create a character before editing its emotes");
+        }
+        final JsonObject edited = target.profile().deepCopy();
+        JsonArray entries = array(object(edited, "personaCollection"), "universalApp");
+        int start = emoteStart(entries, categoryItems);
+        if (start < 0) {
+            start = emoteEnd(entries);
+            final JsonArray reordered = new JsonArray();
+            for (int index = 0; index <= entries.size(); index++) {
+                if (index == start) for (int wheel = 0; wheel < 4; wheel++) reordered.add(emptyEmote());
+                if (index < entries.size()) reordered.add(entries.get(index).deepCopy());
+            }
+            object(edited, "personaCollection").add("universalApp", reordered);
+            entries = reordered;
+        } else if (emoteEnd(entries) - start != 4) {
+            throw new IOException("This character has an incomplete emote wheel");
+        }
+        final String equippedId = string(entries.get(start + wheelSlot).getAsJsonObject(), "id");
+        if (remove) {
+            if (!selectedItem.matches(equippedId)) {
+                throw new IOException("This emote is not in the selected wheel position");
+            }
+            entries.set(start + wheelSlot, emptyEmote());
+        } else {
+            if (selectedItem.matches(equippedId)) {
+                throw new IOException("This emote is already in the selected wheel position");
+            }
+            final JsonObject source = recipeFor(wardrobe, selectedItem).deepCopy();
+            for (int index = 0; index < 4; index++) {
+                if (selectedItem.matches(string(entries.get(start + index).getAsJsonObject(), "id"))) {
+                    entries.set(start + index, emptyEmote());
+                }
+            }
+            entries.set(start + wheelSlot, source.deepCopy());
+        }
+        return editRequest(wardrobe, slotNumber, edited);
+    }
+
+    static JsonObject capeChangeRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                        final List<WardrobeItem> categoryItems, final WardrobeItem selectedItem,
+                                        final boolean remove) throws IOException {
+        if (!remove && !selectedItem.canEquip()) throw new IOException("Acquire this wardrobe item before equipping it");
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size() || !categoryItems.contains(selectedItem)
+            || categoryItems.stream().anyMatch(item -> !"persona_capes".equals(item.type()))) {
+            throw new IOException("Invalid cape selection");
+        }
+        final Slot target = wardrobe.slots().get(slotNumber - 1);
+        if (!target.occupied()) {
+            throw new IOException("Create a character before editing its cape");
+        }
+        final JsonObject edited = target.profile().deepCopy();
+        final JsonObject collection = object(edited, "personaCollection");
+        final JsonArray entries = array(collection, "universalApp");
+        int existing = -1;
+        for (int index = 0; index < entries.size(); index++) {
+            if (entries.get(index).isJsonObject()
+                && CAPE_ID.matcher(string(entries.get(index).getAsJsonObject(), "id")).matches()) {
+                if (existing >= 0) {
+                    throw new IOException("This character has multiple saved capes");
+                }
+                existing = index;
+            }
+        }
+        if (remove) {
+            if (existing < 0 || !selectedItem.matches(string(entries.get(existing).getAsJsonObject(), "id"))) {
+                throw new IOException("This cape is not equipped in the selected character");
+            }
+            entries.remove(existing);
+        } else {
+            if (!CAPE_ID.matcher(selectedItem.packId()).matches()) {
+                throw new IOException("This cape has no complete pack ID");
+            }
+            if (existing >= 0 && selectedItem.matches(string(entries.get(existing).getAsJsonObject(), "id"))) {
+                throw new IOException("This cape is already equipped");
+            }
+            final JsonObject cape = new JsonObject();
+            cape.addProperty("id", selectedItem.packId());
+            if (existing >= 0) {
+                entries.set(existing, cape);
+            } else {
+                final int emotes = emoteStart(entries, List.of());
+                final int insertion = emotes < 0 ? entries.size() : emotes;
+                final JsonArray reordered = new JsonArray();
+                for (int index = 0; index <= entries.size(); index++) {
+                    if (index == insertion) {
+                        reordered.add(cape);
+                    }
+                    if (index < entries.size()) {
+                        reordered.add(entries.get(index).deepCopy());
+                    }
+                }
+                collection.add("universalApp", reordered);
+            }
+        }
+        return editRequest(wardrobe, slotNumber, edited);
+    }
