+    private static double span(final JsonObject mesh) {
+        final var positions = mesh.getAsJsonArray("positions").asList();
+        return positions.stream()
+                        .mapToDouble(vertex -> vertex.getAsJsonArray().get(0).getAsDouble())
+                        .max()
+                        .orElseThrow()
+                - positions.stream()
+                        .mapToDouble(vertex -> vertex.getAsJsonArray().get(0).getAsDouble())
+                        .min()
+                        .orElseThrow();
