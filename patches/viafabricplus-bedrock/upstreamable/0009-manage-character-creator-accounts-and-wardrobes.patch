+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PERSONA_PALETTES", matches = ".+")
+    void matchesSwatchesExecutedFromTheTargetNativeClient() throws Exception {
+        final var palettes =
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(System.getenv("STACKANVIL_PERSONA_PALETTES"))))
+                        .getAsJsonArray();
+        final var targets =
+                List.of(
+                        ColorTarget.HAIR,
+                        ColorTarget.IRIS,
+                        ColorTarget.MOUTH,
+                        ColorTarget.SCLERA,
+                        ColorTarget.SKIN);
+        final int[] indices = {0, 1, 2, 4, 5};
+        for (int index = 0; index < targets.size(); index++) {
+            final var nativeColors =
+                    palettes
+                            .get(indices[index])
+                            .getAsJsonObject()
+                            .getAsJsonArray("colors")
+                            .asList()
+                            .stream()
+                            .map(color -> color.getAsJsonObject().get("argb").getAsString())
+                            .toList();
+            assertEquals(nativeColors, targets.get(index).palette());
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PERSONA_CHANNELS", matches = ".+")
+    void matchesChannelOrderExecutedFromTheTargetNativePicker() throws Exception {
+        final var rows =
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(System.getenv("STACKANVIL_PERSONA_CHANNELS"))))
+                        .getAsJsonArray();
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            final var targets =
+                    switch (row.get("pieceType").getAsInt()) {
+                        case 3 -> List.of(ColorTarget.SKIN);
+                        case 11 -> Category.FACIAL_HAIRS.colorTargets();
+                        case 12 -> Category.MOUTHS.colorTargets();
+                        case 13 -> Category.EYES.colorTargets();
+                        case 14 -> Category.HAIRS.colorTargets();
+                        default -> throw new AssertionError("Unknown native piece type");
+                    };
+            final var channels =
+                    row.getAsJsonArray("channels").asList().stream()
+                            .map(channel -> channel.getAsInt())
+                            .toList();
+            assertEquals(
+                    channels,
+                    targets.stream()
+                            .map(target -> target == ColorTarget.SKIN ? 0 : target.channel())
+                            .toList());
+        }
+    }
