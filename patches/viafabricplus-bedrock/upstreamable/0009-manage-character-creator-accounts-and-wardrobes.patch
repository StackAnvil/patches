@@ -0,0 +1,96 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.awt.AlphaComposite;
+import java.awt.Graphics2D;
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Packs native animated texture collections into horizontal columns of repeating strips. */
+final class BedrockPersonaAnimationAtlas {
+    private final int height;
+    private final Map<String, Tile> tiles = new LinkedHashMap<>();
+    private int width;
+    private int frames = 1;
+
+    BedrockPersonaAnimationAtlas(final int height) {
+        this.height = height;
+    }
+
+    static void validate(final BufferedImage image, final int frames, final int size)
+            throws IOException {
+        if (frames < 1
+                || frames > 256
+                || (frames & (frames - 1)) != 0
+                || image.getWidth() != size
+                || image.getHeight() != size * frames)
+            throw new IOException(
+                    "A persona animation needs square native frames and a power-of-two length");
+    }
+
+    Tile add(final String id, final BufferedImage image, final int frames) throws IOException {
+        final Tile existing = this.tiles.get(id);
+        if (existing != null) return existing;
+        if (image.getHeight() != this.height * frames
+                || frames < 1
+                || frames > 256
+                || (frames & (frames - 1)) != 0)
+            throw new IOException("A persona animation has incompatible frames");
+        final int width = this.width + image.getWidth(), count = Math.max(this.frames, frames);
+        if (width > 1024 || (long) width * this.height * count > 4 * 1024 * 1024)
+            throw new IOException("The equipped animations exceed the texture atlas");
+        final Tile tile = new Tile(image, this.width, frames, this.height);
+        this.tiles.put(id, tile);
+        this.width = width;
+        this.frames = count;
+        return tile;
+    }
+
+    int width() {
+        return this.width;
+    }
+
+    int height() {
+        return this.height;
+    }
+
+    int frames() {
+        return this.frames;
+    }
+
+    BufferedImage image() {
+        final BufferedImage image =
+                new BufferedImage(
+                        this.width, this.height * this.frames, BufferedImage.TYPE_INT_ARGB);
+        final Graphics2D graphics = image.createGraphics();
+        try {
+            graphics.setComposite(AlphaComposite.Src);
+            for (final var tile : this.tiles.values())
+                for (int frame = 0; frame < this.frames; frame++) {
+                    final int offset = frame % tile.frames() * this.height;
+                    graphics.drawImage(
+                            tile.image(),
+                            tile.x(),
+                            frame * this.height,
+                            tile.x() + tile.image().getWidth(),
+                            (frame + 1) * this.height,
+                            0,
+                            offset,
+                            tile.image().getWidth(),
+                            offset + this.height,
+                            null);
+                }
+        } finally {
+            graphics.dispose();
+        }
+        return image;
+    }
+
+    record Tile(BufferedImage image, int x, int frames, int height) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAssembler.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAssembler.java
