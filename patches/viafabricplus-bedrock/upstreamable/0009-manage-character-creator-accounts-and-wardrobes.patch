@@ -0,0 +1,253 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles.Category;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles.WardrobeItem;
+
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpRequest;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.TimeUnit;
+
+/** Acquires persona offers and synchronizes Microsoft Store purchases through native transactions. */
+public final class BedrockMarketplaceTransactions {
+    private static final URI BALANCES = URI.create(
+            "https://entitlements.mktpl.minecraft-services.net/api/v1.0/currencies/virtual/balances");
+
+    private static final URI VIRTUAL = URI.create(
+            "https://entitlements.mktpl.minecraft-services.net/api/v1.0/transaction/virtual");
+
+    private static final URI XBOX_REDEMPTION = URI.create(
+            "https://entitlements.mktpl.minecraft-services.net/api/v1.0/transaction/redeem/xbox");
+
+    private BedrockMarketplaceTransactions() {}
+
+    public static CompletableFuture<Long> minecoins(final BedrockAuthManager account) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final byte[] response = BedrockMarketplaceAssets.request(HttpRequest.newBuilder(BALANCES)
+                        .header("Authorization", account.getMinecraftSession().getUpToDate().getAuthorizationHeader())
+                        .header("Accept", "application/json")
+                        .header("Content-Type", "application/json")
+                        .POST(HttpRequest.BodyPublishers.noBody()), 2 * 1024 * 1024);
+                return parseMinecoins(JsonParser.parseString(new String(response, StandardCharsets.UTF_8)).getAsJsonObject());
+            } catch (Exception e) {
+                throw new CompletionException(e);
+            }
+        });
+    }
+
+    static long parseMinecoins(final JsonObject response) throws IOException {
+        try {
+            final JsonArray balances = response.getAsJsonObject("result").getAsJsonArray("virtualCurrencyBalances");
+            Long minecoins = null;
+            for (final var value : balances) {
+                final JsonObject currency = value.getAsJsonObject();
+                if (!"Minecoin".equals(currency.get("type").getAsString())) continue;
+                final var amount = currency.get("amount");
+                if (minecoins != null || amount == null || !amount.isJsonPrimitive()
+                        || !amount.getAsJsonPrimitive().isNumber())
+                    throw new IOException("The Marketplace returned an invalid Minecoin balance");
+                minecoins = amount.getAsBigDecimal().longValueExact();
+                if (minecoins < 0) throw new IOException("The Marketplace returned a negative Minecoin balance");
+            }
+            if (minecoins == null) throw new IOException("The Marketplace returned no Minecoin balance");
+            return minecoins;
+        } catch (RuntimeException e) {
+            throw new IOException("The Marketplace returned an invalid Minecoin balance", e);
+        }
+    }
+
+    public static CompletableFuture<RedemptionResult> redeemXbox(final BedrockAuthManager account) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final JsonObject body = redemptionRequest(account.getXboxUserProfile().getUpToDate().getId(),
+                        account.getPlayFabXstsToken().getUpToDate().getAuthorizationHeader(), UUID.randomUUID());
+                final RedemptionResult result = parseRedemption(transaction(account, XBOX_REDEMPTION, body));
+                // Refresh the receipt before callers reload persona or classic catalog ownership.
+                BedrockMarketplaceAssets.accountKeys(account);
+                return result;
+            } catch (Exception e) {
+                throw new CompletionException(e);
+            }
+        });
+    }
+
+    private static JsonObject transaction(final BedrockAuthManager account, final URI endpoint, final JsonObject body)
+            throws Exception {
+        return JsonParser.parseString(new String(BedrockMarketplaceAssets.request(HttpRequest.newBuilder(endpoint)
+                .header("Authorization", account.getMinecraftSession().getUpToDate().getAuthorizationHeader())
+                .header("Accept", "application/json")
+                .header("Content-Type", "application/json")
+                .POST(HttpRequest.BodyPublishers.ofString(body.toString())), 2 * 1024 * 1024),
+                StandardCharsets.UTF_8)).getAsJsonObject();
+    }
+
+    static JsonObject redemptionRequest(final String userId, final String xboxToken, final UUID correlation)
+            throws IOException {
+        try {
+            if (userId == null || !userId.matches("[0-9]{1,20}") || Long.parseUnsignedLong(userId) == 0
+                    || xboxToken == null || !xboxToken.matches("XBL3\\.0 x=[^;\\r\\n]+;[^\\r\\n]+"))
+                throw new IOException("The account returned invalid Xbox redemption credentials");
+            final JsonObject authentication = new JsonObject();
+            authentication.addProperty("XboxToken", xboxToken);
+            final JsonObject marketplace = new JsonObject();
+            marketplace.addProperty("userId", userId);
+            marketplace.add("xboxAuthentication", authentication);
+            final JsonObject redemption = new JsonObject();
+            redemption.add("MarketplaceData", marketplace);
+            final JsonObject tags = new JsonObject();
+            tags.addProperty("CorrelationId", correlation.toString());
+            final JsonObject request = new JsonObject();
+            request.add("CustomTags", tags);
+            request.add("Redemption", redemption);
+            return request;
+        } catch (RuntimeException e) {
+            throw new IOException("The account returned invalid Xbox redemption credentials", e);
+        }
+    }
+
+    static RedemptionResult parseRedemption(final JsonObject response) throws IOException {
+        try {
+            final JsonObject result = response.getAsJsonObject("result");
+            final JsonArray succeeded = result.getAsJsonArray("succeeded");
+            final JsonArray failed = result.getAsJsonArray("failed");
+            if (succeeded == null || failed == null) throw new IOException("The Marketplace returned an invalid redemption result");
+            for (final var value : succeeded) {
+                if (!value.isJsonObject()) throw new IOException("The Marketplace returned an invalid redeemed offer");
+            }
+            for (final var value : failed) {
+                if (!value.isJsonObject()) throw new IOException("The Marketplace returned an invalid failed offer");
+            }
+            return new RedemptionResult(succeeded.size(), failed.size(), transactionIds(result.getAsJsonArray("transactionIds")));
+        } catch (RuntimeException e) {
+            throw new IOException("The Marketplace returned an invalid redemption result", e);
+        }
+    }
+
+    public record RedemptionResult(int succeeded, int failed, List<String> transactionIds) {
+        public RedemptionResult {
+            transactionIds = List.copyOf(transactionIds);
+        }
+    }
+
+    public static CompletableFuture<List<WardrobeItem>> acquire(
+            final BedrockAuthManager account, final Category category, final WardrobeItem selected) {
+        return BedrockCharacterProfiles.loadItems(account, category).thenCompose(items -> {
+            final WardrobeItem current = items.stream().filter(item -> item.id().equals(selected.id())
+                    && item.packId().equals(selected.packId()) && item.type().equals(selected.type()))
+                    .findFirst().orElse(null);
+            if (current == null) return CompletableFuture.failedFuture(
+                    new IOException("This offer is no longer in the catalog. Refresh the item list"));
+            if (current.owned()) return CompletableFuture.completedFuture(items);
+            if (current.price() != selected.price() || current.requiresRedeem() != selected.requiresRedeem())
+                return CompletableFuture.failedFuture(new IOException("This offer changed. Refresh the item list"));
+            return CompletableFuture.runAsync(() -> {
+                try {
+                    final JsonObject published = BedrockMarketplaceAssets.published(account, current.id());
+                    final JsonObject body = purchaseRequest(current, published, UUID.randomUUID());
+                    validatePurchase(current, transaction(account, VIRTUAL, body));
+                } catch (Exception e) {
+                    throw new CompletionException(e);
+                }
+            }).thenCompose(_ -> refreshOwnership(account, category, current, 0));
+        });
+    }
+
+    private static CompletableFuture<List<WardrobeItem>> refreshOwnership(
+            final BedrockAuthManager account, final Category category, final WardrobeItem selected, final int attempt) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                return BedrockMarketplaceAssets.accountKeys(account).containsKey(selected.packId());
+            } catch (Exception e) {
+                throw new CompletionException(e);
+            }
+        }).thenCombine(BedrockCharacterProfiles.loadItems(account, category), (hasKey, items) ->
+                hasKey && items.stream().anyMatch(item -> item.id().equals(selected.id())
+                        && item.packId().equals(selected.packId()) && item.owned()) ? items : null)
+                .thenCompose(items -> {
+                    if (items != null) return CompletableFuture.completedFuture(items);
+                    if (attempt >= 4) return CompletableFuture.failedFuture(new IOException(
+                            "The purchase was accepted but its assets are not ready. Refresh the item list"));
+                    return CompletableFuture.runAsync(() -> {},
+                            CompletableFuture.delayedExecutor(500, TimeUnit.MILLISECONDS))
+                            .thenCompose(_ -> refreshOwnership(account, category, selected, attempt + 1));
+                });
+    }
+
+    static JsonObject purchaseRequest(final WardrobeItem selected, final JsonObject published, final UUID correlation)
+            throws IOException {
+        try {
+            UUID.fromString(selected.id());
+            UUID.fromString(selected.packId());
+            if (selected.owned() || selected.price() < 0
+                    || !selected.id().equals(published.get("Id").getAsString())
+                    || !"PersonaDurable".equals(published.get("ContentType").getAsString()))
+                throw new IOException("The selected offer cannot be purchased");
+            final JsonObject properties = published.getAsJsonObject("DisplayProperties");
+            final var price = properties.get("price");
+            if (price == null || !price.isJsonPrimitive() || !price.getAsJsonPrimitive().isNumber()
+                    || price.getAsBigDecimal().intValueExact() != selected.price())
+                throw new IOException("The offer price changed. Refresh the item list");
+            boolean matchesPack = false;
+            for (final var value : properties.getAsJsonArray("packIdentity")) {
+                final var pack = value.getAsJsonObject();
+                matchesPack |= "persona_piece".equals(pack.get("type").getAsString())
+                        && selected.packId().equals(pack.get("uuid").getAsString());
+            }
+            if (!matchesPack) throw new IOException("The offer has a different pack identity");
+            final JsonObject currency = new JsonObject();
+            currency.addProperty("Amount", Integer.toString(selected.price()));
+            currency.addProperty("Type", "Minecoin");
+            final JsonObject tags = new JsonObject();
+            tags.addProperty("CorrelationId", correlation.toString());
+            final JsonObject request = new JsonObject();
+            request.add("CustomTags", tags);
+            request.addProperty("OfferId", selected.id());
+            request.addProperty("StoreId", "");
+            request.add("VirtualCurrency", currency);
+            return request;
+        } catch (RuntimeException e) {
+            throw new IOException("The catalog returned invalid purchase metadata", e);
+        }
+    }
+
+    static void validatePurchase(final WardrobeItem selected, final JsonObject response) throws IOException {
+        try {
+            final JsonObject result = response.getAsJsonObject("result");
+            if (!selected.id().equals(result.get("offerId").getAsString())
+                    || result.getAsJsonArray("transactionIds").isEmpty())
+                throw new IOException("The Marketplace returned an invalid purchase result");
+            transactionIds(result.getAsJsonArray("transactionIds"));
+        } catch (RuntimeException e) {
+            throw new IOException("The Marketplace returned an invalid purchase result", e);
+        }
+    }
+
+    private static List<String> transactionIds(final JsonArray values) throws IOException {
+        if (values == null) throw new IOException("The Marketplace returned no transaction IDs");
+        final List<String> ids = new ArrayList<>(values.size());
+        for (final var id : values) {
+            if (!id.isJsonPrimitive() || !id.getAsJsonPrimitive().isString() || id.getAsString().isBlank()
+                    || id.getAsString().length() > 256)
+                throw new IOException("The Marketplace returned an invalid transaction ID");
+            ids.add(id.getAsString());
+        }
+        return List.copyOf(ids);
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockOwnedSkinPacks.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockOwnedSkinPacks.java
