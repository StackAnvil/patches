+import com.viaversion.viafabricplus.bedrock.appearance.BedrockCharacterProfiles.ColorTarget;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.persona_PieceType;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+final class BedrockPersonaColorsTest {
+    @Test
+    void requiresLoadedOverrideEnabledPiecesAndDefaultsOmittedFlagsToEnabled() throws Exception {
+        final JsonObject metadata = metadata("persona_eyes");
+        final List<ColorTarget> eyes = List.of(ColorTarget.IRIS, ColorTarget.EYEBROWS, ColorTarget.SCLERA);
+        assertEquals(eyes, BedrockPersonaColors.targets(metadata, true));
+        assertTrue(BedrockPersonaColors.targets(metadata, false).isEmpty());
+        metadata.add("allow_tint_override", JsonNull.INSTANCE);
+        assertEquals(eyes, BedrockPersonaColors.targets(metadata, true));
+        metadata.addProperty("allow_tint_override", false);
+        assertTrue(BedrockPersonaColors.targets(metadata, true).isEmpty());
+        metadata.addProperty("allow_tint_override", true);
+        assertEquals(eyes, BedrockPersonaColors.targets(metadata, true));
+        metadata.addProperty("allow_tint_override", 1);
+        assertThrows(IOException.class, () -> BedrockPersonaColors.targets(metadata, true));
+        assertTrue(BedrockPersonaColors.targets(metadata, false).isEmpty());
+    }
+
+    @Test
+    void limitsControlsToRequestedLoadedTypesAndRejectsConflictingMetadata() throws Exception {
+        final JsonObject hair = metadata("persona_hair"), eyes = metadata("persona_eyes");
+        hair.addProperty("allow_tint_override", false);
+        final var packs = Map.of("hair", pack(hair), "eyes", pack(eyes));
+        assertTrue(BedrockPersonaColors.available(List.of(ColorTarget.HAIR), packs).isEmpty());
+        assertEquals(List.of(ColorTarget.IRIS, ColorTarget.SCLERA),
+            BedrockPersonaColors.available(List.of(ColorTarget.IRIS, ColorTarget.SCLERA), packs));
+        assertTrue(BedrockPersonaColors.available(List.of(ColorTarget.SKIN), packs).isEmpty());
+        assertThrows(IOException.class, () -> BedrockPersonaColors.available(List.of(ColorTarget.HAIR),
+            Map.of("fixed", pack(hair), "editable", pack(metadata("persona_hair")))));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PERSONA_LIVE_PICKER", matches = ".+")
+    void matchesNativeMetadataDefaultsRuntimeCopyAndPickerAvailability() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(
+            Path.of(System.getenv("STACKANVIL_PERSONA_LIVE_PICKER")))).getAsJsonObject();
+        for (final var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var type = persona_PieceType.getByValue(row.get("pieceType").getAsInt(), persona_PieceType.Unknown);
+            final JsonObject metadata = metadata("persona_" + type.name()
+                .replaceAll("([a-z])([A-Z])", "$1_$2").toLowerCase(Locale.ROOT));
+            if (!row.get("override").isJsonNull())
+                metadata.add("allow_tint_override", row.get("override"));
+            assertEquals(row.getAsJsonArray("channels").asList().stream().map(value -> value.getAsInt()).toList(),
+                BedrockPersonaColors.targets(metadata, row.get("loaded").getAsBoolean()).stream()
+                    .map(target -> target == ColorTarget.SKIN ? 0 : target.channel()).toList(), row::toString);
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_OFFICIAL_PERSONA", matches = ".+")
+    void resolvesPickerChannelsFromTheLicensedStarterAssets() throws Exception {
+        final var assets = BedrockBuiltinAssets.index("1.26.51.1",
+            NativeAssetFixture.read(Path.of(System.getenv("STACKANVIL_OFFICIAL_PERSONA"))));
+        final var eyes = assets.piece("a0f263b3-e093-4c85-aadb-3759417898ff");
+        final List<ColorTarget> requested = List.of(ColorTarget.IRIS, ColorTarget.EYEBROWS, ColorTarget.SCLERA);
+        assertEquals(requested, BedrockPersonaColors.available(requested, Map.of(eyes.id(), eyes)));
+        assertTrue(BedrockPersonaColors.available(List.of(ColorTarget.HAIR), Map.of(eyes.id(), eyes)).isEmpty());
+    }
+
+    private static JsonObject metadata(final String type) {
+        final JsonObject metadata = new JsonObject();
+        metadata.addProperty("piece_type", type);
+        return metadata;
+    }
+
+    private static BedrockMarketplaceAssets.Pack pack(final JsonObject metadata) {
+        return new BedrockMarketplaceAssets.Pack("piece",
+            Map.of("piece.meta.json", metadata.toString().getBytes(StandardCharsets.UTF_8)));
+    }
+}
