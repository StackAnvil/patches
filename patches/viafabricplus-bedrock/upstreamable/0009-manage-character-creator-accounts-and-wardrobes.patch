+    @WrapOperation(method = "render3dHud", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/renderer/Projection;setupPerspective(FFFFF)V"))
+    private void nativeProjection(final Projection projection, final float near, final float far, final float fov,
+                                  final float width, final float height, final Operation<Void> original,
+                                  @Local(argsOnly = true) final CameraRenderState camera,
+                                  @Local(argsOnly = true) final PlayerRenderState player) {
+        final var nativeView = camera.isFirstPerson && !camera.isPanoramicMode
+                ? BedrockPlayerSkins.firstPersonProjection(player.avatarRenderState, camera.fogType,
+                    camera.cameraEntityPartialTicks) : null;
+        // Projection retains Java's reversed depth convention and the active GPU depth range.
+        original.call(projection, nativeView == null ? near : nativeView.nearPlane(), far,
+                nativeView == null ? fov : nativeView.fieldOfView(), width, height);
+    }
+}
