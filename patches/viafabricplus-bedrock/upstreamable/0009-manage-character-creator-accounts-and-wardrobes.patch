+    private String currentColor(final ColorTarget target) {
+        if (this.wardrobe == null) {
+            return "";
+        }
+        final Slot slot = this.wardrobe.slots().get(this.selectedSlot);
+        if (target == ColorTarget.SKIN) {
+            return slot.skinColor();
+        }
+        if (this.items == null || this.items.isEmpty()) {
+            return "";
+        }
+        final WardrobeItem item = this.items.get(this.selectedItem);
+        final JsonObject collection = slot.profile().getAsJsonObject("personaCollection");
+        if (collection == null || !collection.has("universalApp")) {
+            return "";
+        }
+        for (final JsonElement entry : collection.getAsJsonArray("universalApp")) {
+            if (!entry.isJsonObject()) {
+                continue;
+            }
+            final JsonObject piece = entry.getAsJsonObject();
+            if (piece.has("id") && item.matches(piece.get("id").getAsString())
+                && piece.has("col") && piece.getAsJsonArray("col").size() > target.channel()) {
+                return piece.getAsJsonArray("col").get(target.channel()).getAsString();
+            }
+        }
+        return "";
+    }
