+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+
+/** Loads native emote previews using the selected account's catalog and receipt. */
+public final class BedrockEmotes {
+    private BedrockEmotes() {}
+
+    public static CompletableFuture<Emote> load(
+            final BedrockAuthManager account, final BedrockCharacterProfiles.WardrobeItem item) {
+        return CompletableFuture.supplyAsync(
+                () -> {
+                    try {
+                        if (!"persona_emote".equals(item.type()))
+                            throw new IOException("Choose a Bedrock emote");
+                        if (isBuiltin(item.packId()))
+                            return read(BedrockBuiltinAssets.load().piece(item.packId()));
+                        return loadPublished(account, item.id(), item.packId());
+                    } catch (Exception e) {
+                        throw new IllegalStateException("Could not load the Bedrock emote", e);
+                    }
+                });
+    }
+
+    static CompletableFuture<Emote> loadRemote(final BedrockAuthManager account, final UUID id) {
+        if (isBuiltin(id.toString())) return loadBuiltin(id);
+        return CompletableFuture.supplyAsync(
+                () -> {
+                    try {
+                        final String product =
+                                catalogProduct(
+                                        BedrockMarketplaceAssets.searchPack(account, id), id);
+                        return loadPublished(account, product, id.toString());
+                    } catch (Exception failure) {
+                        throw new IllegalStateException(
+                                "Could not load the remote Bedrock emote", failure);
+                    }
+                });
+    }
+
+    private static Emote loadPublished(
+            final BedrockAuthManager account, final String product, final String pack)
+            throws Exception {
+        final var published = BedrockMarketplaceAssets.published(account, product);
+        validateCatalog(published, product, pack);
+        // Native previews include locked and paid emotes. They use the account's existing receipt
+        // keys without acquiring an entitlement or saving a recipe.
+        return read(
+                BedrockMarketplaceAssets.decode(
+                        BedrockMarketplaceAssets.download(published, "personabinary"),
+                        pack,
+                        BedrockMarketplaceAssets.accountKeys(account).values()));
+    }
+
+    static String catalogProduct(final JsonObject response, final UUID pack) throws IOException {
+        try {
+            final var items = response.getAsJsonObject("data").getAsJsonArray("Items");
+            if (items.size() > 2)
+                throw new IOException("The emote search exceeded its result limit");
+            String product = null;
+            for (final var entry : items) {
+                final var item = entry.getAsJsonObject();
+                final String candidate = item.get("Id").getAsString();
+                validateCatalog(item, candidate, pack.toString());
+                if (product != null && !product.equals(candidate))
+                    throw new IOException("The emote search returned ambiguous products");
+                product = candidate;
+            }
+            if (product == null)
+                throw new IOException("This emote is not available in the catalog");
+            return product;
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid Bedrock emote search response", invalid);
+        }
+    }
+
+    static void validateCatalog(final JsonObject item, final String product, final String pack)
+            throws IOException {
+        try {
+            if (!UUID.fromString(product).toString().equals(item.get("Id").getAsString())
+                    || !"PersonaDurable".equals(item.get("ContentType").getAsString()))
+                throw new IOException("The catalog returned a different emote product");
+            final var properties = item.getAsJsonObject("DisplayProperties");
+            if (!"persona_emote".equals(properties.get("pieceType").getAsString()))
+                throw new IOException("The catalog product is not an emote");
+            for (final var entry : properties.getAsJsonArray("packIdentity")) {
+                final var identity = entry.getAsJsonObject();
+                if ("persona_piece".equals(identity.get("type").getAsString())
+                        && UUID.fromString(pack)
+                                .toString()
+                                .equals(identity.get("uuid").getAsString())) return;
+            }
+            throw new IOException("The catalog returned a different emote pack");
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid Bedrock emote catalog metadata", invalid);
+        }
+    }
+
+    public static boolean isBuiltin(final String id) {
+        return "persona_emote".equals(BedrockPersonaProfile.defaultType(id));
+    }
+
+    static CompletableFuture<Emote> loadBuiltin(final UUID id) {
+        return CompletableFuture.supplyAsync(
+                () -> {
+                    try {
+                        return read(BedrockBuiltinAssets.load().piece(id.toString()));
+                    } catch (Exception e) {
+                        throw new IllegalStateException(
+                                "Could not load the built-in Bedrock emote", e);
+                    }
+                });
+    }
+
+    static Emote read(final BedrockMarketplaceAssets.Pack pack) throws IOException {
+        try {
+            Emote result = null;
+            for (final var file : pack.files().entrySet()) {
+                if (!file.getKey().endsWith(".meta.json")) continue;
+                final var metadata =
+                        JsonParser.parseString(new String(file.getValue(), StandardCharsets.UTF_8))
+                                .getAsJsonObject();
+                if (!"persona_emote".equals(metadata.get("piece_type").getAsString())) continue;
+                if (result != null) throw new IOException("The emote pack has ambiguous metadata");
+                final var sources = metadata.getAsJsonArray("animation_sources");
+                if (sources == null || sources.isEmpty())
+                    throw new IOException("The emote has no animation sources");
+                // Bedrock 1.26.51.1 selects the first declared source for an emote.
+                final var source = sources.get(0).getAsJsonObject();
+                final String path = source.get("animationFile").getAsString();
+                final byte[] bytes = pack.files().get(path);
+                if (bytes == null || bytes.length > 2 * 1024 * 1024)
+                    throw new IOException("The emote animation file is missing or too large");
+                final var definitions =
+                        JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8))
+                                .getAsJsonObject()
+                                .getAsJsonObject("animations");
+                final var animation = definitions.getAsJsonObject(source.get("name").getAsString());
+                if (animation == null) throw new IOException("The emote animation name is missing");
+                result =
+                        new Emote(
+                                UUID.fromString(pack.id()),
+                                BedrockBoneAnimation.parse(animation),
+                                BedrockEmoteMessages.read(pack.files()));
+            }
+            if (result == null) throw new IOException("The pack has no emote animation");
+            return result;
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid Bedrock emote metadata", e);
+        }
+    }
+
+    public record Emote(UUID id, BedrockBoneAnimation animation, BedrockEmoteMessages messages) {}
+}
