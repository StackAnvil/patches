+    public static CompletableFuture<AccountWardrobe> selectClassic(final BedrockAuthManager account,
+                                                                  final BedrockOwnedSkinPacks.Item owned,
+                                                                  final BedrockClassicSkinPack pack,
+                                                                  final BedrockClassicSkinPack.Skin skin) {
+        if (!pack.skins().contains(skin) || !owned.packId().equals(skin.packId()) || skin.skinId().isBlank()) {
+            return CompletableFuture.failedFuture(new IOException("Invalid account skin selection"));
+        }
+        return load(account).thenCompose(before -> {
+            final int slot = before.activeSlot();
+            if (slot < 1 || slot > before.slots().size()) {
+                return CompletableFuture.failedFuture(new IOException("Select a character slot first"));
+            }
+            return updateProfile(account, slot, before.slots().get(slot - 1).profileHash(), current -> {
+                if (current.activeSlot() != slot) throw new IOException("The active character changed. Select the skin again");
+                if (!current.slots().get(slot - 1).profile().getAsJsonObject("personaCollection")
+                    .equals(before.slots().get(slot - 1).profile().getAsJsonObject("personaCollection"))) {
+                    throw new IOException("This character changed on your account. Select the skin again");
+                }
+                return classicSelectionRequest(current, slot, skin);
+            });
+        });
+    }
