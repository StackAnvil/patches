+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+final class BedrockAccountAppearanceTest {
+    @TempDir Path directory;
+
+    @Test
+    void initializesOnlyTheUnselectedAccountAndPersistsItsCharacter() throws IOException {
+        final var store = this.store();
+        store.load("123");
+        assertFalse(store.hasSavedAppearance("123"));
+        final var character = this.character();
+        final var selected = store.initializeAccountCharacter("123", character).orElseThrow();
+        assertEquals(BedrockAppearanceStore.Selection.PERSONA, selected.selection());
+        assertTrue(store.hasSavedAppearance("123"));
+        assertTrue(store.usesAccountCharacter("123", character.slot()));
+        assertEquals(selected.skinId(), this.store().load("123").skinId());
+        assertEquals(0xFF123456, this.store().load("123").skin().getRGB(0, 0));
+        assertFalse(store.hasSavedAppearance("456"));
+        assertTrue(store.initializeAccountCharacter("123", character).isEmpty());
+    }
+
+    @Test
+    void preservesAChoiceMadeWhileTheAccountModelWasDownloading() throws IOException {
+        final var store = this.store();
+        final var character = this.character();
+        store.select("123", BedrockAppearanceStore.Selection.ALEX);
+        assertTrue(store.initializeAccountCharacter("123", character).isEmpty());
+        assertEquals(BedrockAppearanceStore.Selection.ALEX, this.store().load("123").selection());
+
+        final var image = new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(0, 0, 0xFFABCDEF);
+        final var imported = store.importSkinImage("456", image, true);
+        assertTrue(store.initializeAccountCharacter("456", character).isEmpty());
+        final var saved = this.store().load("456");
+        assertEquals(imported.skinId(), saved.skinId());
+        assertEquals(0xFFABCDEF, saved.skin().getRGB(0, 0));
+        assertTrue(saved.effectiveSlim());
+    }
+
+    private BedrockAppearanceStore store() {
+        return new BedrockAppearanceStore(this.directory, _ -> new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB));
+    }
+
+    private BedrockCharacterProfiles.PreparedPersonaCharacter character() {
+        final var atlas = new BufferedImage(128, 128, BufferedImage.TYPE_INT_ARGB);
+        atlas.setRGB(0, 0, 0xFF123456);
+        final var model = new BedrockPersonaModel.Converted(atlas, "{\"minecraft:geometry\":[]}",
+            "{\"geometry\":{\"default\":\"geometry.account\"}}", List.of());
+        final var slot = new BedrockCharacterProfiles.Slot(2, "slim", "#ff123456", List.of(), "account-profile", new JsonObject());
+        return new BedrockCharacterProfiles.PreparedPersonaCharacter(slot, model, new BedrockPersonaProfile(List.of(), List.of()));
+    }
+}
