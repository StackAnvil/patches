+
+/** Submits the immutable equipped selection alongside the owner model's current pose. */
+public final class BedrockEquippedAttachableLayer extends RenderLayer<AvatarRenderState, PlayerModel> {
+    public BedrockEquippedAttachableLayer(final AvatarRenderer<?> parent) {
+        super(parent);
+    }
+
+    @Override
+    public void submit(final PoseStack poses, final SubmitNodeCollector collector, final int light,
+                       final AvatarRenderState state, final float yaw, final float pitch) {
+        if (!(state instanceof BedrockPlayerAttachables.State nativeState) || state.isSpectator) return;
+        final var deformations = BedrockAnimatedModel.deformations(this.getParentModel());
+        for (final var surface : nativeState.bedrockAttachables()) {
+            collector.order(1).submitModel(surface.model(),
+                    new BedrockPlayerAttachables.Draw(deformations, BedrockAnimatedModel.boneMatrices(this.getParentModel()),
+                            surface.bindings(), surface.selection(), surface.pose()), poses,
+                    surface.renderType(), BedrockActorRenderTypes.lightCoords(light, surface.selection().ignoreLighting()),
+                    OverlayTexture.NO_OVERLAY, state.outlineColor);
+        }
+    }
+}
