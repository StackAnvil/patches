+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockPlayerControllers;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+final class BedrockCostumeVisibilityTest {
+    @Test
+    void showsNormalizedCostumeArmsWithoutChangingCustomActorNames() {
+        final var rules = List.of(new BedrockPlayerControllers.Visibility("*", false),
+                new BedrockPlayerControllers.Visibility("rightArm", true),
+                new BedrockPlayerControllers.Visibility("rightSleeve", true));
+        final var humanoid = BedrockHumanoidVisibilityTest.model(true);
+        humanoid.visibility(rules);
+        assertTrue(BedrockHumanoidVisibilityTest.cube(humanoid, "rightarm").visible);
+        assertTrue(BedrockHumanoidVisibilityTest.cube(humanoid, "rightsleeve").visible);
+        assertFalse(BedrockHumanoidVisibilityTest.cube(humanoid, "leftarm").visible);
+        assertFalse(BedrockHumanoidVisibilityTest.cube(humanoid, "body").visible);
+
+        final var custom = BedrockHumanoidVisibilityTest.model(false);
+        custom.visibility(rules);
+        assertFalse(BedrockHumanoidVisibilityTest.cube(custom, "rightarm").visible);
+        assertFalse(BedrockHumanoidVisibilityTest.cube(custom, "rightsleeve").visible);
+        custom.visibility(List.of(new BedrockPlayerControllers.Visibility("*", false),
+                new BedrockPlayerControllers.Visibility("rightarm", true)));
+        assertTrue(BedrockHumanoidVisibilityTest.cube(custom, "rightarm").visible);
+    }
+
+    @Test
+    void retainsWildcardOrderAndExplicitlyHiddenCostumeParts() {
+        final var humanoid = BedrockHumanoidVisibilityTest.model(true);
+        humanoid.visibility(List.of(new BedrockPlayerControllers.Visibility("*", false),
+                new BedrockPlayerControllers.Visibility("right*", true),
+                new BedrockPlayerControllers.Visibility("rightArm", false)));
+        assertFalse(BedrockHumanoidVisibilityTest.cube(humanoid, "rightarm").visible);
+        assertTrue(BedrockHumanoidVisibilityTest.cube(humanoid, "rightsleeve").visible);
+        assertFalse(BedrockHumanoidVisibilityTest.cube(humanoid, "leftarm").visible);
+        humanoid.visibility(List.of(new BedrockPlayerControllers.Visibility("*", false)));
+        assertFalse(BedrockHumanoidVisibilityTest.cube(humanoid, "rightarm").visible);
+        assertFalse(BedrockHumanoidVisibilityTest.cube(humanoid, "rightsleeve").visible);
+    }
+}
