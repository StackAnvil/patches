+    /** Applies the owner's bind-to-current deformation to matching attachable bones. */
+    void bind(final Map<String, Matrix4f> deformations) {
+        final Map<ModelPart, Matrix4f> original = new HashMap<>();
+        this.parts.values().forEach(part -> this.global(part, original));
+        final Map<ModelPart, Matrix4f> desired = new HashMap<>();
+        this.parts.forEach((name, part) -> {
+            final Matrix4f deformation = deformations.get(name);
+            if (deformation != null) desired.put(part, new Matrix4f(deformation).mul(original.get(part)));
+        });
+        final Map<ModelPart, Matrix4f> resolved = new HashMap<>();
+        this.parts.values().forEach(part -> this.bind(part, desired, resolved));
+    }
+
+    private void bind(final ModelPart part, final Map<ModelPart, Matrix4f> desired,
+                      final Map<ModelPart, Matrix4f> resolved) {
+        if (resolved.containsKey(part)) return;
+        final ModelPart parent = this.parents.get(part);
+        if (parent != null) this.bind(parent, desired, resolved);
+        final Matrix4f target = desired.get(part);
+        if (target != null) {
+            final Matrix4f local = parent == null ? new Matrix4f(target)
+                    : new Matrix4f(resolved.get(parent)).invert().mul(target);
+            final Vector3f position = local.getTranslation(new Vector3f());
+            final Vector3f rotation = local.getUnnormalizedRotation(new Quaternionf()).normalize().getEulerAnglesZYX(new Vector3f());
+            final Vector3f scale = local.getScale(new Vector3f());
+            part.setPos(position.x, position.y, position.z);
+            part.setRotation(rotation.x, rotation.y, rotation.z);
+            part.xScale = scale.x;
+            part.yScale = scale.y;
+            part.zScale = scale.z;
+        }
+        this.global(part, resolved);
+    }
+
+    /** Native animated owners retain the complete authored parent hierarchy in their bind matrices. */
+    Map<String, Matrix4f> deformations() {
+        final Map<ModelPart, Matrix4f> current = new HashMap<>();
+        final Map<String, Matrix4f> result = new HashMap<>();
+        this.parts.forEach((name, part) -> result.put(name, new Matrix4f(this.global(part, current))
+                .mul(new Matrix4f(this.bindMatrices.get(part)).invert())));
+        return Map.copyOf(result);
+    }
