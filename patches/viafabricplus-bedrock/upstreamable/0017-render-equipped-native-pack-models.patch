+        queries.put("is_invisible", state.isInvisible);
+        queries.putAll(BedrockAttachableBindings.queries(entity.getMainArm() == net.minecraft.world.entity.HumanoidArm.RIGHT));
+        queries.put("owner_identifier", "minecraft:player");
+        queries.put("is_owner_identifier_any", (BedrockActorAnimation.Query) names -> names.contains("minecraft:player"));
+        final var actor = BedrockActorState.state(entity.getUUID());
+        final Map<String, Object> properties = actor == null ? Map.of() : actor.properties();
+        for (final EquipmentSlot slot : firstPerson ? List.of(EquipmentSlot.MAINHAND, EquipmentSlot.OFFHAND) : SLOTS) {
+            final ItemStack stack = firstPerson ? slot == EquipmentSlot.MAINHAND ? main : off : entity.getItemBySlot(slot);
+            final boolean hand = slot == EquipmentSlot.MAINHAND || slot == EquipmentSlot.OFFHAND;
+            if (hand && (stack.hasFoil() || stack.has(DataComponents.BANNER_PATTERNS) || !BedrockPlayerSkins.options(state.skin).rendering().getOrDefault("enable_attachables", true))) continue;
+            final Map<String, Object> context = Map.of("is_first_person", firstPerson ? 1F : 0F, "item_slot", slotName(slot));
+            final Map<String, Object> itemQueries = new HashMap<>(queries);
+            itemQueries.put("get_animation_frame", BedrockFirstPersonItemRendering.animationFrame(stack));
+            final Map<String, Float> variables = Map.of("is_first_person", firstPerson ? 1F : 0F,
+                    "is_enchanted", stack.hasFoil() ? 1F : 0F);
+            ItemIdentity identity;
+            try {
+                identity = identify(stack, packs, SELECTORS.computeIfAbsent(entity, _ -> new BedrockAttachableSelection()), properties,
+                        new BedrockActorAnimation.Frame(itemQueries, variables, context));
+            } catch (IOException | RuntimeException invalid) {
+                if (FAILED_SELECTIONS.add(stack.getItem().toString()))
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not select equipped attachable for {}", stack.getItem(), invalid);
+                identity = null;
+            }
+            final ItemIdentity selectedIdentity = identity;
+            final var entry = equipment.update(slot, identity != null && identity.variant().equals("default") ? identity : null, state.ageInTicks, () -> {
+                final Resource resource = RESOURCES.computeIfAbsent(selectedIdentity.identifier(), _ -> load(selectedIdentity.identifier(), packs)).orElse(null);
+                return resource == null ? null : new Equipped(resource,
+                        new BedrockPlayerControllers(resource.definition, packs.getRenderControllers().renderControllers()),
+                        resource.animation == null ? null : resource.animation.playback());
+            });
+            if (entry == null) continue;
+            final Equipped equipped = entry.value();
+            try {
+                final float elapsed = entry.elapsed(state.ageInTicks);
+                final Map<String, BedrockBoneAnimation.Transform> pose = equipped.playback == null ? Map.of()
+                        : equipped.playback.sample(elapsed, new BedrockActorAnimation.Frame(itemQueries, variables, context), false, null);
+                final var selection = equipped.controllers.select(elapsed, properties, itemQueries, variables, context);
+                final List<Surface> slotSurfaces = new ArrayList<>();
+                boolean supported = true;
+                for (final var selected : selection.surfaces()) {
+                    final var controller = packs.getRenderControllers().renderControllers().get(selected.controller());
+                    if (controller == null || !controller.materialsMap().keySet().equals(Set.of("*"))) { supported = false; break; }
+                    final String modelKey = selected.geometry() + "\n" + selected.texture();
+                    if (equipped.resource.unsupportedModels.contains(modelKey)) { supported = false; break; }
+                    var geometry = packs.getModels().entityModels().get(selected.geometry());
+                    final var spriteGeometry = TEXTURE_MESHES.get(selected.geometry());
+                    if (spriteGeometry != null && !equipped.resource.models.containsKey(modelKey)) {
+                        try {
+                            geometry = BedrockTextureMeshes.materialize(spriteGeometry, texturePixels(selected.texture(), packs),
+                                    selected.texture(), equipped.resource.definition.getTextures());
+                        } catch (IllegalArgumentException invalid) {
+                            equipped.resource.unsupportedModels.add(modelKey);
+                            supported = false;
+                            break;
+                        }
+                    }
+                    final Identifier texture = texture(selected.texture(), packs);
+                    final var material = materials.alphaTest(selected.material()).orElse(null);
+                    if (geometry == null || !equipped.resource.models.containsKey(modelKey)
+                            && geometry.getParents().stream().allMatch(parent -> parent.getCubes().isEmpty())
+                            || texture == null || material == null) { supported = false; break; }
+                    final var binding = BINDINGS.get(selected.geometry());
+                    final Map<String, String> bindings = binding == null ? Map.of() : binding.evaluate(new BedrockActorAnimation.Frame(itemQueries, variables, context));
+                    if (hand && !BedrockPlayerSkins.hasBindingBones(state, bindings.values())) { supported = false; break; }
+                    Model<Draw> model = equipped.resource.models.get(modelKey);
+                    if (model == null) {
+                        model = model(geometry);
+                        equipped.resource.models.put(modelKey, model);
+                    }
+                    slotSurfaces.add(new Surface(slot, model, texture, selected, pose, bindings, renderType(texture, selected, material)));
+                }
+                if (supported) result.addAll(slotSurfaces);
+            } catch (IOException | RuntimeException invalid) {
+                if (!equipped.failed) ViaFabricPlusBedrock.impl().logger().warn("Could not evaluate equipped attachable {}", identity.identifier(), invalid);
+                equipped.failed = true;
+            }
+        }
+        if (!firstPerson) for (final Surface surface : result) {
+            switch (surface.slot()) {
+                case HEAD -> {
+                    state.headItem.clear();
+                    state.headEquipment = ItemStack.EMPTY;
+                }
+                case CHEST -> state.chestEquipment = ItemStack.EMPTY;
+                case LEGS -> state.legsEquipment = ItemStack.EMPTY;
+                case FEET -> state.feetEquipment = ItemStack.EMPTY;
+                case MAINHAND, OFFHAND -> {
+                    final boolean right = (surface.slot() == EquipmentSlot.MAINHAND) == (entity.getMainArm() == net.minecraft.world.entity.HumanoidArm.RIGHT);
+                    if (right) state.rightHandItemState.clear(); else state.leftHandItemState.clear();
+                }
+                default -> throw new IllegalStateException("Unsupported equipped attachable slot: " + surface.slot());
+            }
+        }
+        return List.copyOf(result);
+    }
+
+    private static void explicitBindings(final ResourcePackStorage packs) {
+        for (final var pack : packs.getPackStackBottomToTop()) {
+            for (final String path : pack.content().getFilesDeep("models/entity/", ".json")) {
+                try {
+                    final var document = pack.content().getJson(path);
+                    if (document.has("minecraft:geometry")) {
+                        for (final var value : document.getAsJsonArray("minecraft:geometry")) {
+                            final var geometry = value.getAsJsonObject();
+                            binding(geometry.getAsJsonObject("description").get("identifier").getAsString(), geometry);
+                        }
+                    } else {
+                        for (final var entry : document.entrySet()) if (entry.getKey().startsWith("geometry.") && entry.getValue().isJsonObject())
+                            binding(entry.getKey(), entry.getValue().getAsJsonObject());
+                    }
+                } catch (RuntimeException invalid) {
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not inspect attachable geometry bindings {}", path, invalid);
+                }
+            }
+        }
+    }
+
+    private static void binding(final String identifier, final com.viaversion.viaversion.libs.gson.JsonObject geometry) {
+        try {
+            BINDINGS.put(identifier, new BedrockAttachableBindings(com.google.gson.JsonParser.parseString(geometry.toString()).getAsJsonObject()));
+            TEXTURE_MESHES.remove(identifier);
+            if (geometry.has("bones") && geometry.getAsJsonArray("bones").asList().stream()
+                    .anyMatch(value -> value.getAsJsonObject().has("texture_meshes"))) {
+                TEXTURE_MESHES.put(identifier, geometry.deepCopy());
+            }
+        } catch (IOException invalid) { throw new IllegalArgumentException("Invalid native binding", invalid); }
+    }
+
+    private static String slotName(final EquipmentSlot slot) {
+        return switch (slot) { case MAINHAND -> "main_hand"; case OFFHAND -> "off_hand"; default -> slot.getName(); };
+    }
+
+    private static ItemIdentity identify(final ItemStack stack, final ResourcePackStorage packs, final BedrockAttachableSelection selector,
+                                         final Map<String, Object> properties, final BedrockActorAnimation.Frame frame) throws IOException {
+        if (stack == null || stack.isEmpty()) return null;
+        final var nativeData = stack.get(DataComponents.CUSTOM_DATA);
+        final String nativeIdentifier = nativeData == null ? null : nativeData.copyTag().getString(ItemDataRewriter.BEDROCK_IDENTIFIER_TAG).orElse(null);
+        if (nativeIdentifier != null) {
+            final var definition = selector.select(packs.getAttachables(), nativeIdentifier, properties, frame);
+            return definition == null ? null : new ItemIdentity(definition.identifier(), "default");
+        }
+        final Identifier model = stack.get(DataComponents.ITEM_MODEL);
+        final var data = stack.get(DataComponents.CUSTOM_MODEL_DATA);
+        return identify(model, data == null ? List.of() : data.strings(), packs.getAttachables().attachables().keySet());
+    }
+
+    static ItemIdentity identify(final Identifier model, final List<String> variants, final Set<String> identifiers) {
+        if (model == null || !model.getNamespace().equals("viabedrock") || !model.getPath().startsWith("attachables/")) return null;
+        String identifier = null;
+        for (final String candidate : identifiers) {
+            if (!model.getPath().equals("attachables/" + StringUtil.makeIdentifierValueSafe(candidate))) continue;
+            // A lossy safe-path collision is not enough evidence to choose one native item.
+            if (identifier != null) return null;
+            identifier = candidate;
+        }
+        return identifier == null ? null : new ItemIdentity(identifier, variants.isEmpty() ? "default" : variants.getFirst());
+    }
+
+    private static Optional<Resource> load(final String identifier, final ResourcePackStorage packs) {
+        try {
+            final var definition = packs.getAttachables().attachables().get(identifier).attachableData();
+            return Optional.of(new Resource(definition, BedrockActorAnimation.serverAttachable(packs, identifier)));
+        } catch (IOException | RuntimeException invalid) {
+            ViaFabricPlusBedrock.impl().logger().warn("Could not load equipped attachable {}", identifier, invalid);
+            return Optional.empty();
+        }
+    }
+
+    private static Model<Draw> model(final org.cube.converter.model.impl.bedrock.BedrockGeometryModel geometry) {
+        final BedrockAnimatedModel animated = BedrockGeometry.animatedModel(geometry, Map.of());
+        return new Model<>(animated.model().root(), RenderTypes::entityCutout) {
+            @Override
+            public void setupAnim(final Draw draw) {
+                animated.pose(draw.pose());
+                animated.bind(draw.deformations(), draw.ownerBones(), draw.bindings());
+                animated.visibility(draw.selection().visibility());
+            }
+        };
+    }
+
+    private static java.awt.image.BufferedImage texturePixels(final String path, final ResourcePackStorage packs) {
+        for (final var pack : packs.getPackStackTopToBottom()) {
+            final var image = pack.content().getShortnameImage(path);
+            if (image != null) return image.getImage();
+        }
+        return null;
+    }
+
+    private static Identifier texture(final String path, final ResourcePackStorage packs) {
+        final Identifier cached = TEXTURES.get(path);
+        if (cached != null) return cached;
+        for (final var pack : packs.getPackStackTopToBottom()) {
+            final var image = pack.content().getShortnameImage(path);
+            if (image == null) continue;
+            final var pixels = image.getImage();
+            if (pixels == null || pixels.getWidth() < 1 || pixels.getHeight() < 1 || pixels.getWidth() > 4096 || pixels.getHeight() > 4096) return null;
+            final NativeImage nativeImage = new NativeImage(pixels.getWidth(), pixels.getHeight(), false);
+            for (int y = 0; y < pixels.getHeight(); y++) for (int x = 0; x < pixels.getWidth(); x++) {
+                final int argb = pixels.getRGB(x, y);
+                nativeImage.setPixelABGR(x, y, (argb & 0xFF00FF00) | ((argb & 0xFF) << 16) | ((argb >>> 16) & 0xFF));
+            }
+            final Identifier id = Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "attachables/" + TEXTURES.size());
+            Minecraft.getInstance().getTextureManager().register(id, new DynamicTexture(id::toString, nativeImage));
+            TEXTURES.put(path, id);
+            return id;
+        }
+        return null;
+    }
+
+    private static RenderType renderType(final Identifier texture, final BedrockPlayerControllers.Surface selection,
+                                         final BedrockActorMaterialDefinitions.AlphaTest material) {
+        final MaterialKey key = new MaterialKey(texture, material, selection.ignoreLighting(), selection.lightMultiplier(),
+                selection.uv(), BedrockActorRenderTypes.usesNetherLighting());
+        return RENDER_TYPES.computeIfAbsent(key, value -> {
+            final var uv = value.uv();
+            return BedrockActorRenderTypes.create(value.texture(), value.material().cull(), value.ignoreLighting(), value.material().emissive(),
+                    value.multiplier(), new BedrockActorUvTransform(uv.offsetX(), uv.offsetY(), uv.scaleX(), uv.scaleY()), value.nether());
+        });
+    }
+
+    public static void clear() {
+        EQUIPPED.clear();
+        SELECTORS.clear();
+        RESOURCES.clear();
+        if (!TEXTURES.isEmpty()) TEXTURES.values().forEach(Minecraft.getInstance().getTextureManager()::release);
+        RENDER_TYPES.clear();
+        BINDINGS.clear();
+        TEXTURE_MESHES.clear();
+        FIRST_PERSON.clear();
+        FAILED_SELECTIONS.clear();
+        TEXTURES.clear();
+        currentPacks = null;
+        currentLevel = null;
+        materials = null;
+    }
+
+    public interface State {
+        List<Surface> bedrockAttachables();
+        void bedrockAttachables(List<Surface> surfaces);
+    }
+
+    record ItemIdentity(String identifier, String variant) {}
+    public record Surface(EquipmentSlot slot, Model<Draw> model, Identifier texture, BedrockPlayerControllers.Surface selection,
+                          Map<String, BedrockBoneAnimation.Transform> pose, Map<String, String> bindings, RenderType renderType) {}
+    public record Draw(Map<String, Matrix4f> deformations, Map<String, Matrix4f> ownerBones, Map<String, String> bindings, BedrockPlayerControllers.Surface selection,
+                       Map<String, BedrockBoneAnimation.Transform> pose) {}
+
+    private record MaterialKey(Identifier texture, BedrockActorMaterialDefinitions.AlphaTest material,
+                               boolean ignoreLighting, float multiplier, BedrockPlayerControllers.Uv uv, boolean nether) {}
+
+    private static final class Resource {
+        private final org.cube.converter.data.bedrock.BedrockAttachableData definition;
+        private final BedrockActorAnimation animation;
+        private final Map<String, Model<Draw>> models = new HashMap<>();
+        private final Set<String> unsupportedModels = new HashSet<>();
+        private final Map<String, BedrockActorAnimation.ParentSetup> parentSetup = new HashMap<>();
+        private Resource(final org.cube.converter.data.bedrock.BedrockAttachableData definition, final BedrockActorAnimation animation) {
+            this.definition = definition;
+            this.animation = animation;
+        }
+    }
+
+    private static final class Equipped {
+        private final Resource resource;
+        private final BedrockPlayerControllers controllers;
+        private final BedrockActorAnimation.Playback playback;
+        private boolean failed;
+        private Equipped(final Resource resource,
+                         final BedrockPlayerControllers controllers, final BedrockActorAnimation.Playback playback) {
+            this.resource = resource;
+            this.controllers = controllers;
+            this.playback = playback;
+        }
+    }
+}
