+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.EnumMap;
+import java.util.Map;
+import java.util.function.Supplier;
+import net.minecraft.world.entity.EquipmentSlot;
+
+/** Retains one native playback lifetime per occupied equipment slot and item identity. */
+final class BedrockEquipmentCache<T> {
+    private final Map<EquipmentSlot, Entry<T>> slots = new EnumMap<>(EquipmentSlot.class);
+
+    Entry<T> update(final EquipmentSlot slot, final BedrockPlayerAttachables.ItemIdentity identity,
+                    final float age, final Supplier<T> create) {
+        if (identity == null) {
+            this.slots.remove(slot);
+            return null;
+        }
+        final Entry<T> existing = this.slots.get(slot);
+        if (existing != null && existing.identity().equals(identity)) return existing;
+        final T value = create.get();
+        if (value == null) {
+            this.slots.remove(slot);
+            return null;
+        }
+        final Entry<T> replacement = new Entry<>(identity, age, value);
+        this.slots.put(slot, replacement);
+        return replacement;
+    }
+
+    record Entry<T>(BedrockPlayerAttachables.ItemIdentity identity, float started, T value) {
+        float elapsed(final float age) {
+            return Float.isFinite(age) && Float.isFinite(this.started) ? Math.max(0, age - this.started) / 20F : 0;
+        }
+    }
+
+}
