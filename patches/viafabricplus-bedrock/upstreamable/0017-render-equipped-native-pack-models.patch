+    @Test
+    void retainsSlotPlaybackAcrossFramesAndResetsOnReplacementUnequipAndNewConnectionCache() {
+        final var cache = new BedrockEquipmentCache<Object>();
+        final var first = new BedrockPlayerAttachables.ItemIdentity("test:first", "default");
+        final var second = new BedrockPlayerAttachables.ItemIdentity("test:second", "default");
+        final var chest = net.minecraft.world.entity.EquipmentSlot.CHEST;
+        final var initial = cache.update(chest, first, 40, Object::new);
+        assertSame(initial, cache.update(chest, first, 60, () -> fail("Stable equipment must retain its playback")));
+        assertEquals(1, initial.elapsed(60));
+        assertEquals(0, initial.elapsed(20));
+        final var head = cache.update(net.minecraft.world.entity.EquipmentSlot.HEAD, first, 80, Object::new);
+        assertNotSame(initial.value(), head.value());
+        final var replacement = cache.update(chest, second, 90, Object::new);
+        assertNotSame(initial.value(), replacement.value());
+        assertEquals(0, replacement.elapsed(90));
+        assertNull(cache.update(chest, null, 100, () -> fail("Unequip must not allocate playback")));
+        assertNotSame(replacement.value(), cache.update(chest, second, 110, Object::new).value());
+        assertNotSame(head.value(), new BedrockEquipmentCache<>().update(net.minecraft.world.entity.EquipmentSlot.HEAD, first, 120, Object::new).value());
+    }
+
+    @Test
+    void inheritsOneOwnerBodyDeformationAndRetainsLocalChildPivots() throws Exception {
+        final var model = BedrockGeometry.animatedModel(geometry(), Map.of());
+        final var body = model.model().root().getChild("root").getChild("waist").getChild("body");
+        final var wing = body.getChild("wing");
+        final var deformation = new Matrix4f().translate(2, 3, 4).rotateY((float) Math.PI / 2).scale(2);
+        for (int frame = 0; frame < 3; frame++) {
+            model.pose(Map.of());
+            model.bind(Map.of("body", deformation));
+            final var locator = new BedrockModelLocators.Locator("wing", 0, 0, 0, 0, 0, 0, false);
+            final var actual = model.locatorTransform(locator).getTranslation(new Vector3f());
+            final var expected = deformation.transformPosition(new Vector3f(4, 0, 2), new Vector3f());
+            assertEquals(expected.x, actual.x, .0001F);
+            assertEquals(expected.y, actual.y, .0001F);
+            assertEquals(expected.z, actual.z, .0001F);
+            assertEquals(4, wing.x);
+            assertEquals(2, wing.z);
+        }
+        model.pose(Map.of());
+        model.bind(Map.of());
+        assertEquals(0, body.x);
+        assertEquals(-12, body.y);
+    }
+
+    @Test
+    void appliesOrderedSurfaceVisibilityWithoutHidingControlledChildBones() throws Exception {
+        final var model = BedrockGeometry.animatedModel(geometry(), Map.of());
+        final var body = model.model().root().getChild("root").getChild("waist").getChild("body");
+        final var wing = body.getChild("wing");
+        model.visibility(List.of(new BedrockPlayerControllers.Visibility("*", false), new BedrockPlayerControllers.Visibility("wing", true)));
+        assertFalse(body.getChild("cube_0").visible);
+        assertTrue(wing.getChild("cube_0").visible);
+        model.visibility(List.of(new BedrockPlayerControllers.Visibility("w*", false)));
+        assertTrue(body.getChild("cube_0").visible);
+        assertFalse(wing.getChild("cube_0").visible);
+        model.visibility(List.of());
+        assertTrue(wing.getChild("cube_0").visible);
+    }
+
+    private static BedrockGeometryModel geometry() throws Exception {
+        return BedrockGeometryModel.fromJson("""
+            {"minecraft:geometry":[{"description":{"identifier":"geometry.worn","texture_width":64,"texture_height":64},
+             "bones":[{"name":"root","pivot":[0,0,0]},
+              {"name":"waist","parent":"root","pivot":[0,12,0]},
+              {"name":"body","parent":"waist","pivot":[0,24,0],"cubes":[{"origin":[-1,20,-1],"size":[2,4,2],"uv":[0,0]}]},
+              {"name":"wing","parent":"body","pivot":[4,24,2],"cubes":[{"origin":[4,20,2],"size":[8,8,0],"uv":{"south":{"uv":[0,0],"uv_size":[8,8]}}}]}]}]}
+            """).getFirst();
+    }
+
