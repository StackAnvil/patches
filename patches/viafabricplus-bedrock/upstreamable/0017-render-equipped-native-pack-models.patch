diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockAttachableMatricesTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockAttachableMatricesTest.java
new file mode 100644
index 0000000..a99fd48
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockAttachableMatricesTest.java
@@ -0,0 +1,150 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
