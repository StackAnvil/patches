+    /** Applies the owner's bind-to-current deformation to matching attachable bones. */
+    void bind(final Map<String, Matrix4f> deformations) {
+        this.boundMatrices.clear();
+        final Map<ModelPart, Matrix4f> original = new HashMap<>();
+        this.parts.values().forEach(part -> this.global(part, original));
+        this.parts.forEach((name, part) -> {
+            final Matrix4f deformation = deformations.get(name);
+            if (deformation != null) this.boundMatrices.put(part, new Matrix4f(deformation).mul(original.get(part)));
+        });
+    }
+
+    /** Native animated owners retain the complete authored parent hierarchy in their bind matrices. */
+    Map<String, Matrix4f> deformations() {
+        final Map<ModelPart, Matrix4f> current = new HashMap<>();
+        final Map<String, Matrix4f> result = new HashMap<>();
+        this.parts.forEach((name, part) -> result.put(name, new Matrix4f(this.global(part, current))
+                .mul(new Matrix4f(this.bindMatrices.get(part)).invert())));
+        return Map.copyOf(result);
+    }
+
+    static Map<String, Matrix4f> deformations(final PlayerModel owner) {
+        if (owner instanceof BedrockPlayerModel nativeOwner) {
+            final Map<String, Matrix4f> animated = nativeOwner.animatedDeformations();
+            if (animated != null) return animated;
+        }
+        final Map<String, ModelPart> bones = Map.of("head", owner.head, "body", owner.body,
+                "rightarm", owner.rightArm, "leftarm", owner.leftArm, "rightleg", owner.rightLeg, "leftleg", owner.leftLeg);
+        final Map<String, Matrix4f> result = new HashMap<>();
+        bones.forEach((name, bone) -> {
+            final var rest = bone.getInitialPose();
+            final Matrix4f bind = new Matrix4f().translate(rest.x(), rest.y(), rest.z())
+                    .rotateZYX(rest.zRot(), rest.yRot(), rest.xRot()).scale(rest.xScale(), rest.yScale(), rest.zScale());
+            final Matrix4f current = new Matrix4f().translate(bone.x, bone.y, bone.z)
+                    .rotateZYX(bone.zRot, bone.yRot, bone.xRot).scale(bone.xScale, bone.yScale, bone.zScale);
+            result.put(name, current.mul(bind.invert()));
+        });
+        return Map.copyOf(result);
+    }
+
+    void visibility(final List<BedrockPlayerControllers.Visibility> rules) {
+        this.parts.forEach((name, part) -> {
+            boolean visible = true;
+            for (final var rule : rules) if (rule.matches(this.names.get(part))) visible = rule.visible();
+            // Hide this bone's authored surfaces without implicitly hiding independently controlled descendants.
+            for (int cube = 0; part.hasChild("cube_" + cube); cube++) part.getChild("cube_" + cube).visible = visible;
+            if (part.hasChild("mesh")) part.getChild("mesh").visible = visible;
+        });
+    }
+
     private Matrix4f global(final ModelPart part, final Map<ModelPart, Matrix4f> matrices) {
         final Matrix4f cached = matrices.get(part);
         if (cached != null) return cached;
+        final Matrix4f bound = this.boundMatrices.get(part);
+        if (bound != null) {
+            final Matrix4f transform = new Matrix4f(bound);
+            matrices.put(part, transform);
+            return transform;
+        }
         final ModelPart parent = this.parents.get(part);
         final Matrix4f transform =
                 parent == null ? new Matrix4f() : new Matrix4f(this.global(parent, matrices));
