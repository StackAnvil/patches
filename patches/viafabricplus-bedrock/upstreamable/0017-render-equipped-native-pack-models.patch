+/** Native equipped pack models, with independent equipment lifetimes and connection-owned resources. */
+public final class BedrockPlayerAttachables {
+    private static final List<EquipmentSlot> SLOTS = List.of(EquipmentSlot.HEAD, EquipmentSlot.CHEST, EquipmentSlot.LEGS, EquipmentSlot.FEET, EquipmentSlot.MAINHAND, EquipmentSlot.OFFHAND);
+    private static final Map<Avatar, BedrockEquipmentCache<Equipped>> EQUIPPED = new WeakHashMap<>();
