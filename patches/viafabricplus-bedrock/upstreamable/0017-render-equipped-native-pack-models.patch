+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.LinkedHashMap;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+/** Native equipment inherits the bundled target library below accepted server overrides. */
+public final class BedrockEquipmentResources {
+    private static ResourcePackStorage source;
+    private static CompletableFuture<ResourcePackStorage> equipment;
+    private static boolean failed;
+
+    private BedrockEquipmentResources() {}
+
+    public static synchronized ResourcePackStorage get(final ResourcePackStorage accepted) throws IOException {
+        if (accepted == null) return null;
+        if (source != accepted) {
+            source = accepted;
+            failed = false;
+            equipment = CompletableFuture.supplyAsync(() -> {
+                try {
+                    return merge(BedrockBuiltinAssets.load().library(),
+                            NativeActorLibrary.resources(accepted.getPackStackBottomToTop(), accepted::isServerPack));
+                } catch (IOException invalid) { throw new CompletionException(invalid); }
+            });
+        }
+        if (failed) return null;
+        try { return equipment.getNow(null); }
+        catch (CompletionException invalid) {
+            failed = true;
+            throw new IOException("Could not prepare native equipment", invalid.getCause());
+        }
+    }
+
+    static ResourcePackStorage merge(final BedrockResourceLibrary builtin,
+                                     final List<NativeActorLibrary.Layer> accepted) throws IOException {
+        final List<NativeActorLibrary.Layer> layers = new ArrayList<>(
+                NativeActorLibrary.resources(builtin.resourcePacks(), _ -> false));
+        layers.addAll(accepted);
+        final BedrockResourceLibrary library = BedrockResourceLibrary.withServerPacks(builtin,
+                accepted.stream().map(NativeActorLibrary.Layer::resources).toList());
+        final Set<String> equippedModels = new HashSet<>();
+        final Set<String> equippedTextures = new HashSet<>();
+        for (final var layer : layers) {
+            for (final var entry : layer.resources().entrySet()) {
+                if (!entry.getKey().startsWith("attachables/") || !entry.getKey().endsWith(".json")) continue;
+                final JsonObject attachable = JsonParser.parseString(new String(entry.getValue(),
+                        StandardCharsets.UTF_8)).getAsJsonObject().getAsJsonObject("minecraft:attachable");
+                if (attachable == null) continue;
+                final JsonObject textures = attachable.getAsJsonObject("description").getAsJsonObject("textures");
+                if (textures != null) textures.entrySet().forEach(texture -> equippedTextures.add(texture.getValue().getAsString()));
+                final JsonObject geometries = attachable.getAsJsonObject("description").getAsJsonObject("geometry");
+                if (geometries != null) geometries.entrySet().forEach(entryModel -> equippedModels.add(entryModel.getValue().getAsString()));
+            }
+        }
+        final List<NativeActorLibrary.Layer> resolved = new ArrayList<>();
+        for (final var layer : layers) {
+            final var resources = new LinkedHashMap<String, byte[]>();
+            layer.resources().forEach((path, bytes) -> {
+                if (path.equals("manifest.json") || path.startsWith("attachables/") || path.startsWith("animations/")
+                        || path.startsWith("animation_controllers/") || path.startsWith("render_controllers/")
+                        || path.startsWith("materials/") || path.startsWith("textures/") && path.length() > 4
+                        && equippedTextures.contains(path.substring(0, path.length() - 4))) resources.put(path, bytes);
+            });
+            for (final var entry : layer.resources().entrySet()) {
+                if (!entry.getKey().startsWith("models/") || !entry.getKey().endsWith(".json")) continue;
+                final JsonObject document = JsonParser.parseString(
+                        new String(entry.getValue(), StandardCharsets.UTF_8)).getAsJsonObject();
+                final JsonArray geometries = new JsonArray();
+                if (document.has("minecraft:geometry")) {
+                    for (final var definition : document.getAsJsonArray("minecraft:geometry")) {
+                        final String identifier = definition.getAsJsonObject().getAsJsonObject("description").get("identifier").getAsString();
+                        if (equippedModels.contains(identifier)) geometries.add(definition.deepCopy());
+                    }
+                } else {
+                    // Resolve selected legacy models against the complete inherited library, then discard unused parents.
+                    for (final var definition : document.entrySet()) {
+                        if (!definition.getKey().startsWith("geometry.")
+                                || !equippedModels.contains(definition.getKey().split(":", -1)[0])) continue;
+                        final JsonObject selected = new JsonObject();
+                        if (document.has("format_version")) selected.add("format_version", document.get("format_version"));
+                        selected.add(definition.getKey(), definition.getValue());
+                        geometries.add(BedrockLegacyGeometry.read(selected,
+                                definition.getKey().split(":", -1)[0], library::model));
+                    }
+                }
+                if (geometries.isEmpty()) continue;
+                final JsonObject normalized = new JsonObject();
+                normalized.addProperty("format_version", "1.12.0");
+                normalized.add("minecraft:geometry", geometries);
+                resources.put(entry.getKey(), normalized.toString().getBytes(StandardCharsets.UTF_8));
+            }
+            resolved.add(new NativeActorLibrary.Layer(layer.server(), resources));
+        }
+        return ResourcePackStorage.nativeActors(resolved);
+    }
+
+    public static synchronized void clear() {
+        source = null;
+        equipment = null;
+        failed = false;
+    }
+}
