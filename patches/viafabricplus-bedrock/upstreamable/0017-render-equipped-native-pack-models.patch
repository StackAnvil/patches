+final class BedrockAttachableBindingsTest {
+    @Test
+    void bindsHeldItemsByHandednessAndMovesTheUsingSpyglassToTheHead() throws Exception {
+        final var binding = new BedrockAttachableBindings(JsonParser.parseString("""
+            {"bones":[{"name":"scope","binding":"q.item_slot_to_bone_name(q.main_hand_item_use_duration > 0 ? 'head' : c.item_slot)"}]}
+            """).getAsJsonObject());
+        final var transforms = Map.of("rightItem", 5F, "leftItem", -5F, "head", 0F);
