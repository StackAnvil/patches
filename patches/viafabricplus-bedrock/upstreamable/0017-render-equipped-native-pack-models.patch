@@ -0,0 +1,46 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+final class BedrockEquippedAnimationTest {
+    @Test
+    void resolvesPackAttachableGraphAndKeepsHeldSpawnScaleAcrossFrames() throws Exception {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"test\",\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":[1,0,0]}}");
+        content.putString("attachables/worn.json", """
+            {"format_version":"1.10.0","minecraft:attachable":{"description":{"identifier":"test:worn",
+             "materials":{"default":"entity_alphatest"},"textures":{"default":"textures/worn"},"geometry":{"default":"geometry.worn"},
+             "animations":{"spawn":"animation.worn.spawn","idle":"animation.worn.idle"},
+             "scripts":{"pre_animation":["v.first=c.is_first_person;"],"animate":["spawn",{"idle":"!v.first"}]},"render_controllers":[]}}}
+            """);
+        content.putString("animations/worn.json", """
+            {"format_version":"1.8.0","animations":{
+             "animation.worn.spawn":{"loop":"hold_on_last_frame","animation_length":0.64,
+              "bones":{"wing":{"scale":{"0":[0,1,0],"0.64":[1,1,1]}}}},
+             "animation.worn.idle":{"loop":true,"bones":{"wing":{"rotation":[0,"math.cos(q.anim_time*100)*6",0]}}}}}
+            """);
+        final var packs = new ResourcePackStorage(List.of(new ResourcePack(content)));
+        final var graph = BedrockActorAnimation.serverAttachable(packs, "test:worn");
+        assertNotNull(graph);
+        final var playback = graph.playback();
+        final var frame = new BedrockActorAnimation.Frame(Map.of(), Map.of(), Map.of("is_first_person", 0));
+        assertEquals(0, playback.sample(0, frame).get("wing").scale().x());
+        assertEquals(.5F, playback.sample(.32F, frame).get("wing").scale().x(), .0001F);
+        final var settled = playback.sample(1, frame).get("wing");
+        assertEquals(1, settled.scale().x());
+        assertEquals(1, playback.sample(2, frame).get("wing").scale().x());
+        assertNotEquals(settled.rotation().y(), playback.sample(2, frame).get("wing").rotation().y());
+        // A new equipment instance starts its own spawn rather than inheriting the old item's clock.
+        assertEquals(0, graph.playback().sample(0, frame).get("wing").scale().x());
+        assertNull(BedrockActorAnimation.serverAttachable(packs, "test:absent"));
+    }
+
+}
