+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.awt.image.BufferedImage;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockTextureMeshesTest {
+    @Test
+    void targetSpriteThresholdAndPixelDepthPreserveAuthoredPositionAndRotation() {
+        final var image = new BufferedImage(32, 16, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(3, 4, 0x01FFFFFF);
+        image.setRGB(5, 6, 0x02FFFFFF);
+        final var source = geometry("{\"position\":[0,-5,-3],\"rotation\":[90,0,-49],\"texture\":\"default\"}");
+        final var model = materialize(source, image);
+        final var cubes = model.getParents().getFirst().getCubes();
+        assertEquals(1, cubes.size());
+        final var cube = cubes.values().iterator().next();
+        assertEquals(2.5F, cube.getPosition().getX());
+        assertEquals(-5F, cube.getPosition().getY());
+        assertEquals(3F, cube.getPosition().getZ());
+        assertEquals(0.5F, cube.getSize().getX());
+        assertEquals(2F, cube.getSize().getY());
+        assertEquals(1F, cube.getSize().getZ());
+        assertEquals(90F, cube.getRotation().getX());
+        assertEquals(-49F, cube.getRotation().getZ());
+        assertEquals(-5F, cube.getPivot().getY());
+        final var part = BedrockGeometry.animatedModel(model, Map.of()).model().root()
+                .getChild("rightitem").getChild("cube_0");
+        assertFalse(part.isEmpty());
+        final var renderedCube = part.getRandomCube(net.minecraft.util.RandomSource.create(0));
+        assertEquals(6, renderedCube.polygons.length);
+        assertEquals((float) Math.toRadians(90), part.xRot, 0.00001F);
+        assertEquals((float) Math.toRadians(-49), part.zRot, 0.00001F);
+        assertTrue(java.util.Arrays.stream(renderedCube.polygons)
+                .allMatch(face -> face.vertices().length == 4));
+        assertTrue(source.getAsJsonArray("bones").get(0).getAsJsonObject().has("texture_meshes"));
+    }
+
+    @Test
+    void explicitDepthAndLocalPivotFollowNativeTransformOrder() {
+        final var image = new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(4, 5, -1);
+        final var source = geometry("{\"texture\":\"default\",\"position\":[7,8,9],\"local_pivot\":[1,2,3],\"scale\":[2,3,4],\"use_pixel_depth\":false}");
+        final var cube = materialize(source, image).getParents().getFirst().getCubes().get(0);
+        assertEquals(14F, cube.getPosition().getX());
+        assertEquals(6F, cube.getPosition().getY());
+        assertEquals(26F, cube.getPosition().getZ());
+        assertEquals(2F, cube.getSize().getX());
+        assertEquals(3F, cube.getSize().getY());
+        assertEquals(4F, cube.getSize().getZ());
+        assertEquals(7F, cube.getPivot().getX());
+    }
+
+    @Test
+    void textureAndVoxelBoundsPreventUnboundedPackGeometry() {
+        final var source = geometry("{\"texture\":\"default\"}");
+        assertThrows(IllegalArgumentException.class, () -> materialize(source,
+                new BufferedImage(257, 1, BufferedImage.TYPE_INT_ARGB)));
+        final var image = new BufferedImage(128, 128, BufferedImage.TYPE_INT_ARGB);
+        for (int x = 0; x < 128; x++) for (int y = 0; y < 128; y++) image.setRGB(x, y, -1);
+        assertThrows(IllegalArgumentException.class, () -> materialize(source, image));
+    }
+
+    @Test
+    void separateTextureMeshesRetainJavaFallbackInsteadOfUsingTheWrongPixels() {
+        final var source = geometry("{\"texture\":\"other\"}");
+        assertThrows(IllegalArgumentException.class, () -> materialize(source,
+                new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB)));
+    }
+
+    private static org.cube.converter.model.impl.bedrock.BedrockGeometryModel materialize(
+            final com.viaversion.viaversion.libs.gson.JsonObject source, final BufferedImage image) {
+        return BedrockTextureMeshes.materialize(source, image, "textures/items/test", Map.of("default", "textures/items/test"));
+    }
+
+    private static com.viaversion.viaversion.libs.gson.JsonObject geometry(final String mesh) {
+        return JsonParser.parseString("{\"description\":{\"identifier\":\"geometry.sprite\",\"texture_width\":16,\"texture_height\":16},"
+                + "\"bones\":[{\"name\":\"rightitem\",\"texture_meshes\":[" + mesh + "]}]}").getAsJsonObject();
+    }
+}
