+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockBoneAnimation;
+import java.util.Map;
+import net.minecraft.client.model.geom.ModelPart;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+
+final class BedrockAttachableMatricesTest {
+    @Test
+    void carriesShearAndReflectionsThroughBoundBonesDescendantsLocatorsAndDrawing() throws Exception {
+        final var model = model();
+        final var body = model.model().root().getChild("root").getChild("body");
+        final var wing = body.getChild("wing");
+        final var local = new Matrix4f().translation(4, -8, 3).rotateZYX(radians(30), radians(20), radians(10));
+        for (final float scaleX : new float[]{2, -2}) {
+            model.pose(Map.of());
+            final var deformation = new Matrix4f().translation(2, 3, 4).rotateY(.7F).scale(scaleX, 3, .5F);
+            final var bodyMatrix = new Matrix4f(deformation).mul(bodyBind());
+            final var wingMatrix = new Matrix4f(bodyMatrix).mul(local);
+            // Rotated bones under nonuniform scale have nonorthogonal columns that TRS cannot preserve.
+            assertTrue(Math.abs(bodyMatrix.getColumn(0, new Vector3f()).dot(bodyMatrix.getColumn(1, new Vector3f()))) > .1F);
+            model.bind(Map.of("body", deformation));
+            assertTrue(model.usesNativeMatrices());
+            assertTrue(drawing(bodyMatrix).equals(model.drawingMatrices().get(body), .000002F));
+            assertTrue(drawing(wingMatrix).equals(model.drawingMatrices().get(wing), .000002F));
+            final var locator = new BedrockModelLocators.Locator("wing", 0, 0, 0, 0, 0, 0, false);
+            assertTrue(wingMatrix.equals(model.locatorTransform(locator), .00002F));
+            assertDraw(model, wing, drawing(wingMatrix), true);
+            // Binding owns its matrices and leaves the authored local animation pose intact.
+            deformation.identity();
+            assertTrue(drawing(bodyMatrix).equals(model.drawingMatrices().get(body), .000002F));
+            assertEquals(1, body.x);
+            assertEquals(-12, body.y);
+        }
+    }
+
+    @Test
+    void drawsIndependentlyBoundChildrenOfSingularParentsWithoutAnInverse() throws Exception {
+        final var model = model();
+        final var root = model.model().root().getChild("root");
+        final var body = root.getChild("body");
+        final var wing = body.getChild("wing");
+        final var deformation = new Matrix4f().translation(-2, 6, 4).rotateX(.3F).scale(2, 3, 4);
+        final var bodyMatrix = new Matrix4f(deformation).mul(bodyBind());
+        final var wingMatrix = new Matrix4f(bodyMatrix).translate(4, -8, 3)
+                .rotateZYX(radians(30), radians(20), radians(10));
+        for (int frame = 0; frame < 3; frame++) {
+            model.bind(Map.of("root", new Matrix4f().scale(0), "body", deformation));
+            assertTrue(model.drawingMatrices().get(root).isFinite());
+            assertEquals(0, model.drawingMatrices().get(root).determinant());
+            assertTrue(drawing(bodyMatrix).equals(model.drawingMatrices().get(body), .000002F));
+            assertDraw(model, wing, drawing(wingMatrix), true);
+        }
+        model.pose(Map.of("root", transform(false, 0)));
+        model.bind(Map.of("body", deformation));
+        assertTrue(model.drawingMatrices().get(body).isFinite());
+        assertDraw(model, wing, model.drawingMatrices().get(wing), false);
+        model.pose(Map.of());
+        assertFalse(model.usesNativeMatrices());
+        assertTrue(drawing(bodyBind()).equals(model.drawingMatrices().get(body), .000002F));
+    }
+
+    @Test
+    void keepsEntityRelativeChildBasisAndReplacesBindingsWithoutAccumulating() throws Exception {
+        final var model = model();
+        final var body = model.model().root().getChild("root").getChild("body");
+        final var wing = body.getChild("wing");
+        model.pose(Map.of("wing", transform(true, 1)));
+        final var deformation = new Matrix4f().rotateZ(.9F).scale(2, .5F, 3);
+        final var origin = new Matrix4f(deformation).mul(bodyBind()).transformPosition(new Vector3f(4, -8, 3));
+        final var expected = new Matrix4f().translation(origin).rotateZYX(radians(30), radians(20), radians(10));
+        for (int frame = 0; frame < 3; frame++) {
+            model.bind(Map.of("body", deformation));
+            assertTrue(drawing(expected).equals(model.drawingMatrices().get(wing), .000002F));
+            assertDraw(model, wing, drawing(expected), true);
+        }
+        model.bind(Map.of());
+        assertTrue(model.usesNativeMatrices());
+        assertTrue(drawing(bodyBind()).equals(model.drawingMatrices().get(body), .000002F));
+        model.pose(Map.of());
+        assertFalse(model.usesNativeMatrices());
+    }
+
+    private static void assertDraw(final BedrockAnimatedModel model, final ModelPart wing,
+                                   final Matrix4f expected, final boolean checkNormal) {
+        final var poses = new PoseStack();
+        poses.translate(2, 3, 4);
+        poses.rotate(new org.joml.Quaternionf().rotationY(.4F));
+        final var base = new Matrix4f(poses.last().pose());
+        BedrockModelTransforms.visit(model.model().root(), poses, () -> {
+            apply(model.model().root(), poses);
+            final var root = model.model().root().getChild("root");
+            apply(root, poses);
+            apply(root.getChild("body"), poses);
+            apply(wing, poses);
+            final var combined = new Matrix4f(base).mul(expected);
+            assertTrue(combined.equals(poses.last().pose(), .000005F));
+            assertEquals(0, combined.transformPosition(new Vector3f(.2F, .3F, .4F))
+                    .distance(poses.last().pose().transformPosition(new Vector3f(.2F, .3F, .4F))), .000001F);
+            if (checkNormal) {
+                final var normal = new Vector3f(.2F, .7F, .3F).normalize();
+                final var expectedNormal = combined.normal(new org.joml.Matrix3f()).transform(new Vector3f(normal)).normalize();
+                assertEquals(0, expectedNormal.distance(poses.last().normal().transform(normal).normalize()), .000001F);
+            }
+        });
+    }
+
+    private static void apply(final ModelPart part, final PoseStack poses) {
+        BedrockModelTransforms.transform(part, poses, () -> part.translateAndRotate(poses));
+    }
+
+    private static Matrix4f bodyBind() {
+        return new Matrix4f().translation(0, 24, 0).rotateZYX(radians(20), radians(30), radians(15))
+                .translate(1, -12, 2).rotateZYX(radians(35), radians(-10), radians(25));
+    }
+
+    private static Matrix4f drawing(final Matrix4f pixels) {
+        return new Matrix4f(pixels).m30(pixels.m30() / 16F).m31(pixels.m31() / 16F).m32(pixels.m32() / 16F);
+    }
+
+    private static float radians(final float degrees) {
+        return (float) Math.toRadians(degrees);
+    }
+
+    private static BedrockBoneAnimation.Transform transform(final boolean relative, final float scale) {
+        return new BedrockBoneAnimation.Transform(new BedrockBoneAnimation.Vector(0, 0, 0),
+                new BedrockBoneAnimation.Vector(0, 0, 0), new BedrockBoneAnimation.Vector(scale, scale, scale), relative);
+    }
+
+    private static BedrockAnimatedModel model() throws Exception {
+        final var geometry = BedrockGeometryModel.fromJson("""
+            {"minecraft:geometry":[{"description":{"identifier":"geometry.test","texture_width":64,"texture_height":64},
+            "bones":[{"name":"root","pivot":[0,0,0],"rotation":[15,30,20]},
+            {"name":"body","parent":"root","pivot":[1,12,2],"rotation":[25,-10,35]},
+            {"name":"wing","parent":"body","pivot":[5,20,5],"rotation":[10,20,30]}]}]}
+            """).getFirst();
+        return BedrockGeometry.animatedModel(geometry, Map.of());
+    }
+}
