diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockAttachableSelectionTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockAttachableSelectionTest.java
new file mode 100644
index 0000000..6bdd22d
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockAttachableSelectionTest.java
@@ -0,0 +1,46 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+class BedrockAttachableSelectionTest {
+    @Test
+    void selectsOwnerBindingsBeforeGenericItemsAndReevaluatesFrameConditions() throws Exception {
+        final String item = "minecraft:iron_chestplate";
+        final String player = item + ".player";
+        final var resources = Map.of(
+                "manifest.json", ("{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"fixture\"}}").getBytes(java.nio.charset.StandardCharsets.UTF_8),
+                "attachables/generic.json", definition(item, null),
+                "attachables/player.json", definition(player, "query.owner_identifier == 'minecraft:player' && query.property('test:enabled') && context.item_slot == 'chest'"));
+        final var packs = ResourcePackStorage.nativeActors(List.of(new NativeActorLibrary.Layer(true, resources)));
+        final var selector = new BedrockAttachableSelection();
+        final var wearer = new BedrockActorAnimation.Frame(Map.of("owner_identifier", "minecraft:player"), Map.of(), Map.of("item_slot", "chest"));
+        assertEquals(player, selector.select(packs.getAttachables(), item, Map.of("test:enabled", true), wearer).identifier());
+        assertEquals(item, selector.select(packs.getAttachables(), item, Map.of("test:enabled", false), wearer).identifier());
+        final var mob = new BedrockActorAnimation.Frame(Map.of("owner_identifier", "minecraft:zombie"), Map.of(), Map.of("item_slot", "chest"));
+        assertEquals(item, selector.select(packs.getAttachables(), item, Map.of("test:enabled", true), mob).identifier());
+        assertNull(selector.select(packs.getAttachables(), "minecraft:apple", Map.of(), wearer));
+        assertEquals(player, selector.select(packs.getAttachables(), item, Map.of("test:enabled", true), wearer).identifier());
+    }
+
+    private static byte[] definition(final String identifier, final String condition) {
+        final var description = new com.google.gson.JsonObject();
+        description.addProperty("identifier", identifier);
+        if (condition != null) {
+            final var bindings = new com.google.gson.JsonObject();
+            bindings.addProperty("minecraft:iron_chestplate", condition);
+            description.add("item", bindings);
+        }
+        final var attachable = new com.google.gson.JsonObject();
+        attachable.add("description", description);
+        final var root = new com.google.gson.JsonObject();
+        root.addProperty("format_version", "1.10.0");
+        root.add("minecraft:attachable", attachable);
+        return root.toString().getBytes(java.nio.charset.StandardCharsets.UTF_8);
+    }
+}
