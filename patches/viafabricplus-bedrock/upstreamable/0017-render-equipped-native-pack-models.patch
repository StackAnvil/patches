+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.util.List;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import net.raphimc.viabedrock.api.resourcepack.definition.AttachableDefinitions;
+
+/** Evaluate item-to-attachable bindings with the wearer's current query and equipment context. */
+public final class BedrockAttachableSelection {
+    private final BedrockMolang molang = new BedrockMolang();
+    private final Map<String, BedrockMolang.Program> conditions = new LinkedHashMap<>(16, 0.75F, true) {
+        @Override
+        protected boolean removeEldestEntry(final Map.Entry<String, BedrockMolang.Program> eldest) { return this.size() > 256; }
+    };
+
+    public AttachableDefinitions.AttachableDefinition select(final AttachableDefinitions definitions, final String item,
+                                                            final Map<String, Object> properties, final BedrockActorAnimation.Frame frame) throws IOException {
+        final Map<String, Object> queries = new HashMap<>(frame.queries());
+        queries.put("has_property", (BedrockActorAnimation.Query) names -> !names.isEmpty() && properties.containsKey(names.getFirst().toString()));
+        queries.put("property", (BedrockActorAnimation.Query) names -> names.isEmpty() ? 0F : properties.getOrDefault(names.getFirst().toString(), 0F));
+        this.molang.queries(queries);
+        this.molang.variables(frame.variables());
+        this.molang.context(frame.context());
+        try {
+            return definitions.selectItem(item, this::matches);
+        } catch (UncheckedIOException invalid) {
+            throw invalid.getCause();
+        }
+    }
+
+    private boolean matches(final String expression) {
+        try {
+            var program = this.conditions.get(expression);
+            if (program == null) {
+                program = BedrockMolang.Program.script(List.of(expression));
+                this.conditions.put(expression, program);
+            }
+            return this.molang.value(program).getAsBoolean();
+        } catch (IOException invalid) {
+            throw new UncheckedIOException(invalid);
+        }
+    }
+}
