+    private static ResourcePackStorage resources(final Avatar entity) {
+        final ResourcePackStorage packs;
+        try {
+            packs = BedrockEquipmentResources.get(BedrockActorResources.get());
+        } catch (IOException invalid) {
+            ViaFabricPlusBedrock.impl().logger().warn("Could not read native equipment resources", invalid);
+            return null;
+        }
+        if (packs == null || !packs.isLoadedOnJavaClient() || packs.getAttachables() == null) {
+            if (currentPacks != null) clear();
+            return null;
+        }
+        if (packs != currentPacks || entity.level() != currentLevel) {
+            clear();
+            currentPacks = packs;
+            currentLevel = entity.level();
+            materials = BedrockActorMaterialDefinitions.load(packs);
+            explicitBindings(packs);
+        }
