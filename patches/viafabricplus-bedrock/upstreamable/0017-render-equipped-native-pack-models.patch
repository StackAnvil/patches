+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import java.awt.image.BufferedImage;
+import java.util.Map;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.cube.converter.parser.bedrock.geometry.BedrockGeometryParser;
+
+/** Target-native item sprites extrude in the X/Z plane before their authored transform. */
+final class BedrockTextureMeshes {
+    private static final int MAX_DIMENSION = 256;
+    private static final int MAX_VOXELS = 8192;
+
+    private BedrockTextureMeshes() {}
+
+    static BedrockGeometryModel materialize(final JsonObject source, final BufferedImage texture,
+                                            final String selectedTexture, final Map<String, String> textures) {
+        if (texture == null || texture.getWidth() < 1 || texture.getHeight() < 1
+                || texture.getWidth() > MAX_DIMENSION || texture.getHeight() > MAX_DIMENSION) {
+            throw new IllegalArgumentException("Unsupported native texture mesh dimensions");
+        }
+        final JsonObject geometry = source.deepCopy();
+        final var description = geometry.getAsJsonObject("description");
+        final float width = description.get("texture_width").getAsFloat();
+        final float height = description.get("texture_height").getAsFloat();
+        if (!Float.isFinite(width) || !Float.isFinite(height) || width <= 0 || height <= 0) {
+            throw new IllegalArgumentException("Invalid native texture mesh geometry dimensions");
+        }
+        int count = 0;
+        for (final var value : geometry.getAsJsonArray("bones")) {
+            final var bone = value.getAsJsonObject();
+            final var meshes = bone.getAsJsonArray("texture_meshes");
+            if (meshes == null) continue;
+            final var cubes = bone.has("cubes") ? bone.getAsJsonArray("cubes") : new JsonArray();
+            for (final var element : meshes) {
+                final var mesh = element.getAsJsonObject();
+                if (!mesh.has("texture") || !selectedTexture.equals(textures.get(mesh.get("texture").getAsString()))) {
+                    throw new IllegalArgumentException("Texture mesh requires a separate material texture");
+                }
+                final float[] position = vector(mesh, "position", 0);
+                final float[] pivot = vector(mesh, "local_pivot", 0);
+                final float[] scale = vector(mesh, "scale", 1);
+                final JsonArray rotation = array(vector(mesh, "rotation", 0));
+                final float sx = width / texture.getWidth() * scale[0];
+                final float sy = Math.max(width / texture.getWidth(), height / texture.getHeight()) * scale[1];
+                final float sz = height / texture.getHeight() * scale[2];
+                final float depth = !mesh.has("use_pixel_depth") || mesh.get("use_pixel_depth").getAsBoolean()
+                        ? Math.max(texture.getWidth(), texture.getHeight()) / 16F : 1F;
+                if (sx <= 0 || sy <= 0 || sz <= 0) throw new IllegalArgumentException("Unsupported texture mesh scale");
+                for (int x = 0; x < texture.getWidth(); x++) {
+                    for (int z = 0; z < texture.getHeight(); z++) {
+                        // Native sprite extrusion accepts alpha >=2, independently of the render material's cutoff.
+                        if ((texture.getRGB(x, z) >>> 24) < 2) continue;
+                        if (++count > MAX_VOXELS) throw new IllegalArgumentException("Native texture mesh exceeds voxel limit");
+                        final var cube = new JsonObject();
+                        cube.add("origin", array(position[0] + x * sx - pivot[0],
+                                position[1] - pivot[1], position[2] + z * sz - pivot[2]));
+                        cube.add("size", array(sx, depth * sy, sz));
+                        cube.add("pivot", array(position));
+                        cube.add("rotation", rotation.deepCopy());
+                        final var uv = new JsonObject();
+                        for (final String face : new String[]{"up", "down", "north", "south", "east", "west"}) {
+                            final var mapping = new JsonObject();
+                            // Sample the source texel at its center on every exposed voxel face.
+                            mapping.add("uv", array((x + 0.5F) * width / texture.getWidth(),
+                                    (z + 0.5F) * height / texture.getHeight()));
+                            mapping.add("uv_size", array(0, 0));
+                            uv.add(face, mapping);
+                        }
+                        cube.add("uv", uv);
+                        cubes.add(cube);
+                    }
+                }
+            }
+            bone.remove("texture_meshes");
+            bone.add("cubes", cubes);
+        }
+        final var document = new JsonObject();
+        document.addProperty("format_version", "1.16.0");
+        final var geometries = new JsonArray();
+        geometries.add(geometry);
+        document.add("minecraft:geometry", geometries);
+        return BedrockGeometryParser.parse(document).getFirst();
+    }
+
+    private static float[] vector(final JsonObject object, final String name, final float fallback) {
+        if (!object.has(name)) return new float[]{fallback, fallback, fallback};
+        final var values = object.getAsJsonArray(name);
+        if (values.size() != 3) throw new IllegalArgumentException("Invalid native texture mesh vector");
+        final float[] result = new float[3];
+        for (int axis = 0; axis < 3; axis++) {
+            result[axis] = values.get(axis).getAsFloat();
+            if (!Float.isFinite(result[axis])) throw new IllegalArgumentException("Invalid native texture mesh vector");
+        }
+        return result;
+    }
+
+    private static JsonArray array(final float... values) {
+        final var result = new JsonArray();
+        for (final float value : values) result.add(value);
+        return result;
+    }
+}
