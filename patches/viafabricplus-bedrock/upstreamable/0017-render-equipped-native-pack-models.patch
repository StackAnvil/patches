+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockEquipmentResourcesTest {
+    @Test
+    void inheritsNativeOwnerBindingsWhileRetainingServerReplacementConditions() throws Exception {
+        final String item = "minecraft:iron_chestplate", player = item + ".player";
+        final var builtin = BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/attachables/generic.json", definition(item, null),
+                "library/vanilla/attachables/player.json", definition(player, "q.owner_identifier == 'minecraft:player'")));
+        final var inherited = BedrockEquipmentResources.merge(builtin, List.of());
+        final var selector = new BedrockAttachableSelection();
+        final var owner = new BedrockActorAnimation.Frame(Map.of("owner_identifier", "minecraft:player"), Map.of());
+        assertEquals(player, selector.select(inherited.getAttachables(), item, Map.of(), owner).identifier());
+        final var overridden = BedrockEquipmentResources.merge(builtin, List.of(new NativeActorLibrary.Layer(true,
+                Map.of("attachables/player.json", definition(player, "q.property('test:enabled')"),
+                        "manifest.json", manifest()))));
+        assertEquals(player, selector.select(overridden.getAttachables(), item, Map.of("test:enabled", true), owner).identifier());
+        assertEquals(item, selector.select(overridden.getAttachables(), item, Map.of("test:enabled", false), owner).identifier());
+        assertNotNull(overridden.getAttachables().attachables().get(item));
+    }
+
+    @Test
+    void resolvesCrossFileLegacyParentsUsingTheAcceptedPackOrder() throws Exception {
+        final byte[] base = """
+                {"format_version":"1.8.0","geometry.armor.base":{"texturewidth":64,"textureheight":32,
+                 "bones":[{"name":"body","pivot":[0,24,0]}]}}
+                """.getBytes(StandardCharsets.UTF_8);
+        final byte[] child = """
+                {"format_version":"1.8.0","geometry.armor.chest:geometry.armor.base":{
+                 "bones":[{"name":"body","pivot":[0,24,0],
+                 "cubes":[{"origin":[-4,12,-2],"size":[8,12,4],"uv":[0,0]}]}]}}
+                """.getBytes(StandardCharsets.UTF_8);
+        final var builtin = BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/models/entity/base.json", base,
+                "library/vanilla/models/entity/chest.json", child,
+                "library/vanilla/attachables/chest.json", definition("test:chest", null)));
+        final var inherited = BedrockEquipmentResources.merge(builtin, List.of());
+        final var model = inherited.getModels().entityModels().get("geometry.armor.chest");
+        assertNotNull(model);
+        assertEquals(64, model.getTextureSize().getX());
+        assertEquals(32, model.getTextureSize().getY());
+        assertEquals(1, model.getParents().size());
+        final var replacement = new NativeActorLibrary.Layer(true, Map.of(
+                "manifest.json", manifest(),
+                "models/entity/base.json", new String(base, StandardCharsets.UTF_8)
+                        .replace("\"texturewidth\":64", "\"texturewidth\":128").getBytes(StandardCharsets.UTF_8)));
+        final var overridden = BedrockEquipmentResources.merge(builtin, List.of(replacement));
+        assertEquals(128, overridden.getModels().entityModels().get("geometry.armor.chest").getTextureSize().getX());
+    }
+
+    private static byte[] manifest() {
+        return ("{\"format_version\":3,\"header\":{\"uuid\":\"" + java.util.UUID.randomUUID()
+                + "\",\"version\":\"1.0.0\",\"name\":\"server\"}}").getBytes(StandardCharsets.UTF_8);
+    }
+
+    private static byte[] definition(final String identifier, final String condition) {
+        final var description = new com.google.gson.JsonObject();
+        description.addProperty("identifier", identifier);
+        final var geometry = new com.google.gson.JsonObject();
+        geometry.addProperty("default", "geometry.armor.chest");
+        description.add("geometry", geometry);
+        if (condition != null) {
+            final var bindings = new com.google.gson.JsonObject();
+            bindings.addProperty("minecraft:iron_chestplate", condition);
+            description.add("item", bindings);
+        }
+        final var attachable = new com.google.gson.JsonObject();
+        attachable.add("description", description);
+        final var root = new com.google.gson.JsonObject();
+        root.addProperty("format_version", "1.10.0");
+        root.add("minecraft:attachable", attachable);
+        return root.toString().getBytes(StandardCharsets.UTF_8);
+    }
+}
