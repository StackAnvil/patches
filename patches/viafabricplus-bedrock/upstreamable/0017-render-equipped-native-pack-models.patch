+final class BedrockEquippedAttachableTest {
+    @Test
+    void resolvesCanonicalPackIdentityAndRetainsTheSelectedVariant() {
+        final var model = Identifier.fromNamespaceAndPath("viabedrock", "attachables/test/wearable");
+        final var first = BedrockPlayerAttachables.identify(model, List.of(), Set.of("test:wearable"));
+        assertEquals(new BedrockPlayerAttachables.ItemIdentity("test:wearable", "default"), first);
+        final var alternate = BedrockPlayerAttachables.identify(model, List.of("alternate"), Set.of("test:wearable"));
+        assertEquals("alternate", alternate.variant());
+        assertNotEquals(first, alternate);
+        assertNull(BedrockPlayerAttachables.identify(model, List.of(), Set.of("test:other")));
+        assertNull(BedrockPlayerAttachables.identify(Identifier.fromNamespaceAndPath("minecraft", model.getPath()), List.of(), Set.of("test:wearable")));
+        assertNull(BedrockPlayerAttachables.identify(model, List.of(), Set.of("test:wearable", "test/wearable")));
+    }
