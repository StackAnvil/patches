+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonPrimitive;
+import java.io.IOException;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Authored binding expressions use the equipped slot and the owner's native skeleton. */
+public final class BedrockAttachableBindings {
+    private final Map<String, BedrockMolang.Program> programs = new HashMap<>();
+    private final BedrockMolang molang = new BedrockMolang();
+
+    public BedrockAttachableBindings(final JsonObject geometry) throws IOException {
+        if (geometry.has("bones")) for (final var value : geometry.getAsJsonArray("bones")) {
+            final var bone = value.getAsJsonObject();
+            if (bone.has("binding")) this.programs.put(bone.get("name").getAsString(),
+                    BedrockMolang.Program.parse(new JsonPrimitive(bone.get("binding").getAsString()), 0));
+        }
+    }
+
+    public Map<String, String> evaluate(final BedrockActorAnimation.Frame frame) throws IOException {
+        this.molang.context(frame.context());
+        this.molang.variables(frame.variables());
+        this.molang.queries(frame.queries(), 0, 0, 0);
+        final Map<String, String> result = new HashMap<>();
+        for (final var entry : this.programs.entrySet()) {
+            final String bone = this.molang.value(entry.getValue()).getAsString();
+            if (bone.isBlank()) throw new IOException("Attachable binding did not resolve an owner bone");
+            result.put(entry.getKey(), bone);
+        }
+        return Map.copyOf(result);
+    }
+
+    public static Map<String, Object> queries(final boolean mainHandRight) {
+        return Map.of("item_slot_to_bone_name", (BedrockActorAnimation.Query) arguments -> {
+            if (arguments.size() != 1) return "";
+            return switch (String.valueOf(arguments.getFirst())) {
+                case "main_hand" -> mainHandRight ? "rightItem" : "leftItem";
+                case "off_hand" -> mainHandRight ? "leftItem" : "rightItem";
+                case "head" -> "head";
+                default -> "";
+            };
+        });
+    }
+}
