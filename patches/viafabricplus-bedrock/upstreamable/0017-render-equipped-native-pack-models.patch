+            queries.put("main_hand_item_use_duration", 0F);
+            for (final String slot : new String[]{"main_hand", "off_hand"}) {
+                final var resolved = binding.evaluate(new BedrockActorAnimation.Frame(queries, Map.of(), Map.of("item_slot", slot)));
+                assertEquals((slot.equals("main_hand") == right) ? 5F : -5F, transforms.get(resolved.get("scope")));
+            }
+            queries.put("main_hand_item_use_duration", 1F);
+            assertEquals(0F, transforms.get(binding.evaluate(new BedrockActorAnimation.Frame(queries, Map.of(), Map.of("item_slot", "main_hand"))).get("scope")));
