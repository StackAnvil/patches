@@ -0,0 +1,68 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.camera;
+
+import net.raphimc.viabedrock.api.model.CameraFovState;
+import net.raphimc.viabedrock.api.model.CameraFovState.Value;
+import net.raphimc.viabedrock.api.model.CameraFovTimeline;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+
+/** Supplies local projection inputs to the shared native transition rules. */
+public final class BedrockCameraFov {
+    private static final CameraFovTimeline TIMELINE = new CameraFovTimeline();
+    private static final Deque<Pending> PENDING = new ArrayDeque<>();
+    private static long acceptedSequence = -1;
+    private static long appliedSequence = -1;
+    private static long previousFrame;
+
+    private BedrockCameraFov() { }
+
+    public static void accept(final CameraFovState state) {
+        if (state.sequence() <= acceptedSequence) return;
+        acceptedSequence = state.sequence();
+        PENDING.addLast(new Pending(state, System.nanoTime()));
+    }
+
+    public static CameraFovState.Transition current() { return TIMELINE.state(); }
+
+    public static void clear() {
+        TIMELINE.restore(CameraFovState.Transition.EMPTY);
+        PENDING.clear();
+        acceptedSequence = -1;
+        appliedSequence = -1;
+        previousFrame = 0;
+    }
+
+    public static float project(final float normalDegrees, final float renderedDegrees) {
+        final long now = System.nanoTime();
+        final float delta = previousFrame == 0 ? 0 : Math.max(0, (now - previousFrame) / 1_000_000_000F);
+        previousFrame = now;
+        final Value normal = Value.constant(normalDegrees * CameraFovState.DEGREES_TO_RADIANS);
+        final Value rendered = Float.isFinite(renderedDegrees) && renderedDegrees > 0
+                ? Value.constant(renderedDegrees * CameraFovState.DEGREES_TO_RADIANS) : normal;
+        boolean restored = false;
+        Value projection = null;
+        while (!PENDING.isEmpty()) {
+            final Pending pending = PENDING.removeFirst();
+            final CameraFovState snapshot = pending.state;
+            if (snapshot.command() != null && snapshot.sequence() == appliedSequence + 1) {
+                TIMELINE.apply(snapshot.command(), rendered, normal);
+                restored = false;
+            } else {
+                TIMELINE.restore(snapshot.transition().resolveLocal(normal.radians()));
+                projection = TIMELINE.advance(snapshot.elapsed() + Math.max(0, (now - pending.receivedAt) / 1_000_000_000F));
+                restored = true;
+            }
+            appliedSequence = snapshot.sequence();
+        }
+        if (!restored) projection = TIMELINE.advance(delta);
+        return projection == null ? normalDegrees : projection.radians() / CameraFovState.DEGREES_TO_RADIANS;
+    }
+
+    private record Pending(CameraFovState state, long receivedAt) { }
+}
