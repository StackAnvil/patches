+package com.viaversion.viafabricplus.bedrock.camera;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.CameraFadeState;
+
+public record CameraFadePayload(CameraFadeState state) implements CustomPacketPayload {
+    public static final Type<CameraFadePayload> TYPE = new Type<>(Identifier.parse(CameraFadeState.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, CameraFadePayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> CameraFadeState.TYPE.write(buffer, payload.state),
+            buffer -> new CameraFadePayload(CameraFadeState.TYPE.read(buffer)));
+
+    @Override
+    public Type<CameraFadePayload> type() { return TYPE; }
+}
