+package com.viaversion.viafabricplus.bedrock.camera;
+
+import net.minecraft.client.CameraType;
+import net.minecraft.client.Minecraft;
+import net.raphimc.viabedrock.api.model.CameraAudioListener;
+import net.raphimc.viabedrock.api.model.CameraPose;
+import net.raphimc.viabedrock.api.model.CameraPoseTimeline;
+import net.raphimc.viabedrock.api.model.CameraPositionState;
+import net.raphimc.viabedrock.api.model.CameraPositionState.Mode;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+
+/** Supplies rendered frame inputs to core's command and blend rules. */
+public final class BedrockCameraPosition {
+    private static final CameraPoseTimeline TIMELINE = new CameraPoseTimeline();
+    private static final Deque<CameraPositionState> PENDING = new ArrayDeque<>();
+    private static CameraPositionState state = CameraPositionState.EMPTY;
+    private static CameraPose rendered;
+    private static long acceptedSequence = -1;
+    private static long appliedSequence = -1;
+    private static long previousFrame;
+    private static boolean preparingTarget;
+    private static float partialTick;
+
+    private BedrockCameraPosition() { }
+
+    public static void accept(final CameraPositionState snapshot) {
+        if (snapshot.sequence() <= acceptedSequence) return;
+        acceptedSequence = snapshot.sequence();
+        PENDING.addLast(snapshot);
+    }
+
+    public static void clear() {
+        PENDING.clear();
+        state = CameraPositionState.EMPTY;
+        rendered = null;
+        acceptedSequence = appliedSequence = -1;
+        previousFrame = 0;
+        preparingTarget = false;
+        partialTick = 0;
+    }
+
+    public static void beginFrame(final float tick) {
+        partialTick = tick;
+        preparingTarget = true;
+    }
+
+    public static CameraAudioListener playerListener() {
+        final var player = Minecraft.getInstance().player;
+        if (state.mode() == Mode.LOCAL || !state.playerAudio() || player == null) return null;
+        final var position = player.getEyePosition(partialTick);
+        return CameraAudioListener.player(new CameraPose.Vector((float) position.x, (float) position.y, (float) position.z),
+                player.getXRot(), player.getYRot());
+    }
+
+    public static CameraType perspective(final CameraType local) {
+        final Mode mode;
+        if (preparingTarget) {
+            final CameraPositionState requested = PENDING.isEmpty() ? state : PENDING.getLast();
+            // A free target has its own pose. Normal alignment remains available as a local input.
+            mode = requested.mode() == Mode.FREE ? Mode.LOCAL : requested.mode();
+        } else {
+            mode = state.mode() == Mode.LOCAL || rendered == null ? Mode.LOCAL : Mode.values()[rendered.renderingMode()];
+        }
+        return switch (mode) {
+            case LOCAL -> local;
+            case FIRST_PERSON -> CameraType.FIRST_PERSON;
+            case THIRD_PERSON, FREE -> CameraType.THIRD_PERSON_BACK;
+            case THIRD_PERSON_FRONT -> CameraType.THIRD_PERSON_FRONT;
+        };
+    }
+
+    public static CameraPose frame(final CameraPose normal) {
+        preparingTarget = false;
+        final long now = System.nanoTime();
+        final float delta = previousFrame == 0 ? 0 : Math.max(0, (now - previousFrame) / 1_000_000_000F);
+        previousFrame = now;
+        boolean changed = false;
+        while (!PENDING.isEmpty()) {
+            final CameraPositionState snapshot = PENDING.removeFirst();
+            state = snapshot;
+            if (snapshot.mode() != Mode.LOCAL) {
+                // A snapshot lacks the old client's interrupted frame. Restore its settled target,
+                // rather than replaying an expired or newly negotiated cutscene from a guessed pose.
+                final boolean continuous = snapshot.live() && snapshot.sequence() == appliedSequence + 1;
+                TIMELINE.begin(rendered != null ? rendered : normal, continuous ? snapshot.duration() : 0, snapshot.ease());
+            }
+            appliedSequence = snapshot.sequence();
+            changed = true;
+        }
+        if (state.mode() == Mode.LOCAL) {
+            rendered = normal;
+            return null;
+        }
+        final CameraPose target = state.mode() == Mode.FREE
+                ? CameraPose.fromDegrees(state.position(), state.pitch(), state.yaw(), normal.fov(), Mode.FREE.ordinal())
+                : new CameraPose(normal.position(), normal.orientation(), normal.fov(), state.mode().ordinal());
+        rendered = TIMELINE.advance(changed ? 0 : delta, target, null);
+        return rendered;
+    }
+}
