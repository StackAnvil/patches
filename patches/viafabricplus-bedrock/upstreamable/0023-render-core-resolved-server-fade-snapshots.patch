+package com.viaversion.viafabricplus.bedrock.camera;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+
+import net.raphimc.viabedrock.api.model.CameraShakeState;
+import net.raphimc.viabedrock.api.model.CameraShakeTimeline;
+
+/** Supplies the shared queue model with the rendering client's clock and preference. */
+public final class BedrockCameraShake {
+    private static final CameraShakeTimeline TIMELINE = new CameraShakeTimeline();
+    private static long sequence = -1, updatedAt;
+
+    private BedrockCameraShake() {}
+
+    public static void accept(final CameraShakeState state) {
+        if (state.sequence() <= sequence) return;
+        advance();
+        if (state.command() != null && state.sequence() == sequence + 1) {
+            if (state.command().stop() || enabled())
+                TIMELINE.apply(state.command(), state.snapshot().seed());
+        } else if (enabled()) {
+            TIMELINE.restore(state.snapshot());
+            TIMELINE.advance(state.elapsed());
+        }
+        sequence = state.sequence();
+    }
+
+    public static CameraShakeTimeline advance() {
+        final long now = System.nanoTime();
+        TIMELINE.advance(updatedAt == 0 ? 0 : Math.max(0, (now - updatedAt) / 1_000_000_000D));
+        updatedAt = now;
+        return TIMELINE;
+    }
+
+    public static boolean enabled() {
+        return ViaFabricPlusBedrock.impl().settings().allowCameraShake().isActive();
+    }
+
+    public static void clear() {
+        TIMELINE.clear();
+        sequence = -1;
+        updatedAt = 0;
+    }
+}
