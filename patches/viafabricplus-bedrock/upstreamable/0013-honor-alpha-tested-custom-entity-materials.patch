From 9bd891eb0e6ad191d399ba7f17fbefc65480cd77 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Mon, 28 Sep 2026 10:39:15 +0200
Subject: [PATCH] fix(entities): honor alpha-tested custom entity materials

Custom entities previously rendered every resource-pack model with the translucent pass, including models whose Bedrock render controllers declare a whole-model alpha-test material. Carry the actor identifier into the client render snapshot and resolve that direct material mapping against the active pack so cutout textures use the cutout pass. Keep translucent rendering for conditional, per-bone, or other materials until their behavior is translated.
---
 .../features/render/MixinCustomEntity.java    |  3 +-
 .../bedrock/render/BedrockEntityRenderer.java | 46 +++++++++++++++----
 .../render/CustomEntityRenderStore.java       | 11 +++--
 3 files changed, 46 insertions(+), 14 deletions(-)

diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/render/MixinCustomEntity.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/render/MixinCustomEntity.java
index d6c7e23..c196c18 100644
--- a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/render/MixinCustomEntity.java
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/render/MixinCustomEntity.java
@@ -40,7 +40,8 @@ public abstract class MixinCustomEntity {
     @Inject(method = "evaluateRenderControllerChange", at = @At("RETURN"))
     private void publishRenderModels(final CallbackInfoReturnable<Boolean> cir) {
         if (cir.getReturnValueZ()) {
-            CustomEntityRenderStore.update(((CustomEntity) (Object) this).javaUuid(), this.models);
+            final CustomEntity entity = (CustomEntity) (Object) this;
+            CustomEntityRenderStore.update(entity.javaUuid(), entity.type(), this.models);
         }
     }
 
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockEntityRenderer.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockEntityRenderer.java
index 86abe4a..3f6070c 100644
--- a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockEntityRenderer.java
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockEntityRenderer.java
@@ -21,6 +21,7 @@ package com.viaversion.viafabricplus.bedrock.render;
 import com.mojang.blaze3d.vertex.PoseStack;
 import com.mojang.math.Axis;
 import com.viaversion.viafabricplus.ViaFabricPlus;
+import com.viaversion.viafabricplus.bedrock.render.CustomEntityRenderStore.RenderData;
 import com.viaversion.viaversion.api.connection.UserConnection;
 import java.util.ArrayList;
 import java.util.HashMap;
@@ -32,6 +33,8 @@ import net.minecraft.client.renderer.culling.Frustum;
 import net.minecraft.client.renderer.entity.EntityRenderer;
 import net.minecraft.client.renderer.entity.EntityRendererProvider;
 import net.minecraft.client.renderer.entity.state.EntityRenderState;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.client.renderer.rendertype.RenderTypes;
 import net.minecraft.client.renderer.state.level.CameraRenderState;
 import net.minecraft.client.renderer.texture.OverlayTexture;
 import net.minecraft.resources.Identifier;
@@ -39,13 +42,14 @@ import net.minecraft.world.entity.Interaction;
 import net.raphimc.viabedrock.api.model.entity.CustomEntity;
 import net.raphimc.viabedrock.api.util.StringUtil;
 import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.cube.converter.data.bedrock.controller.BedrockRenderController;
 import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
 
 /** Renders ViaBedrock custom actors while leaving ordinary interactions invisible. */
 public final class BedrockEntityRenderer extends EntityRenderer<Interaction, EntityRenderState> {
 
     private final Map<String, Model<EntityRenderState>> models = new HashMap<>();
-    private final Map<List<CustomEntity.EvaluatedModel>, List<RenderedModel>> resolvedModelSets = new HashMap<>();
+    private final Map<RenderData, List<RenderedModel>> resolvedModelSets = new HashMap<>();
     private ResourcePackStorage currentPacks;
 
     public BedrockEntityRenderer(final EntityRendererProvider.Context context) {
@@ -79,8 +83,8 @@ public final class BedrockEntityRenderer extends EntityRenderer<Interaction, Ent
             this.resolvedModelSets.clear();
             return;
         }
-        final List<CustomEntity.EvaluatedModel> evaluatedModels = CustomEntityRenderStore.get(entity.getUUID());
-        if (evaluatedModels == null) {
+        final RenderData renderData = CustomEntityRenderStore.get(entity.getUUID());
+        if (renderData == null) {
             return;
         }
         final ResourcePackStorage packs = connection.get(ResourcePackStorage.class);
@@ -89,27 +93,51 @@ public final class BedrockEntityRenderer extends EntityRenderer<Interaction, Ent
             this.models.clear();
             this.resolvedModelSets.clear();
         }
-        state.models = this.resolvedModelSets.computeIfAbsent(evaluatedModels, models -> this.resolveModels(models, packs));
+        state.models = this.resolvedModelSets.computeIfAbsent(renderData, data -> this.resolveModels(data, packs));
         state.yaw = entity.getYRot();
     }
 
     private List<RenderedModel> resolveModels(
-        final List<CustomEntity.EvaluatedModel> evaluatedModels,
+        final RenderData renderData,
         final ResourcePackStorage packs
     ) {
         final List<RenderedModel> resolved = new ArrayList<>();
-        for (var evaluated : evaluatedModels) {
+        final boolean alphaTest = usesWholeModelAlphaTest(renderData.identifier(), packs);
+        for (var evaluated : renderData.models()) {
             final BedrockGeometryModel geometry = packs.getModels().entityModels().get(evaluated.geometryValue());
             if (geometry == null) {
                 continue;
             }
             final Model<EntityRenderState> model = this.models.computeIfAbsent(evaluated.geometryValue(), _ -> BedrockGeometry.entityModel(geometry));
             final String path = "textures/item/entities/" + StringUtil.makeIdentifierValueSafe(evaluated.textureValue().replace("textures/", "")) + ".png";
-            resolved.add(new RenderedModel(model, Identifier.fromNamespaceAndPath("viabedrock", path)));
+            final Identifier texture = Identifier.fromNamespaceAndPath("viabedrock", path);
+            resolved.add(new RenderedModel(model, alphaTest ? RenderTypes.entityCutout(texture) : RenderTypes.entityTranslucent(texture)));
         }
         return List.copyOf(resolved);
     }
 
+    private static boolean usesWholeModelAlphaTest(final String identifier, final ResourcePackStorage packs) {
+        final var definition = packs.getEntities().get(identifier);
+        if (definition == null || definition.entityData().getControllers().isEmpty()) {
+            return false;
+        }
+        for (var selected : definition.entityData().getControllers()) {
+            final BedrockRenderController controller = packs.getRenderControllers().get(selected.identifier());
+            if (controller == null || controller.materialsMap().size() != 1) {
+                return false;
+            }
+            final String expression = controller.materialsMap().get("*");
+            if (expression == null || !expression.regionMatches(true, 0, "Material.", 0, "Material.".length())) {
+                return false;
+            }
+            final String material = definition.entityData().getMaterials().get(expression.substring("Material.".length()));
+            if (!"entity_alphatest".equals(material)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
     @Override
     public void submit(final EntityRenderState renderState, final PoseStack poseStack, final SubmitNodeCollector nodes, final CameraRenderState camera) {
         if (!(renderState instanceof State state)) {
@@ -120,7 +148,7 @@ public final class BedrockEntityRenderer extends EntityRenderer<Interaction, Ent
             poseStack.rotateDegrees(Axis.YP, 180F - state.yaw);
             poseStack.scale(-1F, -1F, 1F);
             poseStack.translate(0F, -1.5F, 0F);
-            nodes.submitModel(rendered.model, state, poseStack, rendered.model.renderType(rendered.texture), state.lightCoords, OverlayTexture.NO_OVERLAY, -1);
+            nodes.submitModel(rendered.model, state, poseStack, rendered.renderType, state.lightCoords, OverlayTexture.NO_OVERLAY, -1);
             poseStack.popPose();
         }
     }
@@ -130,7 +158,7 @@ public final class BedrockEntityRenderer extends EntityRenderer<Interaction, Ent
         private float yaw;
     }
 
-    private record RenderedModel(Model<EntityRenderState> model, Identifier texture) {
+    private record RenderedModel(Model<EntityRenderState> model, RenderType renderType) {
     }
 
 }
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/CustomEntityRenderStore.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/CustomEntityRenderStore.java
index 8146848..c3beb07 100644
--- a/src/main/java/com/viaversion/viafabricplus/bedrock/render/CustomEntityRenderStore.java
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/CustomEntityRenderStore.java
@@ -27,16 +27,16 @@ import net.raphimc.viabedrock.api.model.entity.CustomEntity;
 /** Publishes immutable actor render state across the protocol and render threads. */
 public final class CustomEntityRenderStore {
 
-    private static final Map<UUID, List<CustomEntity.EvaluatedModel>> MODELS = new ConcurrentHashMap<>();
+    private static final Map<UUID, RenderData> MODELS = new ConcurrentHashMap<>();
 
     private CustomEntityRenderStore() {
     }
 
-    public static void update(final UUID uuid, final List<CustomEntity.EvaluatedModel> models) {
-        MODELS.put(uuid, List.copyOf(models));
+    public static void update(final UUID uuid, final String identifier, final List<CustomEntity.EvaluatedModel> models) {
+        MODELS.put(uuid, new RenderData(identifier, List.copyOf(models)));
     }
 
-    public static List<CustomEntity.EvaluatedModel> get(final UUID uuid) {
+    public static RenderData get(final UUID uuid) {
         return MODELS.get(uuid);
     }
 
@@ -48,4 +48,7 @@ public final class CustomEntityRenderStore {
         MODELS.clear();
     }
 
+    public record RenderData(String identifier, List<CustomEntity.EvaluatedModel> models) {
+    }
+
 }
