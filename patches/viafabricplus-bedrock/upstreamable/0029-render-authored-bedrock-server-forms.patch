+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonNull;
+import java.util.List;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiAnimationLifecycleTest {
+    @Test
+    void destroysTheNearestNamedAncestorWithoutRemovingSiblingFactoryInstances() {
+        final String name = UUID.randomUUID().toString();
+        final var text = node(UUID.randomUUID().toString(), List.of());
+        final var sequence = new JsonArray();
+        final var track = new JsonObject();
+        track.addProperty("anim_type", "alpha");
+        track.addProperty("duration", .25);
+        track.add("delay", JsonNull.INSTANCE);
+        track.addProperty("destroy_at_end", name);
+        sequence.add(track);
+        AnimationPrograms.attach(text.properties(), sequence, false);
+        final var first = node("hud." + name, List.of(text));
+        final var second = node(name, List.of());
+        final var factory = node(UUID.randomUUID().toString(), List.of(first, second));
+        factory.properties().addProperty("factory_name", UUID.randomUUID().toString());
+        final var lifecycle = new NativeUiAnimationLifecycle(factory);
+        lifecycle.advance(249_000_000);
+        assertFalse(first.flag("ignored", false));
+        lifecycle.advance(250_000_000);
+        assertTrue(first.flag("ignored", false));
+        assertFalse(second.flag("ignored", false));
+        assertTrue(lifecycle.active());
+        second.properties().addProperty("ignored", true);
+        assertFalse(lifecycle.active());
+    }
+
+    @Test
+    void schedulesDestructionFromActualPlayTimeAndResetRatherThanScreenAge() {
+        final String name = UUID.randomUUID().toString(), play = UUID.randomUUID().toString(), reset = UUID.randomUUID().toString();
+        final var root = node(name, List.of());
+        final var track = new JsonObject();
+        track.addProperty("anim_type", "wait");
+        track.addProperty("duration", 1);
+        track.addProperty("play_event", play);
+        track.addProperty("reset_event", reset);
+        track.addProperty("destroy_at_end", name);
+        final var tracks = new JsonArray();
+        tracks.add(track);
+        AnimationPrograms.attach(root.properties(), tracks, false);
+        final var lifecycle = new NativeUiAnimationLifecycle(root);
+        lifecycle.advance(2_000_000_000L);
+        assertTrue(lifecycle.active());
+        lifecycle.animations().event(root, play, 2_000_000_000L);
+        lifecycle.advance(2_500_000_000L);
+        lifecycle.animations().event(root, reset, 2_500_000_000L);
+        lifecycle.advance(4_000_000_000L);
+        assertTrue(lifecycle.active());
+        lifecycle.animations().event(root, play, 4_000_000_000L);
+        lifecycle.advance(4_999_000_000L);
+        assertTrue(lifecycle.active());
+        lifecycle.advance(5_000_000_000L);
+        assertFalse(lifecycle.active());
+    }
+
+    @Test
+    void bindingRefreshRetainsClocksByControlIdentityAndStartsInsertedControlsAtRefreshTime() {
+        final var first = animatedSlot(1);
+        final var lifecycle = new NativeUiAnimationLifecycle(node("inventory", List.of(first)));
+        lifecycle.advance(250_000_000);
+        assertEquals(.25F, lifecycle.animations().opacityAt(first, 250_000_000).current());
+        final var inserted = animatedSlot(2);
+        final var rebound = animatedSlot(1);
+        rebound.properties().addProperty("hover_text", UUID.randomUUID().toString());
+        lifecycle.replaceRoot(node("inventory", List.of(inserted, rebound)), 250_000_000);
+        assertEquals(.25F, lifecycle.animations().opacityAt(rebound, 250_000_000).current());
+        assertEquals(0, lifecycle.animations().opacityAt(inserted, 250_000_000).current());
+        lifecycle.advance(500_000_000);
+        assertEquals(.5F, lifecycle.animations().opacityAt(rebound, 500_000_000).current());
+        assertEquals(.25F, lifecycle.animations().opacityAt(inserted, 500_000_000).current());
+        lifecycle.replaceRoot(node("inventory", List.of(inserted)), 500_000_000);
+        final var recreated = animatedSlot(1);
+        lifecycle.replaceRoot(node("inventory", List.of(recreated, animatedSlot(2))), 750_000_000);
+        assertEquals(0, lifecycle.animations().opacityAt(recreated, 750_000_000).current());
+    }
+
+    @Test
+    void definitionChangesRestartLocallyAndDestroyedControlsStayRetiredOnBindingRefresh() {
+        final var first = animatedSlot(1);
+        first.properties().getAsJsonObject("animation_program").getAsJsonArray("tracks").get(0)
+            .getAsJsonObject().addProperty("destroy_at_end", first.name());
+        final var lifecycle = new NativeUiAnimationLifecycle(node("inventory", List.of(first)));
+        lifecycle.advance(1_000_000_000);
+        assertTrue(first.flag("ignored", false));
+        final var rebound = new NativeUiScene.Node(first.name(), first.type(), first.properties().deepCopy(), List.of(), first.action());
+        rebound.properties().remove("ignored");
+        lifecycle.replaceRoot(node("inventory", List.of(rebound)), 1_500_000_000);
+        assertTrue(rebound.flag("ignored", false));
+        final var changed = animatedSlot(1);
+        lifecycle.replaceRoot(node("inventory", List.of(changed)), 2_000_000_000);
+        assertFalse(changed.flag("ignored", false));
+        assertEquals(0, lifecycle.animations().opacityAt(changed, 2_000_000_000).current());
+        lifecycle.advance(2_500_000_000L);
+        assertEquals(.5F, lifecycle.animations().opacityAt(changed, 2_500_000_000L).current());
+    }
+
+    private static NativeUiScene.Node animatedSlot(final int slot) {
+        final var node = node("slot", List.of());
+        node.properties().addProperty("inventory_slot", slot);
+        final var track = new JsonObject();
+        track.addProperty("anim_type", "alpha");
+        track.addProperty("from", 0);
+        track.addProperty("to", 1);
+        track.addProperty("duration", 1);
+        final var tracks = new JsonArray();
+        tracks.add(track);
+        AnimationPrograms.attach(node.properties(), tracks, false);
+        return node;
+    }
+
+    private static NativeUiScene.Node node(final String name, final List<NativeUiScene.Node> children) {
+        return new NativeUiScene.Node(name, "panel", new JsonObject(), children, Integer.MIN_VALUE);
+    }
+}
