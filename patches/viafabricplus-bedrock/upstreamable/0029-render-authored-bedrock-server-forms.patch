+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiImageRegionsTest {
+    @Test
+    void preservesNativeAsymmetricSidesAndSubmissionOrder() {
+        final var regions = regions(new NativeUiLayout.Rect(100, 200, 40, 30), 0, 0);
+        assertEquals(9, regions.size());
+        assertEquals(new NativeUiImageRegions.Region(100, 200, 103, 204, 0, 0, 3, 4), regions.get(0));
+        assertEquals(new NativeUiImageRegions.Region(133, 200, 140, 204, 57, 0, 64, 4), regions.get(1));
+        assertEquals(new NativeUiImageRegions.Region(100, 222, 103, 230, 0, 24, 3, 32), regions.get(2));
+        assertEquals(new NativeUiImageRegions.Region(133, 222, 140, 230, 57, 24, 64, 32), regions.get(3));
+        assertEquals(new NativeUiImageRegions.Region(100, 204, 103, 222, 0, 4, 3, 24), regions.get(4));
+        assertEquals(new NativeUiImageRegions.Region(103, 204, 133, 222, 3, 4, 57, 24), regions.get(8));
+    }
+
+    @Test
+    void retainsSignedInteriorForUndersizedDestinationsAndZerosOnlyZeroAxisBorders() {
+        final var small = regions(new NativeUiLayout.Rect(100, 200, 5, 4), 0, 0);
+        assertEquals(new NativeUiImageRegions.Region(100, 200, 103, 204, 0, 0, 3, 4), small.get(0));
+        assertEquals(new NativeUiImageRegions.Region(98, 196, 105, 204, 57, 24, 64, 32), small.get(3));
+        assertEquals(new NativeUiImageRegions.Region(103, 204, 98, 196, 3, 4, 57, 24), small.get(8));
+        final var zeroWidth = regions(new NativeUiLayout.Rect(100, 200, 0, 30), 0, 0);
+        assertEquals(100, zeroWidth.get(0).x1());
+        assertEquals(100, zeroWidth.get(1).x0());
+        assertEquals(4, zeroWidth.get(0).y1() - zeroWidth.get(0).y0());
+        final var zeroHeight = regions(new NativeUiLayout.Rect(100, 200, 40, 0), 0, 0);
+        assertEquals(200, zeroHeight.get(0).y1());
+        assertEquals(200, zeroHeight.get(2).y0());
+        assertEquals(3, zeroHeight.get(0).x1() - zeroHeight.get(0).x0());
+    }
+
+    @Test
+    void scalesSourceBordersUsingBothMetadataDimensionsWithoutRoundingOrClamping() {
+        final var scaled = regions(new NativeUiLayout.Rect(100, 200, 40, 30), 128, 64);
+        assertEquals(new NativeUiImageRegions.Region(100, 200, 103, 204, 0, 0, 1.5F, 2), scaled.get(0));
+        assertEquals(new NativeUiImageRegions.Region(133, 222, 140, 230, 60.5F, 28, 64, 32), scaled.get(3));
+        assertEquals(regions(new NativeUiLayout.Rect(100, 200, 40, 30), 0, 0),
+            regions(new NativeUiLayout.Rect(100, 200, 40, 30), 128, 0));
+    }
+
+    @Test
+    void clipsSingleDestinationAndSourceInEachNativeDirection() {
+        final float[][] expected = {
+            {100, 200, 160, 260, 4, 8, 52, 40},
+            {120, 200, 180, 260, 20, 8, 68, 40},
+            {100, 200, 180, 245, 4, 8, 68, 32},
+            {100, 215, 180, 260, 4, 16, 68, 40},
+            {110, 207.5F, 170, 252.5F, 12, 12, 60, 36}
+        };
+        final String[] directions = {"left", "right", "up", "down", "center"};
+        for (int i = 0; i < directions.length; i++) {
+            final JsonObject image = clipped(directions[i], .25F, false);
+            final JsonArray uv = new JsonArray();
+            uv.add(4);
+            uv.add(8);
+            image.add("uv", uv);
+            assertEquals(region(expected[i]), render(image, new NativeUiLayout.Rect(100, 200, 80, 60)).getFirst());
+        }
+    }
+
+    @Test
+    void clipsSelectedNineSliceEdgesAfterBuildingBorders() {
+        final JsonObject image = sliced();
+        image.addProperty("clip_direction", "left");
+        image.addProperty("clip_ratio", .25F);
+        image.addProperty("clip_pixelperfect", false);
+        final var regions = render(image, new NativeUiLayout.Rect(100, 200, 40, 30));
+        assertEquals(6, regions.size());
+        assertEquals(new NativeUiImageRegions.Region(100, 200, 103, 204, 0, 0, 3, 4), regions.getFirst());
+        assertEquals(new NativeUiImageRegions.Region(100, 222, 103, 230, 0, 24, 3, 32), regions.get(1));
+        assertEquals(new NativeUiImageRegions.Region(100, 204, 103, 222, 0, 4, 3, 24), regions.get(2));
+        assertEquals(new NativeUiImageRegions.Region(103, 200, 125.5F, 204, 3, 0, 43.5F, 4), regions.get(3));
+        assertEquals(new NativeUiImageRegions.Region(103, 204, 125.5F, 222, 3, 4, 43.5F, 24), regions.getLast());
+        image.addProperty("clip_direction", "center");
+        final var centered = render(image, new NativeUiLayout.Rect(100, 200, 40, 30));
+        assertEquals(5, centered.size());
+        assertEquals(new NativeUiImageRegions.Region(100.375F, 206.25F, 102.625F, 219.75F,
+            .375F, 6.5F, 2.625F, 21.5F), centered.getFirst());
+    }
+
+    @Test
+    void roundsRemovedSourcePixelsInsteadOfDestinationPixelsByDefault() {
+        final JsonObject image = sliced();
+        image.addProperty("clip_direction", "left");
+        image.addProperty("clip_ratio", .25F);
+        final var center = render(image, new NativeUiLayout.Rect(100, 200, 40, 30)).getLast();
+        assertEquals(44, center.u1());
+        assertEquals(125.77778F, center.x1(), .00001F);
+        assertEquals(222, center.y1());
+    }
+
+    @Test
+    void preservesSignedClippedInteriorsAndNativeAspectDispatch() {
+        final JsonObject image = sliced();
+        image.addProperty("clip_direction", "left");
+        image.addProperty("clip_ratio", .25F);
+        image.addProperty("clip_pixelperfect", false);
+        final var center = render(image, new NativeUiLayout.Rect(100, 200, 5, 4)).getLast();
+        assertEquals(new NativeUiImageRegions.Region(103, 204, 99.25F, 196, 3, 4, 43.5F, 24), center);
+        image.addProperty("keep_ratio", true);
+        assertEquals(render(image, new NativeUiLayout.Rect(100, 200, 40, 30)),
+            render(without(image, "keep_ratio"), new NativeUiLayout.Rect(100, 200, 40, 30)));
+        final JsonObject single = clipped("left", .25F, false);
+        single.addProperty("keep_ratio", true);
+        assertEquals(new NativeUiImageRegions.Region(100, 200, 130, 230, 0, 0, 48, 32),
+            render(single, new NativeUiLayout.Rect(100, 200, 40, 30)).getFirst());
+        single.addProperty("clip_ratio", 0);
+        assertEquals(new NativeUiImageRegions.Region(100, 205, 140, 225, 0, 0, 64, 32),
+            render(single, new NativeUiLayout.Rect(100, 200, 40, 30)).getFirst());
+    }
+
+    @Test
+    void omitsFullyClippedImagesAndRetainsZeroOrAbsentDirection() {
+        final JsonObject image = sliced();
+        image.addProperty("clip_direction", "left");
+        image.addProperty("clip_ratio", 1);
+        assertTrue(render(image, new NativeUiLayout.Rect(100, 200, 40, 30)).isEmpty());
+        image.addProperty("clip_direction", "none");
+        assertEquals(9, render(image, new NativeUiLayout.Rect(100, 200, 40, 30)).size());
+        image.addProperty("clip_direction", "right");
+        image.addProperty("clip_ratio", 0);
+        assertEquals(render(sliced(), new NativeUiLayout.Rect(100, 200, 40, 30)),
+            render(image, new NativeUiLayout.Rect(100, 200, 40, 30)));
+    }
+
+    private static JsonObject without(final JsonObject image, final String key) {
+        final JsonObject result = image.deepCopy();
+        result.remove(key);
+        return result;
+    }
+
+    @Test
+    void omitsNonFinitePixelClippedInteriorsAndPreservesFiniteNativeBorders() {
+        final JsonObject image = clipped("left", .25F, true);
+        final JsonArray sides = new JsonArray();
+        for (final int value : new int[] {32, 16, 32, 16}) sides.add(value);
+        image.add("nine_slice", sides);
+        final var bounds = new NativeUiLayout.Rect(100, 200, 40, 30);
+        final var clipped = render(image, bounds);
+        assertEquals(3, clipped.size());
+        assertEquals(new NativeUiImageRegions.Region(100, 200, 132, 216, 0, 0, 32, 16), clipped.getFirst());
+        assertEquals(new NativeUiImageRegions.Region(100, 216, 132, 214, 0, 16, 32, 16), clipped.getLast());
+        image.addProperty("clip_pixelperfect", false);
+        final var continuous = render(image, bounds);
+        assertEquals(6, continuous.size());
+        assertEquals(new NativeUiImageRegions.Region(132, 216, 114, 214, 32, 16, 32, 16), continuous.getLast());
+        image.addProperty("clip_pixelperfect", true);
+        image.addProperty("clip_direction", "center");
+        assertTrue(render(image, bounds).isEmpty());
+        image.addProperty("clip_ratio", 0);
+        assertEquals(9, render(image, bounds).size());
+    }
+
+    private static JsonObject clipped(final String direction, final float ratio, final boolean pixelPerfect) {
+        final JsonObject image = new JsonObject();
+        image.addProperty("type", "image");
+        image.addProperty("clip_direction", direction);
+        image.addProperty("clip_ratio", ratio);
+        image.addProperty("clip_pixelperfect", pixelPerfect);
+        return image;
+    }
+
+    private static NativeUiImageRegions.Region region(final float[] values) {
+        return new NativeUiImageRegions.Region(values[0], values[1], values[2], values[3],
+            values[4], values[5], values[6], values[7]);
+    }
+
+    private static List<NativeUiImageRegions.Region> render(final JsonObject image, final NativeUiLayout.Rect bounds) {
+        return NativeUiImageRegions.regions(new NativeUiScene.Node("image", "image", image, List.of(), Integer.MIN_VALUE), bounds, 64, 32);
+    }
+
+    private static JsonObject sliced() {
+        final JsonObject image = new JsonObject();
+        image.addProperty("type", "image");
+        final JsonArray borders = new JsonArray();
+        for (final int value : new int[] {3, 4, 7, 8}) borders.add(value);
+        image.add("nineslice_size", borders);
+        return image;
+    }
+
+    private static List<NativeUiImageRegions.Region> regions(final NativeUiLayout.Rect bounds, final int baseWidth, final int baseHeight) {
+        final JsonObject image = new JsonObject();
+        image.addProperty("type", "image");
+        final JsonArray borders = new JsonArray();
+        for (final int value : new int[] {3, 4, 7, 8}) borders.add(value);
+        image.add("nineslice_size", borders);
+        final JsonArray base = new JsonArray(); base.add(baseWidth); base.add(baseHeight); image.add("base_size", base);
+        return NativeUiImageRegions.regions(new NativeUiScene.Node("image", "image", image, List.of(), Integer.MIN_VALUE), bounds, 64, 32);
+    }
+}
