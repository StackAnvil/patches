+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+/** Applies the native label size multiplier to the selected font's metrics and drawing. */
+public final class NativeUiFont {
+    private NativeUiFont() {}
+
+    public static float scale(final NativeUiScene.Node node) {
+        final float multiplier = switch (node.string("font_size", "normal")) {
+            case "small" -> .5F;
+            case "large" -> 2F;
+            case "extra_large" -> 4F;
+            default -> 1F;
+        };
+        final float scale = multiplier * node.number("font_scale_factor", 1);
+        if (!Float.isFinite(scale) || scale < 0) throw new IllegalArgumentException("Unsupported native UI font scale");
+        return scale;
+    }
+
+    public static int wrapWidth(final NativeUiScene.Node node, final float width) {
+        final float scale = scale(node);
+        return scale == 0 ? Integer.MAX_VALUE : Math.max(1, (int) (width / scale));
+    }
+
+    public static float lineHeight(final NativeUiScene.Node node, final int fallback) {
+        final float height = node.number("font_line_height", fallback);
+        if (!Float.isFinite(height) || height <= 0 || height > 4096) {
+            throw new IllegalArgumentException("Unsupported native UI font line height");
+        }
+        return height;
+    }
+
+    public static NativeUiLayout.Size intrinsic(final NativeUiScene.Node node, final float width,
+                                             final int lines, final int lineHeight) {
+        final float scale = scale(node);
+        return new NativeUiLayout.Size(width * scale, lines * lineHeight(node, lineHeight) * scale);
+    }
+
+    public static NativeUiLayout.Size constrained(final NativeUiScene.Node node, final float width,
+                                               final int lines, final int lineHeight) {
+        return new NativeUiLayout.Size(width, lines * lineHeight(node, lineHeight) * scale(node));
+    }
+}
