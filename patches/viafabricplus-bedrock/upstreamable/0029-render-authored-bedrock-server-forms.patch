+    @Test
+    void editorRejectsOldSceneControlsAndRetiresWithoutSavingOnServerClose() throws Exception {
+        try (final var harness = new Harness()) {
+            BedrockNativeNpcs.accept(harness.owner, editorMessage());
+            harness.run();
+            final var controller = activeController();
+            controller.activate(command(controller.root(), "button.advanced_settings"));
+            controller.refresh();
+            final var oldDelete = command(controller.root(), "button.delete_action");
+            controller.activate(command(controller.root(), "button.add_command"));
+            controller.refresh();
+            controller.activate(oldDelete);
+            assertDoesNotThrow(() -> controller.setText(2, "retained first action"));
+            BedrockNativeNpcs.accept(harness.owner, new NativeNpcDialogueMessage(controller.identifier(), null));
+            harness.run();
+            controller.cancel();
+            assertEquals(NativeUiController.Activation.STAY, controller.dismiss());
