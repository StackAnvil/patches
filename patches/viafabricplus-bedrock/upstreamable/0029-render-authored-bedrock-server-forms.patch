+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import net.minecraft.client.Minecraft;
+
+/** Desktop GuiData units, independent of Java's HUD scale. */
+public record NativeUiViewport(int width, int height, int scale, float renderScale) {
+    public static NativeUiViewport desktop(final int width, final int height, final int offset, final int javaScale) {
+        if (width < 1 || height < 1 || javaScale < 1)
+            throw new IllegalArgumentException("Invalid native UI viewport");
+        // Target AppPlatform desktop type 0: minimum viewport 376 x 250, scale table 1..8.
+        final int maximum = Math.clamp(Math.min(width / 376, height / 250), 1, 8);
+        final int minimum = (maximum + 1) / 2;
+        final int scale = maximum + Math.clamp(offset, minimum - maximum, 0);
+        return new NativeUiViewport(Math.ceilDiv(width, scale), Math.ceilDiv(height, scale), scale,
+            (float) scale / javaScale);
+    }
+
+    public static NativeUiViewport current() {
+        final var window = Minecraft.getInstance().getWindow();
+        return desktop(window.getWidth(), window.getHeight(), 0, window.getGuiScale());
+    }
+
+    public double pointer(final double javaCoordinate) { return javaCoordinate / this.renderScale; }
+    public int pixel(final float nativeCoordinate) { return Math.round(nativeCoordinate * this.renderScale); }
+}
