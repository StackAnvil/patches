+    }
+
+    @Test
+    void clampsThumbDraggingAndRecomputesProportionsOnViewportResize() {
+        final JsonObject root = node("scroll_view", 120, "100%");
+        root.addProperty("scroll_content", "items");
+        root.addProperty("scroll_view_port", "viewport");
