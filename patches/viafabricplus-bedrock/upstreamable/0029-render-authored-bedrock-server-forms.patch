+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.google.gson.JsonElement;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Pattern;
+
+/** Resolves authored anchors and content dimensions independently of the rendering backend. */
+public final class BedrockFormLayout {
+    private static final Pattern DIMENSION = Pattern.compile("([+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+))(%sm|%cm|%c|%x|%y|%|px)?");
+    private static final float LIMIT = 16384;
+    private static final Size EMPTY = new Size(0, 0);
+    private final Metrics metrics;
+    private final Map<BedrockFormScene.Node, Map<Measurement, Size>> measured = new IdentityHashMap<>();
+    private final Map<BedrockFormScene.Node, Boolean> visibleNodes = new IdentityHashMap<>();
+    private int work;
+
+    public BedrockFormLayout(final Metrics metrics) {
+        this.metrics = metrics;
+    }
+
+    public Box layout(final BedrockFormScene.Node node, final int width, final int height,
+                      final Map<BedrockFormScene.Node, Float> scroll) {
+        this.measured.clear();
+        this.visibleNodes.clear();
+        this.visibility(node, true);
+        this.work = 0;
+        final Size size = this.measure(node, width, height);
+        final Rect viewport = new Rect(0, 0, width, height);
+        return this.place(node, viewport, size, 0, viewport, scroll);
+    }
+
+    private void visibility(final BedrockFormScene.Node node, final boolean inherited) {
+        final boolean visible = inherited && node.flag("visible", true);
+        this.visibleNodes.put(node, visible);
+        for (final var child : node.children()) this.visibility(child, visible);
+    }
+
+    private Size measure(final BedrockFormScene.Node node, final float parentWidth, final float parentHeight) {
+        return this.measure(node, new Measurement(parentWidth, parentHeight, 0, 0));
+    }
+
+    private Size measure(final BedrockFormScene.Node node, final Measurement environment) {
+        // The native visibility setter resets computed size metrics without changing authored dimensions.
+        if (!this.visibleNodes.getOrDefault(node, true)) return EMPTY;
+        final Map<Measurement, Size> cache = this.measured.computeIfAbsent(node, _ -> new HashMap<>());
+        final Size previous = cache.get(environment);
+        if (previous != null) return previous;
+        if (++this.work > 65536) throw new IllegalArgumentException("Native form layout exceeds work limits");
+        final boolean container = switch (node.type()) {
+            case "screen", "panel", "factory", "collection_panel", "scroll_view", "scroll_track", "scrollbar_box" -> true;
+            default -> false;
+        };
+        final Size intrinsic = container ? new Size(environment.width, environment.height) : this.metrics.intrinsic(node);
+        float width = intrinsic.width, height = intrinsic.height;
+        for (int pass = 0; pass < 3; pass++) {
+            final float previousWidth = width, previousHeight = height;
+            final List<Size> children = this.children(node, width, height);
+            final Size content = this.content(node, children, width, height);
+            final float maximumWidth = children.stream().map(Size::width).max(Float::compare).orElse(0F);
+            final float maximumHeight = children.stream().map(Size::height).max(Float::compare).orElse(0F);
+            final boolean stack = node.type().equals("stack_panel");
+            final boolean vertical = !node.string("orientation", "vertical").equals("horizontal");
+            final float defaultWidth = stack ? vertical ? environment.width : content.width : intrinsic.width;
+            width = dimension(node, "size", 0, environment, width, height, content.width, maximumWidth, defaultWidth);
+            width = constrain(node, 0, width, environment, width, height, content.width, maximumWidth);
+            final float intrinsicHeight = container || stack ? intrinsic.height : this.metrics.constrained(node, width).height;
+            final float defaultHeight = stack ? vertical ? content.height : environment.height : intrinsicHeight;
+            height = dimension(node, "size", 1, environment, width, height, content.height, maximumHeight, defaultHeight);
+            height = constrain(node, 1, height, environment, width, height, content.height, maximumHeight);
+            if (width == previousWidth && height == previousHeight) break;
+        }
+        final Size result = new Size(width, height);
+        cache.put(environment, result);
+        return result;
+    }
+
+    private List<Size> children(final BedrockFormScene.Node node, final float width, final float height) {
+        final Grid grid = this.grid(node, width, height);
+        final float availableWidth = node.type().equals("grid") && !grid.rescaled ? width / grid.columns : width;
+        final float availableHeight = node.type().equals("grid") && !grid.rescaled && !contentDimension(node, 1)
+            ? height / grid.rows : height;
+        final List<Size> result = new ArrayList<>();
+        for (final var child : node.children()) result.add(this.measure(child, availableWidth, availableHeight));
+        for (int i = 0; i < result.size(); i++) {
+            final var child = node.children().get(i);
+            if (!siblingDimension(child)) continue;
+            float siblingWidth = 0, siblingHeight = 0;
+            for (int other = 0; other < result.size(); other++) if (other != i) {
+                siblingWidth = Math.max(siblingWidth, result.get(other).width);
+                siblingHeight = Math.max(siblingHeight, result.get(other).height);
+            }
+            result.set(i, this.measure(child, new Measurement(availableWidth, availableHeight, siblingWidth, siblingHeight)));
+        }
+        if (node.type().equals("stack_panel")) {
+            final boolean vertical = !node.string("orientation", "vertical").equals("horizontal");
+            final int axis = vertical ? 1 : 0;
+            float used = 0;
+            int fills = 0;
+            for (int i = 0; i < result.size(); i++) {
+                if (!node.children().get(i).flag("visible", true)) continue;
+                if (fill(node.children().get(i), axis)) fills++;
+                else used += vertical ? result.get(i).height : result.get(i).width;
+            }
+            if (fills > 0) {
+                final float remainder = Math.max(0, (vertical ? height : width) - used) / fills;
+                for (int i = 0; i < result.size(); i++) if (node.children().get(i).flag("visible", true) && fill(node.children().get(i), axis))
+                    result.set(i, this.measure(node.children().get(i), vertical ? availableWidth : remainder, vertical ? remainder : availableHeight));
+            }
+        }
+        return result;
+    }
+
+    private static boolean fill(final BedrockFormScene.Node node, final int axis) {
+        final JsonElement size = node.properties().get("size");
+        return size != null && size.isJsonArray() && size.getAsJsonArray().size() == 2
+            && size.getAsJsonArray().get(axis).isJsonPrimitive() && size.getAsJsonArray().get(axis).getAsString().equals("fill");
+    }
+
+    private static boolean siblingDimension(final BedrockFormScene.Node node) {
+        for (final String key : List.of("size", "min_size", "max_size")) {
+            final JsonElement value = node.properties().get(key);
+            if (value != null && value.toString().contains("%sm")) return true;
+        }
+        return false;
+    }
+
+    private Size content(final BedrockFormScene.Node node, final List<Size> children, final float parentWidth, final float parentHeight) {
+        float width = 0, height = 0;
+        final boolean vertical = !node.string("orientation", "vertical").equals("horizontal");
+        if (node.type().equals("grid")) {
+            final Grid grid = this.grid(node, parentWidth, parentHeight);
+            final float[] widths = new float[grid.columns];
+            final float[] heights = new float[grid.rows];
+            for (int i = 0; i < children.size(); i++) {
+                final int column = grid.column(i), row = grid.row(i);
+                widths[column] = Math.max(widths[column], children.get(i).width);
+                heights[row] = Math.max(heights[row], children.get(i).height);
+            }
+            for (final float value : widths) width += value;
+            for (final float value : heights) height += value;
+        } else for (final Size child : children) {
+            if (node.type().equals("stack_panel") && !vertical) width += child.width;
+            else width = Math.max(width, child.width);
+            if (node.type().equals("stack_panel") && vertical) height += child.height;
+            else height = Math.max(height, child.height);
+        }
+        return new Size(width, height);
+    }
+
+    private Box place(final BedrockFormScene.Node node, final Rect parent, final Size size, final float parentLayer,
+                      final Rect parentClip, final Map<BedrockFormScene.Node, Float> scroll) {
+        if (!this.visibleNodes.getOrDefault(node, true)) {
+            final Rect bounds = new Rect(parent.x, parent.y, 0, 0);
+            return new Box(node, bounds, parentClip, EMPTY, bounds, parentLayer,
+                node.children().stream().map(child -> this.place(child, bounds, EMPTY, parentLayer, parentClip, scroll)).toList());
+        }
+        final float[] from = anchor(node.string("anchor_from", "center"));
+        final float[] to = anchor(node.string("anchor_to", "center"));
+        final float x = parent.x + parent.width * from[0] - size.width * to[0]
+            + offset(node, 0, parent.width, size);
+        final float y = parent.y + parent.height * from[1] - size.height * to[1]
+            + offset(node, 1, parent.height, size);
+        final Rect bounds = new Rect(x, y, size.width, size.height);
+        final Rect clip = node.scroll() || node.flag("clips_children", false) ? parentClip.intersect(bounds) : parentClip;
+        final List<Size> sizes = this.children(node, size.width, size.height);
+        Size content = this.content(node, sizes, size.width, size.height);
+        final String contentName = node.string("scroll_content", "");
+        final boolean horizontalScroll = node.string("scroll_direction", "vertical").equals("horizontal");
+        final float scrollAmount = node.scroll() && contentName.isEmpty()
+            ? Math.clamp(scroll.getOrDefault(node, 0F), 0, Math.max(0,
+                horizontalScroll ? content.width - size.width : content.height - size.height)) : 0;
+        final float scrollX = horizontalScroll ? scrollAmount : 0, scrollY = horizontalScroll ? 0 : scrollAmount;
+        final float layer = parentLayer + node.number("layer", 0);
+        final List<Box> children = new ArrayList<>();
+        final boolean vertical = !node.string("orientation", "vertical").equals("horizontal");
+        final Grid grid = this.grid(node, size.width, size.height);
+        final float cellWidth = size.width / grid.columns;
+        final float cellHeight = contentDimension(node, 1) ? content.height / grid.rows : size.height / grid.rows;
+        float cursor = 0;
+        for (int i = 0; i < node.children().size(); i++) {
+            final BedrockFormScene.Node child = node.children().get(i);
+            final Size childSize = sizes.get(i);
+            final Rect childParent;
+            if (node.type().equals("stack_panel")) {
+                childParent = vertical ? new Rect(x - scrollX, y + cursor - scrollY, size.width, childSize.height)
+                    : new Rect(x + cursor - scrollX, y - scrollY, childSize.width, size.height);
+                if (child.flag("visible", true)) cursor += vertical ? childSize.height : childSize.width;
+            } else if (node.type().equals("grid")) {
+                childParent = new Rect(x + grid.column(i) * cellWidth - scrollX, y + grid.row(i) * cellHeight - scrollY, cellWidth, cellHeight);
+            } else childParent = new Rect(x - scrollX, y - scrollY, size.width, size.height);
+            children.add(this.place(child, childParent, childSize, layer, clip, scroll));
+        }
+        Rect viewport = bounds;
+        if (node.scroll() && !contentName.isEmpty()) {
+            final Box contentBox = descendant(children, contentName);
+            final Box viewportBox = descendant(children, node.string("scroll_view_port", ""));
+            if (contentBox != null) {
+                viewport = viewportBox == null ? bounds : viewportBox.bounds;
+                content = new Size(Math.max(contentBox.bounds.width, contentBox.content.width),
+                    Math.max(contentBox.bounds.height, contentBox.content.height));
+                final Box thumb = descendant(children, node.string("scrollbar_box", ""));
+                final boolean horizontal = thumb != null && thumb.node.string("draggable", "vertical").equals("horizontal");
+                final float amount = Math.clamp(scroll.getOrDefault(node, 0F), 0, Math.max(0,
+                    horizontal ? content.width - viewport.width : content.height - viewport.height));
+                final Rect contentClip = clip.intersect(viewport);
+                for (int i = 0; i < children.size(); i++)
+                    children.set(i, scrollContent(children.get(i), contentBox.node, horizontal ? -amount : 0, horizontal ? 0 : -amount, contentClip));
+            }
+        }
+        children.sort(Comparator.comparingDouble(Box::layer));
+        Box result = new Box(node, bounds, clip, content, viewport, layer, List.copyOf(children));
+        if (node.scroll()) {
+            final var model = BedrockFormScroll.model(result, scroll.getOrDefault(node, 0F));
+            if (model != null) result = replace(result, model.originalThumb().node,
+                this.resize(model.originalThumb(), model.thumb(), scroll));
+        }
+        return result;
+    }
+
+    private Box resize(final Box box, final Rect bounds, final Map<BedrockFormScene.Node, Float> scroll) {
+        final List<Size> sizes = this.children(box.node, bounds.width, bounds.height);
+        final List<Box> children = new ArrayList<>();
+        for (int i = 0; i < sizes.size(); i++)
+            children.add(this.place(box.node.children().get(i), bounds, sizes.get(i), box.layer, box.clip, scroll));
+        children.sort(Comparator.comparingDouble(Box::layer));
+        return new Box(box.node, bounds, box.clip, this.content(box.node, sizes, bounds.width, bounds.height),
+            bounds, box.layer, List.copyOf(children));
+    }
+
+    private static Box replace(final Box box, final BedrockFormScene.Node target, final Box replacement) {
+        if (box.node == target) return replacement;
+        return new Box(box.node, box.bounds, box.clip, box.content, box.scrollViewport, box.layer,
+            box.children.stream().map(child -> replace(child, target, replacement)).toList());
+    }
+
+    private static Box descendant(final List<Box> children, final String name) {
+        if (name.isEmpty()) return null;
+        for (final Box child : children) {
+            if (child.node.name().equals(name)) return child;
+            final Box nested = descendant(child.children, name);
+            if (nested != null) return nested;
+        }
+        return null;
+    }
+
+    private static Box scrollContent(final Box box, final BedrockFormScene.Node content, final float x, final float y, final Rect clip) {
+        if (box.node == content) return translated(box, x, y, clip);
+        return new Box(box.node, box.bounds, box.clip, box.content, box.scrollViewport, box.layer,
+            box.children.stream().map(child -> scrollContent(child, content, x, y, clip)).toList());
+    }
+
+    private static Box translated(final Box box, final float x, final float y, final Rect parentClip) {
+        final Rect bounds = new Rect(box.bounds.x + x, box.bounds.y + y, box.bounds.width, box.bounds.height);
+        final Rect clip = box.node.scroll() || box.node.flag("clips_children", false) ? parentClip.intersect(bounds) : parentClip;
+        final Rect viewport = new Rect(box.scrollViewport.x + x, box.scrollViewport.y + y, box.scrollViewport.width, box.scrollViewport.height);
+        return new Box(box.node, bounds, clip, box.content, viewport, box.layer,
+            box.children.stream().map(child -> translated(child, x, y, clip)).toList());
+    }
+
+    private static float constrain(final BedrockFormScene.Node node, final int axis, final float size,
+                                   final Measurement environment, final float width, final float height,
+                                   final float content, final float maximum) {
+        final float minimum = dimension(node, "min_size", axis, environment, width, height, content, maximum, 0);
+        final float declaredUpper = dimension(node, "max_size", axis, environment, width, height, content, maximum, LIMIT);
+        final float upper = declaredUpper == 0 ? LIMIT : declaredUpper;
+        return Math.clamp(size, Math.min(minimum, upper), upper);
+    }
+
+    private static float dimension(final BedrockFormScene.Node node, final String key, final int axis,
+                                   final Measurement environment, final float width, final float height,
+                                   final float content, final float maximum, final float fallback) {
+        final JsonElement pair = node.properties().get(key);
+        if (pair == null || !pair.isJsonArray() || pair.getAsJsonArray().size() != 2) return bounded(fallback);
+        final float parent = axis == 0 ? environment.width : environment.height;
+        final float sibling = axis == 0 ? environment.siblingWidth : environment.siblingHeight;
+        try {
+            return dimension(pair.getAsJsonArray().get(axis), parent, content, maximum, width, height, sibling, fallback);
+        } catch (final IllegalArgumentException error) {
+            throw new IllegalArgumentException("Invalid native form dimension: " + node.name() + "." + key + "[" + axis + "]", error);
+        }
+    }
+
+    static float dimension(final JsonElement value, final float parent, final float content, final float maximum) {
+        return dimension(value, parent, content, maximum, parent, parent, maximum, 0);
+    }
+
+    private static float dimension(final JsonElement value, final float parent, final float content, final float maximum,
+                                   final float width, final float height, final float sibling, final float fallback) {
+        return bounded(signedDimension(value, parent, content, maximum, width, height, sibling, fallback));
+    }
+
+    private static float signedDimension(final JsonElement value, final float parent, final float content, final float maximum,
+                                         final float width, final float height, final float sibling, final float fallback) {
+        if (!value.isJsonPrimitive()) throw new IllegalArgumentException("Unsupported native form dimension");
+        if (value.getAsJsonPrimitive().isNumber()) return signed(value.getAsFloat());
+        final String expression = value.getAsString().replace(" ", "");
+        if (expression.equals("default")) return bounded(fallback);
+        if (expression.equals("fill")) return bounded(parent);
+        final var matcher = DIMENSION.matcher(expression);
+        float result = 0;
+        int end = 0;
+        while (matcher.find()) {
+            if (matcher.start() != end || end != 0 && expression.charAt(end) != '+' && expression.charAt(end) != '-')
+                throw new IllegalArgumentException("Unsupported native form dimension expression");
+            final float amount = Float.parseFloat(matcher.group(1));
+            final String unit = matcher.group(2);
+            result += amount * switch (unit == null ? "px" : unit) {
+                case "%" -> parent / 100;
+                case "%c" -> content / 100;
+                case "%cm" -> maximum / 100;
+                case "%x" -> width / 100;
+                case "%y" -> height / 100;
+                case "%sm" -> sibling / 100;
+                default -> 1;
+            };
+            end = matcher.end();
+        }
+        if (end == 0 || end != expression.length()) throw new IllegalArgumentException("Unsupported native form dimension expression");
+        return signed(result);
+    }
+
+    private static float offset(final BedrockFormScene.Node node, final int axis, final float parent, final Size size) {
+        final JsonElement pair = node.properties().get("offset");
+        if (pair == null || !pair.isJsonArray() || pair.getAsJsonArray().size() != 2) return 0;
+        return signedDimension(pair.getAsJsonArray().get(axis), parent, 0, 0, size.width, size.height, 0, 0);
+    }
+
+    private static boolean contentDimension(final BedrockFormScene.Node node, final int axis) {
+        final JsonElement size = node.properties().get("size");
+        return size != null && size.isJsonArray() && size.getAsJsonArray().size() == 2
+            && size.getAsJsonArray().get(axis).isJsonPrimitive() && size.getAsJsonArray().get(axis).getAsString().contains("%c");
+    }
+
+    static float vector(final BedrockFormScene.Node node, final String key, final int axis, final float fallback) {
+        final JsonElement value = node.properties().get(key);
+        if (value == null || !value.isJsonArray() || value.getAsJsonArray().size() <= axis) return fallback;
+        final float result = value.getAsJsonArray().get(axis).getAsFloat();
+        if (!Float.isFinite(result) || Math.abs(result) > LIMIT) throw new IllegalArgumentException("Invalid native form vector");
+        return result;
+    }
+
+    private static float bounded(final float value) {
+        return Math.max(0, signed(value));
+    }
+
+    private static float signed(final float value) {
+        if (!Float.isFinite(value) || Math.abs(value) > LIMIT) throw new IllegalArgumentException("Native form dimension exceeds layout limits");
+        return value;
+    }
+
+    private Grid grid(final BedrockFormScene.Node node, final float width, final float height) {
+        if (!node.type().equals("grid")) return new Grid(1, 1, true, false);
+        final boolean horizontal = !node.string("grid_fill_direction", "horizontal").equals("vertical");
+        final int count = node.children().size();
+        final boolean explicit = node.properties().has("grid_dimensions");
+        final String rescaling = node.string("grid_rescaling_type", "none");
+        int columns = Math.clamp((int) vector(node, "grid_dimensions", 0, 1), 1, 128);
+        int rows = Math.clamp((int) vector(node, "grid_dimensions", 1, 1), 1, 4096);
+        final boolean rescaled = !explicit && (rescaling.equals("horizontal") || rescaling.equals("vertical"));
+        if (rescaled) {
+            float cellWidth = 0, cellHeight = 0;
+            for (final var child : node.children()) {
+                final Size size = this.measure(child, width, height);
+                cellWidth = Math.max(cellWidth, size.width);
+                cellHeight = Math.max(cellHeight, size.height);
+            }
+            if (rescaling.equals("horizontal")) {
+                columns = cellWidth > 0 ? Math.clamp((int) Math.floor(width / cellWidth), 1, 128) : 1;
+                rows = Math.max(1, (count + columns - 1) / columns);
+            } else {
+                rows = cellHeight > 0 ? Math.clamp((int) Math.floor(height / cellHeight), 1, 4096) : 1;
+                columns = Math.max(1, (count + rows - 1) / rows);
+            }
+        }
+        if (horizontal) rows = Math.max(rows, (count + columns - 1) / columns);
+        else columns = Math.max(columns, (count + rows - 1) / rows);
+        return new Grid(columns, rows, horizontal, rescaled);
+    }
+
+    private record Grid(int columns, int rows, boolean horizontal, boolean rescaled) {
+        int column(final int index) { return this.horizontal ? index % this.columns : index / this.rows; }
+        int row(final int index) { return this.horizontal ? index / this.columns : index % this.rows; }
+    }
+
+    private static float[] anchor(final String name) {
+        return switch (name) {
+            case "top_left" -> new float[]{0, 0};
+            case "top_middle" -> new float[]{.5F, 0};
+            case "top_right" -> new float[]{1, 0};
+            case "left_middle" -> new float[]{0, .5F};
+            case "center" -> new float[]{.5F, .5F};
+            case "right_middle" -> new float[]{1, .5F};
+            case "bottom_left" -> new float[]{0, 1};
+            case "bottom_middle" -> new float[]{.5F, 1};
+            case "bottom_right" -> new float[]{1, 1};
+            default -> throw new IllegalArgumentException("Unsupported native form anchor");
+        };
+    }
+
+    public interface Metrics {
+        Size intrinsic(BedrockFormScene.Node node);
+
+        default Size constrained(final BedrockFormScene.Node node, final float width) {
+            return this.intrinsic(node);
+        }
+    }
+
+    private record Measurement(float width, float height, float siblingWidth, float siblingHeight) {}
+
+    public record Size(float width, float height) {}
+    public record Box(BedrockFormScene.Node node, Rect bounds, Rect clip, Size content, Rect scrollViewport, float layer, List<Box> children) {
+        public Rect visibleBounds() {
+            return this.bounds.intersect(this.clip);
+        }
+    }
+
+    public record Rect(float x, float y, float width, float height) {
+        public Rect intersect(final Rect other) {
+            final float left = Math.max(this.x, other.x), top = Math.max(this.y, other.y);
+            return new Rect(left, top, Math.max(0, Math.min(this.x + this.width, other.x + other.width) - left),
+                Math.max(0, Math.min(this.y + this.height, other.y + other.height) - top));
+        }
+
+        public boolean contains(final double x, final double y) {
+            return x >= this.x && y >= this.y && x < this.x + this.width && y < this.y + this.height;
+        }
+    }
+}
