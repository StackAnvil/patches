+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+/** A bounded, core-resolved scene. Layout never interprets server response indices. */
+public record BedrockFormScene(Node root, Fallback fallback) {
+    private static final Set<String> TYPES = Set.of("screen", "panel", "label", "image", "button", "toggle",
+        "stack_panel", "grid", "scroll_view", "scrollbar_box", "scroll_track", "collection_panel", "factory");
+
+    public static BedrockFormScene parse(final String json) {
+        final JsonObject scene = JsonParser.parseString(json).getAsJsonObject();
+        if (scene.get("format").getAsBigDecimal().intValueExact() != 1) throw new IllegalArgumentException("Unsupported native form format");
+        final Fallback fallback = fallback(scene);
+        return new BedrockFormScene(node(scene.getAsJsonObject("root"), 0, new int[1], fallback.buttons.size(), true), fallback);
+    }
+
+    public static Fallback fallback(final String json) {
+        return fallback(JsonParser.parseString(json).getAsJsonObject());
+    }
+
+    private static Fallback fallback(final JsonObject scene) {
+        final JsonObject form = scene.getAsJsonObject("fallback");
+        if (form == null) throw new IllegalArgumentException("Missing native form fallback");
+        final List<String> buttons = new ArrayList<>();
+        if (form.has("buttons")) {
+            final var entries = form.getAsJsonArray("buttons");
+            if (entries.size() > 1024) throw new IllegalArgumentException("Too many form buttons");
+            for (final var entry : entries) buttons.add(string(entry.getAsJsonObject(), "text", ""));
+        }
+        return new Fallback(string(form, "title", ""), string(form, "content", ""), List.copyOf(buttons));
+    }
+
+    private static Node node(final JsonObject value, final int depth, final int[] count, final int buttonCount,
+                             final boolean inheritedVisible) {
+        if (depth > 64 || ++count[0] > 8192) throw new IllegalArgumentException("Native form scene exceeds layout limits");
+        final String type = string(value, "type", "panel");
+        final JsonElement visibility = value.get("visible");
+        final boolean visible = inheritedVisible && !(visibility != null && visibility.isJsonPrimitive()
+            && visibility.getAsJsonPrimitive().isBoolean() && !visibility.getAsBoolean());
+        if (visible && !TYPES.contains(type)) throw new IllegalArgumentException("Unsupported native form control: " + type);
+        final int action = value.has("action") ? value.get("action").getAsBigDecimal().intValueExact() : Integer.MIN_VALUE;
+        if (value.has("action") && (action < -1 || action >= buttonCount))
+            throw new IllegalArgumentException("Invalid native form response index");
+        final List<Node> children = new ArrayList<>();
+        if (value.has("children")) for (final JsonElement child : value.getAsJsonArray("children"))
+            children.add(node(child.getAsJsonObject(), depth + 1, count, buttonCount, visible));
+        final JsonObject properties = new JsonObject();
+        value.entrySet().stream().filter(entry -> !entry.getKey().equals("children"))
+            .forEach(entry -> properties.add(entry.getKey(), entry.getValue().deepCopy()));
+        return new Node(string(value, "name", ""), type, properties, List.copyOf(children), action);
+    }
+
+    public static String string(final JsonObject properties, final String key, final String fallback) {
+        final JsonElement value = properties.get(key);
+        return value == null || !value.isJsonPrimitive() ? fallback : value.getAsString();
+    }
+
+    public record Node(String name, String type, JsonObject properties, List<Node> children, int action) {
+        public String string(final String key, final String fallback) {
+            return BedrockFormScene.string(this.properties, key, fallback);
+        }
+
+        public float number(final String key, final float fallback) {
+            final JsonElement value = this.properties.get(key);
+            if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) return fallback;
+            final float result = value.getAsFloat();
+            if (!Float.isFinite(result)) throw new IllegalArgumentException("Non-finite native form property");
+            return result;
+        }
+
+        public boolean flag(final String key, final boolean fallback) {
+            final JsonElement value = this.properties.get(key);
+            return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isBoolean()
+                ? value.getAsBoolean() : fallback;
+        }
+
+        public boolean interactive() {
+            return this.action != Integer.MIN_VALUE;
+        }
+
+        public boolean scroll() {
+            return this.type.equals("scroll_view");
+        }
+    }
+
+    public record Fallback(String title, String content, List<String> buttons) {}
+}
