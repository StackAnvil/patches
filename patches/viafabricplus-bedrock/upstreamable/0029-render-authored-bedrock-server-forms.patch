+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.google.gson.JsonObject;
+import java.util.ArrayList;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Plays resolved authored alpha tracks, restarting a visual branch when it becomes active again. */
+final class BedrockFormAnimations {
+    private final Map<BedrockFormScene.Node, Entry> entries = new IdentityHashMap<>();
+    private long frame;
+
+    void beginFrame() { this.frame++; }
+
+    BedrockFormPresentation.Opacity opacity(final BedrockFormScene.Node node, final long now) {
+        final Entry entry = this.entries.computeIfAbsent(node, value -> new Entry(tracks(value)));
+        final float base = Math.clamp(node.number("alpha", 1), 0, 1);
+        if (entry.tracks.isEmpty()) return new BedrockFormPresentation.Opacity(base, base);
+        if (entry.lastFrame != this.frame && entry.lastFrame != this.frame - 1) entry.started = now;
+        entry.lastFrame = this.frame;
+        float current = base, potential = base;
+        for (final Track track : entry.tracks) {
+            current = track.value((now - entry.started) / 1_000_000_000D);
+            potential = Math.max(track.from, track.to);
+        }
+        return new BedrockFormPresentation.Opacity(Math.clamp(current, 0, 1), Math.clamp(potential, 0, 1));
+    }
+
+    private static List<Track> tracks(final BedrockFormScene.Node node) {
+        final var values = node.properties().getAsJsonArray("animation_tracks");
+        if (values == null) return List.of();
+        final List<Track> tracks = new ArrayList<>();
+        for (final var value : values) {
+            final JsonObject track = value.getAsJsonObject();
+            if (!BedrockFormScene.string(track, "anim_type", "").equals("alpha")) continue;
+            tracks.add(new Track(number(track, "from", 1), number(track, "to", 1),
+                Math.clamp(number(track, "duration", 0), 0, 3600),
+                Math.clamp(number(track, "delay", number(track, "start_delay", 0)), 0, 3600), BedrockFormScene.string(track, "easing", "linear")));
+        }
+        return List.copyOf(tracks);
+    }
+
+    private static float number(final JsonObject value, final String key, final float fallback) {
+        if (!value.has(key)) return fallback;
+        final float number = value.get(key).getAsFloat();
+        if (!Float.isFinite(number)) throw new IllegalArgumentException("Non-finite native form animation");
+        return number;
+    }
+
+    private static final class Entry {
+        final List<Track> tracks;
+        long started;
+        long lastFrame = Long.MIN_VALUE;
+        Entry(final List<Track> tracks) { this.tracks = tracks; }
+    }
+
+    record Track(float from, float to, float duration, float delay, String easing) {
+        float value(final double elapsed) {
+            final float progress = duration > 0 ? (float) Math.clamp((elapsed - delay) / duration, 0, 1)
+                : elapsed < delay ? 0 : 1;
+            return this.from + (this.to - this.from) * ease(this.easing, progress);
+        }
+    }
+
+    private static float ease(final String easing, final float progress) {
+        if (easing.equals("linear")) return progress;
+        final int power = easing.endsWith("quad") ? 2 : easing.endsWith("cubic") ? 3
+            : easing.endsWith("quart") ? 4 : easing.endsWith("quint") ? 5 : 0;
+        if (power == 0) throw new IllegalArgumentException("Unsupported native form animation easing");
+        if (easing.startsWith("in_out_")) return progress < .5F ? power(2 * progress, power) / 2
+            : 1 - power(2 * (1 - progress), power) / 2;
+        if (easing.startsWith("out_")) return 1 - power(1 - progress, power);
+        if (easing.startsWith("in_")) return power(progress, power);
+        throw new IllegalArgumentException("Unsupported native form animation easing");
+    }
+
+    private static float power(final float value, final int exponent) {
+        float result = 1;
+        for (int i = 0; i < exponent; i++) result *= value;
+        return result;
+    }
+}
