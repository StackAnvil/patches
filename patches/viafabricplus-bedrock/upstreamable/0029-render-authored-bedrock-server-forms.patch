+                    (payload, buffer) -> NativeContainerAction.TYPE.write(buffer, payload.action),
+                    buffer ->
+                            new NativeContainerActionPayload(
+                                    NativeContainerAction.TYPE.read(buffer)));
+
+    @Override
+    public Type<NativeContainerActionPayload> type() {
+        return TYPE;
+    }
+}
