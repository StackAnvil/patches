+    @Override
+    public void extractRenderState(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        try {
+            this.refreshPendingScene();
+            this.pointerX = mouseX;
+            this.pointerY = mouseY;
+            if (NativeUiPresentation.updateSliderStates(this.scene, this::sliderHovered, this::sliderSelected))
+                this.layout();
+            final List<NativeUiPresentation.Draw> draws = this.draws(mouseX, mouseY);
+            this.synchronize(draws);
+            draws.sort(Comparator.comparingDouble(draw -> draw.box().layer()));
+            NativeUiScene.Node tooltip = null;
+            for (final NativeUiPresentation.Draw draw : draws) {
+                final var box = draw.box();
+                final var clip = box.node().type().equals("label") ? box.visibleBounds() : box.clip();
+                if (draw.enabled() && draw.alpha() > 0 && box.node().type().equals("custom")
+                    && box.node().string("renderer", "").equals("hover_text_renderer")
+                    && !box.node().string("hover_text", "").isEmpty()) tooltip = box.node();
+                if (draw.alpha() <= 0 || box.visibleBounds().width() <= 0 || box.visibleBounds().height() <= 0) continue;
+                graphics.enableScissor(Math.round(clip.x()), Math.round(clip.y()),
+                    Math.round(clip.x() + clip.width()), Math.round(clip.y() + clip.height()));
+                try {
+                    final var node = box.node();
+                    this.renderer().draw(graphics, draw, this.animations);
+                    if (node.type().equals("custom") && (node.string("renderer", "").equals(NativeUiActorPortraits.RENDERER)
+                        || node.string("renderer", "").equals(NativeUiActorPortraits.ACTOR_RENDERER)))
+                        this.renderer().portrait(graphics, box, mouseX, mouseY, delta, draw.alpha());
+                    final Action action = this.actions.get(node);
+                    if (action != null) action.extractRenderState(graphics, mouseX, mouseY, delta);
+                    final NativeInput input = this.inputs.get(node);
+                    if (input != null) input.widget().extractRenderState(graphics, mouseX, mouseY, delta);
+                } finally {
+                    graphics.disableScissor();
+                }
+            }
+            if (tooltip != null) {
+                final Component text = tooltip.properties().has("hover_text_component")
+                    ? ComponentSerialization.CODEC.parse(JsonOps.INSTANCE, tooltip.properties().get("hover_text_component")).getOrThrow()
+                    : NativeUiText.component(tooltip.string("hover_text", ""));
+                final int maximum = Math.round(tooltip.number("hover_text_max_width", 0));
+                final int wrapWidth = maximum > 0 ? Math.max(1, Math.min(maximum, this.width - 16)) : Integer.MAX_VALUE;
+                graphics.setTooltipForNextFrame(this.font, NativeUiText.tooltipLines(this.font, text, wrapWidth), mouseX, mouseY);
+            }
+            if (this.images.failed()) graphics.text(this.font,
+                Component.literal("Some menu images could not load."), 8, this.height - this.font.lineHeight - 8,
+                0xFFFFCCCC, true);
+        } catch (final RuntimeException error) {
+            this.controller.failed(error);
+        }
+    }
