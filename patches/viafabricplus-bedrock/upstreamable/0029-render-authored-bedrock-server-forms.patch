+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.function.Function;
+import java.util.function.Predicate;
+
+/** Selects native visual states before layout while preserving control identities. */
+public final class NativeUiPresentation {
+    private static final List<String> SLIDER_STATES = List.of("default_control", "hover_control");
+    private static final List<String> THUMB_STATES = List.of("default_control", "hover_control", "locked_control", "indent_control");
+
+    private NativeUiPresentation() {}
+
+    public static boolean updateSliderStates(final NativeUiScene.Node root,
+                                      final Predicate<NativeUiScene.Node> hovered,
+                                      final Predicate<NativeUiScene.Node> selected) {
+        return updateSliderStates(root, true, true, false, null, hovered, selected);
+    }
+
+    private static boolean updateSliderStates(final NativeUiScene.Node node, final boolean inheritedVisible,
+                                               final boolean inheritedEnabled, final boolean stateBranch,
+                                               final Boolean activeState, final Predicate<NativeUiScene.Node> hovered,
+                                               final Predicate<NativeUiScene.Node> selected) {
+        // Native named-state setters replace the branch root's authored visibility, not its descendants' bindings.
+        final boolean ownVisible = activeState != null ? activeState
+            : stateBranch ? node.flag("visible_when_active", node.flag("visible", true)) : node.flag("visible", true);
+        final boolean visible = inheritedVisible && ownVisible && !node.flag("ignored", false);
+        boolean changed = false;
+        if (stateBranch && node.flag("visible", true) != visible) {
+            node.properties().addProperty("visible", visible);
+            changed = true;
+        }
+        final boolean enabled = inheritedEnabled && node.flag("enabled", true);
+        final List<String> states = switch (node.type()) {
+            case "slider" -> SLIDER_STATES;
+            case "slider_box" -> THUMB_STATES;
+            default -> List.of();
+        };
+        final String selectedName;
+        if (states.isEmpty()) {
+            selectedName = "";
+        } else {
+            final String selectedProperty = node.type().equals("slider_box")
+                ? !enabled ? "locked_control" : selected.test(node) ? "indent_control" : hovered.test(node) ? "hover_control" : "default_control"
+                : hovered.test(node) ? "hover_control" : "default_control";
+            selectedName = node.string(selectedProperty, "");
+        }
+        for (final var child : node.children()) {
+            Boolean active = null;
+            for (final String state : states) {
+                final String name = node.string(state, "");
+                if (!name.isEmpty() && name.equals(child.name())) {
+                    active = name.equals(selectedName);
+                    break;
+                }
+            }
+            changed |= updateSliderStates(child, visible, enabled, stateBranch || active != null, active, hovered, selected);
+        }
+        return changed;
+    }
+
+    public static List<Draw> draws(final NativeUiLayout.Box root, final Predicate<NativeUiLayout.Box> hovered) {
+        return draws(root, hovered, node -> new Opacity(node.number("alpha", 1), node.number("alpha", 1)));
+    }
+
+    public static List<Draw> draws(final NativeUiLayout.Box root, final Predicate<NativeUiLayout.Box> hovered,
+                           final Function<NativeUiScene.Node, Opacity> opacity) {
+        final List<Draw> result = new ArrayList<>();
+        collect(root, new Opacity(1, 1), true, hovered, opacity, result);
+        return result;
+    }
+
+    private static void collect(final NativeUiLayout.Box box, final Opacity inheritedAlpha,
+                                final boolean inheritedEnabled, final Predicate<NativeUiLayout.Box> hovered,
+                                final Function<NativeUiScene.Node, Opacity> opacity, final List<Draw> result) {
+        final var node = box.node();
+        if (!node.flag("visible", true) || node.flag("ignored", false)) return;
+        final Opacity local = opacity.apply(node);
+        final Opacity alpha = new Opacity(inheritedAlpha.current * Math.clamp(local.current, 0, 1),
+            inheritedAlpha.potential * Math.clamp(local.potential, 0, 1));
+        if (alpha.potential == 0) return;
+        final boolean enabled = inheritedEnabled && node.flag("enabled", true);
+        result.add(new Draw(box, alpha.current, alpha.potential, enabled));
+        final boolean isHovered = node.interactive() && hovered.test(box);
+        final Set<String> excluded = new HashSet<>();
+        if (!node.type().equals("slider") && !node.type().equals("slider_box")) {
+            select(node, excluded, !enabled ? "locked_control" : isHovered ? "hover_control" : "default_control", "default_control",
+                "default_control", "hover_control", "pressed_control", "locked_control");
+        }
+        if (node.type().equals("toggle")) {
+            final String state = node.flag("toggle_state", false) ? "checked" : "unchecked";
+            select(node, excluded, state + (!enabled ? "_locked" : "") + (isHovered ? "_hover" : "") + "_control", state + "_control",
+                "checked_control", "unchecked_control", "checked_hover_control", "unchecked_hover_control",
+                "checked_locked_control", "unchecked_locked_control", "checked_locked_hover_control", "unchecked_locked_hover_control");
+        }
+        if (node.type().equals("slider")) {
+            select(node, excluded, isHovered ? "background_hover_control" : "background_control", "background_control",
+                "background_control", "background_hover_control");
+            select(node, excluded, isHovered ? "progress_hover_control" : "progress_control", "progress_control",
+                "progress_control", "progress_hover_control");
+        }
+        if (node.type().equals("edit_box") && node.properties().has("input")) {
+            excluded.add(node.string("text_control", ""));
+            excluded.add(node.string("place_holder_control", ""));
+        }
+        for (final var child : box.children()) {
+            if (excluded.contains(child.node().name())) continue;
+            collect(child, alpha, enabled, hovered, opacity, result);
+        }
+    }
+
+    private static void select(final NativeUiScene.Node node, final Set<String> excluded,
+                               final String selectedProperty, final String fallbackProperty, final String... states) {
+        String selected = node.string(selectedProperty, "");
+        if (selected.isEmpty()) selected = node.string(fallbackProperty, "");
+        for (final String state : states) {
+            final String name = node.string(state, "");
+            if (!name.isEmpty() && !name.equals(selected)) excluded.add(name);
+        }
+    }
+
+    public record Opacity(float current, float potential) {}
+
+    public record Draw(NativeUiLayout.Box box, float alpha, float potential, boolean enabled) {}
+}
