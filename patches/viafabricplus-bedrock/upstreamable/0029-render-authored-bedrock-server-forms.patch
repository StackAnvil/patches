@@ -0,0 +1,69 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+/** Pointer geometry for authored scrollbars. Native layout math remains a separate parity boundary. */
+final class BedrockFormScroll {
+    private BedrockFormScroll() {}
+
+    static boolean horizontal(final BedrockFormLayout.Box view) {
+        final var thumb = descendant(view, view.node().string("scrollbar_box", ""));
+        return thumb != null ? thumb.node().string("draggable", "vertical").equals("horizontal")
+            : view.node().string("scroll_direction", "vertical").equals("horizontal");
+    }
+
+    static float maximum(final BedrockFormLayout.Box view) {
+        return Math.max(0, horizontal(view) ? view.content().width() - view.scrollViewport().width()
+            : view.content().height() - view.scrollViewport().height());
+    }
+
+    static Model model(final BedrockFormLayout.Box view, final float offset) {
+        final var track = descendant(view, view.node().string("scrollbar_track", ""));
+        final var thumb = descendant(view, view.node().string("scrollbar_box", ""));
+        if (track == null || thumb == null) return null;
+        final boolean horizontal = horizontal(view);
+        final float maximum = maximum(view);
+        final float content = horizontal ? view.content().width() : view.content().height();
+        final float viewport = horizontal ? view.scrollViewport().width() : view.scrollViewport().height();
+        final float length = horizontal ? track.bounds().width() : track.bounds().height();
+        final int axis = horizontal ? 0 : 1;
+        final var minimum = thumb.node().properties().getAsJsonArray("min_size");
+        final float minimumLength = minimum != null && minimum.size() == 2
+            ? BedrockFormLayout.dimension(minimum.get(axis), length, 0, 0) : 0;
+        final float extent = Math.clamp(content > 0 ? length * Math.min(1, viewport / content) : length,
+            Math.clamp(minimumLength, 0, length), length);
+        final float position = maximum > 0 ? (length - extent) * Math.clamp(offset, 0, maximum) / maximum : 0;
+        final var bounds = horizontal
+            ? new BedrockFormLayout.Rect(track.bounds().x() + position, thumb.bounds().y(), extent, thumb.bounds().height())
+            : new BedrockFormLayout.Rect(thumb.bounds().x(), track.bounds().y() + position, thumb.bounds().width(), extent);
+        return new Model(thumb, track.bounds(), bounds, track.clip().intersect(thumb.clip()), maximum,
+            Math.clamp(offset, 0, maximum), horizontal);
+    }
+
+    static BedrockFormLayout.Box descendant(final BedrockFormLayout.Box box, final String name) {
+        if (name.isEmpty()) return null;
+        for (final var child : box.children()) {
+            if (child.node().name().equals(name)) return child;
+            final var found = descendant(child, name);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    record Model(BedrockFormLayout.Box originalThumb, BedrockFormLayout.Rect track, BedrockFormLayout.Rect thumb,
+                 BedrockFormLayout.Rect clip, float maximum, float offset, boolean horizontal) {
+        boolean containsTrack(final double x, final double y) { return this.track.intersect(this.clip).contains(x, y); }
+        boolean containsThumb(final double x, final double y) { return this.thumb.intersect(this.clip).contains(x, y); }
+        float pointer(final double x, final double y) { return (float) (this.horizontal ? x : y); }
+        float start() { return this.horizontal ? this.thumb.x() : this.thumb.y(); }
+        float extent() { return this.horizontal ? this.thumb.width() : this.thumb.height(); }
+        float offsetAt(final float pointer, final float grab) {
+            final float travel = this.horizontal ? this.track.width() - this.thumb.width() : this.track.height() - this.thumb.height();
+            final float start = this.horizontal ? this.track.x() : this.track.y();
+            return travel > 0 ? Math.clamp((pointer - start - grab) / travel, 0, 1) * this.maximum : 0;
+        }
+    }
+}
