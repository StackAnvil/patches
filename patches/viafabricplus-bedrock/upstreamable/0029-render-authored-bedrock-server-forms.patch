+
+/** One retained GUI perspective. World playback and world effect dispatch remain separate. */
+public final class BedrockGuiActorContext implements AutoCloseable {
+    private static final ThreadLocal<BedrockGuiActorContext> CURRENT = new ThreadLocal<>();
+    private static final Map<EntityRenderState, BedrockGuiActorContext> FRAMES = new WeakHashMap<>();
+    private final UUID actor, lifetime;
+    private final Map<String, Object> resources = new java.util.HashMap<>();
+    private Object resourceGeneration;
+    private final BedrockEmotePlayback.GuiPlayback emote = new BedrockEmotePlayback.GuiPlayback();
+    private final List<BedrockActorAnimation.SoundCue> sounds = new ArrayList<>();
+    private final List<BedrockActorAnimation.ParticleCue> particles = new ArrayList<>();
+    private BedrockActorAnimation.Playback source, playback;
+    private BedrockPlayerControllers.Selection selection;
+    private float pitch, yaw;
+    private long started = System.nanoTime();
+
+    public BedrockGuiActorContext(final UUID actor, final UUID lifetime) {
+        this.actor = actor;
+        this.lifetime = lifetime;
+    }
+
+    public static void correctPose(final com.mojang.blaze3d.vertex.PoseStack pose, final float width, final int guiScale) {
+        if (!(width > 0) || !Float.isFinite(width) || guiScale < 1)
+            throw new IllegalArgumentException("Invalid native GUI actor scale");
+        pose.scale(1, -1, -1F / (width * guiScale));
+    }
+
+    public void requireSupportedEffects() {
+        if (!this.sounds.isEmpty() || !this.particles.isEmpty())
+            throw new IllegalArgumentException("Native GUI actor effects are not yet supported");
+    }
+
+    @Override
+    public void close() {
+        FRAMES.values().removeIf(context -> context == this);
+        this.resources.clear();
+        this.resourceGeneration = null;
+        this.source = null;
+        this.playback = null;
+        this.selection = null;
+        this.sounds.clear();
+        this.particles.clear();
+    }
+
+    public boolean owns(final UUID actor, final UUID lifetime) {
+        return this.actor.equals(actor) && java.util.Objects.equals(this.lifetime, lifetime);
+    }
+
+    public static BedrockGuiActorContext current() { return CURRENT.get(); }
+    public static BedrockGuiActorContext frame(final EntityRenderState state) { return FRAMES.get(state); }
+
+    public <T> T scoped(final Supplier<T> operation) {
+        final BedrockGuiActorContext previous = CURRENT.get();
+        try {
+            CURRENT.set(this);
+            return operation.get();
+        } finally {
+            if (previous == null) CURRENT.remove();
+            else CURRENT.set(previous);
+        }
+    }
+
+    public void camera(final float pitch, final float yaw) {
+        this.pitch = pitch;
+        this.yaw = yaw;
+        this.selection = null;
+        this.sounds.clear();
+        this.particles.clear();
+    }
+
+    public static void extracted(final AvatarRenderState state) {
+        extracted((EntityRenderState) state);
+        final var current = current();
+        if (current != null) {
+            state.xRot = current.pitch;
+            state.yRot = 0;
+            state.bodyRot = current.yaw;
+        }
+    }
+
+    public static void extracted(final EntityRenderState state) {
+        final var current = current();
+        if (current == null) FRAMES.remove(state);
+        else FRAMES.put(state, current);
+    }
+
+    public BedrockActorAnimation.Playback playback(final BedrockActorAnimation.Playback source) {
+        if (this.source != source) {
+            this.source = source;
+            this.playback = source == null ? null : source.fork();
+            this.started = System.nanoTime();
+        }
+        return this.playback;
+    }
+
+    @SuppressWarnings("unchecked")
+    public <T> T resource(final Object generation, final String identifier, final Supplier<T> create) {
+        if (generation != this.resourceGeneration) {
+            this.resources.clear();
+            this.resourceGeneration = generation;
+        }
+        return (T) this.resources.computeIfAbsent(identifier, _ -> create.get());
+    }
+
+    public float yaw() { return this.yaw; }
+
+    public float seconds() { return (System.nanoTime() - this.started) / 1_000_000_000F; }
+    public BedrockEmotePlayback.GuiPlayback emote() { return this.emote; }
+    public void sound(final BedrockActorAnimation.SoundCue sound) { if (this.sounds.size() < 128) this.sounds.add(sound); }
+    public void particle(final BedrockActorAnimation.ParticleCue particle) { if (this.particles.size() < 128) this.particles.add(particle); }
+    public List<BedrockActorAnimation.SoundCue> sounds() { return List.copyOf(this.sounds); }
+    public List<BedrockActorAnimation.ParticleCue> particles() { return List.copyOf(this.particles); }
+    public BedrockPlayerControllers.Selection selection() { return this.selection; }
+    public void selection(final BedrockPlayerControllers.Selection selection) { this.selection = selection; }
+}
