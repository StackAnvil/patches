+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+final class NativeUiAnimationsTest {
+    @Test
+    void treatsUnsetAnimationBindingsAsOmittedProperties() {
+        final var explicit = track("alpha", 2, 1, 1);
+        final var unset = explicit.deepCopy();
+        for (final String key : List.of("duration", "from", "to", "delay", "start_delay")) {
+            unset.add(key, com.google.gson.JsonNull.INSTANCE);
+            explicit.remove(key);
+        }
+        final var animations = new NativeUiAnimations();
+        final var nodes = new java.util.ArrayList<NativeUiScene.Node>();
+        for (final var track : List.of(explicit, unset)) {
+            final var properties = new JsonObject();
+            final var tracks = new JsonArray();
+            tracks.add(track);
+            AnimationPrograms.attach(properties, tracks, false);
+            nodes.add(new NativeUiScene.Node("", "image", properties, List.of(), Integer.MIN_VALUE));
+        }
+        for (final long elapsed : new long[] {0, 1_000_000_000L, 3_000_000_000L})
+            assertEquals(animations.opacityAt(nodes.getFirst(), elapsed), animations.opacityAt(nodes.getLast(), elapsed));
+    }
+
