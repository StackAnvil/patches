+            .filter(draw -> draw.box().node().interactive()).map(draw -> draw.box().node().action()).toList();
+        assertEquals(java.util.List.of(0, 2, 3, 4, 5), actions);
+    }
+
+    @Test
+    void rescalesVerticalGridAndFillsColumnsBeforeRows() {
+        final JsonObject root = node("grid", 120, 100);
+        root.addProperty("grid_rescaling_type", "vertical");
+        root.addProperty("grid_fill_direction", "vertical");
+        children(root, node("panel", 40, 30), node("panel", 40, 30), node("panel", 40, 30), node("panel", 40, 30));
+        final var box = layout(scene(root), 320, 200);
+        assertEquals(box.bounds().x(), box.children().get(2).bounds().x());
