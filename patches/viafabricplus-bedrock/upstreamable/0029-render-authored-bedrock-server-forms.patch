+    @Test
+    void selectsNativeHoverTooltipWithoutChangingResponseOrLayout() {
+        final JsonObject root = node("button", 80, 25);
+        root.addProperty("action", 7);
+        root.addProperty("default_control", "normal");
+        root.addProperty("hover_control", "hover");
+        final JsonObject normal = node("panel", "100%", "100%");
+        normal.addProperty("name", "normal");
+        final JsonObject hover = node("panel", "100%", "100%");
+        hover.addProperty("name", "hover");
+        final JsonObject tooltip = node("custom", 0, 0);
+        tooltip.addProperty("renderer", "hover_text_renderer");
+        tooltip.addProperty("hover_text", "Additional detail");
+        children(hover, tooltip);
+        children(root, normal, hover);
+        final var box = layout(scene(root), 320, 200);
+        assertEquals(80, box.bounds().width());
+        assertEquals(25, box.bounds().height());
+        assertEquals(7, box.node().action());
+        assertTrue(BedrockFormPresentation.draws(box, _ -> false).stream().noneMatch(draw -> draw.box().node().type().equals("custom")));
+        final var hovered = BedrockFormPresentation.draws(box, _ -> true);
+        assertEquals(1, hovered.stream().filter(draw -> draw.box().node().type().equals("custom")).count());
+        assertEquals(7, hovered.getFirst().box().node().action());
+        tooltip.addProperty("renderer", "unsupported_renderer");
+        assertThrows(IllegalArgumentException.class, () -> scene(root));
