+
+final class BedrockFormLayoutTest {
+    @Test
+    void resolvesAnchorsOffsetsAndOriginalResponseIndices() {
+        final JsonObject root = node("screen", 320, 200);
+        final JsonObject button = node("button", 100, 40);
+        button.addProperty("anchor_from", "right_middle");
+        button.addProperty("anchor_to", "right_middle");
+        button.add("offset", pair(-12, 6));
+        button.addProperty("action", 3);
+        children(root, button);
+        final var box = layout(scene(root), 320, 200).children().getFirst();
+        assertEquals(new BedrockFormLayout.Rect(208, 86, 100, 40), box.bounds());
+        assertEquals(3, box.node().action());
+    }
+
+    @Test
+    void sizesStacksFromMaximumChildWidthAndSummedHeights() {
+        final JsonObject root = node("stack_panel", "100%cm + 10px", "100%c + 8px");
+        children(root, node("panel", 40, 18), node("panel", 60, 25));
+        final var box = layout(scene(root), 320, 200);
+        assertEquals(70, box.bounds().width());
+        assertEquals(51, box.bounds().height());
+        assertEquals(box.bounds().y() + 18, box.children().get(1).bounds().y());
+        assertEquals(60, box.content().width());
+        assertEquals(43, box.content().height());
+    }
+
+    @Test
+    void retainsGridRowsAndSparseFormButtonIndices() {
+        final JsonObject root = node("grid", 180, "100%c");
+        root.add("grid_dimensions", pair(3, 1));
+        final JsonObject[] cells = new JsonObject[5];
+        for (int i = 0; i < cells.length; i++) {
+            cells[i] = node("button", 60, 40);
+            cells[i].addProperty("action", i * 2);
+        }
+        children(root, cells);
+        final var box = layout(scene(root), 320, 200);
+        assertEquals(80, box.bounds().height());
+        assertEquals(box.bounds().x(), box.children().get(3).bounds().x());
+        assertEquals(box.bounds().y() + 40, box.children().get(3).bounds().y());
+        assertEquals(8, box.children().get(4).node().action());
+    }
+
+    @Test
+    void clipsScrolledChildrenWithoutRenumberingActions() {
+        final JsonObject root = node("scroll_view", 120, 70);
+        root.add("offset", pair(10, 20));
+        final JsonObject stack = node("stack_panel", "100%", "100%c");
+        final JsonObject first = node("button", 100, 30);
+        first.addProperty("action", 4);
+        children(stack, first, node("button", 100, 30), node("button", 100, 30));
+        children(root, stack);
+        final var scene = scene(root);
+        final Map<BedrockFormScene.Node, Float> scroll = new IdentityHashMap<>();
+        scroll.put(scene.root(), 15F);
+        final var box = new BedrockFormLayout(_ -> new BedrockFormLayout.Size(0, 0)).layout(scene.root(), 320, 200, scroll);
+        final var clipped = box.children().getFirst().children().getFirst();
+        assertEquals(new BedrockFormLayout.Rect(10, 20, 100, 15), clipped.visibleBounds());
+        assertFalse(clipped.visibleBounds().contains(30, 10));
