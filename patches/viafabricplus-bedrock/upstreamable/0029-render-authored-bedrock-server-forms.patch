+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import java.util.List;
+
+/** Domain state and responses for an authored screen; geometry and input belong to the shared screen. */
+public interface NativeUiController {
+    String title();
+    NativeUiScene.Node root();
+    void validateVisibleControls();
+    void validateResponseControls(List<NativeUiScene.Node> controls);
+    boolean current();
+    Activation activate(NativeUiScene.Node node);
+    void cancel();
+    void failed(RuntimeException error);
+
+    default Activation dismiss() { this.cancel(); return Activation.CLOSE; }
+    default Inputs inputs() { return null; }
+    default void refresh() {}
+
+    enum Activation { STAY, CLOSE, REPLACED }
+
+    /** Editable values addressed by the controller's original input indices. */
+    interface Inputs {
+        int maxLength(int index);
+        String text(int index);
+        String placeholder(int index);
+        boolean setText(int index, String value);
+        boolean isSlider(int index);
+        void slide(int index, double fraction);
+        void adjust(int index, int direction);
+    }
+}
