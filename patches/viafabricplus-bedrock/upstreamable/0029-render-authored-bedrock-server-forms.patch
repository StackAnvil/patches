+        node.properties().addProperty("anchor_to", "top_left");
+        final var authored = node.properties().deepCopy();
+        final var animations = new NativeUiAnimations();
+        animations.advance(node, 500_000_000);
+        final var solver = new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0), animations);
+        final var small = solver.layout(node, 200, 100, java.util.Map.of());
+        assertEquals(new NativeUiLayout.Rect(5, 15, 110, 40), small.bounds());
+        org.junit.jupiter.api.Assertions.assertTrue(small.visibleBounds().contains(114, 54));
+        org.junit.jupiter.api.Assertions.assertFalse(small.visibleBounds().contains(116, 54));
+        final var large = solver.layout(node, 400, 100, java.util.Map.of());
+        assertEquals(new NativeUiLayout.Rect(5, 15, 210, 40), large.bounds());
