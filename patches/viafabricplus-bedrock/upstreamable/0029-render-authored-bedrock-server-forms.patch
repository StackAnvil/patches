+    private Map<NativeUiScene.Node, Boolean> interactive(final double x, final double y) {
+        final Map<NativeUiScene.Node, Boolean> result = new IdentityHashMap<>();
+        for (final var draw : this.draws((int) x, (int) y)) if (draw.enabled() && draw.alpha() > 0) result.put(draw.box().node(), true);
+        return result;
+    }
