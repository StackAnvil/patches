+/** Bounded asynchronous public images, cached by target version and complete URL without account credentials. */
+final class BedrockFormImageCache {
+    static final int MAX_BYTES = 4 * 1024 * 1024;
+    static final int MAX_PIXELS = 4 * 1024 * 1024;
+    private static final int MAX_ENTRIES = 128;
+    private static final long MAX_CACHE_BYTES = 64L * 1024 * 1024;
+    private static final Duration AGE = Duration.ofDays(7);
+    private final Path directory;
+    private final HttpClient http;
+    private final Executor executor;
+    private final Predicate<URI> allowed;
+    private final Map<URI, CompletableFuture<Data>> pending = new LinkedHashMap<>(16, .75F, true);
+
+    BedrockFormImageCache(final Path directory, final String version, final HttpClient http, final Executor executor) {
+        this(directory, version, http, executor, BedrockFormImageCache::https);
+    }
+
+    // Tests use a separately owned loopback server; production always uses the HTTPS policy above.
+    BedrockFormImageCache(final Path directory, final String version, final HttpClient http,
+                         final Executor executor, final Predicate<URI> allowed) {
+        if (!version.matches("[A-Za-z0-9._-]{1,64}")) throw new IllegalArgumentException("Invalid image cache version");
+        this.directory = directory.resolve(version);
+        this.http = http;
+        this.executor = executor;
+        this.allowed = allowed;
+    }
+
+    synchronized CompletableFuture<Data> load(final String url) {
+        final URI uri;
+        try {
+            uri = URI.create(url);
+            if (url.length() > 4096 || !this.allowed.test(uri)) throw new IllegalArgumentException("Unsupported image URL");
+        } catch (final RuntimeException error) {
+            return CompletableFuture.failedFuture(error);
+        }
+        final var existing = this.pending.get(uri);
+        if (existing != null && !existing.isCompletedExceptionally()) return existing;
+        if (existing != null) this.pending.remove(uri, existing);
+        this.pruneMemory();
+        if (this.pending.size() >= MAX_ENTRIES) return CompletableFuture.failedFuture(new IOException("Too many menu images"));
+        final CompletableFuture<Data> result;
+        try {
+            result = CompletableFuture.supplyAsync(() -> {
+                try {
+                    final Path file = this.directory.resolve(hash(uri.toString()) + ".png");
+                    if (Files.isRegularFile(file)) {
+                        try {
+                            if (Files.size(file) <= MAX_BYTES && Files.getLastModifiedTime(file).toInstant().plus(AGE).isAfter(java.time.Instant.now()))
+                                try (final var input = Files.newInputStream(file)) { return decode(input.readNBytes(MAX_BYTES + 1)); }
+                        } catch (final IOException | RuntimeException invalid) {
+                            // Replace an incomplete or corrupt entry with a fresh bounded download.
+                        }
+                    }
+                    final Data data = decode(this.download(uri, 0, System.nanoTime() + TimeUnit.SECONDS.toNanos(20)));
+                    this.store(file, data.bytes);
+                    return data;
+                } catch (final Exception error) {
+                    throw new java.util.concurrent.CompletionException(error);
+                }
+            }, this.executor);
+        } catch (final java.util.concurrent.RejectedExecutionException busy) {
+            return CompletableFuture.failedFuture(new IOException("Menu image queue is full", busy));
+        }
+        this.pending.put(uri, result);
+        result.whenComplete((data, failure) -> {
+            synchronized (this) {
+                if (failure != null) this.pending.remove(uri, result);
+                this.pruneMemory();
+            }
+        });
+        return result;
+    }
+
+    private byte[] download(final URI uri, final int redirects, final long deadline) throws Exception {
+        if (!this.allowed.test(uri)) throw new IOException("Unsupported image redirect");
+        final long remaining = deadline - System.nanoTime();
+        if (remaining <= 0) throw new java.util.concurrent.TimeoutException("Menu image request timed out");
+        final var request = HttpRequest.newBuilder(uri).timeout(Duration.ofNanos(Math.min(remaining, TimeUnit.SECONDS.toNanos(15))))
+            .header("Accept", "image/png,image/jpeg").GET().build();
+        final var responseFuture = this.http.sendAsync(request, info -> new LimitedBody());
+        final HttpResponse<byte[]> response;
+        try { response = responseFuture.get(remaining, TimeUnit.NANOSECONDS); }
+        finally { if (!responseFuture.isDone()) responseFuture.cancel(true); }
+        if (response.statusCode() >= 300 && response.statusCode() <= 399) {
+            if (redirects >= 3) throw new IOException("Too many image redirects");
+            final String location = response.headers().firstValue("Location").orElseThrow(() -> new IOException("Missing image redirect"));
+            return this.download(uri.resolve(location), redirects + 1, deadline);
+        }
+        if (response.statusCode() != 200) throw new IOException("Menu image request failed");
+        return response.body();
+    }
+
+    static boolean https(final URI uri) {
+        return "https".equalsIgnoreCase(uri.getScheme()) && uri.getHost() != null
+            && uri.getUserInfo() == null && uri.getFragment() == null;
+    }
+
+    static Data decode(final byte[] bytes) throws IOException {
+        if (bytes.length == 0 || bytes.length > MAX_BYTES) throw new IOException("Menu image exceeds byte limits");
+        try (final var input = ImageIO.createImageInputStream(new ByteArrayInputStream(bytes))) {
+            final var readers = ImageIO.getImageReaders(input);
+            if (!readers.hasNext()) throw new IOException("Unsupported menu image format");
+            final var reader = readers.next();
+            try {
+                if (!reader.getFormatName().equalsIgnoreCase("png") && !reader.getFormatName().equalsIgnoreCase("jpeg"))
+                    throw new IOException("Unsupported menu image format");
+                reader.setInput(input, true, true);
+                final int width = reader.getWidth(0), height = reader.getHeight(0);
+                if (width <= 0 || height <= 0 || width > 2048 || height > 2048 || (long) width * height > MAX_PIXELS)
+                    throw new IOException("Menu image exceeds pixel limits");
+                final BufferedImage pixels = reader.read(0);
+                final var output = new ByteArrayOutputStream();
+                if (!ImageIO.write(pixels, "png", output) || output.size() > MAX_BYTES)
+                    throw new IOException("Decoded menu image exceeds byte limits");
+                return new Data(output.toByteArray(), width, height);
+            } finally { reader.dispose(); }
+        }
+    }
+
+    private void store(final Path file, final byte[] bytes) {
+        Path temporary = null;
+        try {
+            Files.createDirectories(this.directory);
+            temporary = Files.createTempFile(this.directory, "image-", ".tmp");
+            Files.write(temporary, bytes);
+            Files.move(temporary, file, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+            try (final var paths = Files.list(this.directory)) {
+                final var entries = paths.filter(path -> path.getFileName().toString().matches("[0-9a-f]{64}\\.png"))
+                    .sorted(java.util.Comparator.comparingLong(BedrockFormImageCache::modified).reversed()).toList();
+                long total = 0;
+                for (int i = 0; i < entries.size(); i++) {
+                    total += Files.size(entries.get(i));
+                    if (i >= MAX_ENTRIES || total > MAX_CACHE_BYTES) Files.deleteIfExists(entries.get(i));
+                }
+            }
+        } catch (final IOException ignored) {
+            // Read-only or unavailable cache storage must not stop the current menu.
+        } finally {
+            if (temporary != null) try { Files.deleteIfExists(temporary); } catch (final IOException ignored) {}
+        }
+    }
+
+    private synchronized void pruneMemory() {
+        long total = 0;
+        for (final var future : this.pending.values()) if (future.isDone() && !future.isCompletedExceptionally()) {
+            final Data data = future.getNow(null);
+            if (data != null) total += data.bytes.length;
+        }
+        final var values = this.pending.entrySet().iterator();
+        while (values.hasNext() && (total > MAX_CACHE_BYTES || this.pending.size() >= MAX_ENTRIES)) {
+            final var future = values.next().getValue();
+            if (!future.isDone()) continue;
+            final Data data = future.isCompletedExceptionally() ? null : future.getNow(null);
+            if (data != null) total -= data.bytes.length;
+            values.remove();
+        }
+    }
+
+    private static long modified(final Path path) {
+        try { return Files.getLastModifiedTime(path).toMillis(); } catch (final IOException missing) { return 0; }
+    }
+
+    private static String hash(final String value) {
+        try { return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(value.getBytes(java.nio.charset.StandardCharsets.UTF_8))); }
+        catch (final java.security.NoSuchAlgorithmException impossible) { throw new AssertionError(impossible); }
+    }
+
+    record Data(byte[] bytes, int width, int height) {}
+
+    private static final class LimitedBody implements HttpResponse.BodySubscriber<byte[]> {
+        private final CompletableFuture<byte[]> result = new CompletableFuture<>();
+        private final ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        private Flow.Subscription subscription;
+
+        @Override public CompletionStage<byte[]> getBody() { return this.result; }
+        @Override public void onSubscribe(final Flow.Subscription subscription) {
+            this.subscription = subscription;
+            subscription.request(1);
+        }
+        @Override public void onNext(final List<ByteBuffer> buffers) {
+            for (final var buffer : buffers) {
+                if ((long) this.bytes.size() + buffer.remaining() > MAX_BYTES) {
+                    this.subscription.cancel();
+                    this.result.completeExceptionally(new IOException("Menu image exceeds byte limits"));
+                    return;
+                }
+                final byte[] chunk = new byte[buffer.remaining()];
+                buffer.get(chunk);
+                this.bytes.writeBytes(chunk);
+            }
+            this.subscription.request(1);
+        }
+        @Override public void onError(final Throwable error) { this.result.completeExceptionally(error); }
+        @Override public void onComplete() { this.result.complete(this.bytes.toByteArray()); }
+    }
+}
