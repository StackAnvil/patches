+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.NativeFormMessage;
+
+public record NativeFormPayload(NativeFormMessage message) implements CustomPacketPayload {
+    public static final Type<NativeFormPayload> TYPE = new Type<>(Identifier.parse(NativeFormMessage.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, NativeFormPayload> CODEC = CustomPacketPayload.codec(
+        (payload, buffer) -> NativeFormMessage.TYPE.write(buffer, payload.message),
+        buffer -> new NativeFormPayload(NativeFormMessage.TYPE.read(buffer)));
+
+    @Override
+    public Type<NativeFormPayload> type() {
+        return TYPE;
+    }
+}
