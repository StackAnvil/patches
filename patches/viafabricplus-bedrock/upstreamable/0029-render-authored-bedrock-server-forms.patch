+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiViewportTest {
+    @Test
+    void matchesExecutedTargetDesktopScaleAndOffsetBounds() {
+        // Original 1.26.51.1 GuiData 141566fd0, AppPlatform desktop type 0.
+        final int[][] nativeCases = {
+            {319, 209, 1, 1}, {640, 360, 1, 1}, {1280, 694, 2, 1},
+            {1920, 1080, 4, 2}, {2560, 1440, 5, 3}, {3840, 2076, 8, 4},
+            {6144, 3318, 8, 4}
+        };
+        for (final int[] fixture : nativeCases) {
+            for (final int javaScale : new int[] {1, 2, 4, 8}) {
+                final var preferred = NativeUiViewport.desktop(fixture[0], fixture[1], 0, javaScale);
+                assertEquals(fixture[2], preferred.scale());
+                assertEquals(fixture[3], NativeUiViewport.desktop(fixture[0], fixture[1], -99, javaScale).scale());
+                assertEquals(preferred, NativeUiViewport.desktop(fixture[0], fixture[1], 99, javaScale));
+                assertEquals((float) fixture[2] / javaScale, preferred.renderScale());
+            }
+        }
+    }
+
+    @Test
+    void boundsScaleByBothViewportAxesAndPreservesEveryDiscreteOffset() {
+        for (int maximum = 1; maximum <= 8; maximum++) {
+            final int width = 376 * maximum, height = 250 * maximum;
+            final int minimum = (maximum + 1) / 2;
+            for (int requested = -10; requested <= 10; requested++) {
+                final var viewport = NativeUiViewport.desktop(width, height, requested, 3);
+                assertEquals(Math.clamp(maximum + requested, minimum, maximum), viewport.scale());
+            }
+            if (maximum > 1) {
+                assertEquals(maximum - 1, NativeUiViewport.desktop(width - 1, height, 0, 3).scale());
+                assertEquals(maximum - 1, NativeUiViewport.desktop(width, height - 1, 0, 3).scale());
+            }
+        }
+    }
+
+    @Test
+    void keepsNativeLayoutAndJavaRenderCoordinatesInvertibleAcrossGuiScales() {
+        for (final int javaScale : new int[] {1, 2, 3, 4, 5, 8}) {
+            final var viewport = NativeUiViewport.desktop(3840, 2134, 0, javaScale);
+            assertEquals(480, viewport.width());
+            assertEquals(267, viewport.height());
+            for (final float coordinate : new float[] {-1, 0, 5, 30, 129.5F, 267, 480}) {
+                assertEquals(coordinate, viewport.pointer(coordinate * viewport.renderScale()), .0001);
+                assertEquals(coordinate, viewport.pointer(viewport.pixel(coordinate)), .5 / viewport.renderScale() + .0001);
+            }
+        }
+    }
+}
