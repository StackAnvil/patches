+            input.onClick(click(22, 20, 0), false);
+            input.onClick(click(10, 29, 1), false);
+            assertEquals("\n", input.selectedText());
+            input.extractWidgetRenderState(graphics, 0, 0, 0);
+            verify(graphics).textHighlight(22, 20, 70, 29, true);
+        });
+    }
+
+    @Test
+    void retainsTheAuthoredMultilineWidgetAndFocusAcrossControllerRefreshes() throws Exception {
+        withGame((game, font) -> {
+            final var inputNode = new JsonObject();
+            inputNode.addProperty("name", "command_editor");
+            inputNode.addProperty("type", "edit_box");
+            inputNode.addProperty("enabled_newline", true);
+            inputNode.addProperty("anchor_from", "top_left");
+            inputNode.addProperty("anchor_to", "top_left");
+            final var size = new JsonArray(); size.add(100); size.add(36); inputNode.add("size", size);
+            final var descriptor = new JsonObject(); descriptor.addProperty("index", 0); inputNode.add("input", descriptor);
+            final var scene = new JsonObject(); scene.addProperty("format", 1); scene.add("root", inputNode);
+            final var controller = mock(NativeUiController.class);
+            final var values = mock(NativeUiController.Inputs.class);
+            when(controller.inputs()).thenReturn(values);
+            when(controller.title()).thenReturn("");
+            when(controller.current()).thenReturn(true);
+            when(controller.root()).thenAnswer(call -> NativeUiScene.parse(scene.toString(), java.util.Set.of()).root());
+            when(values.maxLength(0)).thenReturn(100);
+            when(values.text(0)).thenReturn("first");
+            when(values.placeholder(0)).thenReturn("");
+            when(values.setText(eq(0), anyString())).thenReturn(true);
+            final var screen = new NativeUiSceneScreen(controller);
+            screen.width = 200; screen.height = 100; screen.init();
+            final var input = (NativeUiMultilineInput) screen.children().getFirst();
+            screen.setFocused(input);
+            assertTrue(screen.keyPressed(key(InputConstants.KEY_END, 0)));
+            assertTrue(screen.keyPressed(key(InputConstants.KEY_RETURN, 0)));
+            assertSame(input, screen.children().getFirst());
+            assertSame(input, screen.getFocused());
+            assertEquals(6, input.cursor());
+            assertTrue(screen.charTyped(new CharacterEvent('x')));
+            verify(values).setText(0, "first\nx");
+            assertSame(input, screen.getFocused());
+            assertEquals(7, input.cursor());
+            screen.removed();
+        });
+    }
+
+    private static KeyEvent key(final int key, final int modifiers) {
+        final int symbol = switch (key) {
+            case InputConstants.KEY_RETURN -> 13;
+            case InputConstants.KEY_BACKSPACE -> 8;
+            default -> (1 << 30) | key;
+        };
+        return new KeyEvent(key, symbol, modifiers);
+    }
+
+    private static MouseButtonEvent click(final double x, final double y, final int modifiers) {
+        return new MouseButtonEvent(x, y, new MouseButtonInfo(InputConstants.MOUSE_BUTTON_LEFT, modifiers));
+    }
+
+    private static void withGame(final Interaction interaction) throws Exception {
+        final Font font = mock(Font.class);
+        when(font.getSplitter()).thenReturn(new StringSplitter((c, style) -> 6));
+        when(font.width(anyString())).thenAnswer(call -> ((String) call.getArgument(0)).length() * 6);
+        when(font.plainSubstrByWidth(anyString(), anyInt())).thenAnswer(call -> {
+            final String value = call.getArgument(0);
+            return value.substring(0, Math.min(value.length(), Math.max(0, ((int) call.getArgument(1)) / 6)));
+        });
+        final Minecraft game = mock(Minecraft.class);
+        final var field = Minecraft.class.getField("font"); field.setAccessible(true); field.set(game, font);
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            interaction.run(game, font);
+        }
+    }
+
+    private interface Interaction {
+        void run(Minecraft game, Font font) throws Exception;
+    }
+}
