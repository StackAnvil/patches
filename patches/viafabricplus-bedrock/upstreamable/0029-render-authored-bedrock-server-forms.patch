+        children(root, hidden, visibleAction);
+        final var box = layout(scene(root), 320, 200);
+        assertEquals(60, box.bounds().height(), .001F);
+        assertEquals(box.bounds().y() + 40, box.children().get(1).bounds().y(), .001F);
+        final var draws = BedrockFormPresentation.draws(box, _ -> true);
+        assertEquals(java.util.List.of(7), draws.stream().filter(draw -> draw.box().node().interactive())
+            .map(draw -> draw.box().node().action()).toList());
+        assertFalse(draws.stream().anyMatch(draw -> draw.box().node() == box.children().getFirst().node()));
+    }
+
+    @Test
+    void selectsAuthoredHoverAndLockedVisualTreesWithoutChangingLayout() {
+        final JsonObject root = node("panel", 120, 40);
+        root.addProperty("alpha", .5);
+        final JsonObject button = node("button", 100, 30);
+        button.addProperty("action", 2);
+        button.addProperty("alpha", .5);
+        button.addProperty("default_control", "normal");
+        button.addProperty("hover_control", "hovered");
+        button.addProperty("locked_control", "locked");
+        final JsonObject normal = node("image", 100, 30), hover = node("image", 100, 30), locked = node("image", 100, 30);
+        normal.addProperty("name", "normal");
+        hover.addProperty("name", "hovered");
+        locked.addProperty("name", "locked");
