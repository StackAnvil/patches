+
+    public NativeUiLayout(final Metrics metrics) {
+        this(metrics, null);
+    }
+
+    public NativeUiLayout(final Metrics metrics, final NativeUiAnimations animations) {
+        this.metrics = metrics;
+        this.animations = animations;
+    }
+
+    private NativeUiDimension dimensionValue(final NativeUiScene.Node node, final String key, final int axis) {
+        final NativeUiDimension animated = this.animations == null ? null : this.animations.dimension(node, key, axis);
+        if (animated != null) return animated;
+        final JsonElement pair = node.properties().get(key);
+        if (pair == null || !pair.isJsonArray() || pair.getAsJsonArray().size() != 2) return null;
+        return NativeUiDimension.parse(pair.getAsJsonArray().get(axis));
+    }
+
+    public Box layout(final NativeUiScene.Node node, final int width, final int height,
+                      final Map<NativeUiScene.Node, Float> scroll) {
+        this.measured.clear();
+        this.visibleNodes.clear();
+        this.visibility(node, true);
+        this.work = 0;
+        final Size size = this.measure(node, width, height);
+        final Rect viewport = new Rect(0, 0, width, height);
+        return this.place(node, viewport, size, 0, viewport, scroll, null);
+    }
+
+    private void visibility(final NativeUiScene.Node node, final boolean inherited) {
+        final boolean visible = inherited && node.flag("visible", true) && !node.flag("ignored", false);
+        this.visibleNodes.put(node, visible);
+        for (final var child : node.children()) this.visibility(child, visible);
+    }
+
+    private Size measure(final NativeUiScene.Node node, final float parentWidth, final float parentHeight) {
+        return this.measure(node, new Measurement(parentWidth, parentHeight, 0, 0, parentWidth, parentHeight));
+    }
+
+    private Size measure(final NativeUiScene.Node node, final Measurement environment) {
+        // The native visibility setter resets computed size metrics without changing authored dimensions.
+        if (!this.visibleNodes.getOrDefault(node, true)) return EMPTY;
+        final Map<Measurement, Size> cache = this.measured.computeIfAbsent(node, _ -> new HashMap<>());
+        final Size previous = cache.get(environment);
+        if (previous != null) return previous;
+        if (++this.work > 65536) throw new IllegalArgumentException("Native UI layout exceeds work limits");
+        final boolean container = switch (node.type()) {
+            case "screen", "panel", "input_panel", "factory", "collection_panel", "scroll_view", "scroll_track", "scrollbar_box", "button", "toggle" -> true;
+            default -> false;
+        };
+        final boolean inventoryButton = node.type().equals("button") && node.properties().has("inventory_actions");
+        final boolean image = node.type().equals("image");
+        final boolean ratioSize = image && node.flag("default_size_scales_to_ratio", false);
+        final Size intrinsic = container || inventoryButton || image && !ratioSize
+            ? new Size(environment.defaultWidth, environment.defaultHeight) : this.metrics.intrinsic(node);
+        final boolean defaultWidthAxis = defaultSize(node, 0);
+        final boolean defaultHeightAxis = defaultSize(node, 1);
+        float width = intrinsic.width, height = intrinsic.height;
+        for (int pass = 0; pass < 3; pass++) {
+            final float previousWidth = width, previousHeight = height;
+            // Resolve dimensions independent of children before descending. Measuring at the
+            // inherited extent first multiplies speculative passes through nested content panels.
+            if (!defaultWidthAxis && !childDimension(node, 0)) {
