+        assertEquals(disabled.children().getFirst().children().get(2), lockedDraws.getLast().box());
+        assertTrue(lockedDraws.stream().noneMatch(BedrockFormPresentation.Draw::enabled));
+        assertEquals(box.bounds(), disabled.bounds());
+    }
+
+    @Test
+    void rescalesAuthoredGridCellWidthsAndRetainsInvisibleCellsAndIndices() {
+        final JsonObject root = node("grid", 200, "100%c");
+        root.addProperty("grid_rescaling_type", "horizontal");
+        final JsonObject[] cells = new JsonObject[6];
+        for (int i = 0; i < cells.length; i++) {
+            cells[i] = node("button", "25% - 1px", "100%x");
+            cells[i].addProperty("action", i);
+        }
+        cells[1].addProperty("visible", false);
+        children(root, cells);
