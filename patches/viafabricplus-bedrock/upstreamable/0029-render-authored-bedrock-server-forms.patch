+            final float maximumHeight = children.stream().map(Size::height).max(Float::compare).orElse(0F);
+            final boolean stack = node.type().equals("stack_panel");
+            final boolean vertical = !node.string("orientation", "vertical").equals("horizontal");
+            final float defaultWidth = ratioSize && defaultWidthAxis && !defaultHeightAxis && intrinsic.height > 0
