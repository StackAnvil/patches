+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiPresentationTest {
+    @Test
+    void showsScrollControlsOnlyForOverflowOrAnExplicitAlwaysVisibleOwner() {
+        for (final boolean grouped : new boolean[] {false, true}) {
+            final var content = node("content", "panel", true);
+            final var track = node("track", "scroll_track", true);
+            final var thumb = node("thumb", "scrollbar_box", true);
+            final var controls = node("controls", "panel", true, track, thumb);
+            final var scroll = grouped ? node("scroll", "scroll_view", true, content, controls)
+                : node("scroll", "scroll_view", true, content, track, thumb);
+            scroll.properties().addProperty("scroll_content", "content");
+            scroll.properties().addProperty("scrollbar_track", "track");
+            scroll.properties().addProperty("scrollbar_box", "thumb");
+            if (grouped) scroll.properties().addProperty("scroll_box_and_track_panel", "controls");
+            final var otherOwner = node("controls", "image", true);
+            final var root = node("root", "panel", true, scroll, otherOwner);
+            for (final boolean alwaysVisible : new boolean[] {false, true, false}) {
+                scroll.properties().addProperty("scrollbar_always_visible", alwaysVisible);
+                for (final int height : new int[] {11, 12, 13, 12}) {
+                    content.properties().getAsJsonArray("size").set(1, new com.google.gson.JsonPrimitive(height));
+                    final var draws = NativeUiPresentation.draws(layout(root), _ -> false);
+                    final boolean shown = alwaysVisible || height > 12;
+                    assertEquals(shown, draws.stream().anyMatch(draw -> draw.box().node() == track));
+                    assertEquals(shown, draws.stream().anyMatch(draw -> draw.box().node() == thumb));
+                    assertTrue(draws.stream().anyMatch(draw -> draw.box().node() == otherOwner));
+                    assertTrue(track.flag("visible", false));
+                    assertTrue(thumb.flag("visible", false));
+                    assertTrue(content.flag("visible", false));
+                }
+            }
+        }
+    }
+
+    @Test
+    void keepsLocalImageOpacitySeparateFromExplicitAncestorPropagation() {
+        final var child = node("content", "button", true);
+        child.properties().addProperty("alpha", .6F);
+        final var transparent = node("background", "image", true, child);
+        transparent.properties().addProperty("alpha", 0);
+        final var ancestor = node("ancestor", "panel", true, transparent);
+        ancestor.properties().addProperty("alpha", .5F);
+        ancestor.properties().addProperty("propagate_alpha", true);
+        for (final boolean propagate : new boolean[] {false, true, false}) {
+            transparent.properties().addProperty("propagate_alpha", propagate);
+            final var draws = NativeUiPresentation.draws(layout(ancestor), _ -> false);
+            final var content = draws.stream().filter(draw -> draw.box().node() == child).findFirst();
+            if (propagate) assertTrue(content.isEmpty());
+            else assertEquals(.3F, content.orElseThrow().alpha(), .001F);
+            assertTrue(draws.stream().noneMatch(draw -> draw.box().node() == transparent));
+        }
+    }
+
+    @Test
+    void restoresOnlyTheSelectedSliderSubtreeBeforeMeasuringAndKeepsItsIdentities() {
+        final var normal = state("normal", true);
+        final var hover = state("over", false);
+        final var unrelated = node("unrelated", "panel", false);
+        final var slider = node("range", "slider", true, normal, hover, unrelated);
+        slider.properties().addProperty("input", 17);
+        slider.properties().addProperty("default_control", "normal");
+        slider.properties().addProperty("hover_control", "over");
+        for (final boolean hovered : new boolean[] {false, true, false, true}) {
+            NativeUiPresentation.updateSliderStates(slider, _ -> hovered, _ -> false);
+            assertFalse(NativeUiPresentation.updateSliderStates(slider, _ -> hovered, _ -> false));
+            final var box = layout(slider);
+            final var active = box.children().get(hovered ? 1 : 0);
+            final var inactive = box.children().get(hovered ? 0 : 1);
+            assertSame(hovered ? hover : normal, active.node());
+            assertEquals(30, active.bounds().width());
+            assertEquals(30, active.children().getFirst().bounds().width());
+            assertEquals(0, inactive.bounds().width());
+            assertEquals(0, inactive.children().getFirst().bounds().width());
+            assertEquals(0, active.children().get(1).bounds().width());
+            assertEquals(0, active.children().get(1).children().getFirst().bounds().width());
+            assertEquals(0, box.children().get(2).bounds().width());
+            final var draws = NativeUiPresentation.draws(box, _ -> hovered);
+            assertTrue(draws.stream().anyMatch(draw -> draw.box().node() == active.children().getFirst().node()));
+            assertFalse(draws.stream().anyMatch(draw -> draw.box().node() == inactive.node()));
+            assertFalse(unrelated.flag("visible", true));
+            assertEquals(17, slider.properties().get("input").getAsInt());
+        }
+        hover.children().get(1).properties().addProperty("visible_when_active", true);
+        assertTrue(NativeUiPresentation.updateSliderStates(slider, _ -> true, _ -> false));
+        assertEquals(30, layout(slider).children().get(1).children().get(1).bounds().width());
+        assertEquals(30, layout(slider).children().get(1).children().get(1).children().getFirst().bounds().width());
+    }
+
+    @Test
+    void appliesLockedThenIndentThenHoverThenDefaultThumbPriority() {
+        for (final boolean enabled : new boolean[] {false, true}) {
+            for (final boolean hovered : new boolean[] {false, true}) {
+                for (final boolean selected : new boolean[] {false, true}) {
+                    final var thumb = thumb();
+                    thumb.properties().addProperty("enabled", enabled);
+                    NativeUiPresentation.updateSliderStates(thumb, _ -> hovered, _ -> selected);
+                    final int activeIndex = !enabled ? 2 : selected ? 3 : hovered ? 1 : 0;
+                    final var box = layout(thumb);
+                    for (int index = 0; index < box.children().size(); index++) {
+                        assertEquals(index == activeIndex ? 30 : 0, box.children().get(index).bounds().width());
+                    }
+                    final var draws = NativeUiPresentation.draws(box, _ -> hovered);
+                    assertTrue(draws.stream().anyMatch(draw -> draw.box().node() == box.children().get(activeIndex).node()));
+                    assertTrue(draws.stream().allMatch(draw -> draw.enabled() == enabled));
+                    assertEquals(23, thumb.properties().get("input").getAsInt());
+                }
+            }
+        }
+    }
+
+    @Test
+    void inheritsDisabledOwnersAndResetsHiddenOwnersWithoutLosingTheirState() {
+        final var thumb = thumb();
+        final var owner = node("owner", "panel", true, thumb);
+        owner.properties().addProperty("enabled", false);
+        NativeUiPresentation.updateSliderStates(owner, _ -> true, _ -> true);
+        assertEquals(30, layout(owner).children().getFirst().children().get(2).bounds().width());
+        owner.properties().addProperty("visible", false);
+        assertTrue(NativeUiPresentation.updateSliderStates(owner, _ -> true, _ -> true));
+        assertTrue(thumb.children().stream().noneMatch(child -> child.flag("visible", true)));
+        assertTrue(NativeUiPresentation.draws(layout(owner), _ -> true).isEmpty());
+        owner.properties().addProperty("visible", true);
+        owner.properties().addProperty("enabled", true);
+        assertTrue(NativeUiPresentation.updateSliderStates(owner, _ -> true, _ -> true));
+        final var box = layout(owner).children().getFirst();
+        assertSame(thumb, box.node());
+        assertEquals(30, box.children().get(3).bounds().width());
+        assertEquals(0, box.children().get(2).bounds().width());
+    }
+
+    @Test
+    void leavesOtherControlVisibilityAndResponseOwnershipUntouched() {
+        final var hidden = state("hidden", false);
+        final var button = node("button", "button", true, hidden);
+        button.properties().addProperty("hover_control", "hidden");
+        final var response = new NativeUiScene.Node(button.name(), button.type(), button.properties(), button.children(), 7);
+        assertFalse(NativeUiPresentation.updateSliderStates(response, _ -> true, _ -> true));
+        assertFalse(hidden.flag("visible", true));
+        assertEquals(0, layout(response).children().getFirst().bounds().width());
+        assertEquals(7, response.action());
+        assertEquals(1, response.children().size());
+    }
+
+    private static NativeUiScene.Node thumb() {
+        final var thumb = node("thumb", "slider_box", true,
+            state("normal", true), state("over", false), state("locked", false), state("indent", false));
+        thumb.properties().addProperty("input", 23);
+        thumb.properties().addProperty("default_control", "normal");
+        thumb.properties().addProperty("hover_control", "over");
+        thumb.properties().addProperty("locked_control", "locked");
+        thumb.properties().addProperty("indent_control", "indent");
+        return thumb;
+    }
+
+    private static NativeUiScene.Node state(final String name, final boolean visible) {
+        final var image = node(name + "_image", "image", visible);
+        image.properties().addProperty("visible_when_active", true);
+        final var nestedImage = node(name + "_nested_image", "image", false);
+        nestedImage.properties().addProperty("visible_when_active", true);
+        final var conditional = node(name + "_conditional", "panel", false, nestedImage);
+        conditional.properties().addProperty("visible_when_active", false);
+        final var state = node(name, "panel", visible, image, conditional);
+        state.properties().addProperty("visible_when_active", visible);
+        return state;
+    }
+
+    private static NativeUiScene.Node node(final String name, final String type, final boolean visible,
+                                              final NativeUiScene.Node... children) {
+        final JsonObject properties = new JsonObject();
+        properties.addProperty("visible", visible);
+        final JsonArray size = new JsonArray();
+        size.add(30);
+        size.add(12);
+        properties.add("size", size);
+        return new NativeUiScene.Node(name, type, properties, List.of(children), Integer.MIN_VALUE);
+    }
+
+    private static NativeUiLayout.Box layout(final NativeUiScene.Node root) {
+        return new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0)).layout(root, 300, 200, Map.of());
+    }
+}
