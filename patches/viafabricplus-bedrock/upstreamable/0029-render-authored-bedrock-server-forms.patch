+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.mojang.blaze3d.platform.InputConstants;
+import com.mojang.serialization.JsonOps;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import net.minecraft.client.gui.ComponentPath;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.AbstractButton;
+import net.minecraft.client.gui.components.AbstractWidget;
+import net.minecraft.client.gui.components.EditBox;
+import net.minecraft.client.gui.components.Tooltip;
+import net.minecraft.client.gui.narration.NarrationElementOutput;
+import net.minecraft.client.gui.navigation.FocusNavigationEvent;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.input.CharacterEvent;
+import net.minecraft.client.input.InputWithModifiers;
+import net.minecraft.client.input.KeyEvent;
+import net.minecraft.client.input.MouseButtonEvent;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.ComponentSerialization;
+
+/** Draws the authored scene, with ordinary Java event, focus, narration and response handling. */
+public final class NativeUiSceneScreen extends Screen implements NativeUiScreen {
+    private final NativeUiController controller;
+    private NativeUiScene.Node scene;
+    private final NativeUiImages images = new NativeUiImages();
+    private NativeUiAnimationLifecycle lifecycle;
+    private NativeUiAnimations animations;
+    private long animationStarted;
+    private final Map<NativeUiScene.Node, Float> scroll = new IdentityHashMap<>();
+    private final Map<NativeUiScene.Node, Action> actions = new IdentityHashMap<>();
+    private final Map<NativeUiScene.Node, NativeInput> inputs = new IdentityHashMap<>();
+    private final Map<NativeUiScene.Node, NativeUiLayout.Box> geometry = new IdentityHashMap<>();
+    private final Map<String, Action> actionWidgets = new HashMap<>();
+    private final Map<String, NativeInput> inputWidgets = new HashMap<>();
+    private boolean refreshPending;
+    private NativeUiRenderer renderer;
+    private NativeUiLayout.Box root;
+    private Drag drag;
+    private InputDrag inputDrag;
+    private long imageRevision;
+    private double pointerX = -1;
+    private double pointerY = -1;
+
+    public NativeUiSceneScreen(final NativeUiController controller) {
+        super(NativeUiText.component(controller.title()));
+        this.controller = controller;
+        this.scene = controller.root();
+        this.resetAnimations();
+    }
+
+    private void resetAnimations() {
+        this.lifecycle = new NativeUiAnimationLifecycle(this.scene);
+        this.animations = this.lifecycle.animations();
+        this.animationStarted = System.nanoTime();
+    }
+
+    private long animationTime() { return System.nanoTime() - this.animationStarted; }
+
+    private void scrollAnimation(final NativeUiScene.Node target, final boolean released) {
+        final long now = this.animationTime();
+        this.animations.event(target, "scrollbar.active", now);
+        if (released) this.animations.event(target, "scrollbar.released", now);
+    }
+
+    public boolean controlledBy(final NativeUiController controller) {
+        return this.controller == controller;
+    }
+
+    @Override
+    public void extractBackground(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        // The resource-pack scene owns its background, including any world overlay.
+    }
+
+    @Override
+    protected void init() {
+        this.drag = null;
+        this.inputDrag = null;
+        this.setDragging(false);
+        this.layout();
+        this.reconcileWidgets();
+    }
+
+    private void reconcileWidgets() {
+        this.actions.clear();
+        this.inputs.clear();
+        final List<ControlBox> boxes = new ArrayList<>();
+        controls(this.root, "", 0, boxes);
+        boxes.sort(Comparator.comparingDouble((ControlBox control) -> control.box.layer()).reversed());
+        final Set<String> retainedActions = new HashSet<>(), retainedInputs = new HashSet<>();
+        for (final var control : boxes) {
+            final var box = control.box;
+            if (!box.node().interactive()) continue;
+            if (this.controller.inputs() != null && box.node().type().equals("edit_box") && box.node().properties().has("input")) {
+                final NativeInput input = this.inputWidgets.computeIfAbsent(control.key,
+                    key -> box.node().flag("enabled_newline", false) ? new MultilineInput(box) : new SingleLineInput(box));
+                input.place(box);
+                if (!this.children().contains(input.widget())) this.addWidget(input.widget());
+                this.inputs.put(box.node(), input);
+                retainedInputs.add(control.key);
+            } else {
+                final Action action = this.actionWidgets.computeIfAbsent(control.key, key -> new Action(box));
+                action.place(box);
+                if (!this.children().contains(action)) this.addWidget(action);
+                this.actions.put(box.node(), action);
+                retainedActions.add(control.key);
+            }
+        }
+        this.inputWidgets.entrySet().removeIf(entry -> {
+            if (retainedInputs.contains(entry.getKey())) return false;
+            this.removeWidget(entry.getValue().widget());
+            return true;
+        });
+        this.actionWidgets.entrySet().removeIf(entry -> {
+            if (retainedActions.contains(entry.getKey())) return false;
+            this.removeWidget(entry.getValue());
+            return true;
+        });
+        this.synchronize(this.draws(-1, -1));
+        this.controller.validateResponseControls(this.actions.values().stream()
+            .filter(action -> action.visible && action.eligible).map(action -> action.node).toList());
+    }
+
+    private static void controls(final NativeUiLayout.Box box, final String parent, final int occurrence,
+                                 final List<ControlBox> result) {
+        // Collection templates repeat authored names. Retain each instance separately across scene refreshes.
+        final String name = box.node().name();
+        final String path = parent + "/" + name.length() + ":" + name + ":" + occurrence;
+        result.add(new ControlBox(box, path + ":" + box.node().type() + ":" + box.node().action()
+            + ":" + box.node().properties().get("input") + ":" + box.node().flag("enabled_newline", false)));
+        final Map<String, Integer> occurrences = new HashMap<>();
+        for (final var child : box.children()) {
+            final int childOccurrence = occurrences.merge(child.node().name(), 1, Integer::sum) - 1;
+            controls(child, path, childOccurrence, result);
+        }
+    }
+
+    private record ControlBox(NativeUiLayout.Box box, String key) {}
+
+    private long layoutRevision = -1;
+
+    private void layout() {
+        NativeUiPresentation.updateSliderStates(this.scene, this::sliderHovered, this::sliderSelected);
+        this.controller.validateVisibleControls();
+        this.renderer().prepare(this.scene);
+        this.root = new NativeUiLayout(this.renderer(), this.animations).layout(this.scene, this.width, this.height, this.scroll);
+        this.root = NativeUiSlider.apply(this.root);
+        this.geometry.clear();
+        this.indexGeometry(this.root);
