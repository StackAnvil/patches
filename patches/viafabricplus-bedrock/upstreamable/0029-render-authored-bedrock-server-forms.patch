diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/npc/BedrockNativeNpcs.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/npc/BedrockNativeNpcs.java
new file mode 100644
index 0000000..308d167
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/npc/BedrockNativeNpcs.java
@@ -0,0 +1,89 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.npc;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiSceneScreen;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.Connection;
+import net.raphimc.viabedrock.api.model.NativeNpcDialogueMessage;
+
+/** Bind every scene and queued callback to the listener that received it, on direct and proxy routes. */
+public final class BedrockNativeNpcs {
+    private static BedrockNpcController active;
+
+    private BedrockNativeNpcs() {}
+
+    public static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(NativeNpcDialoguePayload.TYPE, NativeNpcDialoguePayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(NativeNpcEditorPayload.TYPE, NativeNpcEditorPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) ->
+            ClientPlayNetworking.registerReceiver(NativeNpcEditorPayload.TYPE,
+                (payload, context) -> accept(listener.getConnection(), payload.message())));
+        ClientPlayConnectionEvents.INIT.register((listener, client) ->
+            ClientPlayNetworking.registerReceiver(NativeNpcDialoguePayload.TYPE,
+                (payload, context) -> accept(listener.getConnection(), payload.message())));
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> disconnected(listener.getConnection()));
+    }
+
+    static boolean current(final BedrockNpcController controller) { return active == controller; }
+
+    static boolean connected(final Connection owner) {
+        final var listener = Minecraft.getInstance().getConnection();
+        return listener != null && listener.getConnection() == owner && owner.isConnected();
+    }
+
+    static void disconnected(final Connection owner) {
+        if (active != null && active.ownedBy(owner)) close(active);
+    }
+
+    static void close(final BedrockNpcController controller) {
+        if (active != controller) return;
+        controller.retire();
+        active = null;
+        closeOwnedScreen(controller);
+    }
+
+    private static void closeOwnedScreen(final BedrockNpcController controller) {
+        final var client = Minecraft.getInstance();
+        if (controller != null && client.gui.screen() instanceof NativeUiSceneScreen screen && screen.controlledBy(controller))
+            client.setScreenAndShow(null);
+    }
+
+    static void accept(final Connection owner, final NativeNpcDialogueMessage message) {
+        final var client = Minecraft.getInstance();
+        client.execute(() -> {
+            if (!connected(owner)) return;
+            if (message.scene() == null) {
+                if (active == null || !active.ownedBy(owner) || !active.identifier().equals(message.responseIdentifier())) return;
+                close(active);
+                return;
+            }
+            // A replacement invalidates the old response identity even when the new scene is rejected.
+            final var previous = active;
+            if (previous != null) previous.retire();
+            active = null;
+            final BedrockNpcController next;
+            try {
+                next = new BedrockNpcController(owner, BedrockNpcScene.parse(message));
+            } catch (final RuntimeException error) {
+                closeOwnedScreen(previous);
+                BedrockNpcController.reject(owner, message.responseIdentifier());
+                ViaFabricPlusBedrock.impl().logger().error("Invalid native NPC scene", error);
+                return;
+            }
+            active = next;
+            try {
+                client.setScreenAndShow(new NativeUiSceneScreen(next));
+            } catch (final RuntimeException error) {
+                next.failed(error);
+            }
+        });
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/npc/BedrockNpcController.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/npc/BedrockNpcController.java
new file mode 100644
index 0000000..41caaba
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/npc/BedrockNpcController.java
@@ -0,0 +1,167 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.npc;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiController;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import com.mojang.blaze3d.Blaze3D;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.NativeNpcDialogueMessage;
+import net.raphimc.viabedrock.api.resourcepack.ui.NpcDialogueUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.NpcEditorState;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.Set;
+import java.util.List;
+import java.util.Optional;
+import net.minecraft.network.Connection;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.network.protocol.common.ServerboundCustomClickActionPacket;
+import net.minecraft.resources.Identifier;
+
+final class BedrockNpcController implements NativeUiController, NativeUiController.Inputs {
+    private final Connection owner;
+    private final BedrockNpcConversation conversation;
+    private final NpcEditorState editor;
+    private final NpcDialogueUi resolver;
+    private BedrockNpcScene editorScene;
+    private final Set<NativeUiScene.Node> editorControls = Collections.newSetFromMap(new IdentityHashMap<>());
+
+    BedrockNpcController(final Connection owner, final BedrockNpcScene scene) {
+        this.owner = owner;
+        this.conversation = new BedrockNpcConversation(scene);
+        if (scene.editorSource() == null) { this.editor = null; this.resolver = null; }
+        else {
+            final var program = JsonParser.parseString(scene.editorSource()).getAsJsonObject().getAsJsonObject("program");
+            final var source = program.getAsJsonObject("editor");
+            if (!scene.identifier().equals(source.get("response_id").getAsString()))
+                throw new IllegalArgumentException("NPC editor identity does not match its scene");
+            this.editor = new NpcEditorState(source);
+            this.resolver = NpcDialogueUi.fromProgram(program);
+            this.editorScene = scene;
+            this.collectEditorControls(scene.root());
+        }
+    }
+
+    String identifier() { return this.conversation.scene().identifier(); }
+    void retire() { this.conversation.retire(); }
+    boolean ownedBy(final Connection owner) { return this.owner == owner; }
+
+    @Override public String title() { return this.editor == null ? this.conversation.scene().title() : this.editorScene.title(); }
+    @Override public NativeUiScene.Node root() { return this.editor == null ? this.conversation.scene().root() : this.editorScene.root(); }
+    @Override public void validateVisibleControls() { NativeUiScene.validateVisibleControls(this.root(), BedrockNpcScene.RENDERERS); }
+
+    @Override
+    public void validateResponseControls(final List<NativeUiScene.Node> controls) {
+        // Commands can be hidden or disabled by the authored scene. Escape still sends the exit response.
+        for (final var node : controls) if (!node.properties().has("action") && !node.properties().has("url")
+            && !(this.editor != null && (node.properties().has("command") || node.properties().has("input"))))
+            throw new IllegalArgumentException("Unsupported native NPC interaction");
+    }
+
+    @Override
+    public boolean current() {
+        return this.conversation.current() && BedrockNativeNpcs.current(this) && BedrockNativeNpcs.connected(this.owner);
+    }
+
+    @Override
+    public Activation activate(final NativeUiScene.Node node) {
+        if (!this.current()) return Activation.STAY;
+        if (this.editor != null) {
+            if (!this.editorControls.contains(node) || !node.properties().has("command")) return Activation.STAY;
+            this.editor.activate(node.string("command", ""), node.properties().has("selection")
+                ? node.properties().get("selection").getAsBigDecimal().intValueExact() : -1);
+            this.sendEditorUpdates();
+            if (this.editor.closed()) { this.conversation.cancel(this::respond); return Activation.CLOSE; }
+            return Activation.STAY;
+        }
+        return this.conversation.activate(node, this::respond, Blaze3D::openUri)
+            ? Activation.CLOSE : Activation.STAY;
+    }
+
+    @Override
+    public void cancel() {
+        if (!this.current()) return;
+        if (this.editor != null) {
+            while (!this.editor.closed()) this.editor.cancel();
+            this.sendEditorUpdates();
+        }
+        this.conversation.cancel(this::respond);
+    }
+
+    @Override public Activation dismiss() {
+        if (this.editor == null) return NativeUiController.super.dismiss();
+        if (!this.current()) return Activation.STAY;
+        this.editor.cancel();
+        this.sendEditorUpdates();
+        if (this.editor.closed()) { this.conversation.cancel(this::respond); return Activation.CLOSE; }
+        return Activation.STAY;
+    }
+
+    @Override public void refresh() {
+        if (this.editor != null && !this.editor.closed()) {
+            this.editorScene = BedrockNpcScene.parse(
+                new NativeNpcDialogueMessage(this.identifier(), this.resolver.resolveLocal(this.editor).toString()));
+            this.editorControls.clear();
+            this.collectEditorControls(this.editorScene.root());
+        }
+    }
+    @Override public Inputs inputs() { return this.editor == null ? null : this; }
+    @Override public int maxLength(final int index) { return this.editor.maxLength(index); }
+    @Override public String text(final int index) { return this.editor.text(index); }
+    @Override public String placeholder(final int index) { return this.resolver.placeholder(this.editor, index); }
+    @Override public boolean isSlider(final int index) { return false; }
+    @Override public void slide(final int index, final double fraction) { throw new IllegalArgumentException("NPC editor has no slider input"); }
+    @Override public void adjust(final int index, final int direction) { throw new IllegalArgumentException("NPC editor has no slider input"); }
+    @Override public boolean setText(final int index, final String value) {
+        if (!this.current()) return false;
+        final boolean changed = this.editor.setText(index, value);
+        this.sendEditorUpdates();
+        return changed;
+    }
+
+    private void collectEditorControls(final NativeUiScene.Node node) {
+        if (node.interactive()) this.editorControls.add(node);
+        node.children().forEach(this::collectEditorControls);
+    }
+
+    private void sendEditorUpdates() {
+        if (!BedrockNativeNpcs.current(this) || !BedrockNativeNpcs.connected(this.owner)) return;
+        for (final var update : this.editor.drainUpdates()) {
+            final var response = new CompoundTag();
+            response.putInt("edit_type", update.type().getValue());
+            response.putString("data", update.data());
+            response.putInt("action_index", update.actionIndex());
+            this.owner.send(new ServerboundCustomClickActionPacket(Identifier.parse(this.identifier()), Optional.of(response)));
+        }
+    }
+
+    private void respond(final int action) {
+        if (!BedrockNativeNpcs.current(this) || !BedrockNativeNpcs.connected(this.owner)) return;
+        respond(this.owner, Identifier.parse(this.identifier()), action);
+    }
+
+    static void reject(final Connection owner, final String identifier) {
+        final var id = Identifier.tryParse(identifier);
+        if (id != null && BedrockNativeNpcs.connected(owner)) respond(owner, id, -1);
+    }
+
+    private static void respond(final Connection owner, final Identifier identifier, final int action) {
+        final CompoundTag response = new CompoundTag();
+        if (action < 0) response.putBoolean("exit", true);
+        else response.putInt("button_id", action);
+        owner.send(new ServerboundCustomClickActionPacket(identifier, Optional.of(response)));
+    }
+
+    @Override
+    public void failed(final RuntimeException error) {
+        if (!this.current()) return;
+        ViaFabricPlusBedrock.impl().logger().error("Native NPC scene could not be rendered", error);
+        this.cancel();
+        BedrockNativeNpcs.close(this);
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/npc/BedrockNpcConversation.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/npc/BedrockNpcConversation.java
new file mode 100644
index 0000000..ceb1064
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/npc/BedrockNpcConversation.java
@@ -0,0 +1,53 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.npc;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.net.URI;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.Set;
+import java.util.function.Consumer;
+import java.util.function.IntConsumer;
+
+/** Retain original sparse command indices and retire replaced scenes without sending an exit. */
+final class BedrockNpcConversation {
+    private final BedrockNpcScene scene;
+    private final Set<NativeUiScene.Node> controls = Collections.newSetFromMap(new IdentityHashMap<>());
+    private boolean retired;
+
+    BedrockNpcConversation(final BedrockNpcScene scene) {
+        this.scene = scene;
+        this.collect(scene.root());
+    }
+
+    BedrockNpcScene scene() { return this.scene; }
+    boolean current() { return !this.retired; }
+    void retire() { this.retired = true; }
+
+    boolean activate(final NativeUiScene.Node node, final IntConsumer response, final Consumer<URI> openLink) {
+        if (this.retired || !this.controls.contains(node)) return false;
+        if (node.properties().has("url")) {
+            openLink.accept(BedrockNpcScene.link(node));
+            return false;
+        }
+        if (!node.properties().has("action")) return false;
+        this.retired = true;
+        response.accept(node.action());
+        return true;
+    }
+
+    void cancel(final IntConsumer response) {
+        if (this.retired) return;
+        this.retired = true;
+        response.accept(-1);
+    }
+
+    private void collect(final NativeUiScene.Node node) {
+        if (node.interactive()) this.controls.add(node);
+        node.children().forEach(this::collect);
+    }
+}
