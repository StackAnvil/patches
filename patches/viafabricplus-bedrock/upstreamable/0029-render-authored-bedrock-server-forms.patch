+    }
+
+    private boolean fill(final NativeUiScene.Node node, final int axis) {
+        final var size = this.dimensionValue(node, "size", axis);
+        return size != null && size.uses(NativeUiDimension.Unit.FILL);
+    }
+
+    private boolean siblingDimension(final NativeUiScene.Node node) {
+        for (final String key : List.of("size", "min_size", "max_size")) for (int axis = 0; axis < 2; axis++) {
+            final var value = this.dimensionValue(node, key, axis);
+            if (value != null && value.uses(NativeUiDimension.Unit.SIBLING)) return true;
+        }
+        return false;
+    }
+
+    private Size content(final NativeUiScene.Node node, final List<Size> children, final float parentWidth, final float parentHeight) {
+        float width = 0, height = 0;
+        final boolean vertical = !node.string("orientation", "vertical").equals("horizontal");
+        if (node.type().equals("grid")) {
+            final Grid grid = this.grid(node, parentWidth, parentHeight);
+            final Map<Integer, Float> widths = new java.util.HashMap<>();
+            final Map<Integer, Float> heights = new java.util.HashMap<>();
+            for (int i = 0; i < children.size(); i++) {
+                final int[] position = grid.position(node.children().get(i), i);
+                final int column = position[0], row = position[1];
+                widths.merge(column, children.get(i).width, Math::max);
+                heights.merge(row, children.get(i).height, Math::max);
+            }
+            for (final float value : widths.values()) width += value;
+            for (final float value : heights.values()) height += value;
+        } else for (final Size child : children) {
+            if (node.type().equals("stack_panel") && !vertical) width += child.width;
+            else width = Math.max(width, child.width);
+            if (node.type().equals("stack_panel") && vertical) height += child.height;
+            else height = Math.max(height, child.height);
+        }
+        return new Size(width, height);
+    }
+
+    private Box place(final NativeUiScene.Node node, final Rect parent, final Size size, final float parentLayer,
+                      final Rect parentClip, final Map<NativeUiScene.Node, Float> scroll, final NativeUiScene.Node container) {
