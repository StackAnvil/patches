@@ -0,0 +1,164 @@
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.viaversion.viafabricplus.bedrock.render.BedrockGuiActorContext;
+import java.util.List;
+import org.joml.Quaternionf;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiActorPortraitsTest {
+    @Test
+    void resolvesSignedUniqueIdPrefixesAndRejectsWrongTypedOrOverflowValues() {
+        for (final long id : new long[] {Long.MIN_VALUE, -1, 0, 150150, Long.MAX_VALUE}) {
+            final var node = node();
+            node.properties().getAsJsonObject("property_bag").addProperty("#entity_id", " \t" + id + "suffix");
+            assertEquals(id, NativeUiActorPortraits.uniqueId(node));
+        }
+        final var node = node();
+        assertEquals(-1, NativeUiActorPortraits.uniqueId(node));
+        node.properties().getAsJsonObject("property_bag").addProperty("#entity_id", 150150);
+        assertThrows(IllegalArgumentException.class, () -> NativeUiActorPortraits.uniqueId(node));
+        for (final var malformed : List.of("", "+", "actor150150", "9223372036854775808")) {
+            node.properties().getAsJsonObject("property_bag").addProperty("#entity_id", malformed);
+            assertThrows(IllegalArgumentException.class, () -> NativeUiActorPortraits.uniqueId(node));
+        }
+    }
+
+    @Test
+    void usesNativeCachedBoxAndMouseAnglesWithoutHeightAutoFit() {
+        final var rect = new NativeUiLayout.Rect(10, 20, 60, 90);
+        final var ordinary = NativeUiActorPortraits.camera(rect, 0, 0, 0);
+        assertEquals(15.707963F, ordinary.pitch(), .00001F);
+        assertEquals(-24.980915F, ordinary.yaw(), .00001F);
+        assertEquals(60, ordinary.scale());
+        assertEquals(new NativeUiActorPortraits.Camera(0, -0F, 60), NativeUiActorPortraits.camera(rect, 1, 40, 65));
+        final var mouse = NativeUiActorPortraits.camera(rect, 1, 80, 25);
+        assertEquals(-15.707963F, mouse.pitch(), .00001F);
+        assertEquals(-15.707963F, mouse.yaw(), .00001F);
+        assertEquals(mouse, NativeUiActorPortraits.camera(new NativeUiLayout.Rect(10, 55, 60, 20), 1, 80, 25));
+    }
+
+    @Test
+    void matchesNativePlayerRootVerticesAtEveryPitchAndGuiScale() {
+        // Bedrock 1.26.51.1 live GUI draw: height=0, skip offset=true, model scale=1/16.
+        // Original matrix block14558da04..14558dfa1 keeps the control center unchanged.
+        for (final int guiScale : new int[] {1, 2, 3}) {
+            for (final float playerScale : new float[] {0, .5F, 1, 2}) {
+                for (final float pitch : new float[] {-30, 0, 22.608185F, 30}) {
+                    final var rotation = new Quaternionf().rotateX((float) Math.toRadians(pitch));
+                    final var translation = NativeUiActorPortraits.playerTranslation(rotation, playerScale);
+                    final var pose = new PoseStack();
+                    pose.translate(30 * guiScale, 45 * guiScale, 0);
+                    pose.scale(60 * guiScale, 60 * guiScale, -60 * guiScale);
+                    BedrockGuiActorContext.correctPose(pose, 60, guiScale);
+                    pose.translate(translation.x, translation.y, translation.z);
+                    pose.rotate(rotation);
+                    // The Java Avatar/Living renderer applies these before drawing converted pixels.
+                    pose.scale(-playerScale, -playerScale, playerScale);
+                    pose.scale(.9375F, .9375F, .9375F);
+                    pose.translate(0, -1.501F, 0);
+                    for (final var point : List.of(new Vector3f(-4, -8, -4), new Vector3f(4, 0, 4),
+                            new Vector3f(-4, 12, -2), new Vector3f(4, 24, 2))) {
+                        final float nativeScale = .9375F * playerScale / 16F;
+                        final var expected = new Vector3f(-point.x * nativeScale,
+                                -point.y / 16F * .9375F * playerScale,
+                                point.z * nativeScale);
+                        rotation.transform(expected);
+                        final var projected = pose.last().pose().transformPosition(new Vector3f(point).div(16F));
+                        assertEquals((30 + 60 * expected.x) * guiScale, projected.x, .001F);
+                        assertEquals((45 - 60 * expected.y) * guiScale, projected.y, .001F);
+                        assertEquals(expected.z - 5, projected.z, .0001F);
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void keepsTheHeadVisibleAndCropsTheLegsAtNativePlayerScale() {
+        final var rotation = new Quaternionf();
+        final var translation = NativeUiActorPortraits.playerTranslation(rotation, 1);
+        final var pose = new PoseStack();
+        pose.translate(27.5F, 45, 0);
+        pose.scale(54.72F, 54.72F, -54.72F);
+        BedrockGuiActorContext.correctPose(pose, 54.72F, 1);
+        pose.translate(translation.x, translation.y, translation.z);
+        pose.scale(-1, -1, 1);
+        pose.scale(.9375F, .9375F, .9375F);
+        pose.translate(0, -1.501F, 0);
+        final var head = pose.last().pose().transformPosition(new Vector3f(0, -.5F, 0));
+        final var feet = pose.last().pose().transformPosition(new Vector3f(0, 1.5F, 0));
+        assertTrue(head.y > 0 && head.y < 90);
+        assertTrue(feet.y > 90);
+        assertEquals(54.72F * 2 * .9375F, feet.y - head.y, .0001F);
+        assertEquals(0F, 1.501F * .9375F + translation.y, .000001F);
+    }
+
+    @Test
+    void changingTheIntermediateViewportPreservesProjectedPositionsAtEveryGuiScale() {
+        final var control = new NativeUiLayout.Rect(126.84F, 139, 54.72F, 90.24F);
+        for (final var clip : List.of(new NativeUiLayout.Rect(106.2F, 135, 96, 96),
+                new NativeUiLayout.Rect(0, 0, 400, 300), new NativeUiLayout.Rect(145, 180, 20, 30))) {
+            final var viewport = NativeUiActorPortraits.viewport(clip, 400, 300);
+            for (final int guiScale : new int[] {1, 2, 3}) {
+                for (final float pitch : new float[] {-30, 0, 22.608185F, 30}) {
+                    final var rotation = new Quaternionf().rotateX((float) Math.toRadians(pitch));
+                    final var pose = new PoseStack();
+                    pose.translate((viewport.x() + viewport.width() / 2F) * guiScale,
+                            (viewport.y() + viewport.height() / 2F) * guiScale, 0);
+                    pose.scale(control.width() * guiScale, control.width() * guiScale, -control.width() * guiScale);
+                    BedrockGuiActorContext.correctPose(pose, control.width(), guiScale);
+                    final var translation = NativeUiActorPortraits.viewportTranslation(control, viewport, rotation, 1);
+                    pose.translate(translation.x, translation.y, translation.z);
+                    pose.rotate(rotation);
+                    for (final var point : List.of(new Vector3f(), new Vector3f(.3F, .9F, -.4F),
+                            new Vector3f(-.58F, 2.21F, .51F))) {
+                        final var expected = rotation.transform(new Vector3f(point).add(0, -1.501F * .9375F, 0));
+                        final var projected = pose.last().pose().transformPosition(new Vector3f(point));
+                        assertEquals((control.x() + control.width() / 2F + control.width() * expected.x) * guiScale,
+                                projected.x, .001F);
+                        assertEquals((control.y() + control.height() / 2F - control.width() * expected.y) * guiScale,
+                                projected.y, .001F);
+                        assertEquals(expected.z - 5, projected.z, .001F);
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void allowsModelOverflowInsideTheInheritedScissorAndClampsTheTextureToTheScreen() {
+        final var control = new NativeUiLayout.Rect(20.64F, 4, 54.72F, 90.24F);
+        final var viewport = NativeUiActorPortraits.viewport(new NativeUiLayout.Rect(0, 0, 96, 96), 200, 200);
+        assertFalse(control.contains(48, 2));
+        assertTrue(viewport.contains(48, 2));
+        assertFalse(viewport.contains(48, -1));
+        final var scissor = new net.minecraft.client.gui.navigation.ScreenRectangle(0, 1, 96, 94);
+        final var pip = new net.minecraft.client.renderer.state.gui.pip.GuiEntityRenderState(
+                new net.minecraft.client.renderer.entity.state.AvatarRenderState(), new Vector3f(), new Quaternionf(), null,
+                (int) viewport.x(), (int) viewport.y(), (int) (viewport.x() + viewport.width()),
+                (int) (viewport.y() + viewport.height()), control.width(), scissor);
+        assertEquals(scissor, pip.bounds());
+        assertEquals(control.width(), pip.scale());
+        assertEquals(new NativeUiLayout.Rect(0, 0, 200, 100),
+                NativeUiActorPortraits.viewport(new NativeUiLayout.Rect(-10, -20, 250, 150), 200, 100));
+    }
+
+    @Test
+    void rejectsInvalidPlayerScale() {
+        for (final float scale : new float[] {-1, Float.NaN, Float.POSITIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class,
+                    () -> NativeUiActorPortraits.playerTranslation(new Quaternionf(), scale));
+        }
+    }
+
+    private static NativeUiScene.Node node() {
+        final JsonObject properties = new JsonObject();
+        properties.add("property_bag", new JsonObject());
+        return new NativeUiScene.Node("portrait", "custom", properties, List.of(), Integer.MIN_VALUE);
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiAnimationLifecycleTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiAnimationLifecycleTest.java
