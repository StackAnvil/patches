+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeContainerScrollTest {
+    @Test
+    void wheelAndThumbCaptureSurviveMenuReresolutionAndClampAfterResize() {
+        final var scroll = new NativeContainerScroll();
+        var root = layout(scroll, 100);
+        assertFalse(scroll.wheel(root, 125, 10, 0, -1));
+        assertNull(scroll.animationTarget());
+        assertTrue(scroll.wheel(root, 10, 10, 0, -2));
+        assertSame(root.node(), scroll.animationTarget());
+        root = layout(scroll, 100);
+        assertSame(root.node(), scroll.animationTarget());
+        assertEquals(-36, root.children().getFirst().children().getFirst().bounds().y());
+        assertTrue(scroll.press(root, 115, 90));
+        root = layout(scroll, 100);
+        assertTrue(scroll.drag(root, 115, 1000));
+        root = layout(scroll, 100);
+        assertEquals(-200, root.children().getFirst().children().getFirst().bounds().y());
+        root = layout(scroll, 150);
+        assertEquals(-150, root.children().getFirst().children().getFirst().bounds().y());
+        assertTrue(scroll.release());
+        assertFalse(scroll.drag(root, 115, 10));
+        assertFalse(scroll.release());
+    }
+
+    private static NativeUiLayout.Box layout(final NativeContainerScroll scroll, final int height) {
+        final var scene = NativeUiScene.parse("""
+            {"format":1,"root":{"name":"view","type":"scroll_view","size":[120,"100%"],
+             "anchor_from":"top_left","anchor_to":"top_left","scroll_content":"items","scroll_view_port":"viewport",
+             "scrollbar_track":"track","scrollbar_box":"thumb","children":[
+              {"name":"viewport","type":"panel","size":[110,"100%"],"anchor_from":"top_left","anchor_to":"top_left","children":[
+               {"name":"items","type":"panel","size":[110,300],"anchor_from":"top_left","anchor_to":"top_left","children":[]}]},
+              {"name":"track","type":"scroll_track","size":[10,"100%"],"offset":[110,0],"anchor_from":"top_left","anchor_to":"top_left","children":[
+               {"name":"thumb","type":"scrollbar_box","size":[10,"100%"],"min_size":[0,12],"draggable":"vertical",
+                "anchor_from":"top_left","anchor_to":"top_left","children":[]}]}]}}
+            """, Set.of());
+        return new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0)).layout(scene.root(), 120, height, scroll.offsets(scene.root()));
+    }
+}
