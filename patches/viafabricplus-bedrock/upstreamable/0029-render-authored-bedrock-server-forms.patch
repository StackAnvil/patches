+        final var initial = NativeUiPresentation.draws(box, _ -> false, node -> timeline.opacity(node, 1_000_000_000L));
+        assertEquals(0, initial.getLast().alpha());
+        assertEquals(.5F, initial.getLast().potential());
+        assertEquals(2, initial.getLast().box().node().action());
+        timeline.beginFrame();
+        final var middle = NativeUiPresentation.draws(box, _ -> false, node -> timeline.opacity(node, 1_080_000_000L));
+        assertEquals(.375F, middle.getLast().alpha(), .001F);
+        timeline.beginFrame();
+        final var completed = NativeUiPresentation.draws(box, _ -> false, node -> timeline.opacity(node, 2_000_000_000L));
+        assertEquals(.5F, completed.getLast().alpha());
