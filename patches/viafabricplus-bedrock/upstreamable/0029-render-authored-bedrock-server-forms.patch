+
+    @Test
+    void sizesEmptyContentRelativePanelsWithoutFeedingParentHeightBackIntoTheStack() {
+        final JsonObject root = node("stack_panel", 120, "100%c");
+        final JsonObject empty = node("panel", "100%", "100%cm + 4px");
+        empty.addProperty("visible", false);
+        final JsonObject fixed = node("button", 100, 20);
+        fixed.addProperty("action", 2);
