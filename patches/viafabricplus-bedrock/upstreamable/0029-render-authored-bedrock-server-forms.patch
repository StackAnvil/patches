+    /** GUI sampling observes the current announcement without changing world playback or origin. */
+    public static final class GuiPlayback {
+        private Playing source;
+        private BedrockBoneAnimation.Playback animation;
+
+        public Map<String, BedrockBoneAnimation.Transform> sample(final UUID player, final Map<String, ?> queries,
+                final java.util.function.Consumer<BedrockAnimationSound> sounds,
+                final java.util.function.Consumer<BedrockAnimationParticle.Cue> particles) {
+            final Playing current = PLAYING.get(player);
+            final long now = System.nanoTime();
+            if (current == null || current.expired(now)) { this.source = null; this.animation = null; return Map.of(); }
+            if (this.source != current) {
+                this.source = current;
+                this.animation = current.animation().fork();
+            }
+            return this.animation.sample((now - current.started()) / 1_000_000_000F, queries, true, sounds, particles);
+        }
+    }
