+    public static final Type<NativeCustomFormPayload> TYPE = new Type<>(Identifier.parse(NativeFormMessage.CUSTOM_CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, NativeCustomFormPayload> CODEC = CustomPacketPayload.codec(
