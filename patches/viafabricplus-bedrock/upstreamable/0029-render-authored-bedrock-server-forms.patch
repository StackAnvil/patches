+/** Native UID selection and independent cameras for player and actor portraits. */
+public final class NativeUiActorPortraits {
+    public static final String RENDERER = "live_horse_renderer";
+    public static final String ACTOR_RENDERER = "actor_portrait_renderer";
+    private final Map<String, BedrockGuiActorContext> contexts = new HashMap<>();
+    private final Map<NativeUiScene.Node, String> paths = new java.util.IdentityHashMap<>();
+    private Object level;
+
+    public void clear() {
+        this.contexts.values().forEach(BedrockGuiActorContext::close);
+        this.contexts.clear();
+        this.paths.clear();
+        this.level = null;
+    }
+
+    public void prepare(final NativeUiScene.Node root) {
+        this.paths.clear();
+        this.path(root, "");
+        final var retained = new java.util.HashSet<>(this.paths.values());
+        this.contexts.entrySet().removeIf(entry -> {
+            if (retained.contains(entry.getKey())) return false;
+            entry.getValue().close();
+            return true;
+        });
+    }
+
+    private void path(final NativeUiScene.Node node, final String parent) {
+        final String path = parent + "/" + node.name();
+        this.paths.put(node, path);
+        final Map<String, Integer> occurrences = new HashMap<>();
+        for (final var child : node.children()) {
+            final int occurrence = occurrences.merge(child.name(), 1, Integer::sum);
+            this.path(child, path + "/" + occurrence);
+        }
+    }
+
+    public static long uniqueId(final NativeUiScene.Node node) {
+        if (node.string("renderer", "").equals(ACTOR_RENDERER)) {
+            final var portrait = node.properties().getAsJsonObject("actor_portrait");
+            if (portrait == null || !portrait.has("unique_id"))
+                throw new IllegalArgumentException("Native actor portrait has no identity");
+            return portrait.get("unique_id").getAsBigDecimal().longValueExact();
+        }
+        final var bag = node.properties().getAsJsonObject("property_bag");
+        final JsonElement value = bag == null ? null : bag.get("#entity_id");
+        if (value == null) return -1;
+        if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString())
+            throw new IllegalArgumentException("Native portrait actor ID must be a string");
+        final String text = value.getAsString();
+        int start = 0;
+        while (start < text.length() && " \t\n\r\f\u000b".indexOf(text.charAt(start)) >= 0) start++;
+        int end = start;
+        if (end < text.length() && (text.charAt(end) == '+' || text.charAt(end) == '-')) end++;
+        final int digits = end;
+        while (end < text.length() && text.charAt(end) >= '0' && text.charAt(end) <= '9') end++;
+        if (end == digits) throw new IllegalArgumentException("Invalid native portrait actor ID");
+        return Long.parseLong(text.substring(start, end));
+    }
+
+    public static Camera camera(final NativeUiLayout.Rect rect, final int mode, final float mouseX, final float mouseY) {
+        final float dx = mode == 1 ? (mouseX - rect.x() - rect.width() / 2F) / 40F : 3F;
+        final float dy = mode == 1 ? (mouseY - rect.y() - rect.height() / 2F) / 40F : 1F;
+        return new Camera((float) Math.atan(dy) * 20F, (float) -Math.atan(dx) * 20F, rect.width());
+    }
+
+    /** Cancels Java's model origin for the native GUI player renderer. */
+    public static Vector3f playerTranslation(final Quaternionfc rotation, final float playerScale) {
+        if (playerScale < 0 || !Float.isFinite(playerScale))
+            throw new IllegalArgumentException("Invalid native portrait player scale");
+        // Native GUI actor draws skip both the eye offset and world model-root translation.
+        // Cancel Java's Living/Avatar origin shift; converted bones already use the GUI origin.
+        return rotation.transform(new Vector3f(0, -1.501F * .9375F * playerScale, 0)).add(0, 0, -5);
+    }
+
+    /** The native renderer uses the inherited scissor, not the custom control as a viewport. */
+    public static NativeUiLayout.Rect viewport(final NativeUiLayout.Rect clip, final int width, final int height) {
+        final var visible = clip.intersect(new NativeUiLayout.Rect(0, 0, width, height));
+        final int left = Math.round(visible.x()), top = Math.round(visible.y());
+        return new NativeUiLayout.Rect(left, top, Math.round(visible.x() + visible.width()) - left,
+                Math.round(visible.y() + visible.height()) - top);
+    }
+
+    /** Keeps the native control center when Java's intermediate texture uses a larger viewport. */
+    public static Vector3f viewportTranslation(final NativeUiLayout.Rect control, final NativeUiLayout.Rect viewport,
+                                               final Quaternionfc rotation, final float playerScale) {
+        if (!(control.width() > 0) || !Float.isFinite(control.width()))
+            throw new IllegalArgumentException("Invalid native portrait control width");
+        return playerTranslation(rotation, playerScale).add(
+                (control.x() + control.width() / 2F - viewport.x() - viewport.width() / 2F) / control.width(),
+                (viewport.y() + viewport.height() / 2F - control.y() - control.height() / 2F) / control.width(), 0);
+    }
+
+    public void draw(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box,
+                     final float mouseX, final float mouseY, final float partialTick) {
+        this.draw(graphics, box, mouseX, mouseY, partialTick, 1);
+    }
+
+    public void draw(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box,
+                     final float mouseX, final float mouseY, final float partialTick, final float opacity) {
+        final Minecraft client = Minecraft.getInstance();
+        if (client.level != this.level) {
+            this.contexts.values().forEach(BedrockGuiActorContext::close);
+            this.contexts.clear();
+            this.level = client.level;
+        }
+        if (!BedrockActorState.supportsUniqueIds()) throw new IllegalArgumentException("Native portrait identity capability is unavailable");
+        final String key = this.paths.get(box.node());
+        if (key == null) throw new IllegalStateException("Native portrait scene was not prepared");
+        final long uniqueId = uniqueId(box.node());
+        final var uuid = BedrockActorState.uuidByUniqueId(uniqueId);
+        if (uuid == null || client.level == null) {
+            this.retire(key);
+            return;
+        }
+        final var entity = client.level.getEntity(uuid);
+        if (entity == null || entity.isRemoved()) {
+            this.retire(key);
+            return;
+        }
+        final var snapshot = BedrockActorState.state(uuid);
+        if (snapshot == null || snapshot.uniqueId() == null) throw new IllegalArgumentException("Native portrait identity is unavailable");
+        var context = this.contexts.get(key);
+        if (context == null || !context.owns(uuid, snapshot.lifetime())) {
+            if (context != null) context.close();
+            context = new BedrockGuiActorContext(uuid, snapshot.lifetime());
+            this.contexts.put(key, context);
+        }
+        if (box.node().string("renderer", "").equals(ACTOR_RENDERER)) {
+            this.actor(graphics, box, entity, snapshot, context, opacity);
+            return;
+        }
+        if (!(entity instanceof Avatar player)) throw new IllegalArgumentException("Native portrait actor class is not verified");
+        final var camera = camera(box.bounds(), 1, mouseX, mouseY);
+        if (camera.scale() <= 0) return;
+        context.camera(camera.pitch(), camera.yaw());
+        final var renderState = context.scoped(() -> client.getEntityRenderDispatcher().extractEntity(player, partialTick));
+        context.requireSupportedEffects();
+        if (!(renderState instanceof AvatarRenderState state)) throw new IllegalArgumentException("Invalid native portrait player state");
+        final var rotation = new Quaternionf().rotateX((float) Math.toRadians(camera.pitch()));
+        final var viewport = viewport(box.clip(), graphics.guiWidth(), graphics.guiHeight());
+        if (viewport.width() <= 0 || viewport.height() <= 0) return;
+        graphics.entity(state, camera.scale(), viewportTranslation(box.bounds(), viewport, rotation, state.scale),
+                rotation, null, (int) viewport.x(), (int) viewport.y(),
+                (int) (viewport.x() + viewport.width()), (int) (viewport.y() + viewport.height()));
+    }
+
+    private void actor(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box,
+                       final net.minecraft.world.entity.Entity entity,
+                       final net.raphimc.viabedrock.api.model.NativeActorMessage.Snapshot snapshot,
+                       final BedrockGuiActorContext context, final float opacity) {
+        final var viewport = viewport(box.clip(), graphics.guiWidth(), graphics.guiHeight());
+        if (viewport.width() <= 0 || viewport.height() <= 0) return;
+        final var portrait = box.node().properties().getAsJsonObject("actor_portrait");
+        final var data = portrait.getAsJsonObject("actor_data");
+        final var properties = box.node().properties().deepCopy();
+        final var bag = properties.getAsJsonObject("property_bag");
+        if (bag != null) bag.entrySet().forEach(entry -> properties.add(entry.getKey(), entry.getValue()));
+        final String offsetType = portrait.has("offsets") ? portrait.get("offsets").getAsString() : "portrait_offsets";
+        if (!offsetType.equals("portrait_offsets") && !offsetType.equals("picker_offsets"))
+            throw new IllegalArgumentException("Invalid native portrait offset type");
+        final JsonObject offsets = data.getAsJsonObject(offsetType);
+        final var nativeBounds = BedrockActorState.bounds(entity.getUUID());
+        if (nativeBounds == null) throw new IllegalArgumentException("Native portrait bounding box is unavailable");
+        final var client = Minecraft.getInstance();
+        final float automaticRotation = properties.has("rotate_mode") && properties.get("rotate_mode").getAsString().equals("auto")
+            ? context.seconds() * 30F : 0;
+        final var camera = NativeUiActorCamera.resolve(box.bounds(), viewport, box.layer(),
+            net.raphimc.viabedrock.api.model.NativeActorBoundsMessage.scaledDimension(nativeBounds.width(), snapshot.scale()),
+            net.raphimc.viabedrock.api.model.NativeActorBoundsMessage.scaledDimension(nativeBounds.height(), snapshot.scale()),
+            net.raphimc.viabedrock.api.model.NativeActorBoundsMessage.scaledDimension(nativeBounds.width(), snapshot.scale()),
+            NativeUiViewport.current().scale(), properties, offsets, automaticRotation);
+        context.camera(0, 0);
+        try {
+            final var resources = BedrockGuiActorAppearance.resources();
+            final var appearance = context.resource(resources, snapshot.identifier(), () -> {
+                try { return BedrockGuiActorAppearance.load(resources, snapshot.identifier()); }
+                catch (final java.io.IOException error) { throw new java.io.UncheckedIOException(error); }
+            });
+            final int variant = portrait.get("variant").getAsBigDecimal().intValueExact();
+            final var state = context.scoped(() -> {
+                try {
+                    final var frame = appearance.sample(context.seconds(), snapshot, variant, 0, 0);
+                    return ((IBedrockGuiActorRenderer) client.getEntityRenderDispatcher()).stackanvil$guiActorRenderer()
+                        .extract(appearance, frame, camera.modelTransform(), opacity);
+                } catch (final java.io.IOException error) { throw new java.io.UncheckedIOException(error); }
+            });
+            graphics.entity(state, camera.scale(), camera.translation(), new Quaternionf(), null,
+                (int) viewport.x(), (int) viewport.y(), (int) (viewport.x() + viewport.width()),
+                (int) (viewport.y() + viewport.height()));
+        } catch (final java.io.IOException error) { throw new java.io.UncheckedIOException(error); }
+    }
+
+    private void retire(final String key) {
+        final var context = this.contexts.remove(key);
+        if (context != null) context.close();
+    }
+
+    public record Camera(float pitch, float yaw, float scale) {}
+}
