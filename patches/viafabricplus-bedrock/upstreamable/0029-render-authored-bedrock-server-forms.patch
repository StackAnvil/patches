+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.mojang.serialization.JsonOps;
+import java.util.IdentityHashMap;
+import java.util.Map;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.ComponentSerialization;
+import net.minecraft.network.chat.FontDescription;
+import net.minecraft.resources.Identifier;
+
+/** Shared accepted-pack text, image and intrinsic metrics, independent of screen authority. */
+public final class NativeUiRenderer implements NativeUiLayout.Metrics {
+    private final Font font;
+    private final NativeUiImages images;
+    private final Map<NativeUiScene.Node, Component> texts = new IdentityHashMap<>();
+
+    public NativeUiRenderer(final Font font, final NativeUiImages images) {
+        this.font = font;
+        this.images = images;
+    }
+
+    public void reset() { this.texts.clear(); }
+
+    @Override
+    public NativeUiLayout.Size constrained(final NativeUiScene.Node node, final float width) {
+        if (!node.type().equals("label")) return this.intrinsic(node);
+        final int lines = this.font.split(this.text(node), NativeUiFont.wrapWidth(node, width)).size();
+        return NativeUiFont.constrained(node, width, lines, this.font.lineHeight);
+    }
+
+    public void draw(final GuiGraphicsExtractor graphics, final NativeUiPresentation.Draw draw) {
+        final var node = draw.box().node();
+        if (node.type().equals("image") && !node.string("texture", "").isEmpty())
+            this.images.draw(graphics, draw.box(), color(node, draw.alpha()));
+        else if (node.type().equals("label")) this.label(graphics, draw.box(), draw.alpha());
+    }
+
+    public NativeUiLayout.Size intrinsic(final NativeUiScene.Node node) {
+        return switch (node.type()) {
+            case "label" -> NativeUiFont.intrinsic(node, this.font.width(this.text(node)),
+                node.string("text", "").split("\\n", -1).length, this.font.lineHeight);
+            case "image" -> {
+                if (node.string("texture", "").isEmpty()) yield new NativeUiLayout.Size(0, 0);
+                final var image = this.images.image(node);
+                yield image == null ? new NativeUiLayout.Size(16, 16) : new NativeUiLayout.Size(image.width(), image.height());
+            }
+            case "button", "toggle" -> new NativeUiLayout.Size(200, 20);
+            default -> new NativeUiLayout.Size(0, 0);
+        };
+    }
+
+    public void label(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final float alpha) {
+        this.label(graphics, box, alpha, this.text(box.node()));
+    }
+
+    public void label(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final float alpha, final Component text) {
+        final var node = box.node();
+        final float scale = NativeUiFont.scale(node);
+        if (scale == 0) return;
+        final int width = NativeUiFont.wrapWidth(node, box.bounds().width());
+        final var lines = this.font.split(text, width);
+        final String alignment = node.string("text_alignment", "left");
+        graphics.pose().pushMatrix();
+        try {
+            graphics.pose().translate(box.bounds().x(), box.bounds().y());
+            graphics.pose().scale(scale, scale);
+            int y = 0;
+            for (final var line : lines) {
+                final int lineWidth = this.font.width(line);
+                final int x = alignment.equals("center") ? (width - lineWidth) / 2 : alignment.equals("right") ? width - lineWidth : 0;
+                graphics.text(this.font, line, x, y, color(node, alpha), node.flag("shadow", false));
+                y += this.font.lineHeight;
+            }
+        } finally {
+            graphics.pose().popMatrix();
+        }
+    }
+
+    public Component text(final NativeUiScene.Node node) {
+        return this.texts.computeIfAbsent(node, value -> {
+            final Component text = value.properties().has("text_component")
+                ? ComponentSerialization.CODEC.parse(JsonOps.INSTANCE,
+                    value.properties().get("text_component")).getOrThrow()
+                : value.flag("localize", false) ? Component.translatable(value.string("text", ""))
+                    : NativeUiText.component(value.string("text", ""));
+            return this.styled(value, text);
+        });
+    }
+
+    public Component styled(final NativeUiScene.Node node, final Component text) {
+        final String font = node.string("font", "");
+        return font.isEmpty() ? text : text.copy().withStyle(style -> style.withFont(new FontDescription.Resource(Identifier.parse(font))));
+    }
+
+    public static int color(final NativeUiScene.Node node, final float alpha) {
+        final int red = Math.round(Math.clamp(NativeUiLayout.vector(node, "color", 0, 1), 0, 1) * 255);
+        final int green = Math.round(Math.clamp(NativeUiLayout.vector(node, "color", 1, 1), 0, 1) * 255);
+        final int blue = Math.round(Math.clamp(NativeUiLayout.vector(node, "color", 2, 1), 0, 1) * 255);
+        return Math.round(alpha * 255) << 24 | red << 16 | green << 8 | blue;
+    }
+
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiScene.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiScene.java
new file mode 100644
index 0000000..cb0b408
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiScene.java
@@ -0,0 +1,93 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+/** Bounded resolved UI geometry and opaque controller annotations shared by forms and containers. */
+public record NativeUiScene(Node root) {
+    private static final Set<String> TYPES = Set.of("screen", "panel", "label", "image", "button", "toggle",
+        "stack_panel", "grid", "scroll_view", "scrollbar_box", "scroll_track", "collection_panel", "factory", "custom",
+        "slider", "slider_box", "edit_box", "input_panel");
+
+    public static NativeUiScene parse(final String json, final Set<String> renderers) {
+        final JsonObject scene = JsonParser.parseString(json).getAsJsonObject();
+        final int format = scene.get("format").getAsBigDecimal().intValueExact();
+        if (format != 1 && format != 2) throw new IllegalArgumentException("Unsupported native UI format");
+        return new NativeUiScene(node(scene.getAsJsonObject("root"), 0, new int[1], true, renderers));
+    }
+
+    public static void validateVisibleControls(final Node node, final Set<String> renderers) {
+        validateVisibleControls(node, true, renderers);
+    }
+
+    private static void validateVisibleControls(final Node node, final boolean inheritedVisible, final Set<String> renderers) {
+        final boolean visible = inheritedVisible && node.flag("visible", true) && !node.flag("ignored", false);
+        if (visible && (!TYPES.contains(node.type()) || node.type().equals("custom") && !renderers.contains(node.string("renderer", ""))))
+            throw new IllegalArgumentException("Unsupported native UI control: " + node.type());
+        for (final var child : node.children()) validateVisibleControls(child, visible, renderers);
+    }
+
+    private static Node node(final JsonObject value, final int depth, final int[] count, final boolean inheritedVisible,
+                             final Set<String> renderers) {
+        if (depth > 64 || ++count[0] > 8192) throw new IllegalArgumentException("Native UI scene exceeds layout limits");
+        final String type = string(value, "type", "panel");
+        final JsonElement visibility = value.get("visible");
+        final boolean visible = inheritedVisible && !(visibility != null && visibility.isJsonPrimitive()
+            && visibility.getAsJsonPrimitive().isBoolean() && !visibility.getAsBoolean()) && !(value.has("ignored") && value.get("ignored").isJsonPrimitive()
+            && value.get("ignored").getAsJsonPrimitive().isBoolean() && value.get("ignored").getAsBoolean());
+        if (visible && (!TYPES.contains(type) || type.equals("custom") && !renderers.contains(string(value, "renderer", ""))))
+            throw new IllegalArgumentException("Unsupported native UI control: " + type);
+        final List<Node> children = new ArrayList<>();
+        if (value.has("children")) for (final JsonElement child : value.getAsJsonArray("children"))
+            children.add(node(child.getAsJsonObject(), depth + 1, count, visible, renderers));
+        final JsonObject properties = new JsonObject();
+        value.entrySet().stream().filter(entry -> !entry.getKey().equals("children"))
+            .forEach(entry -> properties.add(entry.getKey(), entry.getValue().deepCopy()));
+        final int action = value.has("action") ? value.get("action").getAsBigDecimal().intValueExact() : Integer.MIN_VALUE;
+        return new Node(string(value, "name", ""), type, properties, List.copyOf(children), action);
+    }
+
+    public static String string(final JsonObject properties, final String key, final String fallback) {
+        final JsonElement value = properties.get(key);
+        return value == null || !value.isJsonPrimitive() ? fallback : value.getAsString();
+    }
+
+    public record Node(String name, String type, JsonObject properties, List<Node> children, int action) {
+        public String string(final String key, final String fallback) {
+            return NativeUiScene.string(this.properties, key, fallback);
+        }
+
+        public float number(final String key, final float fallback) {
+            final JsonElement value = this.properties.get(key);
+            if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) return fallback;
+            final float result = value.getAsFloat();
+            if (!Float.isFinite(result)) throw new IllegalArgumentException("Non-finite native UI property");
+            return result;
+        }
+
+        public boolean flag(final String key, final boolean fallback) {
+            final JsonElement value = this.properties.get(key);
+            return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isBoolean()
+                ? value.getAsBoolean() : fallback;
+        }
+
+        public boolean interactive() {
+            return this.action != Integer.MIN_VALUE || this.properties.has("input") || this.properties.has("command")
+                || this.properties.has("inventory_actions") || this.properties.has("inventory_command");
+        }
+
+        public boolean scroll() {
+            return this.type.equals("scroll_view");
+        }
+    }
+
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiScroll.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiScroll.java
