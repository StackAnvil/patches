+    @Override
+    public boolean mouseClicked(final MouseButtonEvent event, final boolean doubleClick) {
+        if (this.controller.inputs() != null && event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+            for (final var draw : this.draws((int) event.x(), (int) event.y()).reversed()) {
+                final var box = draw.box();
+                if (!draw.enabled() || draw.alpha() <= 0 || !box.visibleBounds().contains(event.x(), event.y())
+                    || !box.node().properties().has("input")) continue;
+                final int index = inputIndex(box.node());
+                if (!this.controller.inputs().isSlider(index)) continue;
+                final var owner = sliderOwner(this.root, box.node(), null);
+                if (owner == null) continue;
+                this.inputDrag = new InputDrag(index, owner);
+                this.slide(this.inputDrag, event.x(), event.y());
+                this.setDragging(true);
+                return true;
+            }
+        }
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+            final var target = scrollbar(this.root, event.x(), event.y(), this.interactive(event.x(), event.y()));
+            if (target != null) {
+                final var model = NativeUiScroll.model(target, this.scroll.getOrDefault(target.node(), 0F));
+                final float pointer = model.pointer(event.x(), event.y());
+                final float grab = model.containsThumb(event.x(), event.y()) ? pointer - model.start() : model.extent() / 2;
+                this.scrollAnimation(target.node(), false);
+                this.drag = new Drag(target.node(), grab);
+                this.setDragging(true);
+                this.scroll.put(target.node(), model.offsetAt(pointer, grab));
+                this.layout();
+                return true;
+            }
+        }
+        return super.mouseClicked(event, doubleClick);
+    }
+
+    @Override
+    public boolean mouseDragged(final MouseButtonEvent event, final double deltaX, final double deltaY) {
