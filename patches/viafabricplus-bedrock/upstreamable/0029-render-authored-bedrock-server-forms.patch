+        if (this.drag != null && event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+            this.animations.event(this.drag.node, "scrollbar.released", this.animationTime());
+            this.drag = null;
+            this.setDragging(false);
+            return true;
+        }
+        return super.mouseReleased(event);
+    }
