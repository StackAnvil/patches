+        animations.advance(node, 0);
+        assertEquals(-10, animations.dimension(node, "offset", 0).resolve(100, 0, 0, 0, 0, 0, 0));
+        animations.event(node, "play", 0);
+        animations.advance(node, 250_000_000);
+        assertEquals(0, animations.dimension(node, "offset", 0).resolve(100, 0, 0, 0, 0, 0, 0));
+        animations.event(node, "play", 250_000_000);
+        animations.advance(node, 500_000_000);
+        assertEquals(10, animations.dimension(node, "offset", 0).resolve(100, 0, 0, 0, 0, 0, 0));
+        animations.event(node, "reset", 500_000_000);
+        animations.advance(node, 750_000_000);
