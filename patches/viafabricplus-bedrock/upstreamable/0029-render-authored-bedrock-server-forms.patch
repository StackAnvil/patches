+import net.minecraft.network.Connection;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.ComponentSerialization;
+
+/** Draws the authored scene, with ordinary Java event, focus, narration and response handling. */
+final class BedrockNativeFormScreen extends Screen {
+    private final Connection owner;
+    private final int formId;
+    private BedrockFormScene scene;
+    private final BedrockCustomFormState custom;
+    private final NativeUiImages images = new NativeUiImages();
+    private final NativeUiAnimations animations = new NativeUiAnimations();
+    private final Map<NativeUiScene.Node, Float> scroll = new IdentityHashMap<>();
+    private final Map<NativeUiScene.Node, Action> actions = new IdentityHashMap<>();
+    private final Map<NativeUiScene.Node, NativeInput> inputs = new IdentityHashMap<>();
+    private final Map<NativeUiScene.Node, NativeUiLayout.Box> geometry = new IdentityHashMap<>();
+    private final Map<String, Action> actionWidgets = new HashMap<>();
+    private final Map<String, NativeInput> inputWidgets = new HashMap<>();
+    private boolean customRefreshPending;
+    private NativeUiRenderer renderer;
+    private NativeUiLayout.Box root;
+    private boolean responded;
+    private Drag drag;
+    private InputDrag inputDrag;
+    private long imageRevision;
+    private double pointerX = -1;
+    private double pointerY = -1;
+
+    BedrockNativeFormScreen(final Connection owner, final int formId, final BedrockFormScene scene) {
+        this(owner, formId, scene, null);
+    }
+
+    BedrockNativeFormScreen(final Connection owner, final int formId, final BedrockFormScene scene,
+                            final BedrockCustomFormState custom) {
+        super(NativeUiText.component(scene.fallback().title()));
+        this.owner = owner;
+        this.formId = formId;
+        this.scene = scene;
+        this.custom = custom;
+    }
+
+    @Override
+    protected void init() {
+        this.drag = null;
+        this.inputDrag = null;
+        this.setDragging(false);
+        this.layout();
+        this.reconcileWidgets();
+    }
+
+    private void reconcileWidgets() {
+        this.actions.clear();
+        this.inputs.clear();
+        final List<ControlBox> boxes = new ArrayList<>();
+        controls(this.root, "", boxes);
+        boxes.sort(Comparator.comparingDouble((ControlBox control) -> control.box.layer()).reversed());
+        final Set<String> retainedActions = new HashSet<>(), retainedInputs = new HashSet<>();
+        for (final var control : boxes) {
+            final var box = control.box;
+            if (!box.node().interactive()) continue;
+            if (this.custom != null && box.node().type().equals("edit_box") && box.node().properties().has("input")) {
+                final NativeInput input = this.inputWidgets.computeIfAbsent(control.key, key -> new NativeInput(box));
+                input.place(box);
+                if (!this.children().contains(input)) this.addWidget(input);
+                this.inputs.put(box.node(), input);
+                retainedInputs.add(control.key);
+            } else {
+                final Action action = this.actionWidgets.computeIfAbsent(control.key, key -> new Action(box));
+                action.place(box);
+                if (!this.children().contains(action)) this.addWidget(action);
+                this.actions.put(box.node(), action);
+                retainedActions.add(control.key);
+            }
+        }
+        this.inputWidgets.entrySet().removeIf(entry -> {
+            if (retainedInputs.contains(entry.getKey())) return false;
+            this.removeWidget(entry.getValue());
+            return true;
+        });
+        this.actionWidgets.entrySet().removeIf(entry -> {
+            if (retainedActions.contains(entry.getKey())) return false;
+            this.removeWidget(entry.getValue());
+            return true;
+        });
+        this.synchronize(this.draws(-1, -1));
+        if (!this.scene.fallback().buttons().isEmpty() && this.actions.values().stream()
+            .noneMatch(action -> action.visible && action.eligible && action.node.action() >= 0))
+            throw new IllegalArgumentException("Native form has no usable response controls");
+    }
+
+    private static void controls(final NativeUiLayout.Box box, final String parent, final List<ControlBox> result) {
+        final String path = parent + "/" + box.node().name();
+        result.add(new ControlBox(box, path + ":" + box.node().type() + ":" + box.node().properties().get("input")));
+        for (final var child : box.children()) controls(child, path, result);
+    }
+
+    private record ControlBox(NativeUiLayout.Box box, String key) {}
+
+    private void layout() {
+        NativeUiPresentation.updateSliderStates(this.scene.root(), this::sliderHovered, this::sliderSelected);
+        this.scene.validateVisibleControls();
+        this.root = new NativeUiLayout(this.renderer()).layout(this.scene.root(), this.width, this.height, this.scroll);
+        this.root = NativeUiSlider.apply(this.root);
+        this.geometry.clear();
+        this.indexGeometry(this.root);
+        this.positionActions(this.root);
+    }
+
+    private void indexGeometry(final NativeUiLayout.Box box) {
+        this.geometry.put(box.node(), box);
+        for (final var child : box.children()) this.indexGeometry(child);
+    }
+
+    private boolean sliderHovered(final NativeUiScene.Node node) {
+        final var box = this.geometry.get(node);
+        return box != null && box.visibleBounds().contains(this.pointerX, this.pointerY);
+    }
+
+    private boolean sliderSelected(final NativeUiScene.Node node) {
+        return this.inputDrag != null && node.properties().has("input")
+            && inputIndex(node) == this.inputDrag.index;
+    }
+
+    private NativeUiRenderer renderer() {
+        if (this.renderer == null) this.renderer = new NativeUiRenderer(this.font, this.images);
+        return this.renderer;
+    }
+
+    private void positionActions(final NativeUiLayout.Box box) {
+        final Action action = this.actions.get(box.node());
+        if (action != null) action.place(box);
+        final NativeInput input = this.inputs.get(box.node());
+        if (input != null) input.place(box);
+        for (final var child : box.children()) this.positionActions(child);
+    }
+
+    @Override
+    public void extractRenderState(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        this.extractTransparentBackground(graphics);
+        try {
+            this.refreshPendingCustom();
+            this.pointerX = mouseX;
+            this.pointerY = mouseY;
+            if (NativeUiPresentation.updateSliderStates(this.scene.root(), this::sliderHovered, this::sliderSelected))
+                this.layout();
+            final List<NativeUiPresentation.Draw> draws = this.draws(mouseX, mouseY);
+            this.synchronize(draws);
+            draws.sort(Comparator.comparingDouble(draw -> draw.box().layer()));
+            NativeUiScene.Node tooltip = null;
+            for (final NativeUiPresentation.Draw draw : draws) {
+                final var box = draw.box();
+                final var clip = box.node().type().equals("label") ? box.visibleBounds() : box.clip();
+                if (draw.enabled() && draw.alpha() > 0 && box.node().type().equals("custom")
+                    && box.node().string("renderer", "").equals("hover_text_renderer")
+                    && !box.node().string("hover_text", "").isEmpty()) tooltip = box.node();
+                if (draw.alpha() <= 0 || box.visibleBounds().width() <= 0 || box.visibleBounds().height() <= 0) continue;
+                graphics.enableScissor(Math.round(clip.x()), Math.round(clip.y()),
+                    Math.round(clip.x() + clip.width()), Math.round(clip.y() + clip.height()));
+                try {
+                    final var node = box.node();
+                    if (node.type().equals("image") && !node.string("texture", "").isEmpty())
+                        this.images.draw(graphics, box, NativeUiRenderer.color(node, draw.alpha()));
+                    else if (node.type().equals("label")) this.renderer().label(graphics, box, draw.alpha());
+                    final Action action = this.actions.get(node);
+                    if (action != null) action.extractRenderState(graphics, mouseX, mouseY, delta);
+                    final NativeInput input = this.inputs.get(node);
+                    if (input != null) input.extractRenderState(graphics, mouseX, mouseY, delta);
+                } finally {
+                    graphics.disableScissor();
+                }
+            }
+            if (tooltip != null) {
+                final Component text = tooltip.properties().has("hover_text_component")
+                    ? ComponentSerialization.CODEC.parse(JsonOps.INSTANCE, tooltip.properties().get("hover_text_component")).getOrThrow()
+                    : NativeUiText.component(tooltip.string("hover_text", ""));
+                final int maximum = Math.round(tooltip.number("hover_text_max_width", 0));
+                final int wrapWidth = maximum > 0 ? Math.max(1, Math.min(maximum, this.width - 16)) : Integer.MAX_VALUE;
+                graphics.setTooltipForNextFrame(this.font, NativeUiText.tooltipLines(this.font, text, wrapWidth), mouseX, mouseY);
+            }
+            if (this.images.failed()) graphics.text(this.font,
+                Component.literal("Some menu images could not load."), 8, this.height - this.font.lineHeight - 8,
+                0xFFFFCCCC, true);
+        } catch (final RuntimeException error) {
+            ViaFabricPlusBedrock.impl().logger().warn("Could not draw native form; opening its ordinary controls", error);
+            this.fallback();
+        }
+    }
+
+    private List<NativeUiPresentation.Draw> draws(final int mouseX, final int mouseY) {
+        this.animations.beginFrame();
+        final long now = System.nanoTime();
+        return NativeUiPresentation.draws(this.root, box -> {
+            final Action action = this.actions.get(box.node());
+            return box.node().type().equals("slider") || box.node().type().equals("slider_box")
+                ? box.visibleBounds().contains(mouseX, mouseY)
+                : action != null && (action.isFocused() || box.visibleBounds().contains(mouseX, mouseY));
+        }, node -> this.animations.opacity(node, now));
+    }
+
+    private void synchronize(final List<NativeUiPresentation.Draw> draws) {
+        for (final Action action : this.actions.values()) action.visible = false;
+        for (final NativeInput input : this.inputs.values()) input.visible = false;
+        for (final NativeUiPresentation.Draw draw : draws) {
+            final Action action = this.actions.get(draw.box().node());
+            if (action != null) {
+                action.visible = true;
+                action.eligible = draw.enabled() && draw.box().bounds().width() > 0 && draw.box().bounds().height() > 0;
+                action.active = action.eligible && draw.alpha() > 0;
+                action.setAlpha(draw.alpha());
+            }
+            final NativeInput input = this.inputs.get(draw.box().node());
+            if (input != null) {
+                input.visible = draw.box().visibleBounds().width() > 0 && draw.box().visibleBounds().height() > 0;
+                input.active = draw.enabled() && draw.alpha() > 0;
+                input.setEditable(input.active);
+                input.setAlpha(draw.alpha());
+            }
+        }
+    }
+
+    private Map<NativeUiScene.Node, Boolean> interactive(final double x, final double y) {
+        final Map<NativeUiScene.Node, Boolean> result = new IdentityHashMap<>();
+        for (final var draw : this.draws((int) x, (int) y)) if (draw.enabled() && draw.alpha() > 0) result.put(draw.box().node(), true);
+        return result;
+    }
+
+    @Override
+    public boolean mouseScrolled(final double x, final double y, final double horizontal, final double vertical) {
+        final var target = scrolling(this.root, x, y, this.interactive(x, y));
+        if (target == null) return super.mouseScrolled(x, y, horizontal, vertical);
+        final double delta = NativeUiScroll.horizontal(target) && horizontal != 0 ? horizontal : vertical;
+        this.scroll.put(target.node(), Math.clamp(this.scroll.getOrDefault(target.node(), 0F)
+            - (float) delta * target.node().number("scroll_speed", 18), 0, NativeUiScroll.maximum(target)));
+        this.layout();
+        return true;
+    }
+
+    @Override
+    public boolean mouseClicked(final MouseButtonEvent event, final boolean doubleClick) {
+        if (this.custom != null && event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+            for (final var draw : this.draws((int) event.x(), (int) event.y()).reversed()) {
+                final var box = draw.box();
+                if (!draw.enabled() || draw.alpha() <= 0 || !box.visibleBounds().contains(event.x(), event.y())
+                    || !box.node().properties().has("input")) continue;
+                final int index = inputIndex(box.node());
+                if (!this.custom.isSlider(index)) continue;
+                final var owner = sliderOwner(this.root, box.node(), null);
+                if (owner == null) continue;
+                this.inputDrag = new InputDrag(index, owner);
+                this.slide(this.inputDrag, event.x(), event.y());
+                this.setDragging(true);
+                return true;
+            }
+        }
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+            final var target = scrollbar(this.root, event.x(), event.y(), this.interactive(event.x(), event.y()));
+            if (target != null) {
+                final var model = NativeUiScroll.model(target, this.scroll.getOrDefault(target.node(), 0F));
+                final float pointer = model.pointer(event.x(), event.y());
+                final float grab = model.containsThumb(event.x(), event.y()) ? pointer - model.start() : model.extent() / 2;
+                this.drag = new Drag(target.node(), grab);
+                this.setDragging(true);
+                this.scroll.put(target.node(), model.offsetAt(pointer, grab));
+                this.layout();
+                return true;
+            }
+        }
+        return super.mouseClicked(event, doubleClick);
+    }
+
+    @Override
+    public boolean mouseDragged(final MouseButtonEvent event, final double deltaX, final double deltaY) {
+        if (this.inputDrag != null && event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+            final InputDrag current = this.inputDrag;
+            this.slide(current, event.x(), event.y());
+            this.inputDrag = current;
+            this.setDragging(true);
+            return true;
+        }
+        if (this.drag != null && event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+            final var target = find(this.root, this.drag.node);
+            final var model = target == null ? null : NativeUiScroll.model(target, this.scroll.getOrDefault(this.drag.node, 0F));
+            if (model != null) {
+                this.scroll.put(this.drag.node, model.offsetAt(model.pointer(event.x(), event.y()),
+                    Math.min(this.drag.grab, model.extent())));
+                this.layout();
+            }
+            return true;
+        }
+        return super.mouseDragged(event, deltaX, deltaY);
+    }
+
+    @Override
+    public boolean mouseReleased(final MouseButtonEvent event) {
+        if (this.inputDrag != null && event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+            this.inputDrag = null;
+            this.setDragging(false);
+            return true;
+        }
+        if (this.drag != null && event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+            this.drag = null;
+            this.setDragging(false);
+            return true;
+        }
+        return super.mouseReleased(event);
+    }
+
+    private static NativeUiLayout.Box find(final NativeUiLayout.Box box, final NativeUiScene.Node node) {
+        if (box.node() == node) return box;
+        for (final var child : box.children()) {
+            final var found = find(child, node);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    private NativeUiLayout.Box scrollbar(final NativeUiLayout.Box box, final double x, final double y,
+                                            final Map<NativeUiScene.Node, Boolean> interactive) {
+        if (!interactive.containsKey(box.node()) || !box.clip().contains(x, y)) return null;
+        for (int i = box.children().size() - 1; i >= 0; i--) {
+            final var target = this.scrollbar(box.children().get(i), x, y, interactive);
+            if (target != null) return target;
+        }
+        if (box.node().scroll()) {
+            final var model = NativeUiScroll.model(box, this.scroll.getOrDefault(box.node(), 0F));
+            if (model != null && model.maximum() > 0 && interactive.containsKey(model.originalThumb().node())
+                && model.containsTrack(x, y)) return box;
+        }
+        return null;
+    }
+
+    private static NativeUiLayout.Box scrolling(final NativeUiLayout.Box box, final double x, final double y,
+                                                   final Map<NativeUiScene.Node, Boolean> interactive) {
+        if (!interactive.containsKey(box.node()) || !box.clip().contains(x, y)) return null;
+        for (int i = box.children().size() - 1; i >= 0; i--) {
+            final var target = scrolling(box.children().get(i), x, y, interactive);
+            if (target != null) return target;
+        }
+        return box.node().scroll() && box.bounds().contains(x, y) && NativeUiScroll.maximum(box) > 0 ? box : null;
+    }
+
+    @Override
+    public boolean keyPressed(final KeyEvent event) {
+        if (this.custom != null && this.getFocused() instanceof Action action && action.node.properties().has("input")
+            && (event.key() == InputConstants.KEY_LEFT || event.key() == InputConstants.KEY_RIGHT)) {
+            this.custom.adjust(inputIndex(action.node), event.key() == InputConstants.KEY_LEFT ? -1 : 1);
+            this.refreshCustom();
+            return true;
+        }
+        if (!(this.getFocused() instanceof NativeInput) && (event.key() == InputConstants.KEY_PAGEUP || event.key() == InputConstants.KEY_PAGEDOWN
+            || event.key() == InputConstants.KEY_HOME || event.key() == InputConstants.KEY_END)) {
+            final var focused = this.getFocused() instanceof Action action ? action.node
+                : this.getFocused() instanceof NativeInput input ? input.node : null;
+            NativeUiLayout.Box target = this.keyboardScroll(this.root, focused);
+            if (target == null) target = this.keyboardScroll(this.root, null);
+            if (target != null) {
+                final float page = NativeUiScroll.horizontal(target) ? target.scrollViewport().width() : target.scrollViewport().height();
+                final float maximum = NativeUiScroll.maximum(target);
+                final float previous = this.scroll.getOrDefault(target.node(), 0F);
+                final float value = switch (event.key()) {
+                    case InputConstants.KEY_HOME -> 0;
+                    case InputConstants.KEY_END -> maximum;
+                    case InputConstants.KEY_PAGEUP -> previous - page;
+                    default -> previous + page;
+                };
+                this.scroll.put(target.node(), Math.clamp(value, 0, maximum));
+                this.layout();
+                return true;
+            }
+        }
+        final boolean result = super.keyPressed(event);
+        this.refreshPendingCustom();
+        if (this.getFocused() instanceof Action action) this.reveal(this.root, action.node);
+        else if (this.getFocused() instanceof NativeInput input) this.reveal(this.root, input.node);
+        return result;
+    }
+
+    @Override
+    public boolean charTyped(final CharacterEvent event) {
+        final boolean result = super.charTyped(event);
+        this.refreshPendingCustom();
+        if (this.getFocused() instanceof NativeInput input) this.reveal(this.root, input.node);
+        return result;
+    }
+
+    private NativeUiLayout.Box keyboardScroll(final NativeUiLayout.Box box, final NativeUiScene.Node focused) {
+        for (int i = box.children().size() - 1; i >= 0; i--) {
+            final var nested = this.keyboardScroll(box.children().get(i), focused);
+            if (nested != null) return nested;
+        }
+        if (!box.node().scroll() || NativeUiScroll.maximum(box) == 0) return null;
+        if (focused != null) return find(box, focused) != null ? box : null;
+        return this.actions.values().stream().anyMatch(action -> action.visible && action.active && find(box, action.node) != null) ? box : null;
+    }
+
+    private boolean reveal(final NativeUiLayout.Box box, final NativeUiScene.Node focused) {
+        if (box.node() == focused) return true;
+        for (final var child : box.children()) if (this.reveal(child, focused)) {
+            if (box.node().scroll()) {
+                final var control = find(box, focused);
+                if (control == null) return true;
+                final var bounds = control.bounds();
+                final var viewport = box.scrollViewport().intersect(box.clip());
+                final boolean horizontal = NativeUiScroll.horizontal(box);
+                final float start = horizontal ? bounds.x() : bounds.y(), extent = horizontal ? bounds.width() : bounds.height();
+                final float viewportStart = horizontal ? viewport.x() : viewport.y(), viewportExtent = horizontal ? viewport.width() : viewport.height();
+                final float delta = start < viewportStart ? start - viewportStart
+                    : Math.max(0, start + extent - viewportStart - viewportExtent);
+                if (delta != 0) {
+                    this.scroll.put(box.node(), Math.clamp(this.scroll.getOrDefault(box.node(), 0F) + delta,
+                        0, NativeUiScroll.maximum(box)));
+                    this.layout();
+                }
+            }
+            return true;
+        }
+        return false;
+    }
+
+    @Override
+    public void onClose() {
+        this.respond(-1);
+    }
+
+    private void respond(final int action) {
+        if (this.responded) return;
+        this.responded = true;
+        BedrockNativeForms.respond(this.owner, this.formId, action);
+        this.minecraft.setScreenAndShow(null);
+    }
+
+    @Override
+    public boolean isPauseScreen() {
+        return false;
+    }
+
+    @Override
+    public void tick() {
+        if (!BedrockNativeForms.current(this.owner)) this.minecraft.setScreenAndShow(null);
+        else if (this.imageRevision != this.images.revision()) {
+            this.imageRevision = this.images.revision();
+            try { this.layout(); }
+            catch (final RuntimeException error) {
+                ViaFabricPlusBedrock.impl().logger().warn("Could not update native form images; opening its ordinary controls", error);
+                this.fallback();
+            }
+        }
+    }
+
+    @Override
+    public void removed() {
+        this.images.close();
+    }
+
+    private static int inputIndex(final NativeUiScene.Node node) {
+        return node.properties().getAsJsonObject("input").get("index").getAsBigDecimal().intValueExact();
+    }
+
+    private void activate(final NativeUiScene.Node node) {
+        if (this.custom == null) { this.respond(node.action()); return; }
+        final String command = node.string("command", "");
+        if (command.equals("cancel") || node.action() == -1) { this.respond(-1); return; }
+        if (command.equals("submit")) {
+            if (this.responded) return;
+            final var response = this.custom.response();
+            this.responded = true;
+            BedrockNativeForms.respond(this.owner, this.formId, response);
+            this.minecraft.setScreenAndShow(null);
+            return;
+        }
+        if (!node.properties().has("input")) return;
+        final int index = inputIndex(node);
+        final var input = node.properties().getAsJsonObject("input");
+        if (command.equals("expand")) this.custom.expand(index);
+        else if (input.has("option")) this.custom.select(index, input.get("option").getAsBigDecimal().intValueExact());
+        else if (this.custom.type(index).equals("toggle")) this.custom.toggle(index);
+        else if (this.custom.isSlider(index)) this.custom.adjust(index, 1);
+        this.refreshCustom();
+    }
+
+    private static NativeUiLayout.Box sliderOwner(final NativeUiLayout.Box box, final NativeUiScene.Node target,
+                                                     final NativeUiLayout.Box owner) {
+        final var current = box.node().type().equals("slider") ? box : owner;
+        if (box.node() == target) return current;
+        for (final var child : box.children()) {
+            final var found = sliderOwner(child, target, current);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    private void slide(final InputDrag drag, final double x, final double y) {
+        final boolean vertical = drag.owner.node().string("slider_direction", "horizontal").equals("vertical");
+        final float extent = vertical ? drag.owner.bounds().height() : drag.owner.bounds().width();
+        if (extent <= 0) return;
+        this.custom.slide(drag.index, NativeUiSlider.pointerFraction(drag.owner, x, y));
+        this.refreshCustom();
+        this.inputDrag = drag;
+    }
+
+    private void refreshPendingCustom() {
+        if (this.customRefreshPending) this.refreshCustom();
+    }
+
+    private void refreshCustom() {
+        if (this.custom == null) return;
+        this.customRefreshPending = false;
+        try {
+            final Map<String, Float> offsets = new HashMap<>();
+            this.scrollOffsets(this.scene.root(), "", offsets, false);
+            this.scene = this.custom.scene();
+            this.renderer = null;
+            this.scroll.clear();
+            this.scrollOffsets(this.scene.root(), "", offsets, true);
+            this.layout();
+            this.reconcileWidgets();
+        } catch (final RuntimeException error) {
+            ViaFabricPlusBedrock.impl().logger().warn("Could not update native custom form; requesting its ordinary controls", error);
+            this.fallback();
+        }
+    }
+
+    private void scrollOffsets(final NativeUiScene.Node node, final String parent, final Map<String, Float> offsets,
+                               final boolean restore) {
+        final String key = parent + "/" + node.name();
+        if (node.scroll()) {
+            if (restore) this.scroll.put(node, offsets.getOrDefault(key, 0F));
+            else offsets.put(key, this.scroll.getOrDefault(node, 0F));
+        }
+        for (final var child : node.children()) this.scrollOffsets(child, key, offsets, restore);
+    }
+
+    private void fallback() {
+        if (this.custom == null)
+            this.minecraft.setScreenAndShow(new BedrockFallbackFormScreen(this.owner, this.formId, this.scene.fallback()));
+        else {
+            if (this.responded) return;
+            this.responded = true;
+            BedrockNativeForms.fallback(this.owner, this.formId);
+            this.minecraft.setScreenAndShow(null);
+        }
+    }
+
+    private record InputDrag(int index, NativeUiLayout.Box owner) {}
+
+    private final class NativeInput extends EditBox {
+        private NativeUiScene.Node node;
+        private NativeUiLayout.Box box;
+
+        NativeInput(final NativeUiLayout.Box box) {
+            super(BedrockNativeFormScreen.this.font, 0, 0, 1, 1, NativeUiText.component(Action.caption(box.node())));
+            this.node = box.node();
+            final int index = inputIndex(this.node);
+            this.setMaxLength(BedrockNativeFormScreen.this.custom.maxLength(index));
+            this.setValue(BedrockNativeFormScreen.this.custom.text(index));
+            this.setHint(NativeUiText.component(BedrockNativeFormScreen.this.custom.placeholder(index)));
+            this.setBordered(false);
+            this.place(box);
+            this.setResponder(value -> {
+                BedrockNativeFormScreen.this.customRefreshPending |= BedrockNativeFormScreen.this.custom.setText(index, value);
+            });
+        }
+
+        void place(final NativeUiLayout.Box box) {
+            this.node = box.node();
+            this.box = box;
+            final var bounds = box.bounds();
+            this.setRectangle(Math.max(1, Math.round(bounds.width())), Math.max(1, Math.round(bounds.height())),
+                Math.round(bounds.x()), Math.round(bounds.y()));
+        }
+
+        @Override
+        public boolean isMouseOver(final double x, final double y) {
+            return this.box.visibleBounds().contains(x, y) && super.isMouseOver(x, y);
+        }
+    }
+
+    private record Drag(NativeUiScene.Node node, float grab) {}
+
+    private final class Action extends AbstractButton {
+        private NativeUiScene.Node node;
+        private NativeUiLayout.Box box;
+        private boolean eligible;
+
+        Action(final NativeUiLayout.Box box) {
+            super(0, 0, 1, 1, NativeUiText.component(caption(box.node())));
+            this.node = box.node();
+            this.place(box);
+        }
+
+        void place(final NativeUiLayout.Box box) {
+            this.node = box.node();
+            this.setMessage(NativeUiText.component(caption(this.node)));
+            final String tooltip = this.node.string("tooltip", "");
+            this.setTooltip(tooltip.isEmpty() ? null : Tooltip.create(NativeUiText.component(tooltip)));
+            this.box = box;
+            final var bounds = box.bounds();
+            this.setRectangle(Math.max(1, Math.round(bounds.width())), Math.max(1, Math.round(bounds.height())),
+                Math.round(bounds.x()), Math.round(bounds.y()));
+        }
+
+        @Override
+        public void onPress(final InputWithModifiers input) {
+            BedrockNativeFormScreen.this.activate(this.node);
+        }
+
+        @Override
+        protected void extractContents(final GuiGraphicsExtractor graphics, final int x, final int y, final float delta) {
+            if (this.node.string("default_control", "").isEmpty() && !this.node.properties().has("input")) {
+                this.extractDefaultSprite(graphics);
+                this.extractDefaultLabel(graphics.textRendererForWidget(this, GuiGraphicsExtractor.HoveredTextEffects.TOOLTIP_AND_CURSOR));
+            }
+        }
+
+        @Override
+        public ComponentPath nextFocusPath(final FocusNavigationEvent event) {
+            return this.node.flag("focus_enabled", true) ? super.nextFocusPath(event) : null;
+        }
+
+        @Override
+        public boolean isMouseOver(final double x, final double y) {
+            return this.box.visibleBounds().contains(x, y) && super.isMouseOver(x, y);
+        }
+
+        @Override
+        protected void updateWidgetNarration(final NarrationElementOutput output) {
+            this.defaultButtonNarrationText(output);
+        }
+
+        private static String caption(final NativeUiScene.Node node) {
+            final String text = node.string("text", "");
+            if (!text.isEmpty()) return text;
+            for (final var child : node.children()) {
+                final String value = caption(child);
+                if (!value.isEmpty()) return value;
+            }
+            return node.name();
+        }
+    }
+}
