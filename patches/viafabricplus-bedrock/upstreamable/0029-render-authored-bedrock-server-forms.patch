+    private NativeUiLayout.Box scrollbar(final NativeUiLayout.Box box, final double x, final double y,
+                                            final Map<NativeUiScene.Node, Boolean> interactive) {
+        if (!interactive.containsKey(box.node()) || !box.clip().contains(x, y)) return null;
+        for (int i = box.children().size() - 1; i >= 0; i--) {
+            final var target = this.scrollbar(box.children().get(i), x, y, interactive);
+            if (target != null) return target;
+        }
+        if (box.node().scroll()) {
+            final var model = NativeUiScroll.model(box, this.scroll.getOrDefault(box.node(), 0F));
+            if (model != null && model.maximum() > 0 && interactive.containsKey(model.originalThumb().node())
+                && model.containsTrack(x, y)) return box;
+        }
+        return null;
+    }
+
+    private static NativeUiLayout.Box scrolling(final NativeUiLayout.Box box, final double x, final double y,
+                                                   final Map<NativeUiScene.Node, Boolean> interactive) {
+        if (!interactive.containsKey(box.node()) || !box.clip().contains(x, y)) return null;
+        for (int i = box.children().size() - 1; i >= 0; i--) {
+            final var target = scrolling(box.children().get(i), x, y, interactive);
+            if (target != null) return target;
+        }
+        return box.node().scroll() && box.bounds().contains(x, y) && NativeUiScroll.maximum(box) > 0 ? box : null;
+    }
