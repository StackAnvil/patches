+final class NativeUiSliderTest {
+    @Test
+    void positionsThumbAcrossTheFullOwnerExtentAndMovesItsChildren() {
+        final var skin = box("skin", "image", "{}", 142, 42, 10, 16);
+        final var thumb = box("thumb", "slider_box", "{\"offset\":[7,12]}", 142, 42, 10, 16, skin);
+        final var owner = owner("{\"slider_value\":0,\"slider_box_control\":\"thumb\"}", thumb);
+        final var placed = NativeUiSlider.apply(owner).children().getFirst();
+        assertEquals(95, placed.bounds().x());
+        assertEquals(42, placed.bounds().y());
+        assertEquals(placed.bounds(), placed.children().getFirst().bounds());
+        assertEquals(142, thumb.bounds().x());
+        assertSame(thumb.node(), placed.node());
+        assertEquals(owner.clip(), placed.clip());
+    }
+
+    @Test
+    void preservesAnchorsWithNestedParentTermsAndClearsTheOtherOffsetAxis() {
+        final var thumb = box("thumb", "slider_box", "{\"anchor_from\":\"bottom_right\",\"anchor_to\":\"top_left\"}", 0, 0, 10, 16);
+        final var parent = box("wrapper", "panel", "{}", 120, 30, 40, 20, thumb);
+        final var owner = owner("{\"slider_direction\":\"vertical\",\"slider_inverted\":true,\"slider_value\":0.25,\"slider_box_control\":\"thumb\"}", parent);
+        final var placed = NativeUiSlider.apply(owner).children().getFirst().children().getFirst();
+        assertEquals(160, placed.bounds().x());
+        assertEquals(35, placed.bounds().y());
+    }
+
+    @Test
+    void updatesBothNamedProgressImagesWithoutRewritingTexturesOrNestedSliders() {
+        final var normal = box("normal", "image", "{\"clip_direction\":\"right\",\"texture\":\"tex\"}", 100, 20, 80, 60);
+        final var hover = box("hover", "image", "{\"visible\":false}", 100, 20, 80, 60);
+        final var unrelated = box("", "image", "{}", 100, 20, 80, 60);
+        final var nested = owner("{\"slider_value\":0.75,\"progress_control\":\"normal\"}",
+                box("normal", "image", "{}", 100, 20, 80, 60));
+        final var owner = owner("{\"slider_steps\":5,\"slider_value\":1,\"progress_control\":\"normal\",\"progress_hover_control\":\"hover\"}", normal, hover, unrelated, nested);
+        final var placed = NativeUiSlider.apply(owner);
+        assertEquals(.75F, placed.children().get(0).node().number("clip_ratio", -1));
+        assertEquals(.75F, placed.children().get(1).node().number("clip_ratio", -1));
+        assertEquals(.25F, placed.children().get(3).children().getFirst().node().number("clip_ratio", -1));
+        assertEquals("tex", placed.children().getFirst().node().string("texture", ""));
+        assertEquals("right", placed.children().getFirst().node().string("clip_direction", ""));
+        assertSame(normal.node(), placed.children().getFirst().node());
+        assertSame(normal.node(), NativeUiSlider.apply(owner).children().getFirst().node());
+        assertSame(unrelated.node(), placed.children().get(2).node());
+    }
+
+    @Test
+    void usesFloatHalfStepRoundingAndFullOwnerPointerBounds() {
+        assertEquals(1, NativeUiSlider.stepIndex(Math.nextDown(.25F), 3));
+        assertEquals(0, NativeUiSlider.stepIndex(1, 1));
+        assertThrows(IllegalArgumentException.class, () -> NativeUiSlider.stepIndex(0, 0));
+        final var owner = owner("{\"slider_steps\":5,\"slider_inverted\":true}");
+        assertEquals(1, NativeUiSlider.pointerFraction(owner, 0, 0));
+        assertEquals(0, NativeUiSlider.pointerFraction(owner, 200, 0));
+        assertEquals(.75F, NativeUiSlider.pointerFraction(owner, 120, 0));
+        assertEquals(.5F, NativeUiSlider.pointerFraction(owner, 140, 0));
+        assertEquals(.25F, NativeUiSlider.fraction(owner("{\"slider_steps\":5,\"slider_value\":1}").node()));
+        assertEquals(.25F, NativeUiSlider.fraction(owner("{\"slider_steps\":1,\"slider_value\":0.25}").node()));
+        assertThrows(IllegalArgumentException.class, () -> NativeUiSlider.stepIndex(Float.NaN, 3));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_SLIDER_PLACEMENT", matches = ".+")
+    void matchesOriginalNativePointerAndThumbControls() throws Exception {
+        final var directory = Path.of(System.getenv("STACKANVIL_SLIDER_PLACEMENT"));
+        final var pointers = JsonParser.parseString(Files.readString(directory.resolve("native-slider-pointer-probe-result.json"))).getAsJsonObject();
+        for (final var entry : pointers.getAsJsonArray("rows")) {
+            final var row = entry.getAsJsonObject();
+            final boolean vertical = row.get("direction").getAsInt() == 1;
+            final var owner = box("owner", "slider", "{\"slider_direction\":\"%s\",\"slider_inverted\":%s,\"slider_steps\":%d}"
+                    .formatted(vertical ? "vertical" : "horizontal", row.get("reverse").getAsInt() != 0, row.get("steps").getAsInt()),
+                    100, 200, 80, 60);
+            final float coordinate = row.get("actualPointer").getAsFloat();
+            assertEquals(row.get("fraction").getAsFloat(), NativeUiSlider.pointerFraction(owner,
+                    vertical ? 0 : coordinate, vertical ? coordinate : 0));
+        }
+        final var geometry = JsonParser.parseString(Files.readString(directory.resolve("native-slider-geometry-probe-result.json"))).getAsJsonObject();
+        for (final var entry : geometry.getAsJsonArray("rows")) {
+            final var row = entry.getAsJsonObject();
+            final boolean vertical = row.get("direction").getAsInt() == 1;
+            final var thumb = box("thumb", "slider_box", "{}", 135, 42, 10, 16);
+            final var owner = owner("{\"slider_direction\":\"%s\",\"slider_inverted\":%s,\"slider_value\":%s,\"slider_box_control\":\"thumb\"}"
+                    .formatted(vertical ? "vertical" : "horizontal", row.get("reverse").getAsInt() != 0, row.get("fraction")), thumb);
+            final var terms = row.getAsJsonArray("offsetTerms").get(vertical ? 1 : 0).getAsJsonArray();
+            final float relative = terms.get(0).getAsJsonArray().get(1).getAsFloat();
+            final float pixels = terms.get(1).getAsJsonArray().get(1).getAsFloat();
+            final var placed = NativeUiSlider.apply(owner).children().getFirst().bounds();
+            final float expected = vertical ? 20 + 30 - 8 + relative * 60 - pixels : 100 + 40 - 5 + relative * 80 - pixels;
+            assertEquals(expected, vertical ? placed.y() : placed.x());
+        }
+    }
+
+    private static NativeUiLayout.Box owner(final String properties, final NativeUiLayout.Box... children) {
+        return box("owner", "slider", properties, 100, 20, 80, 60, children);
+    }
+
+    private static NativeUiLayout.Box box(final String name, final String type, final String properties,
+                                            final float x, final float y, final float width, final float height,
+                                            final NativeUiLayout.Box... children) {
+        final var nodes = List.of(children).stream().map(NativeUiLayout.Box::node).toList();
+        final var node = new NativeUiScene.Node(name, type, JsonParser.parseString(properties).getAsJsonObject(), nodes, Integer.MIN_VALUE);
+        final var bounds = new NativeUiLayout.Rect(x, y, width, height);
+        return new NativeUiLayout.Box(node, bounds, new NativeUiLayout.Rect(0, 0, 1000, 1000),
+                new NativeUiLayout.Size(width, height), bounds, 0, List.of(children));
+    }
+}
