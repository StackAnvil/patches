+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.viaversion.viafabricplus.bedrock.render.BedrockGuiActorContext;
+import java.util.List;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiActorCameraTest {
+    @Test
+    void projectsConvertedVerticesThroughTheCapturedNativeNpcMatrix() {
+        // build 51061372, protocol 2193. Native camera entry and exit matrices, 145543ce0..145544289.
+        final var control = new NativeUiLayout.Rect(88, 58, 80, 144);
+        final var offsets = offsets();
+        final var nativeMatrix = new Matrix4f().set(new float[] {
+            53.2939148F, 0, -30.7692604F, 0, 0, -61.5385132F, 0, 0,
+            30.7692604F, 0, 53.2939148F, 0, 121, 222.7384644F, -495, 1
+        });
+        for (final var viewport : List.of(new NativeUiLayout.Rect(0, 0, 480, 270),
+                new NativeUiLayout.Rect(88, 58, 80, 96), new NativeUiLayout.Rect(95, 80, 50, 40))) {
+            final var camera = NativeUiActorCamera.resolve(control, viewport, 5, .6F, 2.099998474F, .6F,
+                8, new JsonObject(), offsets, 0);
+            final var pose = new PoseStack();
+            pose.translate((viewport.x() + viewport.width() / 2) * 8,
+                (viewport.y() + viewport.height() / 2) * 8, 0);
+            pose.scale(camera.scale() * 8, camera.scale() * 8, -camera.scale() * 8);
+            BedrockGuiActorContext.correctPose(pose, camera.scale(), 8);
+            pose.translate(camera.translation().x, camera.translation().y, camera.translation().z);
+            pose.mulPose(camera.modelTransform());
+            for (final var vertex : List.of(new Vector3f(-4, 34, -4), new Vector3f(4, 24, 4),
+                    new Vector3f(-4, 0, -2), new Vector3f(4, 12, 2))) {
+                final var expected = nativeMatrix.transformPosition(new Vector3f(vertex).div(16));
+                final var converted = new Vector3f(vertex.x / 16, 1.5F - vertex.y / 16, vertex.z / 16);
+                final var projected = pose.last().pose().transformPosition(converted);
+                assertEquals(expected.x * 8, projected.x, .002F);
+                assertEquals(expected.y * 8, projected.y, .002F);
+                assertEquals(-expected.z, projected.z, .001F);
+            }
+        }
+    }
+
+    @Test
+    void preservesPhysicalPortraitProjectionAcrossJavaHudScales() {
+        final var control = new NativeUiLayout.Rect(100, 70, 80, 144);
+        final var clip = new NativeUiLayout.Rect(100, 94, 80, 96);
+        Vector3f reference = null;
+        for (final int javaScale : new int[] {1, 2, 4}) {
+            final var viewport = NativeUiViewport.desktop(854, 480, 0, javaScale);
+            final var camera = NativeUiActorCamera.resolve(control, clip, 5, .6F, 2.1F, .6F,
+                viewport.scale(), new JsonObject(), offsets(), 0);
+            final var pose = new PoseStack();
+            pose.translate((clip.x() + clip.width() / 2) * viewport.scale(),
+                (clip.y() + clip.height() / 2) * viewport.scale(), 0);
+            final float textureScale = camera.scale() * viewport.renderScale() * javaScale;
+            pose.scale(textureScale, textureScale, -textureScale);
+            BedrockGuiActorContext.correctPose(pose, camera.scale() * viewport.renderScale(), javaScale);
+            pose.translate(camera.translation().x, camera.translation().y, camera.translation().z);
+            pose.mulPose(camera.modelTransform());
+            final var projected = pose.last().pose().transformPosition(new Vector3f(0, -.5F, 0));
+            if (reference == null) reference = projected;
+            else assertTrue(reference.equals(projected, .0001F));
+        }
+    }
+
+    @Test
+    void keepsGuiScaleCorrectionIndependentOfBoundingBoxFittingAndHonorsProperties() {
+        final var control = new NativeUiLayout.Rect(0, 0, 80, 156);
+        final var viewport = new NativeUiLayout.Rect(0, 0, 100, 100);
+        for (final int guiScale : new int[] {1, 2, 4, 8}) {
+            final var ordinary = NativeUiActorCamera.resolve(control, viewport, 5, 1, 2, 1,
+                guiScale, new JsonObject(), offsets(), 0);
+            final var larger = NativeUiActorCamera.resolve(control, viewport, 5, 1, 4, 1,
+                guiScale, new JsonObject(), offsets(), 0);
+            assertEquals(ordinary.scale() / 2, larger.scale());
+            assertEquals(ordinary.translation().y * ordinary.scale(), larger.translation().y * larger.scale(), .0001F);
+            final var properties = new JsonObject();
+            properties.addProperty("translate_y", 70);
+            final var moved = NativeUiActorCamera.resolve(control, viewport, 5, 1, 2, 1,
+                guiScale, properties, offsets(), 30);
+            assertEquals(-20 / moved.scale(), moved.translation().y - ordinary.translation().y, .0001F);
+            assertNotEquals(ordinary.modelTransform(), moved.modelTransform());
+        }
+        assertThrows(IllegalArgumentException.class, () -> NativeUiActorCamera.resolve(control, viewport, 5,
+            0, 2, 1, 1, new JsonObject(), offsets(), 0));
+    }
+
+    private static JsonObject offsets() {
+        final var offsets = new JsonObject();
+        final var scale = new JsonArray();
+        for (int axis = 0; axis < 3; axis++) scale.add(1.75F);
+        offsets.add("scale", scale);
+        final var translation = new JsonArray();
+        translation.add(-7); translation.add(50); translation.add(0);
+        offsets.add("translate", translation);
+        return offsets;
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiActorPortraitsTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiActorPortraitsTest.java
