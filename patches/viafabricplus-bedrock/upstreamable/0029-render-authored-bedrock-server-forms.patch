+import org.joml.Matrix4f;
+import org.joml.Matrix4fc;
+
+/** GUI-only geometry submission. Neither Java mannequins nor world playback supply its appearance. */
+public final class BedrockGuiActorRenderer extends EntityRenderer<Entity, BedrockGuiActorRenderer.State> {
+    private final Map<ModelKey, Model<EntityRenderState>> models = new HashMap<>();
+    private final Map<String, Identifier> textures = new HashMap<>();
+    private Object generation;
+    private final String textureRoot = "gui_actors/" + java.util.UUID.randomUUID() + "/";
+
+    public BedrockGuiActorRenderer(final EntityRendererProvider.Context context) { super(context); }
+    @Override public State createRenderState() { return new State(); }
+
+    public void clear() {
+        this.textures.values().forEach(Minecraft.getInstance().getTextureManager()::release);
+        this.textures.clear();
+        this.models.clear();
+        this.generation = null;
+    }
+
+    public State extract(final BedrockGuiActorAppearance appearance, final BedrockGuiActorAppearance.Frame frame,
+                         final Matrix4fc modelTransform, final float opacity) throws IOException {
+        if (!Float.isFinite(opacity) || opacity < 0 || opacity > 1)
+            throw new IllegalArgumentException("Invalid native portrait opacity");
+        if (this.generation != appearance.resourceGeneration()) {
+            this.clear();
+            this.generation = appearance.resourceGeneration();
+        }
+        final var state = new State();
+        state.pose = frame.pose();
+        state.visibility = frame.visibility();
+        state.modelTransform.set(modelTransform).translate(0, 1.5F, 0)
+            .scale(frame.scale().x(), frame.scale().y(), frame.scale().z()).translate(0, -1.5F, 0);
+        state.color = (Math.round(opacity * 255) << 24) | 0xFFFFFF;
+        state.lightCoords = 0xF000F0;
+        final List<Draw> draws = new ArrayList<>();
+        for (final var surface : frame.draws().surfaces()) {
+            final var geometry = appearance.model(surface.geometry());
+            final var key = new ModelKey(surface.geometry(), surface.visibility());
+            final var model = this.models.computeIfAbsent(key, _ -> BedrockGeometry.entityModel(geometry,
+                geometry.getParents().stream().map(parent -> parent.getName())
+                    .filter(name -> visible(surface.visibility(), name)).collect(java.util.stream.Collectors.toSet())));
+            final var material = appearance.materials().alphaTest(surface.material())
+                .orElseThrow(() -> new IOException("Unsupported native GUI actor material " + surface.material()));
+            final var uv = surface.uv();
+            final var type = BedrockActorRenderTypes.createGui(this.texture(appearance, surface.texture()), material.cull(),
+                surface.ignoreLighting(), material.emissive(), surface.lightMultiplier(),
+                new BedrockActorUvTransform(uv.offsetX(), uv.offsetY(), uv.scaleX(), uv.scaleY()));
+            draws.add(new Draw(model, type));
+        }
+        state.draws = List.copyOf(draws);
+        BedrockGuiActorContext.extracted(state);
+        return state;
+    }
+
+    private static boolean visible(final List<com.viaversion.viafabricplus.bedrock.appearance.BedrockPlayerControllers.Visibility> rules, final String name) {
+        boolean visible = true;
+        for (final var rule : rules) if (rule.matches(name)) visible = rule.visible();
+        return visible;
+    }
+
+    private Identifier texture(final BedrockGuiActorAppearance appearance, final String path) throws IOException {
+        final var cached = this.textures.get(path);
+        if (cached != null) return cached;
+        final var image = appearance.image(path);
+        final var pixels = new NativeImage(image.getWidth(), image.getHeight(), false);
+        for (int y = 0; y < image.getHeight(); y++) for (int x = 0; x < image.getWidth(); x++) {
+            final int argb = image.getRGB(x, y);
+            pixels.setPixelABGR(x, y, (argb & 0xFF00FF00) | ((argb & 0xFF) << 16) | ((argb >>> 16) & 0xFF));
+        }
+        final var id = Identifier.fromNamespaceAndPath("viafabricplus-bedrock", this.textureRoot + this.textures.size());
+        Minecraft.getInstance().getTextureManager().register(id, new DynamicTexture(id::toString, pixels));
+        this.textures.put(path, id);
+        return id;
+    }
+
+    @Override
+    public void submit(final State state, final PoseStack pose, final SubmitNodeCollector nodes, final CameraRenderState camera) {
+        pose.pushPose();
+        try {
+            pose.mulPose(state.modelTransform);
+            for (final var draw : state.draws)
+                nodes.submitModel(draw.model(), state, pose, draw.type(), state.lightCoords, OverlayTexture.NO_OVERLAY, state.color, null, 0);
+        } finally {
+            pose.popPose();
+        }
+    }
+
+    public static final class State extends EntityRenderState implements BedrockAnimatedEntityState {
+        private Map<String, BedrockBoneAnimation.Transform> pose = Map.of();
+        private BedrockActorAnimation.Visibility visibility = BedrockActorAnimation.Visibility.UNSPECIFIED;
+        private final Matrix4f modelTransform = new Matrix4f();
+        private List<Draw> draws = List.of();
+        private int color = -1;
+        @Override public Map<String, BedrockBoneAnimation.Transform> pose() { return this.pose; }
+        @Override public BedrockActorAnimation.Visibility visibility() { return this.visibility; }
+    }
+
+    private record ModelKey(String geometry, List<com.viaversion.viafabricplus.bedrock.appearance.BedrockPlayerControllers.Visibility> visibility) {}
+    private record Draw(Model<EntityRenderState> model, RenderType type) {}
+}
