+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockGuiActorAppearanceTest {
+    @Test
+    void samplesVariantSelectionAndPoseInSeparatePersistentPerspectives() throws Exception {
+        final var library = BedrockResourceLibrary.read(Map.of(
+            "library/vanilla/entity/probe.json", bytes("""
+                {"minecraft:client_entity":{"description":{"identifier":"test:probe",
+                 "materials":{"default":"npc"},"geometry":{"default":"geometry.probe"},
+                 "textures":{"first":"textures/first","second":"textures/second"},
+                 "animations":{"pose":"animation.probe"},"scripts":{"initialize":["v.counter=0;"],
+                   "pre_animation":["v.counter=v.counter+1;"],"animate":["pose"]},
+                 "render_controllers":["controller.render.probe"]}}}
+                """),
+            "library/vanilla/animations/probe.json", bytes("""
+                {"animations":{"animation.probe":{"loop":true,"bones":{"head":{
+                  "position":["v.counter",0,0],"rotation":["q.target_x_rotation","q.target_y_rotation",0]}}}}}
+                """),
+            "library/vanilla/render_controllers/probe.json", bytes("""
+                {"render_controllers":{"controller.render.probe":{
+                  "arrays":{"textures":{"Array.skins":["Texture.first","Texture.second"]}},
+                  "geometry":"Geometry.default","materials":[{"*":"Material.default"}],
+                  "textures":["Array.skins[q.variant]"],"part_visibility":[{"*":"q.is_in_ui"}]}}}
+                """),
+            "library/vanilla/materials/probe.material", bytes("""
+                {"materials":{"npc:entity_alphatest":{}}}
+                """)));
+        final var first = BedrockGuiActorAppearance.load(library, "test:probe");
+        final var second = BedrockGuiActorAppearance.load(library, "test:probe");
+        try (final var context = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID())) {
+            final var a = sample(context, first, 0, 0);
+            final var b = sample(context, first, 1, 1);
+            final var c = sample(context, second, 0, 1);
+            assertEquals(1, a.pose().get("head").position().x());
+            assertEquals(2, b.pose().get("head").position().x());
+            assertEquals(1, c.pose().get("head").position().x());
+            assertEquals(12, b.pose().get("head").rotation().x());
+            assertEquals(-8, b.pose().get("head").rotation().y());
+            assertNotEquals(a.draws().surfaces().getFirst().texture(), b.draws().surfaces().getFirst().texture());
+            assertEquals(b.draws(), c.draws());
+            assertTrue(b.draws().surfaces().getFirst().visibility().getFirst().visible());
+            assertTrue(first.materials().alphaTest(b.draws().surfaces().getFirst().material()).isPresent());
+        }
+        assertThrows(IllegalStateException.class, () -> first.sample(2, null, 0, 0, 0));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_NPC_ASSETS", matches = ".+")
+    void resolvesEveryLicensedNpcVariantWithItsNativeGeometryTextureAndMaterial() throws Exception {
+        final var library = BedrockBuiltinAssets.load().library();
+        final var appearance = BedrockGuiActorAppearance.load(library, "minecraft:npc");
+        final var selected = new java.util.HashSet<String>();
+        try (final var context = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID())) {
+            for (int variant = 0; variant < 60; variant++) {
+                final var frame = sample(context, appearance, variant / 60F, variant);
+                assertEquals(1, frame.draws().surfaces().size());
+                final var draw = frame.draws().surfaces().getFirst();
+                assertTrue(selected.add(draw.texture()));
+                assertFalse(appearance.model(draw.geometry()).getParents().isEmpty());
+                assertNotNull(appearance.image(draw.texture()));
+                assertTrue(appearance.materials().alphaTest(draw.material()).isPresent());
+                assertFalse(frame.pose().isEmpty());
+            }
+        }
+    }
+
+    private static BedrockGuiActorAppearance.Frame sample(final BedrockGuiActorContext context,
+            final BedrockGuiActorAppearance appearance, final float seconds, final int variant) {
+        context.camera(12, -8);
+        return context.scoped(() -> {
+            try { return appearance.sample(seconds, null, variant, 12, -8); }
+            catch (final IOException error) { throw new java.io.UncheckedIOException(error); }
+        });
+    }
+
+    private static byte[] bytes(final String json) { return json.getBytes(StandardCharsets.UTF_8); }
+}
