+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import java.io.IOException;
+import java.util.HashMap;
+import java.util.Map;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.resources.Identifier;
+
+/** Uses accepted resource-pack textures; opening a form never starts another asset download. */
+final class BedrockFormImages {
+    private final Map<Identifier, Image> images = new HashMap<>();
+
+    Image image(final String texture) {
+        final Identifier id = Identifier.tryParse(texture);
+        if (id == null || !id.getNamespace().equals("viabedrock") || !id.getPath().startsWith("textures/"))
+            throw new IllegalArgumentException("Invalid native form texture");
+        final var resource = Minecraft.getInstance().getResourceManager().getResource(id)
+            .orElseThrow(() -> new IllegalArgumentException("Missing native form texture"));
+        final Image cached = this.images.get(id);
+        if (cached != null && cached.source == resource.source()) return cached;
+        if (!this.images.containsKey(id) && this.images.size() >= 256) throw new IllegalArgumentException("Too many native form textures");
+        try (final var input = resource.open(); final NativeImage pixels = NativeImage.read(input)) {
+            if (pixels.getWidth() > 4096 || pixels.getHeight() > 4096)
+                throw new IllegalArgumentException("Native form texture exceeds size limits");
+            final Image image = new Image(id, pixels.getWidth(), pixels.getHeight(), resource.source());
+            this.images.put(id, image);
+            return image;
+        } catch (final IOException error) {
+            throw new IllegalArgumentException("Could not read native form texture", error);
+        }
+    }
+
+    void draw(final GuiGraphicsExtractor graphics, final BedrockFormLayout.Box box, final int color) {
+        final BedrockFormScene.Node node = box.node();
+        final Image image = this.image(node.string("texture", ""));
+        float width = box.bounds().width(), height = box.bounds().height();
+        final float u = BedrockFormLayout.vector(node, "uv", 0, 0), v = BedrockFormLayout.vector(node, "uv", 1, 0);
+        final float sourceWidth = BedrockFormLayout.vector(node, "uv_size", 0, image.width);
+        final float sourceHeight = BedrockFormLayout.vector(node, "uv_size", 1, image.height);
+        if (sourceWidth <= 0 || sourceHeight <= 0) return;
+        if (node.flag("keep_ratio", false)) {
+            final float scale = Math.min(width / sourceWidth, height / sourceHeight);
+            width = sourceWidth * scale;
+            height = sourceHeight * scale;
+        }
+        final int x = Math.round(box.bounds().x() + (box.bounds().width() - width) / 2);
+        final int y = Math.round(box.bounds().y() + (box.bounds().height() - height) / 2);
+        final String nineKey = node.properties().has("nine_slice") ? "nine_slice" : "nineslice_size";
+        final var slice = node.properties().get(nineKey);
+        if (slice == null) {
+            blit(graphics, image, x, y, Math.round(width), Math.round(height), u, v,
+                Math.round(sourceWidth), Math.round(sourceHeight), color);
+            return;
+        }
+        final float border;
+        if (slice.isJsonArray()) {
+            final var sides = slice.getAsJsonArray();
+            border = sides.size() == 4 ? sides.get(0).getAsFloat() : 0;
+            if (sides.size() == 4) for (int side = 1; side < 4; side++)
+                if (sides.get(side).getAsFloat() != border)
+                    throw new IllegalArgumentException("Unsupported asymmetric native form nine-slice");
+        } else border = slice.isJsonPrimitive() && slice.getAsJsonPrimitive().isNumber() ? slice.getAsFloat() : 0;
+        final float borderX = border, borderY = border;
+        if (!Float.isFinite(borderX) || !Float.isFinite(borderY) || borderX < 0 || borderY < 0)
+            throw new IllegalArgumentException("Invalid native form nine-slice");
+        final float sourceBorderX = Math.min(borderX, sourceWidth / 2), sourceBorderY = Math.min(borderY, sourceHeight / 2);
+        final float targetBorderX = Math.min(sourceBorderX, width / 2), targetBorderY = Math.min(sourceBorderY, height / 2);
+        final float[] sx = {0, sourceBorderX, sourceWidth - sourceBorderX, sourceWidth};
+        final float[] sy = {0, sourceBorderY, sourceHeight - sourceBorderY, sourceHeight};
+        final float[] dx = {0, targetBorderX, width - targetBorderX, width};
+        final float[] dy = {0, targetBorderY, height - targetBorderY, height};
+        for (int row = 0; row < 3; row++) for (int column = 0; column < 3; column++) {
+            blit(graphics, image, x + Math.round(dx[column]), y + Math.round(dy[row]),
+                Math.round(dx[column + 1]) - Math.round(dx[column]), Math.round(dy[row + 1]) - Math.round(dy[row]),
+                u + sx[column], v + sy[row], Math.round(sx[column + 1] - sx[column]),
+                Math.round(sy[row + 1] - sy[row]), color);
+        }
+    }
+
+    private static void blit(final GuiGraphicsExtractor graphics, final Image image, final int x, final int y,
+                             final int width, final int height, final float u, final float v,
+                             final int sourceWidth, final int sourceHeight, final int color) {
+        if (width > 0 && height > 0 && sourceWidth > 0 && sourceHeight > 0)
+            graphics.blit(RenderPipelines.GUI_TEXTURED, image.id, x, y, u, v, width, height,
+                sourceWidth, sourceHeight, image.width, image.height, color);
+    }
+
+    record Image(Identifier id, int width, int height, Object source) {}
+}
