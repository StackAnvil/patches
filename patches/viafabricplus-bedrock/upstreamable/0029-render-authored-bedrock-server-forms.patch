+    private static ContainerUi program() { return program(null); }
+
+    private static ContainerUi program(final Boolean hiddenUnsupported) { return program(hiddenUnsupported, false); }
+
+    private static ContainerUi program(final Boolean hiddenUnsupported, final boolean animated) {
+        final var definitions = new com.viaversion.viaversion.libs.gson.JsonObject();
+        final var root =
+                com.viaversion.viaversion.libs.gson.JsonParser.parseString(
+                                "{\"type\":\"panel\",\"size\":[640,320],\"controls\":[]}")
+                        .getAsJsonObject();
+        if (animated) {
+            final var animation = com.viaversion.viaversion.libs.gson.JsonParser.parseString("""
+                {"anim_type":"offset","from":[0,0],"to":[100,0],"duration":1,"play_event":"screen.entrance_push"}
+                """).getAsJsonObject();
+            final var animationDefinition = new com.viaversion.viaversion.libs.gson.JsonObject();
+            animationDefinition.addProperty("parent", "");
+            animationDefinition.add("value", animation);
+            definitions.add("chest.move", animationDefinition);
+            final var animations = new com.viaversion.viaversion.libs.gson.JsonArray();
+            animations.add("@chest.move");
+            root.add("anims", animations);
+        }
+        final var cell =
+                com.viaversion.viaversion.libs.gson.JsonParser.parseString(
+                                """
+                                {"type":"button","size":[18,18],"button_mappings":[{"from_button_id":"button.menu_select","to_button_id":"button.container_take_all_place_all","mapping_type":"pressed"}]}
+                                """)
+                        .getAsJsonObject();
+        final var cellDefinition = new com.viaversion.viaversion.libs.gson.JsonObject();
+        cellDefinition.addProperty("parent", "");
+        cellDefinition.add("value", cell);
+        definitions.add("chest.cell", cellDefinition);
+        for (final String collection :
+                List.of("container_items", "inventory_items", "hotbar_items")) {
+            final var grid =
+                    com.viaversion.viaversion.libs.gson.JsonParser.parseString(
+                                    """
+                                    {"type":"grid","size":[162,54],"grid_dimensions":[9,3],"grid_item_template":"chest.cell","anchor_from":"top_left","anchor_to":"top_left"}
+                                    """)
+                            .getAsJsonObject();
+            grid.addProperty("collection_name", collection);
+            final var offset = new com.viaversion.viaversion.libs.gson.JsonArray();
+            offset.add(100);
+            offset.add(
+                    collection.equals("container_items")
+                            ? 50
+                            : collection.equals("inventory_items") ? 104 : 158);
+            grid.add("offset", offset);
+            final var control = new com.viaversion.viaversion.libs.gson.JsonObject();
+            control.add(collection, grid);
+            root.getAsJsonArray("controls").add(control);
+        }
+        if (hiddenUnsupported != null) {
+            final var button =
+                    com.viaversion.viaversion.libs.gson.JsonParser.parseString(
+                                    """
+                                    {"type":"button","size":[18,18],"button_mappings":[{"from_button_id":"button.menu_select","to_button_id":"button.unhandled_action","mapping_type":"pressed"}]}
+                                    """)
+                            .getAsJsonObject();
+            button.addProperty("visible", !hiddenUnsupported);
+            final var extra = new com.viaversion.viaversion.libs.gson.JsonObject();
+            extra.add("additional_control", button);
+            root.getAsJsonArray("controls").add(extra);
+        }
+        final var definition = new com.viaversion.viaversion.libs.gson.JsonObject();
+        definition.addProperty("parent", "");
+        definition.add("value", root);
+        definitions.add("chest.panel", definition);
+        final var host = new com.viaversion.viaversion.libs.gson.JsonObject();
+        host.addProperty("parent", "");
+        final var hostValue = new com.viaversion.viaversion.libs.gson.JsonObject();
+        hostValue.addProperty("$screen_content", "chest.panel");
+        host.add("value", hostValue);
+        definitions.add("chest.small_chest_screen", host);
+        definitions.add("chest.small_chest_panel", definition);
+        final var program = new com.viaversion.viaversion.libs.gson.JsonObject();
+        program.add("definitions", definitions);
+        return ContainerUi.fromProgram(program);
+    }
+
+    private static NativeUiPresentation.Draw slot(final int index, final float x, final float y) {
+        final var properties = new JsonObject();
+        properties.addProperty("inventory_slot", index);
