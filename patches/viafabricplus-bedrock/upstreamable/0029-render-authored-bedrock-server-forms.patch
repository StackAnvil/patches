+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.screen.form.BedrockFormScene;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiFontTest {
+    private static final NativeUiLayout.Metrics METRICS = new NativeUiLayout.Metrics() {
+        @Override
+        public NativeUiLayout.Size intrinsic(final NativeUiScene.Node node) {
+            return NativeUiFont.intrinsic(node, 60, 1, 9);
+        }
+
+        @Override
+        public NativeUiLayout.Size constrained(final NativeUiScene.Node node, final float width) {
+            return NativeUiFont.constrained(node, width, Math.ceilDiv(60, NativeUiFont.wrapWidth(node, width)), 9);
+        }
+    };
+
+    @Test
+    void measuresNativeFontSizesAndAuthoredFactorsThroughWrappedStackLayout() {
+        final JsonObject root = node("stack_panel", 30, "100%c");
+        final JsonArray children = new JsonArray();
+        for (final String size : new String[] {"small", "normal", "large", "extra_large"}) {
+            final JsonObject label = node("label", 30, "default");
+            label.addProperty("font_size", size);
+            children.add(label);
+        }
+        root.add("children", children);
+        final var box = layout(root);
+        final float[] heights = {4.5F, 18, 72, 324};
+        float position = 0;
+        for (int i = 0; i < heights.length; i++) {
+            assertEquals(heights[i], box.children().get(i).bounds().height());
+            assertEquals(position, box.children().get(i).bounds().y());
+            position += heights[i];
+        }
+        assertEquals(position, box.bounds().height());
+
+        children.get(3).getAsJsonObject().addProperty("font_scale_factor", .4F);
+        children.get(0).getAsJsonObject().addProperty("font_scale_factor", .64F);
+        final var scaled = layout(root);
+        assertEquals(2.88F, scaled.children().getFirst().bounds().height(), .0001F);
+        assertEquals(57.6F, scaled.children().get(3).bounds().height(), .0001F);
+    }
+
+    @Test
+    void preservesFixedClippingAndZeroSizeWithoutRemappingResponseControls() {
+        final JsonObject root = node("stack_panel", 30, "100%c");
+        final JsonObject large = node("label", 30, 12);
+        large.addProperty("font_size", "large");
+        final JsonObject zero = node("label", "default", "default");
+        zero.addProperty("font_scale_factor", 0);
+        final JsonObject hidden = node("label", 30, 90);
+        hidden.addProperty("font_scale_factor", -1);
+        hidden.addProperty("visible", false);
+        final JsonObject button = node("button", 30, 20);
+        button.addProperty("action", 0);
+        final JsonArray children = new JsonArray();
+        for (final var child : new JsonObject[] {large, zero, hidden, button}) children.add(child);
+        root.add("children", children);
+        final var box = layout(root);
+        assertEquals(12, box.children().getFirst().visibleBounds().height());
+        assertEquals(0, box.children().get(1).bounds().width());
+        assertEquals(0, box.children().get(1).bounds().height());
+        assertEquals(0, box.children().get(2).bounds().height());
+        assertEquals(12, box.children().get(3).bounds().y());
+        assertEquals(0, box.children().get(3).node().action());
+        hidden.addProperty("visible", true);
+        assertThrows(IllegalArgumentException.class, () -> layout(root));
+    }
+
+    @Test
+    void usesNativeNormalFallbackAndPreservesSmallFactorsWithoutClamping() {
+        final JsonObject label = node("label", "default", "default");
+        assertEquals(new NativeUiLayout.Rect(0, 0, 60, 9), layout(label).bounds());
+        label.addProperty("font_size", "unknown");
+        assertEquals(new NativeUiLayout.Rect(0, 0, 60, 9), layout(label).bounds());
+        label.addProperty("font_scale_factor", .0625F);
+        assertEquals(new NativeUiLayout.Rect(0, 0, 3.75F, .5625F), layout(label).bounds());
+    }
+
+    @Test
+    void keepsFractionalFamilyLineAdvancesThroughWrappedStackLayout() {
+        final JsonObject root = node("stack_panel", 30, "100%c");
+        final JsonObject title = node("label", 30, "default");
+        title.addProperty("font_size", "large");
+        title.addProperty("font_line_height", 11.8125F);
+        final JsonObject fallback = node("label", 30, "default");
+        final JsonArray children = new JsonArray();
+        children.add(title);
+        children.add(fallback);
+        root.add("children", children);
+        final var box = layout(root);
+        assertEquals(94.5F, box.children().getFirst().bounds().height());
+        assertEquals(94.5F, box.children().get(1).bounds().y());
+        assertEquals(112.5F, box.bounds().height());
+        assertEquals(11.8125F, NativeUiFont.lineHeight(box.children().getFirst().node(), 9));
+        assertEquals(9, NativeUiFont.lineHeight(box.children().get(1).node(), 9));
+        title.addProperty("font_line_height", -1);
+        assertThrows(IllegalArgumentException.class, () -> layout(root));
+    }
+
+    private static NativeUiLayout.Box layout(final JsonObject root) {
+        root.addProperty("anchor_from", "top_left");
+        root.addProperty("anchor_to", "top_left");
+        final JsonObject scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.add("root", root);
+        final JsonObject fallback = new JsonObject();
+        final JsonArray buttons = new JsonArray();
+        buttons.add(new JsonObject());
+        fallback.add("buttons", buttons);
+        scene.add("fallback", fallback);
+        return new NativeUiLayout(METRICS).layout(BedrockFormScene.parse(scene.toString()).root(), 200, 500, Map.of());
+    }
+
+    private static JsonObject node(final String type, final Object width, final Object height) {
+        final JsonObject node = new JsonObject();
+        node.addProperty("type", type);
+        final JsonArray size = new JsonArray();
+        for (final Object value : new Object[] {width, height}) {
+            if (value instanceof Number number) size.add(number);
+            else size.add(value.toString());
+        }
+        node.add("size", size);
+        return node;
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiImageCacheTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiImageCacheTest.java
new file mode 100644
index 0000000..c782dae
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiImageCacheTest.java
@@ -0,0 +1,142 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.sun.net.httpserver.HttpServer;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayOutputStream;
+import java.net.InetSocketAddress;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import javax.imageio.ImageIO;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiImageCacheTest {
+    @TempDir Path cache;
+
+    @Test
+    void downloadDeduplicatesWithoutBlockingAndLoadsDiskCacheOffline() throws Exception {
+        final byte[] png = png(12, 7);
+        final AtomicInteger requests = new AtomicInteger();
+        final CountDownLatch received = new CountDownLatch(1), release = new CountDownLatch(1);
+        final HttpServer server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        server.createContext("/image", exchange -> {
+            requests.incrementAndGet();
+            received.countDown();
+            try { release.await(5, TimeUnit.SECONDS); } catch (final InterruptedException error) { Thread.currentThread().interrupt(); }
+            exchange.sendResponseHeaders(200, png.length);
+            try (final var output = exchange.getResponseBody()) { output.write(png); }
+        });
+        server.start();
+        try (final var executor = Executors.newFixedThreadPool(2)) {
+            final String url = "http://127.0.0.1:" + server.getAddress().getPort() + "/image";
+            final var images = fixture(executor);
+            final var first = images.load(url);
+            assertSame(first, images.load(url));
+            assertTrue(received.await(5, TimeUnit.SECONDS));
+            assertFalse(first.isDone());
+            release.countDown();
+            final var data = first.get(5, TimeUnit.SECONDS);
+            assertEquals(12, data.width()); assertEquals(7, data.height());
+            assertEquals(1, requests.get());
+            server.stop(0);
+            final var cached = fixture(executor).load(url).get(5, TimeUnit.SECONDS);
+            assertArrayEquals(data.bytes(), cached.bytes());
+            assertEquals(1, requests.get());
+            // A different target version cannot silently reuse the old version's entry.
+            final var other = new NativeUiImageCache(this.cache, "other", http(), executor, uri -> uri.getHost().equals("127.0.0.1"));
+            assertThrows(Exception.class, () -> other.load(url).get(5, TimeUnit.SECONDS));
+        } finally { release.countDown(); server.stop(0); }
+    }
+
+    @Test
+    void enforcesDownloadBoundsRedirectPolicyAndRecoversCorruptCache() throws Exception {
+        final byte[] png = png(3, 2);
+        final AtomicInteger requests = new AtomicInteger();
+        final AtomicInteger retries = new AtomicInteger();
+        final HttpServer server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        server.createContext("/good", exchange -> {
+            requests.incrementAndGet(); exchange.sendResponseHeaders(200, png.length);
+            try (final var output = exchange.getResponseBody()) { output.write(png); }
+        });
+        server.createContext("/retry", exchange -> {
+            if (retries.incrementAndGet() == 1) { exchange.sendResponseHeaders(503, -1); exchange.close(); }
+            else {
+                exchange.sendResponseHeaders(200, png.length);
+                try (final var output = exchange.getResponseBody()) { output.write(png); }
+            }
+        });
+        server.createContext("/redirect", exchange -> {
+            exchange.getResponseHeaders().add("Location", "/good"); exchange.sendResponseHeaders(302, -1); exchange.close();
+        });
+        server.createContext("/badredirect", exchange -> {
+            exchange.getResponseHeaders().add("Location", "file:///unavailable"); exchange.sendResponseHeaders(302, -1); exchange.close();
+        });
+        server.createContext("/large", exchange -> {
+            exchange.sendResponseHeaders(200, NativeUiImageCache.MAX_BYTES + 1L);
+            try (final var output = exchange.getResponseBody()) { output.write(new byte[NativeUiImageCache.MAX_BYTES + 1]); }
+            catch (final java.io.IOException cancelled) { /* The bounded subscriber cancels the oversized stream. */ }
+        });
+        server.start();
+        try (final var executor = Executors.newFixedThreadPool(2)) {
+            final String url = "http://127.0.0.1:" + server.getAddress().getPort();
+            assertEquals(3, fixture(executor).load(url + "/redirect").get(5, TimeUnit.SECONDS).width());
+            assertThrows(Exception.class, () -> fixture(executor).load(url + "/badredirect").get(5, TimeUnit.SECONDS));
+            assertThrows(Exception.class, () -> fixture(executor).load(url + "/large").get(5, TimeUnit.SECONDS));
+            fixture(executor).load(url + "/good").get(5, TimeUnit.SECONDS);
+            try (final var files = Files.list(this.cache.resolve("test"))) {
+                for (final Path file : files.toList()) Files.write(file, new byte[] {0});
+            }
+            assertEquals(2, fixture(executor).load(url + "/good").get(5, TimeUnit.SECONDS).height());
+            assertEquals(3, requests.get());
+            final var retrying = fixture(executor);
+            assertThrows(Exception.class, () -> retrying.load(url + "/retry").get(5, TimeUnit.SECONDS));
+            assertEquals(3, retrying.load(url + "/retry").get(5, TimeUnit.SECONDS).width());
+            assertEquals(2, retries.get());
+        } finally { server.stop(0); }
+    }
+
+    @Test
+    void rejectsUnsafeProductionUrlsAndOversizedDecodedImages() throws Exception {
+        assertTrue(NativeUiImageCache.https(URI.create("https://example.invalid/picture?q=1")));
+        for (final String url : new String[] {"http://example.invalid/picture", "file:///picture", "https://user:pass@example.invalid/picture", "https://example.invalid/picture#fragment", "https:/picture"})
+            assertFalse(NativeUiImageCache.https(URI.create(url)));
+        final var busy = new NativeUiImageCache(this.cache, "test", http(),
+            task -> { throw new java.util.concurrent.RejectedExecutionException(); });
+        assertTrue(busy.load("https://example.invalid/image").isCompletedExceptionally());
+        assertThrows(java.io.IOException.class, () -> NativeUiImageCache.decode(new byte[] {0}));
+        assertThrows(java.io.IOException.class, () -> NativeUiImageCache.decode(png(2049, 1)));
+        try (final var executor = Executors.newSingleThreadExecutor()) {
+            final var production = new NativeUiImageCache(this.cache, "test", http(), executor);
+            assertTrue(production.load("http://127.0.0.1/image").isCompletedExceptionally());
+        }
+    }
+
+    private NativeUiImageCache fixture(final java.util.concurrent.Executor executor) {
+        return new NativeUiImageCache(this.cache, "test", http(), executor,
+            uri -> "http".equals(uri.getScheme()) && "127.0.0.1".equals(uri.getHost()) && uri.getUserInfo() == null);
+    }
+
+    private static HttpClient http() {
+        return HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(1)).followRedirects(HttpClient.Redirect.NEVER).build();
+    }
+
+    private static byte[] png(final int width, final int height) throws Exception {
+        final var bytes = new ByteArrayOutputStream();
+        ImageIO.write(new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB), "png", bytes);
+        return bytes.toByteArray();
+    }
+}
