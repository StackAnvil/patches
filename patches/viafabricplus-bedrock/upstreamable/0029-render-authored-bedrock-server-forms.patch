@@ -0,0 +1,66 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import java.util.Set;
+import java.util.Map;
+import net.raphimc.viabedrock.api.model.NativeHudMessage;
+
+/** One factory instance and its clock; scene replacement does not revive an expired title. */
+final class NativeHudOverlayState {
+    private NativeUiScene scene;
+    private NativeUiAnimations animations;
+    private NativeUiAnimationLifecycle lifecycle;
+    private long elapsed;
+    private int lifetime;
+    private NativeUiLayout.Box layout;
+    private NativeUiLayout.Metrics metrics;
+    private int width, height;
+    private long layoutRevision, imageRevision;
+
+    boolean accept(final NativeHudMessage message) {
+        if (message.scene().isEmpty()) { clear(); return true; }
+        if (!message.restart() && !active()) return false;
+        final var next = NativeUiScene.parse(message.scene(), Set.of());
+        if (message.restart()) {
+            this.elapsed = 0;
+            this.lifecycle = new NativeUiAnimationLifecycle(next.root());
+        } else this.lifecycle.replaceRoot(next.root(), time(0));
+        this.scene = next;
+        this.lifetime = message.ticks();
+        this.animations = this.lifecycle.animations();
+        this.lifecycle.advance(time(0));
+        this.layout = null;
+        if (!active()) clear();
+        return true;
+    }
+
+    boolean active() { return this.scene != null && (this.lifetime == NativeHudMessage.ANIMATION_LIFETIME ? this.lifecycle.active() : this.elapsed < this.lifetime); }
+    NativeUiScene scene() { return this.scene; }
+    NativeUiAnimations animations() { return this.animations; }
+    long time(final float partialTick) { return (long) ((this.elapsed + partialTick) * 50_000_000D); }
+
+    NativeUiLayout.Box layout(final NativeUiLayout.Metrics metrics, final int width, final int height, final long imageRevision) {
+        if (this.layout == null || this.metrics != metrics || this.width != width || this.height != height
+                || this.layoutRevision != this.animations.layoutRevision() || this.imageRevision != imageRevision) {
+            this.layout = new NativeUiLayout(metrics, this.animations).layout(this.scene.root(), width, height, Map.of());
+            this.metrics = metrics;
+            this.width = width;
+            this.height = height;
+            this.layoutRevision = this.animations.layoutRevision();
+            this.imageRevision = imageRevision;
+        }
+        return this.layout;
+    }
+
+    void tick() {
+        if (this.scene == null) return;
+        this.elapsed++;
+        this.lifecycle.advance(time(0));
+        if (!active()) clear();
+    }
+    void clear() { this.scene = null; this.animations = null; this.lifecycle = null; this.layout = null; this.metrics = null; this.elapsed = 0; this.lifetime = 0; }
+}
