@@ -0,0 +1,120 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiText;
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.input.KeyEvent;
+import net.minecraft.client.input.MouseButtonEvent;
+import net.minecraft.network.Connection;
+import net.minecraft.network.chat.Component;
+
+/** Keeps the original form usable when an authored control or asset cannot be rendered. */
+final class BedrockFallbackFormScreen extends Screen {
+    private final Connection owner;
+    private final int formId;
+    private final BedrockFormScene.Fallback form;
+    private final Component content;
+    private final List<Button> buttons = new ArrayList<>();
+    private int scroll, contentHeight, panelWidth;
+    private boolean responded;
+
+    BedrockFallbackFormScreen(final Connection owner, final int formId, final BedrockFormScene.Fallback form) {
+        super(NativeUiText.component(form.title()));
+        this.owner = owner;
+        this.formId = formId;
+        this.form = form;
+        this.content = NativeUiText.component(form.content());
+    }
+
+    @Override
+    protected void init() {
+        this.buttons.clear();
+        this.panelWidth = Math.max(40, Math.min(360, this.width - 32));
+        this.contentHeight = this.font.split(this.content, this.panelWidth).size() * this.font.lineHeight;
+        for (int i = 0; i < this.form.buttons().size(); i++) {
+            final int index = i;
+            this.buttons.add(this.addRenderableWidget(Button.builder(NativeUiText.component(this.form.buttons().get(i)),
+                _ -> this.respond(index)).bounds((this.width - this.panelWidth) / 2, 0, this.panelWidth, 20).build()));
+        }
+        this.position();
+    }
+
+    private int maximumScroll() {
+        return Math.max(0, this.contentHeight + 10 + this.buttons.size() * 24 - Math.max(1, this.height - 60));
+    }
+
+    private void position() {
+        this.scroll = Math.clamp(this.scroll, 0, this.maximumScroll());
+        for (int i = 0; i < this.buttons.size(); i++) {
+            final Button button = this.buttons.get(i);
+            button.setY(36 + this.contentHeight + i * 24 - this.scroll);
+        }
+    }
+
+    @Override
+    public void extractRenderState(final GuiGraphicsExtractor graphics, final int x, final int y, final float delta) {
+        this.extractTransparentBackground(graphics);
+        graphics.text(this.font, this.title, (this.width - this.font.width(this.title)) / 2, 12, 0xFFFFFFFF);
+        graphics.enableScissor(0, 30, this.width, this.height - 24);
+        try {
+            graphics.textWithWordWrap(this.font, this.content, (this.width - this.panelWidth) / 2,
+                30 - this.scroll, this.panelWidth, 0xFFFFFFFF, false);
+            super.extractRenderState(graphics, x, y, delta);
+        } finally {
+            graphics.disableScissor();
+        }
+    }
+
+    @Override
+    public boolean mouseScrolled(final double x, final double y, final double horizontal, final double vertical) {
+        this.scroll -= (int) (vertical * 18);
+        this.position();
+        return true;
+    }
+
+    @Override
+    public boolean keyPressed(final KeyEvent event) {
+        final boolean result = super.keyPressed(event);
+        if (this.getFocused() instanceof Button button) {
+            if (button.getY() < 30) this.scroll += button.getY() - 30;
+            else if (button.getBottom() > this.height - 24) this.scroll += button.getBottom() - (this.height - 24);
+            this.position();
+        }
+        return result;
+    }
+
+    @Override
+    public boolean mouseClicked(final MouseButtonEvent event, final boolean doubleClick) {
+        return event.y() >= 30 && event.y() < this.height - 24 && super.mouseClicked(event, doubleClick);
+    }
+
+    private void respond(final int action) {
+        if (this.responded) return;
+        this.responded = true;
+        BedrockNativeForms.respond(this.owner, this.formId, action);
+        this.minecraft.setScreenAndShow(null);
+    }
+
+    @Override
+    public void onClose() {
+        this.respond(-1);
+    }
+
+    @Override
+    public boolean isPauseScreen() {
+        return false;
+    }
+
+    @Override
+    public void tick() {
+        if (!BedrockNativeForms.current(this.owner)) this.minecraft.setScreenAndShow(null);
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormController.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormController.java
new file mode 100644
index 0000000..ee81a73
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormController.java
@@ -0,0 +1,107 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiController;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.List;
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.Connection;
+
+/** Original form identities and typed values, independent of the shared authored-screen renderer. */
+final class BedrockFormController implements NativeUiController {
+    private final Connection owner;
+    private final int formId;
+    private final BedrockCustomFormState custom;
+    private BedrockFormScene scene;
+    private boolean responded;
+
+    BedrockFormController(final Connection owner, final int formId, final BedrockFormScene scene,
+                          final BedrockCustomFormState custom) {
+        this.owner = owner;
+        this.formId = formId;
+        this.scene = scene;
+        this.custom = custom;
+    }
+
+    @Override
+    public String title() { return this.scene.fallback().title(); }
+
+    @Override
+    public NativeUiScene.Node root() { return this.scene.root(); }
+
+    @Override
+    public void validateVisibleControls() { this.scene.validateVisibleControls(); }
+
+    @Override
+    public void validateResponseControls(final List<NativeUiScene.Node> controls) {
+        if (!this.scene.fallback().buttons().isEmpty() && controls.stream().noneMatch(node -> node.action() >= 0))
+            throw new IllegalArgumentException("Native form has no usable response controls");
+    }
+
+    @Override
+    public boolean current() { return BedrockNativeForms.current(this.owner); }
+
+    @Override
+    public Inputs inputs() { return this.custom; }
+
+    @Override
+    public void refresh() {
+        if (this.custom != null) this.scene = this.custom.scene();
+    }
+
+    @Override
+    public Activation activate(final NativeUiScene.Node node) {
+        if (this.responded) return Activation.STAY;
+        if (this.custom == null) {
+            this.respond(node.action());
+            return Activation.CLOSE;
+        }
+        final String command = node.string("command", "");
+        if (command.equals("cancel") || node.action() == -1) {
+            this.cancel();
+            return Activation.CLOSE;
+        }
+        if (command.equals("submit")) {
+            final var response = this.custom.response();
+            this.responded = true;
+            BedrockNativeForms.respond(this.owner, this.formId, response);
+            return Activation.CLOSE;
+        }
+        if (!node.properties().has("input")) return Activation.STAY;
+        final var input = node.properties().getAsJsonObject("input");
+        final int index = input.get("index").getAsBigDecimal().intValueExact();
+        if (command.equals("expand")) this.custom.expand(index);
+        else if (input.has("option")) this.custom.select(index, input.get("option").getAsBigDecimal().intValueExact());
+        else if (this.custom.type(index).equals("toggle")) this.custom.toggle(index);
+        else if (this.custom.isSlider(index)) this.custom.adjust(index, 1);
+        return Activation.STAY;
+    }
+
+    @Override
+    public void cancel() { this.respond(-1); }
+
+    private void respond(final int action) {
+        if (this.responded) return;
+        this.responded = true;
+        BedrockNativeForms.respond(this.owner, this.formId, action);
+    }
+
+    @Override
+    public void failed(final RuntimeException error) {
+        if (this.responded || !this.current()) return;
+        ViaFabricPlusBedrock.impl().logger().warn("Could not render native form; requesting its ordinary controls", error);
+        this.responded = true;
+        final Minecraft client = Minecraft.getInstance();
+        if (this.custom == null)
+            client.setScreenAndShow(new BedrockFallbackFormScreen(this.owner, this.formId, this.scene.fallback()));
+        else {
+            BedrockNativeForms.fallback(this.owner, this.formId);
+            client.setScreenAndShow(null);
+        }
+    }
+}
