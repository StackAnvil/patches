+        assertTrue(controller.current(connection, menu, 6));
+    }
+
+    @Test
+    void closeReuseDisconnectAndExpiryNeverAdoptContentsForAnotherMenu() {
+        final var connection = new Object();
+        final var menu = new Object();
+        final var replacement = new Object();
+        for (final int failure : new int[] {0, 1, 2}) {
+            final var controller =
+                    new NativeContainerPresentationController<Object, Object, Object>();
+            assertTrue(controller.claim(connection, menu, 6, 6, 1));
+            assertNull(controller.offer(connection, menu, 6, 1, true, 0, new Object()));
+            if (failure == 0) controller.tick(connection, replacement, 6, 1);
+            if (failure == 1) controller.clear();
+            if (failure == 2) controller.tick(connection, menu, 6, 100);
+            assertNull(controller.contents(connection, replacement, 6, 101));
+            assertNull(controller.contents(connection, menu, 6, 102));
+        }
+    }
+
+    @Test
+    void contentsBeforePresentationAndLegacyImmediatePresentationKeepTheirOrder() {
+        final var controller = new NativeContainerPresentationController<Object, Object, Object>();
+        final var connection = new Object();
+        final var menu = new Object();
+        final var presentation = new Object();
+        assertNull(controller.contents(connection, menu, 6, 0));
+        assertTrue(controller.claim(connection, menu, 6, 6, 1));
+        assertSame(presentation, controller.offer(connection, menu, 6, 1, true, 1, presentation));
+        final var replacement = new Object();
+        assertTrue(controller.claim(connection, replacement, 7, 7, 2));
+        assertSame(
+                presentation,
+                controller.offer(connection, replacement, 7, 2, false, 2, presentation));
+    }
+}
