+import net.minecraft.client.renderer.state.gui.pip.PictureInPictureRenderState;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+/** Each native actor perspective retains its own texture until the GUI has drawn its blit. */
+@Mixin(GuiRenderer.class)
+public abstract class MixinNativeUiPictures {
+    @Unique private final Map<BedrockGuiActorContext, GuiEntityRenderer> nativePictures = new IdentityHashMap<>();
+    @Unique private final Set<BedrockGuiActorContext> usedNativePictures = Collections.newSetFromMap(new IdentityHashMap<>());
+
+    @Inject(method = "preparePictureInPicture", at = @At("HEAD"))
+    private void beginNativePictures(final CallbackInfo ci) {
+        this.usedNativePictures.clear();
+    }
+
+    @WrapOperation(method = "preparePictureInPictureState", at = @At(value = "INVOKE", target =
+        "Lnet/minecraft/client/gui/render/pip/PictureInPictureRenderer;prepare(Lnet/minecraft/client/renderer/state/gui/pip/PictureInPictureRenderState;Lnet/minecraft/client/renderer/state/gui/GuiRenderState;Lnet/minecraft/client/renderer/feature/FeatureRenderDispatcher;I)V"))
+    private void prepareNativePicture(final PictureInPictureRenderer<?> renderer, final PictureInPictureRenderState state,
+                                      final GuiRenderState gui, final FeatureRenderDispatcher features, final int scale,
+                                      final Operation<Void> original) {
+        final var context = state instanceof GuiEntityRenderState entity && renderer instanceof GuiEntityRenderer
+                ? BedrockGuiActorContext.frame(entity.renderState()) : null;
+        if (context == null) {
+            original.call(renderer, state, gui, features, scale);
+            return;
+        }
+        this.usedNativePictures.add(context);
+        final var picture = this.nativePictures.computeIfAbsent(context,
+                key -> new GuiEntityRenderer(Minecraft.getInstance().getEntityRenderDispatcher()));
+        picture.prepare((GuiEntityRenderState) state, gui, features, scale);
+    }
+
+    @Inject(method = "preparePictureInPicture", at = @At("TAIL"))
+    private void retireUnusedNativePictures(final CallbackInfo ci) {
+        this.nativePictures.entrySet().removeIf(entry -> {
+            if (this.usedNativePictures.contains(entry.getKey())) return false;
+            entry.getValue().close();
+            return true;
+        });
+    }
+
+    @Inject(method = "close", at = @At("HEAD"))
+    private void closeNativePictures(final CallbackInfo ci) {
+        this.nativePictures.values().forEach(GuiEntityRenderer::close);
+        this.nativePictures.clear();
+        this.usedNativePictures.clear();
+    }
+}
