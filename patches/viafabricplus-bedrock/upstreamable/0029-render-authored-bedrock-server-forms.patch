+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiPresentation;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.List;
+import net.minecraft.SharedConstants;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.client.multiplayer.MultiPlayerGameMode;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.network.Connection;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.entity.EntityEquipment;
+import net.minecraft.world.entity.player.Inventory;
+import net.minecraft.world.inventory.ChestMenu;
+import net.minecraft.world.inventory.ContainerInput;
+import net.minecraft.world.inventory.Slot;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class BedrockNativeContainerScreenTest {
+    @Test
+    void bindsGeometryToActualSlotsAndRetainsVanillaDispatchAuthority() throws Exception {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final var player = mock(LocalPlayer.class);
+        final var inventory = new Inventory(player, new EntityEquipment());
+        final var menu = ChestMenu.threeRows(7, inventory);
+        player.containerMenu = menu;
+        final var connection = mock(Connection.class);
+        when(connection.isConnected()).thenReturn(true);
+        final var listener = mock(ClientPacketListener.class);
+        when(listener.getConnection()).thenReturn(connection);
+        final var game = mock(Minecraft.class);
+        game.player = player;
+        game.gameMode = mock(MultiPlayerGameMode.class);
+        when(game.getConnection()).thenReturn(listener);
+        final var sessionField = BedrockNativeContainers.class.getDeclaredField("SESSION");
+        sessionField.setAccessible(true);
+        @SuppressWarnings("unchecked") final var session = (NativeContainerSession<Connection, ChestMenu>) sessionField.get(null);
+        session.clear();
+        assertTrue(session.accept(connection, menu, 7, 7, 1));
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            final var screen = new BedrockNativeContainerScreen(connection, menu, inventory, Component.empty(), program(), ContainerUi.Kind.CHEST_3_ROWS);
+            screen.prepare(mock(Font.class), 640, 320);
+            final var unsupported = new BedrockNativeContainerScreen(connection, menu, inventory, Component.empty(), program(false), ContainerUi.Kind.CHEST_3_ROWS);
+            assertThrows(IllegalArgumentException.class, () -> unsupported.prepare(mock(Font.class), 640, 320));
+            final var hiddenUnsupported = new BedrockNativeContainerScreen(connection, menu, inventory, Component.empty(), program(true), ContainerUi.Kind.CHEST_3_ROWS);
+            assertDoesNotThrow(() -> hiddenUnsupported.prepare(mock(Font.class), 640, 320));
+            final var minecraft = Screen.class.getDeclaredField("minecraft");
+            minecraft.setAccessible(true);
+            minecraft.set(screen, game);
+            final var geometry = BedrockNativeContainerScreen.class.getDeclaredField("geometry");
+            geometry.setAccessible(true);
+            geometry.set(screen, new NativeContainerGeometry(List.of(slot(4, 210, 90)), menu.slots.size()));
+            assertSame(menu.slots.get(4), screen.nativeHoveredSlot(210, 90));
+            assertTrue(screen.nativeIsHovering(menu.slots.get(4), 227.5, 107.5));
+            assertNull(screen.nativeHoveredSlot(menu.slots.get(4).x, menu.slots.get(4).y));
+            final var dispatch = net.minecraft.client.gui.screens.inventory.AbstractContainerScreen.class
+                .getDeclaredMethod("slotClicked", Slot.class, int.class, int.class, ContainerInput.class);
+            dispatch.setAccessible(true);
+            for (final var input : List.of(ContainerInput.PICKUP, ContainerInput.QUICK_MOVE, ContainerInput.QUICK_CRAFT)) {
+                dispatch.invoke(screen, menu.slots.get(4), 999, 0, input);
+                verify(game.gameMode).handleContainerInput(7, 4, 0, input, player);
+            }
+            assertSame(menu, screen.getMenu());
+            final var replacement = ChestMenu.threeRows(7, inventory);
+            player.containerMenu = replacement;
+            assertNull(screen.nativeHoveredSlot(210, 90));
+            assertFalse(screen.nativeIsHovering(menu.slots.get(4), 210, 90));
+            assertSame(menu, screen.getMenu());
+            assertSame(replacement, player.containerMenu);
+        } finally { session.clear(); }
+    }
+
+    @Test
+    void presentationReplacementNeverLeaksItsSameMenuRemovalGuard() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final var player = mock(LocalPlayer.class);
+        final var inventory = new Inventory(player, new EntityEquipment());
+        final var menu = ChestMenu.threeRows(7, inventory);
+        final var foreign = ChestMenu.threeRows(7, inventory);
+        player.containerMenu = menu;
+        final var game = mock(Minecraft.class);
+        game.player = player;
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            final var screen = new net.minecraft.client.gui.screens.inventory.ContainerScreen(menu, inventory, Component.empty());
+            doAnswer(invocation -> {
+                assertTrue(BedrockNativeContainers.replacing(menu));
+                assertFalse(BedrockNativeContainers.replacing(foreign));
+                throw new IllegalStateException("Screen initialization failed");
+            }).when(game).setScreenAndShow(screen);
+            assertThrows(IllegalStateException.class, () -> BedrockNativeContainers.replace(screen));
+            assertFalse(BedrockNativeContainers.replacing(menu));
+            player.containerMenu = foreign;
+            BedrockNativeContainers.replace(screen);
+            verify(game, times(1)).setScreenAndShow(screen);
+            assertFalse(BedrockNativeContainers.replacing(foreign));
+        }
+    }
+
+    @Test
+    void visibleRequiredRendererGateRejectsUnknownButKeepsHiddenIdentity() {
+        final var properties = new JsonObject();
