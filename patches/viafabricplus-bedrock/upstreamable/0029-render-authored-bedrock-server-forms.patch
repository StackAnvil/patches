+                            && box.node() == this.flightOwner) this.flying(graphics, draw.alpha());
+                    else if (box.node().type().equals("custom")
+                            && custom.equals("live_horse_renderer"))
+                        this.renderer.portrait(graphics, box, mouseX, mouseY, delta, draw.alpha());
+                    else this.renderer.draw(graphics, draw, this.lifecycle.animations());
+                } finally { graphics.disableScissor(); }
+            }
+        } catch (final RuntimeException error) { this.fallback(error); }
+    }
+
+    private void item(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final int mouseX, final int mouseY, final float alpha) {
+        if (box.node().flag("disabled_filter_visible", false))
+            throw new IllegalArgumentException("Unsupported native inactive-item filter");
