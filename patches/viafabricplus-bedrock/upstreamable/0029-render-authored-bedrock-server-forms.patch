@@ -0,0 +1,61 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockFormImageRegionsTest {
+    @Test
+    void preservesNativeAsymmetricSidesAndSubmissionOrder() {
+        final var regions = regions(new BedrockFormLayout.Rect(100, 200, 40, 30), 0, 0);
+        assertEquals(9, regions.size());
+        assertEquals(new BedrockFormImageRegions.Region(100, 200, 103, 204, 0, 0, 3, 4), regions.get(0));
+        assertEquals(new BedrockFormImageRegions.Region(133, 200, 140, 204, 57, 0, 64, 4), regions.get(1));
+        assertEquals(new BedrockFormImageRegions.Region(100, 222, 103, 230, 0, 24, 3, 32), regions.get(2));
+        assertEquals(new BedrockFormImageRegions.Region(133, 222, 140, 230, 57, 24, 64, 32), regions.get(3));
+        assertEquals(new BedrockFormImageRegions.Region(100, 204, 103, 222, 0, 4, 3, 24), regions.get(4));
+        assertEquals(new BedrockFormImageRegions.Region(103, 204, 133, 222, 3, 4, 57, 24), regions.get(8));
+    }
+
+    @Test
+    void retainsSignedInteriorForUndersizedDestinationsAndZerosOnlyZeroAxisBorders() {
+        final var small = regions(new BedrockFormLayout.Rect(100, 200, 5, 4), 0, 0);
+        assertEquals(new BedrockFormImageRegions.Region(100, 200, 103, 204, 0, 0, 3, 4), small.get(0));
+        assertEquals(new BedrockFormImageRegions.Region(98, 196, 105, 204, 57, 24, 64, 32), small.get(3));
+        assertEquals(new BedrockFormImageRegions.Region(103, 204, 98, 196, 3, 4, 57, 24), small.get(8));
+        final var zeroWidth = regions(new BedrockFormLayout.Rect(100, 200, 0, 30), 0, 0);
+        assertEquals(100, zeroWidth.get(0).x1());
+        assertEquals(100, zeroWidth.get(1).x0());
+        assertEquals(4, zeroWidth.get(0).y1() - zeroWidth.get(0).y0());
+        final var zeroHeight = regions(new BedrockFormLayout.Rect(100, 200, 40, 0), 0, 0);
+        assertEquals(200, zeroHeight.get(0).y1());
+        assertEquals(200, zeroHeight.get(2).y0());
+        assertEquals(3, zeroHeight.get(0).x1() - zeroHeight.get(0).x0());
+    }
+
+    @Test
+    void scalesSourceBordersUsingBothMetadataDimensionsWithoutRoundingOrClamping() {
+        final var scaled = regions(new BedrockFormLayout.Rect(100, 200, 40, 30), 128, 64);
+        assertEquals(new BedrockFormImageRegions.Region(100, 200, 103, 204, 0, 0, 1.5F, 2), scaled.get(0));
+        assertEquals(new BedrockFormImageRegions.Region(133, 222, 140, 230, 60.5F, 28, 64, 32), scaled.get(3));
+        assertEquals(regions(new BedrockFormLayout.Rect(100, 200, 40, 30), 0, 0),
+            regions(new BedrockFormLayout.Rect(100, 200, 40, 30), 128, 0));
+    }
+
+    private static List<BedrockFormImageRegions.Region> regions(final BedrockFormLayout.Rect bounds, final int baseWidth, final int baseHeight) {
+        final JsonObject image = new JsonObject();
+        image.addProperty("type", "image");
+        final JsonArray borders = new JsonArray();
+        for (final int value : new int[] {3, 4, 7, 8}) borders.add(value);
+        image.add("nineslice_size", borders);
+        final JsonArray base = new JsonArray(); base.add(baseWidth); base.add(baseHeight); image.add("base_size", base);
+        return BedrockFormImageRegions.regions(new BedrockFormScene.Node("image", "image", image, List.of(), Integer.MIN_VALUE), bounds, 64, 32);
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormLayoutTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormLayoutTest.java
