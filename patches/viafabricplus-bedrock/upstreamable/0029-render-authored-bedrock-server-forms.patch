+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.mojang.blaze3d.platform.InputConstants;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import net.minecraft.SharedConstants;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.StringSplitter;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.input.MouseButtonEvent;
+import net.minecraft.client.input.MouseButtonInfo;
+import net.minecraft.client.sounds.SoundManager;
+import net.minecraft.server.Bootstrap;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeUiSceneScreenInteractionTest {
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @ParameterizedTest
+    @EnumSource(NativeUiController.Activation.class)
+    void preservesDomainActionIndicesAndDoesNotCloseAReplacementScreen(final NativeUiController.Activation activation) throws Exception {
+        final var controller = new Controller(activation);
+        withScreen(controller, (game, screen) -> {
+            assertEquals(3, screen.children().size());
+            final var selected = screen.getChildAt(10, 40).orElseThrow();
+            assertTrue(screen.mouseClicked(event(10, 40), false));
+            assertEquals(List.of(177), controller.responses);
+            if (activation == NativeUiController.Activation.CLOSE) verify(game).setScreenAndShow(null);
+            else verify(game, never()).setScreenAndShow(any());
+            assertEquals(activation == NativeUiController.Activation.STAY ? 1 : 0, controller.refreshes);
+            if (activation == NativeUiController.Activation.STAY)
+                assertSame(selected, screen.getChildAt(10, 40).orElseThrow());
+            assertEquals(0, controller.cancels);
+            assertTrue(controller.validated.stream().anyMatch(node -> node.action() == 177));
+        });
+    }
+
+    @Test
+    void abandonsAStaleConnectionWithoutSendingCancellation() throws Exception {
+        final var controller = new Controller(NativeUiController.Activation.STAY);
+        withScreen(controller, (game, screen) -> {
+            controller.current = false;
+            screen.tick();
+            verify(game).setScreenAndShow(null);
+            assertTrue(controller.responses.isEmpty());
+            assertEquals(0, controller.cancels);
+        });
+    }
+
+    private static void withScreen(final Controller controller, final Interaction interaction) throws Exception {
+        final Font font = mock(Font.class);
+        when(font.getSplitter()).thenReturn(new StringSplitter((c, style) -> 6));
+        final Minecraft game = mock(Minecraft.class);
+        when(game.getSoundManager()).thenReturn(mock(SoundManager.class));
+        final var field = Minecraft.class.getField("font");
+        field.setAccessible(true);
+        field.set(game, font);
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            final var screen = new NativeUiSceneScreen(controller);
+            screen.width = 200;
+            screen.height = 100;
+            screen.init();
+            try {
+                interaction.run(game, screen);
+            } finally {
+                screen.removed();
+            }
+        }
+    }
+
+    private static MouseButtonEvent event(final double x, final double y) {
+        return new MouseButtonEvent(x, y, new MouseButtonInfo(InputConstants.MOUSE_BUTTON_LEFT, 0));
+    }
+
+    private static NativeUiScene.Node root() {
+        final var root = control("panel", 200, 100, 0);
+        final var children = new JsonArray();
+        for (final int index : new int[] {2, 177, -1}) {
+            final var button = control("button", 100, 20, children.size() * 30);
+            button.addProperty("action", index);
+            button.addProperty("default_control", "normal");
+            children.add(button);
+        }
+        root.add("children", children);
+        final var scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.add("root", root);
+        return NativeUiScene.parse(scene.toString(), Set.of()).root();
+    }
+
+    private static JsonObject control(final String type, final int width, final int height, final int y) {
+        final var control = new JsonObject();
+        control.addProperty("name", "repeated_template");
+        control.addProperty("type", type);
+        control.addProperty("anchor_from", "top_left");
+        control.addProperty("anchor_to", "top_left");
+        final var size = new JsonArray();
+        size.add(width);
+        size.add(height);
+        control.add("size", size);
+        final var offset = new JsonArray();
+        offset.add(0);
+        offset.add(y);
+        control.add("offset", offset);
+        return control;
+    }
+
+    private static final class Controller implements NativeUiController {
+        private final Activation activation;
+        private final NativeUiScene.Node root = NativeUiSceneScreenInteractionTest.root();
+        private final List<Integer> responses = new ArrayList<>();
+        private List<NativeUiScene.Node> validated = List.of();
+        private int refreshes, cancels;
+        private boolean current = true;
+
+        private Controller(final Activation activation) { this.activation = activation; }
+        @Override public String title() { return ""; }
+        @Override public NativeUiScene.Node root() { return this.root; }
+        @Override public void validateVisibleControls() { NativeUiScene.validateVisibleControls(this.root, Set.of()); }
+        @Override public void validateResponseControls(final List<NativeUiScene.Node> controls) { this.validated = controls; }
+        @Override public boolean current() { return this.current; }
+        @Override public Activation activate(final NativeUiScene.Node node) {
+            this.responses.add(node.action());
+            return this.activation;
+        }
+        @Override public void cancel() { this.cancels++; }
+        @Override public void failed(final RuntimeException error) { throw error; }
+        @Override public void refresh() { this.refreshes++; }
+    }
+
+    private interface Interaction {
+        void run(Minecraft game, NativeUiSceneScreen screen) throws Exception;
+    }
+}
