+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiText;
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.input.KeyEvent;
+import net.minecraft.client.input.MouseButtonEvent;
+import net.minecraft.network.Connection;
+import net.minecraft.network.chat.Component;
+
+/** Keeps the original form usable when an authored control or asset cannot be rendered. */
+final class BedrockFallbackFormScreen extends Screen {
+    private final Connection owner;
+    private final int formId;
+    private final BedrockFormScene.Fallback form;
+    private final Component content;
+    private final List<Button> buttons = new ArrayList<>();
+    private int scroll, contentHeight, panelWidth;
+    private boolean responded;
+
+    BedrockFallbackFormScreen(final Connection owner, final int formId, final BedrockFormScene.Fallback form) {
+        super(NativeUiText.component(form.title()));
+        this.owner = owner;
+        this.formId = formId;
+        this.form = form;
+        this.content = NativeUiText.component(form.content());
+    }
+
+    @Override
+    protected void init() {
+        this.buttons.clear();
+        this.panelWidth = Math.max(40, Math.min(360, this.width - 32));
+        this.contentHeight = this.font.split(this.content, this.panelWidth).size() * this.font.lineHeight;
+        for (int i = 0; i < this.form.buttons().size(); i++) {
+            final int index = i;
+            this.buttons.add(this.addRenderableWidget(Button.builder(NativeUiText.component(this.form.buttons().get(i)),
+                _ -> this.respond(index)).bounds((this.width - this.panelWidth) / 2, 0, this.panelWidth, 20).build()));
+        }
+        this.position();
+    }
+
+    private int maximumScroll() {
+        return Math.max(0, this.contentHeight + 10 + this.buttons.size() * 24 - Math.max(1, this.height - 60));
+    }
+
+    private void position() {
+        this.scroll = Math.clamp(this.scroll, 0, this.maximumScroll());
+        for (int i = 0; i < this.buttons.size(); i++) {
+            final Button button = this.buttons.get(i);
+            button.setY(36 + this.contentHeight + i * 24 - this.scroll);
+        }
+    }
+
+    @Override
+    public void extractRenderState(final GuiGraphicsExtractor graphics, final int x, final int y, final float delta) {
+        this.extractTransparentBackground(graphics);
+        graphics.text(this.font, this.title, (this.width - this.font.width(this.title)) / 2, 12, 0xFFFFFFFF);
+        graphics.enableScissor(0, 30, this.width, this.height - 24);
+        try {
+            graphics.textWithWordWrap(this.font, this.content, (this.width - this.panelWidth) / 2,
+                30 - this.scroll, this.panelWidth, 0xFFFFFFFF, false);
+            super.extractRenderState(graphics, x, y, delta);
+        } finally {
+            graphics.disableScissor();
+        }
+    }
+
+    @Override
+    public boolean mouseScrolled(final double x, final double y, final double horizontal, final double vertical) {
+        this.scroll -= (int) (vertical * 18);
+        this.position();
+        return true;
+    }
+
+    @Override
+    public boolean keyPressed(final KeyEvent event) {
+        final boolean result = super.keyPressed(event);
+        if (this.getFocused() instanceof Button button) {
+            if (button.getY() < 30) this.scroll += button.getY() - 30;
+            else if (button.getBottom() > this.height - 24) this.scroll += button.getBottom() - (this.height - 24);
+            this.position();
+        }
+        return result;
+    }
+
+    @Override
+    public boolean mouseClicked(final MouseButtonEvent event, final boolean doubleClick) {
+        return event.y() >= 30 && event.y() < this.height - 24 && super.mouseClicked(event, doubleClick);
+    }
+
+    private void respond(final int action) {
+        if (this.responded) return;
+        this.responded = true;
+        BedrockNativeForms.respond(this.owner, this.formId, action);
+        this.minecraft.setScreenAndShow(null);
+    }
+
+    @Override
+    public void onClose() {
+        this.respond(-1);
+    }
+
+    @Override
+    public boolean isPauseScreen() {
+        return false;
+    }
+
+    @Override
+    public void tick() {
+        if (!BedrockNativeForms.current(this.owner)) this.minecraft.setScreenAndShow(null);
+    }
+}
