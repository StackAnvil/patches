+            final var model = NativeUiScroll.model(result, scroll.getOrDefault(node, 0F));
+            if (model != null) result = replace(result, model.originalThumb().node,
+                this.resize(model.originalThumb(), model.thumb(), scroll));
+        }
+        return result;
+    }
+
+    private Box resize(final Box box, final Rect bounds, final Map<NativeUiScene.Node, Float> scroll) {
+        final List<Size> sizes = this.children(box.node, bounds.width, bounds.height);
+        final List<Box> children = new ArrayList<>();
+        for (int i = 0; i < sizes.size(); i++)
+            children.add(this.place(box.node.children().get(i), bounds, sizes.get(i), box.layer, box.clip, scroll, box.node));
+        children.sort(Comparator.comparingDouble(Box::layer));
+        return new Box(box.node, bounds, box.clip, this.content(box.node, sizes, bounds.width, bounds.height),
+            bounds, box.layer, List.copyOf(children));
+    }
+
+    private static Box replace(final Box box, final NativeUiScene.Node target, final Box replacement) {
+        if (box.node == target) return replacement;
+        return new Box(box.node, box.bounds, box.clip, box.content, box.scrollViewport, box.layer,
+            box.children.stream().map(child -> replace(child, target, replacement)).toList());
+    }
+
+    private static Box descendant(final List<Box> children, final String name) {
+        if (name.isEmpty()) return null;
+        for (final Box child : children) {
+            if (child.node.name().equals(name)) return child;
+            final Box nested = descendant(child.children, name);
+            if (nested != null) return nested;
+        }
+        return null;
+    }
+
+    private static Box scrollContent(final Box box, final NativeUiScene.Node content, final float x, final float y, final Rect clip) {
+        if (box.node == content) return translated(box, x, y, clip);
+        return new Box(box.node, box.bounds, box.clip, box.content, box.scrollViewport, box.layer,
+            box.children.stream().map(child -> scrollContent(child, content, x, y, clip)).toList());
+    }
+
+    private static Box translated(final Box box, final float x, final float y, final Rect parentClip) {
+        final Rect bounds = new Rect(box.bounds.x + x, box.bounds.y + y, box.bounds.width, box.bounds.height);
+        final Rect clip = box.node.scroll() || box.node.flag("clips_children", false) ? parentClip.intersect(bounds) : parentClip;
+        final Rect viewport = new Rect(box.scrollViewport.x + x, box.scrollViewport.y + y, box.scrollViewport.width, box.scrollViewport.height);
+        return new Box(box.node, bounds, clip, box.content, viewport, box.layer,
+            box.children.stream().map(child -> translated(child, x, y, clip)).toList());
+    }
+
+    private float constrain(final NativeUiScene.Node node, final int axis, final float size,
+                                   final Measurement environment, final float width, final float height,
+                                   final float content, final float maximum) {
+        final float minimum = dimension(node, "min_size", axis, environment, width, height, content, maximum, 0);
+        final float declaredUpper = dimension(node, "max_size", axis, environment, width, height, content, maximum, LIMIT);
+        final float upper = declaredUpper == 0 ? LIMIT : declaredUpper;
+        return Math.clamp(size, Math.min(minimum, upper), upper);
+    }
+
+    private float dimension(final NativeUiScene.Node node, final String key, final int axis,
+                                   final Measurement environment, final float width, final float height,
+                                   final float content, final float maximum, final float fallback) {
+        final NativeUiDimension dimension = this.dimensionValue(node, key, axis);
+        if (dimension == null) return bounded(fallback);
+        final float parent = axis == 0 ? environment.width : environment.height;
+        final float sibling = axis == 0 ? environment.siblingWidth : environment.siblingHeight;
+        try {
+            final float value = dimension.resolve(parent, content, maximum, width, height, sibling, fallback);
+            // A loose maximum does not request geometry beyond our supported layout range.
+            return bounded(key.equals("max_size") ? Math.min(value, LIMIT) : value);
+        } catch (final IllegalArgumentException error) {
+            throw new IllegalArgumentException("Invalid native UI dimension: " + node.name() + "." + key + "[" + axis + "]", error);
+        }
+    }
+
+    public static float dimension(final JsonElement value, final float parent, final float content, final float maximum) {
+        return dimension(value, parent, content, maximum, parent, parent, maximum, 0);
+    }
+
+    private static float dimension(final JsonElement value, final float parent, final float content, final float maximum,
+                                   final float width, final float height, final float sibling, final float fallback) {
+        return bounded(evaluatedDimension(value, parent, content, maximum, width, height, sibling, fallback));
+    }
+
+    private static float evaluatedDimension(final JsonElement value, final float parent, final float content, final float maximum,
+                                         final float width, final float height, final float sibling, final float fallback) {
+        return NativeUiDimension.parse(value).resolve(parent, content, maximum, width, height, sibling, fallback);
+    }
+
+    private float offset(final NativeUiScene.Node node, final int axis, final float parent, final Size size) {
+        final var dimension = this.dimensionValue(node, "offset", axis);
+        return dimension == null ? 0 : signed(dimension.resolve(parent, 0, 0, size.width, size.height, 0, 0));
+    }
+
+    private boolean contentDimension(final NativeUiScene.Node node, final int axis) {
+        final var size = this.dimensionValue(node, "size", axis);
+        return size != null && (size.uses(NativeUiDimension.Unit.CHILDREN) || size.uses(NativeUiDimension.Unit.MAX_CHILD));
+    }
+
+    public static float vector(final NativeUiScene.Node node, final String key, final int axis, final float fallback) {
+        final JsonElement value = node.properties().get(key);
+        if (value == null || !value.isJsonArray() || value.getAsJsonArray().size() <= axis) return fallback;
+        final float result = value.getAsJsonArray().get(axis).getAsFloat();
+        if (!Float.isFinite(result) || Math.abs(result) > LIMIT) throw new IllegalArgumentException("Invalid native UI vector");
+        return result;
+    }
+
+    private static float bounded(final float value) {
+        return Math.max(0, signed(value));
+    }
+
+    private static float signed(final float value) {
+        if (!Float.isFinite(value) || Math.abs(value) > LIMIT) throw new IllegalArgumentException("Native UI dimension exceeds layout limits");
+        return value;
+    }
+
+    private Grid grid(final NativeUiScene.Node node, final float width, final float height) {
+        if (!node.type().equals("grid")) return new Grid(1, 1, true, false, false);
+        final boolean horizontal = !node.string("grid_fill_direction", "horizontal").equals("vertical");
+        final int count = node.children().size();
+        if (count > 8192) throw new IllegalArgumentException("Native grid exceeds child limits");
+        final boolean explicit = node.properties().has("grid_dimensions");
+        final String rescaling = node.string("grid_rescaling_type", "none");
+        final boolean manual = node.string("grid_item_template", "").isEmpty();
+        int columns = gridCapacity(node, 0, manual);
+        int rows = gridCapacity(node, 1, manual);
+        if (manual && (columns == 0 || rows == 0))
+            throw new IllegalArgumentException("Unsupported zero-capacity manual native grid");
+        final boolean rescaled = !explicit && !manual && (rescaling.equals("horizontal") || rescaling.equals("vertical"));
+        if (manual) {
+            for (final var child : node.children()) {
+                final int[] position = gridPosition(child);
+                try {
+                    Math.addExact(Math.multiplyExact(columns, position[1]), position[0]);
+                } catch (final ArithmeticException error) {
+                    throw new IllegalArgumentException("Native grid index exceeds its range", error);
+                }
+            }
+        }
+        if (rescaled) {
+            float cellWidth = 0, cellHeight = 0;
+            for (final var child : node.children()) {
+                final Size size = this.measure(child, width, height);
+                cellWidth = Math.max(cellWidth, size.width);
+                cellHeight = Math.max(cellHeight, size.height);
+            }
+            if (rescaling.equals("horizontal")) {
+                columns = cellWidth > 0 ? Math.clamp((int) Math.floor(width / cellWidth), 1, 128) : 1;
+                rows = Math.max(1, (int) Math.ceilDiv((long) count, columns));
+            } else {
+                rows = cellHeight > 0 ? Math.clamp((int) Math.floor(height / cellHeight), 1, 4096) : 1;
+                columns = Math.max(1, (int) Math.ceilDiv((long) count, rows));
+            }
+        }
+        if (!manual) {
+            if (horizontal) rows = Math.max(rows, (int) Math.ceilDiv((long) count, columns));
+            else columns = Math.max(columns, (int) Math.ceilDiv((long) count, rows));
+        }
+        return new Grid(columns, rows, horizontal, rescaled, manual);
+    }
+
+    private static int gridCapacity(final NativeUiScene.Node node, final int axis, final boolean manual) {
+        final JsonElement value = node.properties().get("grid_dimensions");
+        if (value == null) return manual ? 0 : 1;
+        if (!value.isJsonArray() || value.getAsJsonArray().size() != 2)
+            throw new IllegalArgumentException("Invalid native grid capacity");
+        final JsonElement count = value.getAsJsonArray().get(axis);
+        if (!count.isJsonPrimitive() || !count.getAsJsonPrimitive().isNumber())
+            throw new IllegalArgumentException("Invalid native grid capacity");
+        try {
+            final int capacity = count.getAsBigDecimal().intValueExact();
+            if (capacity < 0) throw new IllegalArgumentException("Invalid native grid capacity");
+            return manual ? capacity : Math.max(1, capacity);
+        } catch (final ArithmeticException error) {
+            throw new IllegalArgumentException("Invalid native grid capacity", error);
+        }
+    }
+
+    private static int[] gridPosition(final NativeUiScene.Node node) {
+        final JsonElement value = node.properties().get("grid_position");
+        if (value == null) return new int[]{0, 0};
+        if (!value.isJsonArray() || value.getAsJsonArray().size() != 2)
+            throw new IllegalArgumentException("Invalid native grid position");
+        final int[] position = new int[2];
+        for (int axis = 0; axis < position.length; axis++) {
+            final JsonElement coordinate = value.getAsJsonArray().get(axis);
+            if (!coordinate.isJsonPrimitive() || !coordinate.getAsJsonPrimitive().isNumber())
+                throw new IllegalArgumentException("Invalid native grid position");
+            try {
+                position[axis] = coordinate.getAsBigDecimal().intValueExact();
+            } catch (final ArithmeticException error) {
+                throw new IllegalArgumentException("Invalid native grid position", error);
+            }
+            if (position[axis] < 0) throw new IllegalArgumentException("Invalid native grid position");
+        }
+        return position;
+    }
+
+    private record Grid(int columns, int rows, boolean horizontal, boolean rescaled, boolean manual) {
+        int[] position(final NativeUiScene.Node node, final int index) {
+            if (this.manual) return gridPosition(node);
+            return this.horizontal ? new int[]{index % this.columns, index / this.columns}
+                : new int[]{index / this.rows, index % this.rows};
+        }
+    }
+
+    private static float[] anchor(final String name) {
+        return switch (name) {
+            case "top_left" -> new float[]{0, 0};
+            case "top_middle" -> new float[]{.5F, 0};
+            case "top_right" -> new float[]{1, 0};
+            case "left_middle" -> new float[]{0, .5F};
+            case "center" -> new float[]{.5F, .5F};
+            case "right_middle" -> new float[]{1, .5F};
+            case "bottom_left" -> new float[]{0, 1};
+            case "bottom_middle" -> new float[]{.5F, 1};
+            case "bottom_right" -> new float[]{1, 1};
+            default -> throw new IllegalArgumentException("Unsupported native UI anchor");
+        };
+    }
+
+    public interface Metrics {
+        Size intrinsic(NativeUiScene.Node node);
+
+        default Size constrained(final NativeUiScene.Node node, final float width) {
+            return this.intrinsic(node);
+        }
+    }
+
+    private record Measurement(float width, float height, float siblingWidth, float siblingHeight, float defaultWidth, float defaultHeight) {}
+
+    public record Size(float width, float height) {}
+    public record Box(NativeUiScene.Node node, Rect bounds, Rect clip, Size content, Rect scrollViewport, float layer, List<Box> children) {
+        public Rect visibleBounds() {
+            return this.bounds.intersect(this.clip);
+        }
+    }
+
+    public record Rect(float x, float y, float width, float height) {
+        public Rect intersect(final Rect other) {
+            final float left = Math.max(this.x, other.x), top = Math.max(this.y, other.y);
+            return new Rect(left, top, Math.max(0, Math.min(this.x + this.width, other.x + other.width) - left),
+                Math.max(0, Math.min(this.y + this.height, other.y + other.height) - top));
+        }
+
+        public boolean contains(final double x, final double y) {
+            return x >= this.x && y >= this.y && x < this.x + this.width && y < this.y + this.height;
+        }
+    }
+}
