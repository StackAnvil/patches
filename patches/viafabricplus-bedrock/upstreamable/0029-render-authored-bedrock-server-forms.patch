@@ -0,0 +1,942 @@
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.util.IdentityHashMap;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiLayoutTest {
+    @Test
+    void measuresNestedContentAtItsAuthoredWidthWithoutSpeculativeDescendantPasses() {
+        JsonObject root = node("label", "100%", 16);
+        for (int depth = 0; depth < 20; depth++) {
+            final JsonObject parent = node("panel", "100% - 2px", "100%c + 1px");
+            children(parent, root);
+            root = parent;
+        }
+        final int[] calls = {0};
+        final var solver = new NativeUiLayout(_ -> {
+            calls[0]++;
+            return new NativeUiLayout.Size(0, 16);
+        });
+        final var box = solver.layout(scene(root).root(), 360, 240, Map.of());
+        assertEquals(36, box.bounds().height(), .0001F);
+        var leaf = box;
+        while (!leaf.children().isEmpty()) leaf = leaf.children().getFirst();
+        assertEquals(320, leaf.bounds().width());
+        assertTrue(calls[0] < 100, "Each ancestor should pass its resolved width to descendants");
+    }
+
+    @Test
+    void looseMaximumConstraintsRetainBoundedGeometryAndRejectNonFiniteValues() {
+        final JsonObject root = node("panel", 200, 100);
+        final JsonObject child = node("panel", "100% + 3px", "100% + 6px");
+        children(root, child);
+        final var expected = layout(scene(root), 640, 360).children().getFirst().bounds();
+        for (final Object maximum : new Object[]{100000, "100000px", "100000% + 1px"}) {
+            child.add("max_size", pair(maximum, maximum));
+            assertEquals(expected, layout(scene(root), 640, 360).children().getFirst().bounds());
+        }
+        child.add("max_size", pair(Double.POSITIVE_INFINITY, 100000));
+        assertThrows(IllegalArgumentException.class, () -> layout(scene(root), 640, 360));
+        child.add("max_size", pair(100000, 100000));
+        child.add("size", pair(100000, 20));
+        assertThrows(IllegalArgumentException.class, () -> layout(scene(root), 640, 360));
+        child.add("size", pair(20, 20));
+        child.add("offset", pair(100000, 0));
+        assertThrows(IllegalArgumentException.class, () -> layout(scene(root), 640, 360));
+    }
+
+    @Test
+    void excludesIgnoredBranchesFromStackRemaindersAndSiblingMetrics() {
+        final JsonObject ignored = node("panel", 400, 90);
+        ignored.addProperty("ignored", true);
+        children(ignored, node("label", 800, 100));
+        final JsonObject filling = node("panel", "fill", 20);
+        final JsonObject sibling = node("panel", "100%sm", 20);
+        final JsonObject fixed = node("panel", 40, 20);
+        final JsonObject root = node("stack_panel", 200, 20);
+        root.addProperty("orientation", "horizontal");
+        children(root, ignored, filling, fixed);
+        final var scene = scene(root);
+        final var box = layout(scene, 200, 20);
+        assertEquals(0, box.children().getFirst().bounds().width());
+        assertEquals(0, box.children().getFirst().children().getFirst().bounds().height());
+        assertEquals(160, box.children().get(1).bounds().width());
+        assertEquals(0, box.children().get(1).bounds().x());
+        assertEquals(160, box.children().get(2).bounds().x());
+
+        children(root, ignored, sibling, fixed);
+        assertEquals(40, layout(scene(root), 200, 20).children().get(1).bounds().width());
+        ignored.addProperty("ignored", false);
+        assertEquals(400, layout(scene(root), 200, 20).children().get(1).bounds().width());
+    }
+
+    @Test
+    void placesStackChildrenWithoutAnchorsUnlessExplicitlyEnabled() {
+        for (final boolean vertical : new boolean[] {false, true}) {
+            for (final boolean anchored : new boolean[] {false, true}) {
+                final JsonObject stack = node("stack_panel", vertical ? 100 : 372, vertical ? 372 : 100);
+                stack.addProperty("orientation", vertical ? "vertical" : "horizontal");
+                stack.addProperty("use_child_anchors", anchored);
+                final JsonObject first = node("panel", 186, 186);
+                first.remove("anchor_from");
+                first.remove("anchor_to");
+                first.add("offset", pair(7, 11));
+                final JsonObject second = first.deepCopy();
