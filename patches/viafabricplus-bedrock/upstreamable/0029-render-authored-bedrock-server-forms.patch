+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiColorAnimationTest {
+    @Test
+    void interpolatesAllChannelsWithoutClampingUntilImageSubmission() {
+        final var color = track();
+        color.add("from", JsonParser.parseString("[0.125,1,-0.25,0.8]"));
+        color.add("to", JsonParser.parseString("[1.2,0,0.5,0.2]"));
+        color.addProperty("easing", "out_back");
+        final var node = node("image", color);
+        final var animations = new NativeUiAnimations();
+        animations.advance(node, 750_000_000L);
+        // Pinned native updater 144578f30 preserves easing overshoot on all four channels.
+        final var actual = animations.color(node);
+        assertTrue(actual.red() > 1.2F);
+        assertTrue(actual.green() < 0);
+        assertTrue(actual.blue() > .5F);
+        assertTrue(actual.alpha() < .2F);
+        assertEquals(actual.argb(.5F), NativeUiRenderer.imageColor(node, .5F, animations));
+        assertEquals(255, actual.argb(1) >>> 16 & 255);
+        assertEquals(0, actual.argb(1) >>> 8 & 255);
+        assertEquals(1, animations.opacityAt(node, 750_000_000L).current());
+    }
+
+    @Test
+    void retainsColorClockOnBindingRefreshAndRewindsOnlyOnReset() {
+        final var color = track();
+        color.add("from", JsonParser.parseString("[0,1,0,1]"));
+        color.add("to", JsonParser.parseString("[1,0,1,0]"));
+        color.addProperty("play_event", "play");
+        color.addProperty("reset_event", "reset");
+        color.addProperty("next_index", 0);
+        final var node = node("image", color);
+        final var lifecycle = new NativeUiAnimationLifecycle(node);
+        final var animations = lifecycle.animations();
+        animations.event(node, "play", 0);
+        lifecycle.advance(250_000_000);
+        assertEquals(new NativeUiColor(.25F, .75F, .25F, .75F), animations.color(node));
+        final var replacement = new NativeUiScene.Node(node.name(), node.type(), node.properties().deepCopy(), List.of(), node.action());
+        lifecycle.replaceRoot(replacement, 250_000_000);
+        lifecycle.advance(500_000_000);
+        assertEquals(new NativeUiColor(.5F, .5F, .5F, .5F), animations.color(replacement));
+        assertEquals(0x40808080, NativeUiRenderer.imageColor(replacement, .5F, animations));
+        animations.event(replacement, "reset", 500_000_000);
+        lifecycle.advance(1_500_000_000L);
+        assertEquals(new NativeUiColor(0, 1, 0, 1), animations.color(replacement));
+        animations.event(replacement, "play", 1_500_000_000L);
+        lifecycle.advance(2_750_000_000L);
+        assertEquals(new NativeUiColor(.25F, .75F, .25F, .75F), animations.color(replacement));
+    }
+
+    @Test
+    void usesNativeDefaultsForMissingColorChannelsAndMultipliesImageAlphaOnce() {
+        final var color = track();
+        color.add("from", JsonParser.parseString("[0.25,0.5,0.75]"));
+        final var node = node("image", color);
+        final var animations = new NativeUiAnimations();
+        animations.advance(node, 0);
+        assertEquals(new NativeUiColor(.25F, .5F, .75F, 1), animations.color(node));
+        animations.advance(node, 1_000_000_000);
+        assertEquals(NativeUiColor.WHITE, animations.color(node));
+        node.properties().add("color", JsonParser.parseString("[0.25,0.5,0.75,0.5]"));
+        assertEquals(0x404080BF, NativeUiRenderer.imageColor(node, .5F, new NativeUiAnimations()));
+        assertEquals(new NativeUiColor(.85F, .5F, .2F, 1), NativeUiColor.parse(JsonParser.parseString("\"orange\"")));
+        assertThrows(IllegalArgumentException.class, () -> NativeUiColor.parse(JsonParser.parseString("[\"NaN\"]")));
+    }
+
+    @Test
+    void skipsColorTracksWithoutAnImageComponentAndStartsTheirSuccessorAtZero() {
+        final var color = track();
+        final var alpha = new JsonObject();
+        alpha.addProperty("anim_type", "alpha");
+        alpha.addProperty("duration", 1);
+        alpha.addProperty("from", 1);
+        alpha.addProperty("to", 0);
+        color.addProperty("next_index", 1);
+        final var node = node("label", color, alpha);
+        final var roots = new JsonArray();
+        roots.add(0);
+        node.properties().getAsJsonObject("animation_program").add("roots", roots);
+        final var animations = new NativeUiAnimations();
+        assertEquals(1, animations.opacityAt(node, 250_000_000).current());
+        assertNull(animations.color(node));
+        assertEquals(.75F, animations.opacityAt(node, 500_000_000).current());
+    }
+
+    private static JsonObject track() {
+        final var track = new JsonObject();
+        track.addProperty("anim_type", "color");
+        track.addProperty("duration", 1);
+        return track;
+    }
+
+    static NativeUiScene.Node node(final String type, final JsonObject... definitions) {
+        final var properties = new JsonObject();
+        final var tracks = new JsonArray();
+        for (final var definition : definitions) tracks.add(definition.deepCopy());
+        AnimationPrograms.attach(properties, tracks, false);
+        return new NativeUiScene.Node("", type, properties, List.of(), Integer.MIN_VALUE);
+    }
+}
