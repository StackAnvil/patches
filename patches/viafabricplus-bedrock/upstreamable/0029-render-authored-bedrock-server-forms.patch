@@ -0,0 +1,55 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonElement;
+
+/** Image-component RGBA, kept unclamped during native animation interpolation. */
+record NativeUiColor(float red, float green, float blue, float alpha) {
+    static final NativeUiColor WHITE = new NativeUiColor(1, 1, 1, 1);
+
+    static NativeUiColor parse(final JsonElement value) {
+        if (value == null || value.isJsonNull()) return WHITE;
+        if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()) {
+            return switch (value.getAsString()) {
+                case "red" -> new NativeUiColor(1, 0, 0, 1);
+                case "green" -> new NativeUiColor(0, 1, 0, 1);
+                case "blue" -> new NativeUiColor(0, 0, 1, 1);
+                case "purple" -> new NativeUiColor(1, 0, 1, 1);
+                case "cyan" -> new NativeUiColor(0, 1, 1, 1);
+                case "nil" -> new NativeUiColor(0, 0, 0, 0);
+                case "black" -> new NativeUiColor(0, 0, 0, 1);
+                case "yellow" -> new NativeUiColor(1, 1, 0, 1);
+                case "orange" -> new NativeUiColor(.85F, .5F, .2F, 1);
+                case "grey", "gray" -> new NativeUiColor(.5F, .5F, .5F, 1);
+                default -> WHITE;
+            };
+        }
+        if (!value.isJsonArray()) return WHITE;
+        final var channels = value.getAsJsonArray();
+        return new NativeUiColor(channel(channels, 0), channel(channels, 1), channel(channels, 2), channel(channels, 3));
+    }
+
+    private static float channel(final com.google.gson.JsonArray values, final int index) {
+        if (index >= values.size() || values.get(index).isJsonNull()) return 1;
+        final float channel = values.get(index).getAsFloat();
+        if (!Float.isFinite(channel)) throw new IllegalArgumentException("Non-finite native UI color");
+        return channel;
+    }
+
+    NativeUiColor interpolate(final NativeUiColor to, final float factor) {
+        return new NativeUiColor(this.red + (to.red - this.red) * factor,
+            this.green + (to.green - this.green) * factor, this.blue + (to.blue - this.blue) * factor,
+            this.alpha + (to.alpha - this.alpha) * factor);
+    }
+
+    int argb(final float opacity) {
+        return byteChannel(this.alpha * opacity) << 24 | byteChannel(this.red) << 16
+            | byteChannel(this.green) << 8 | byteChannel(this.blue);
+    }
+
+    private static int byteChannel(final float value) { return Math.round(Math.clamp(value, 0, 1) * 255); }
+}
