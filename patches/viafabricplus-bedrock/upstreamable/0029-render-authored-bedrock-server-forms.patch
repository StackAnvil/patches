+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Predicate;
+import java.util.function.Function;
+
+/** Selects authored visual states without removing hidden controls from layout. */
+final class BedrockFormPresentation {
+    private BedrockFormPresentation() {}
+
+    static List<Draw> draws(final BedrockFormLayout.Box root, final Predicate<BedrockFormLayout.Box> hovered) {
+        return draws(root, hovered, node -> new Opacity(node.number("alpha", 1), node.number("alpha", 1)));
+    }
+
+    static List<Draw> draws(final BedrockFormLayout.Box root, final Predicate<BedrockFormLayout.Box> hovered,
+                           final Function<BedrockFormScene.Node, Opacity> opacity) {
+        final List<Draw> result = new ArrayList<>();
+        collect(root, new Opacity(1, 1), true, hovered, opacity, result);
+        return result;
+    }
+
+    private static void collect(final BedrockFormLayout.Box box, final Opacity inheritedAlpha,
+                                final boolean inheritedEnabled, final Predicate<BedrockFormLayout.Box> hovered,
+                                final Function<BedrockFormScene.Node, Opacity> opacity, final List<Draw> result) {
+        final var node = box.node();
+        if (!node.flag("visible", true) || node.flag("ignored", false)) return;
+        final Opacity local = opacity.apply(node);
+        final Opacity alpha = new Opacity(inheritedAlpha.current * Math.clamp(local.current, 0, 1),
+            inheritedAlpha.potential * Math.clamp(local.potential, 0, 1));
+        if (alpha.potential == 0) return;
+        final boolean enabled = inheritedEnabled && node.flag("enabled", true);
+        result.add(new Draw(box, alpha.current, alpha.potential, enabled));
+        final String normal = node.string("default_control", "");
+        final String hover = node.string("hover_control", normal);
+        final String pressed = node.string("pressed_control", normal);
+        final String locked = node.string("locked_control", normal);
+        final String selected = !enabled ? locked : node.interactive() && hovered.test(box) ? hover : normal;
+        for (final var child : box.children()) {
+            final String name = child.node().name();
+            if (!normal.isEmpty() && (name.equals(normal) || name.equals(hover) || name.equals(pressed) || name.equals(locked))
+                && !name.equals(selected)) continue;
+            collect(child, alpha, enabled, hovered, opacity, result);
+        }
+    }
+
+    record Opacity(float current, float potential) {}
+
+    record Draw(BedrockFormLayout.Box box, float alpha, float potential, boolean enabled) {}
+}
