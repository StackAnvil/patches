+        assertEquals(90, box.content().height());
+    }
+
+    @Test
+    void keepsInvisibleSiblingGeometryButSuppressesItsSubtreeAndResponse() {
+        final JsonObject root = node("stack_panel", 100, "100%c");
+        final JsonObject hidden = node("custom", 100, 40);
+        hidden.addProperty("visible", false);
+        final JsonObject hiddenAction = node("button", 100, 20);
+        hiddenAction.addProperty("action", 3);
+        children(hidden, hiddenAction);
+        final JsonObject visibleAction = node("button", 100, 20);
