+    private boolean reveal(final NativeUiLayout.Box box, final NativeUiScene.Node focused) {
+        if (box.node() == focused) return true;
+        for (final var child : box.children()) if (this.reveal(child, focused)) {
+            if (box.node().scroll()) {
+                final var control = find(box, focused);
+                if (control == null) return true;
+                final var bounds = control.bounds();
+                final var viewport = box.scrollViewport().intersect(box.clip());
+                final boolean horizontal = NativeUiScroll.horizontal(box);
+                final float start = horizontal ? bounds.x() : bounds.y(), extent = horizontal ? bounds.width() : bounds.height();
+                final float viewportStart = horizontal ? viewport.x() : viewport.y(), viewportExtent = horizontal ? viewport.width() : viewport.height();
+                final float delta = start < viewportStart ? start - viewportStart
+                    : Math.max(0, start + extent - viewportStart - viewportExtent);
+                if (delta != 0) {
+                    this.scrollAnimation(box.node(), true);
+                    this.scroll.put(box.node(), Math.clamp(this.scroll.getOrDefault(box.node(), 0F) + delta,
+                        0, NativeUiScroll.maximum(box)));
+                    this.layout();
+                }
+            }
+            return true;
+        }
+        return false;
+    }
