+                new NativeUiScene.Node("slot", "button", properties, List.of(), Integer.MIN_VALUE);
+        final var rect = new NativeUiLayout.Rect(x, y, 18, 18);
+        return new NativeUiPresentation.Draw(new NativeUiLayout.Box(node, rect, rect, new NativeUiLayout.Size(18, 18), rect, 0, List.of()), 1, 1, true);
+    }
+}
