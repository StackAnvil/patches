+        assertEquals(model.thumb().height(), model.originalThumb().children().getFirst().bounds().height(), .001F);
+        scroll.put(scene.root(), 200F);
+        final var resized = solver.layout(scene.root(), 320, 150, scroll);
+        final var resizedModel = NativeUiScroll.model(resized, 200);
+        assertEquals(150, resizedModel.maximum());
+        assertEquals(150, resizedModel.offset());
