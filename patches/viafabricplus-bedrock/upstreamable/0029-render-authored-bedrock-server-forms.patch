+    private static BedrockFormLayout.Box layout(final BedrockFormScene scene, final int width, final int height) {
+        return new BedrockFormLayout(_ -> new BedrockFormLayout.Size(0, 0)).layout(scene.root(), width, height, Map.of());
+    }
+
+    private static BedrockFormScene scene(final JsonObject root) {
+        return BedrockFormScene.parse(json(root).toString());
+    }
+
+    private static JsonObject json(final JsonObject root) {
+        final JsonObject value = new JsonObject(), fallback = new JsonObject();
+        value.addProperty("format", 1);
+        value.add("root", root);
+        final JsonArray buttons = new JsonArray();
+        for (int i = 0; i < 10; i++) {
+            final JsonObject button = new JsonObject();
+            button.addProperty("text", Integer.toString(i));
+            buttons.add(button);
+        }
+        fallback.add("buttons", buttons);
+        value.add("fallback", fallback);
+        return value;
+    }
+
+    private static JsonObject node(final String type, final Object width, final Object height) {
+        final JsonObject node = new JsonObject();
+        node.addProperty("type", type);
+        node.addProperty("anchor_from", "top_left");
+        node.addProperty("anchor_to", "top_left");
+        node.add("size", pair(width, height));
+        return node;
+    }
+
+    private static JsonArray pair(final Object first, final Object second) {
+        final JsonArray pair = new JsonArray();
+        for (final Object value : new Object[]{first, second}) {
+            if (value instanceof Number number) pair.add(number);
+            else pair.add(value.toString());
+        }
+        return pair;
+    }
+
+    private static void children(final JsonObject parent, final JsonObject... values) {
+        final JsonArray children = new JsonArray();
+        for (final JsonObject value : values) children.add(value);
+        parent.add("children", children);
+    }
