+
+    @Test
+    void restartsHoverBranchAlphaOnReentryAndPreservesDelay() {
+        final JsonObject root = node("button", 120, 40);
+        root.addProperty("action", 1);
+        root.addProperty("default_control", "default");
+        root.addProperty("hover_control", "hover");
+        final JsonObject normal = node("image", 120, 40), hover = node("image", 120, 40);
+        normal.addProperty("name", "default");
+        hover.addProperty("name", "hover");
+        final JsonObject track = new JsonObject();
+        track.addProperty("anim_type", "alpha");
+        track.addProperty("from", 0);
+        track.addProperty("to", 1);
+        track.addProperty("duration", .1);
+        track.addProperty("delay", .02);
+        track.addProperty("easing", "linear");
+        final JsonArray tracks = new JsonArray();
+        tracks.add(track);
+        hover.add("animation_tracks", tracks);
+        children(root, normal, hover);
+        final var box = layout(scene(root), 320, 200);
+        final var timeline = new NativeUiAnimations();
+        timeline.beginFrame();
+        NativeUiPresentation.draws(box, _ -> true, node -> timeline.opacity(node, 1_000_000_000L));
+        timeline.beginFrame();
+        final var progressed = NativeUiPresentation.draws(box, _ -> true, node -> timeline.opacity(node, 1_070_000_000L));
+        assertEquals(.5F, progressed.getLast().alpha(), .001F);
+        timeline.beginFrame();
+        NativeUiPresentation.draws(box, _ -> false, node -> timeline.opacity(node, 1_080_000_000L));
+        timeline.beginFrame();
+        final var restarted = NativeUiPresentation.draws(box, _ -> true, node -> timeline.opacity(node, 2_000_000_000L));
+        assertEquals(0, restarted.getLast().alpha());
+        assertEquals(1, restarted.getLast().potential());
