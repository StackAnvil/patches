+final class BedrockGuiActorContextTest {
+    @Test
+    void keepsGuiClockAndScriptVariablesSeparateFromWorldAndOtherPortraits() throws Exception {
+        final var graph = BedrockActorAnimation.read(JsonParser.parseString("""
+            {"animations":{"idle":"animation.idle"},"scripts":{
+             "initialize":["v.counter=0;"],"pre_animation":["v.counter=v.counter+1;"],"animate":["idle"]}}
+            """).getAsJsonObject(), Map.of(), JsonParser.parseString("""
+            {"animation.idle":{"loop":true,"bones":{"head":{"position":["v.counter",0,0]}}}}
+            """).getAsJsonObject(), new JsonObject(), "1.10.0");
+        final var world = graph.playback();
+        final var frame = new BedrockActorAnimation.Frame(Map.of("is_in_ui", true), Map.of());
+        final var gui = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        final var other = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        final var guiActor = gui.playback(world);
+        assertNotSame(world, guiActor);
+        assertSame(guiActor, gui.playback(world));
+        assertEquals(1, guiActor.sample(0, frame).get("head").position().x());
+        assertEquals(2, guiActor.sample(1, frame).get("head").position().x());
+        assertEquals(1, world.sample(0, frame).get("head").position().x());
+        assertEquals(1, other.playback(world).sample(0, frame).get("head").position().x());
+        assertNotSame(guiActor, gui.playback(graph.playback()));
+    }
+
+    @Test
+    void correctsPipUniformDepthScaleWithoutChangingWorldOrOrdinaryGuiTransforms() {
+        for (final int guiScale : new int[] {1, 2, 3}) {
+            final var pose = new com.mojang.blaze3d.vertex.PoseStack();
+            pose.translate(40 * guiScale, 65 * guiScale, 0);
+            pose.scale(60 * guiScale, 60 * guiScale, -60 * guiScale);
+            pose.pushPose();
+            BedrockGuiActorContext.correctPose(pose, 60, guiScale);
+            pose.translate(0, 0, -5);
+            final var matrix = pose.last().pose();
+            assertEquals(60 * guiScale, matrix.m00(), .00001F);
+            assertEquals(-60 * guiScale, matrix.m11(), .00001F);
+            assertEquals(1, matrix.m22(), .00001F);
+            assertEquals(-5, matrix.m32(), .00001F);
+            assertEquals(40 * guiScale, matrix.m30(), .00001F);
+            pose.popPose();
+            assertEquals(-60 * guiScale, pose.last().pose().m22(), .00001F);
+        }
+    }
+
+    @Test
+    void retainsGuiEffectsAndRejectsUnimplementedSubmissionInsteadOfPlayingIntoWorld() throws Exception {
+        final var graph = BedrockActorAnimation.read(JsonParser.parseString("{\"sound_effects\":{\"click\":\"gui.click\"}}").getAsJsonObject(),
+                Map.of(), new JsonObject(), new JsonObject(), "1.10.0").playback();
+        final var gui = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        gui.requireSupportedEffects();
+        final var sound = graph.soundCue(new BedrockAnimationSound(0, "click", "head"));
+        gui.sound(sound);
+        assertEquals(java.util.List.of(sound), gui.sounds());
+        assertThrows(IllegalArgumentException.class, gui::requireSupportedEffects);
+        gui.camera(0, 0);
+        gui.requireSupportedEffects();
+    }
+
+    @Test
+    void retiresExtractedFramesAndEquipmentResourcesWithoutTouchingAnotherPerspective() {
+        final var context = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        final var other = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        final var frame = new net.minecraft.client.renderer.entity.state.AvatarRenderState();
+        final var otherFrame = new net.minecraft.client.renderer.entity.state.AvatarRenderState();
+        context.scoped(() -> { BedrockGuiActorContext.extracted(frame); return null; });
+        other.scoped(() -> { BedrockGuiActorContext.extracted(otherFrame); return null; });
+        final Object key = new Object();
+        final Object equipment = context.resource(key, "appearance", Object::new);
+        assertSame(equipment, context.resource(key, "appearance", Object::new));
+        assertNotSame(equipment, context.resource(key, "replacement", Object::new));
+        final Object replacement = context.resource(new Object(), "appearance", Object::new);
+        assertNotSame(equipment, replacement);
+        context.close();
+        assertNull(BedrockGuiActorContext.frame(frame));
+        assertSame(other, BedrockGuiActorContext.frame(otherFrame));
+        assertNotSame(replacement, context.resource(key, "appearance", Object::new));
+        other.close();
+    }
+
+    @Test
+    void restoresNestedGuiContextAfterSubmissionFailure() {
+        final var outer = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        final var inner = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        assertNull(BedrockGuiActorContext.current());
+        outer.scoped(() -> {
+            assertSame(outer, BedrockGuiActorContext.current());
+            assertThrows(IllegalStateException.class, () -> inner.scoped(() -> {
+                assertSame(inner, BedrockGuiActorContext.current());
+                throw new IllegalStateException("submission failed");
+            }));
+            assertSame(outer, BedrockGuiActorContext.current());
+            return null;
+        });
+        assertNull(BedrockGuiActorContext.current());
+    }
+}
