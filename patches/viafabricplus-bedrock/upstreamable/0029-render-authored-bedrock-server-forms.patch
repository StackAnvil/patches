+    @Override
+    public boolean mouseScrolled(final double x, final double y, final double horizontal, final double vertical) {
+        for (final NativeInput input : this.inputs.values()) {
+            if (input instanceof MultilineInput && input.widget().mouseScrolled(x, y, horizontal, vertical)) return true;
+        }
+        final var target = scrolling(this.root, x, y, this.interactive(x, y));
+        if (target == null) return super.mouseScrolled(x, y, horizontal, vertical);
+        final double delta = NativeUiScroll.horizontal(target) && horizontal != 0 ? horizontal : vertical;
+        this.scroll.put(target.node(), Math.clamp(this.scroll.getOrDefault(target.node(), 0F)
+            - (float) delta * target.node().number("scroll_speed", 18), 0, NativeUiScroll.maximum(target)));
+        this.scrollAnimation(target.node(), true);
+        this.layout();
+        return true;
+    }
