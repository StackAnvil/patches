@@ -0,0 +1,79 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+/**
+ * The receiver's real menu lifetime and content-order state, independently testable without a
+ * renderer.
+ */
+final class NativeContainerPresentationController<C, M, P> {
+    private final NativeContainerSession<C, M> session = new NativeContainerSession<>();
+    private NativeContainerPending<C, M, P> pending;
+    private C contentConnection;
+    private M contentMenu;
+
+    boolean claim(
+            final C owner,
+            final M menu,
+            final int currentMenuId,
+            final int messageMenuId,
+            final long sequence) {
+        final boolean accepted =
+                this.session.accept(owner, menu, currentMenuId, messageMenuId, sequence);
+        if (accepted) this.pending = null;
+        return accepted;
+    }
+
+    P offer(
+            final C owner,
+            final M menu,
+            final int menuId,
+            final long sequence,
+            final boolean awaitingContents,
+            final long now,
+            final P presentation) {
+        if (!this.session.current(owner, menu, menuId) || this.session.sequence() != sequence)
+            return null;
+        if (awaitingContents && (this.contentConnection != owner || this.contentMenu != menu)) {
+            this.pending =
+                    new NativeContainerPending<>(owner, menu, menuId, sequence, now, presentation);
+            return null;
+        }
+        return presentation;
+    }
+
+    P contents(final C owner, final M menu, final int menuId, final long now) {
+        this.contentConnection = owner;
+        this.contentMenu = menu;
+        if (this.pending == null) return null;
+        final P result = this.pending.contents(owner, menu, menuId, this.session.sequence(), now);
+        this.pending = null;
+        return this.session.current(owner, menu, menuId) ? result : null;
+    }
+
+    void tick(final C owner, final M menu, final int menuId, final long now) {
+        if (this.pending != null
+                && (!this.session.current(owner, menu, menuId)
+                        || !this.pending.current(
+                                owner, menu, menuId, this.session.sequence(), now)))
+            this.pending = null;
+        if (this.contentMenu != menu || this.contentConnection != owner) {
+            this.contentConnection = null;
+            this.contentMenu = null;
+        }
+    }
+
+    boolean current(final C owner, final M menu, final int menuId) {
+        return this.session.current(owner, menu, menuId);
+    }
+
+    void clear() {
+        this.session.clear();
+        this.pending = null;
+        this.contentConnection = null;
+        this.contentMenu = null;
+    }
+}
