+    @Override
+    public boolean keyPressed(final KeyEvent event) {
+        if (this.controller.inputs() != null && this.getFocused() instanceof Action action && action.node.properties().has("input")
+            && (event.key() == InputConstants.KEY_LEFT || event.key() == InputConstants.KEY_RIGHT)) {
+            this.controller.inputs().adjust(inputIndex(action.node), event.key() == InputConstants.KEY_LEFT ? -1 : 1);
+            this.refreshScene();
+            return true;
+        }
+        if (!(this.getFocused() instanceof NativeInput) && (event.key() == InputConstants.KEY_PAGEUP || event.key() == InputConstants.KEY_PAGEDOWN
+            || event.key() == InputConstants.KEY_HOME || event.key() == InputConstants.KEY_END)) {
+            final var focused = this.getFocused() instanceof Action action ? action.node
+                : this.getFocused() instanceof NativeInput input ? input.node() : null;
+            NativeUiLayout.Box target = this.keyboardScroll(this.root, focused);
+            if (target == null) target = this.keyboardScroll(this.root, null);
+            if (target != null) {
+                final float page = NativeUiScroll.horizontal(target) ? target.scrollViewport().width() : target.scrollViewport().height();
+                final float maximum = NativeUiScroll.maximum(target);
+                final float previous = this.scroll.getOrDefault(target.node(), 0F);
+                final float value = switch (event.key()) {
+                    case InputConstants.KEY_HOME -> 0;
+                    case InputConstants.KEY_END -> maximum;
+                    case InputConstants.KEY_PAGEUP -> previous - page;
+                    default -> previous + page;
+                };
+                this.scrollAnimation(target.node(), true);
+                this.scroll.put(target.node(), Math.clamp(value, 0, maximum));
+                this.layout();
+                return true;
+            }
+        }
+        final boolean result = super.keyPressed(event);
+        this.refreshPendingScene();
+        if (this.getFocused() instanceof Action action) this.reveal(this.root, action.node);
+        else if (this.getFocused() instanceof NativeInput input) this.reveal(this.root, input.node());
+        return result;
+    }
+
+    @Override
+    public boolean charTyped(final CharacterEvent event) {
