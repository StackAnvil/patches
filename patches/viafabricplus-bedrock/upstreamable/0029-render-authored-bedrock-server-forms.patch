+                        preview.stack.isDamageableItem() && preview.stack.isDamaged());
+                props.addProperty("progress_bar_total_amount", preview.stack.getMaxDamage());
+                props.addProperty(
+                        "progress_bar_current_amount",
+                        preview.stack.getMaxDamage() - preview.stack.getDamageValue());
+                final var node = new NativeUiScene.Node(box.node().name(), box.node().type(), props, box.node().children(), box.node().action());
+                progress = new NativeUiLayout.Box(node, box.bounds(), box.clip(), box.content(), box.scrollViewport(), box.layer(), box.children());
+            }
+        }
+        for (final var quad : NativeInventoryProgress.quads(progress, alpha, (float) this.minecraft.getWindow().getGuiScale())) {
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(quad.bounds().x(), quad.bounds().y());
+                graphics.pose().scale(quad.bounds().width(), quad.bounds().height());
+                graphics.fill(0, 0, 1, 1, quad.color().argb());
+            } finally { graphics.pose().popMatrix(); }
+        }
+    }
+
+    private void flying(final GuiGraphicsExtractor graphics, final float alpha) {
+        for (final var frame : this.flights.frames(this.clock.getAsLong())) {
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(frame.x(), frame.y());
+                graphics.pose().scale(frame.scale(), frame.scale());
+                NativeInventoryItemOpacity.extract((IBedrockGuiItemOpacity) graphics, alpha,
+                        () -> graphics.item(frame.stack(), 0, 0));
+            } finally { graphics.pose().popMatrix(); }
+        }
+    }
+
+    private void cursor(final NativeUiLayout.Box box, final boolean inherited) {
+        final boolean cursor = inherited || box.node().flag("follows_cursor", false);
+        if (cursor) this.vanillaCursor.add(box.node());
+        for (final var child : box.children()) this.cursor(child, cursor);
+    }
+
+    private void anchors(final NativeUiLayout.Box box) {
+        final var node = box.node();
+        if (this.flightOwner == null && node.string("renderer", "").equals("flying_item_renderer"))
+            this.flightOwner = node;
+        if (node.properties().has("inventory_slot") && node.properties().has("collection")
+            && box.bounds().width() > 0 && box.bounds().height() > 0)
+            this.anchors.putIfAbsent(node.properties().get("inventory_slot").getAsInt(),
+                new NativeInventoryFlights.Anchor(box.bounds().x(), box.bounds().y(), box.bounds().width() / 16));
+        for (final var child : box.children()) this.anchors(child);
+    }
+
+    @Override
+    protected void slotClicked(final Slot slot, final int index, final int button, final ContainerInput input) {
+        if (!this.current()) return;
+        if (this.actionScope.subset()) return;
+        super.slotClicked(slot, index, button, input);
+        this.refreshSafely();
+    }
+
+    private record Preview(ItemStack stack, String count) {}
+
+    @Override
+    public void extractBackground(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        // The resource-pack scene owns its background, including any world overlay.
+    }
+
+    @Override
+    protected boolean hasClickedOutside(final double x, final double y, final int left, final int top) {
+        return this.root == null || !this.root.bounds().contains(x, y);
+    }
+
+    @Override
+    public boolean mouseScrolled(final double x, final double y, final double horizontal, final double vertical) {
+        if (!this.current()) return false;
+        if (!this.scroll.wheel(this.root, x, y, horizontal, vertical)) return super.mouseScrolled(x, y, horizontal, vertical);
+        this.scrollAnimation(true);
+        this.refreshSafely();
+        return true;
+    }
+
+    @Override
+    public boolean mouseClicked(final MouseButtonEvent event, final boolean doubleClick) {
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.press(this.root, event.x(), event.y())) {
+            this.scrollAnimation(false);
+            this.refreshSafely();
+            return true;
+        }
+        for (final var draw : this.draws.reversed()) if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && draw.enabled() && draw.alpha() > 0
+            && draw.box().node().string("inventory_command", "").equals("close")
+            && draw.box().visibleBounds().contains(event.x(), event.y())) { this.onClose(); return true; }
+        if (this.actionScope.subset()) {
+            if (this.activated && event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+                final int slot = this.geometry.hovered(event.x(), event.y());
+                if (this.actionScope.slots().contains(slot) && this.menu.slots.get(slot).isActive())
+                    this.send(NativeContainerAction.Mode.AUTO_PLACE_ONE, slot);
+            }
+            return true;
+        }
+        return super.mouseClicked(event, doubleClick);
+    }
+
+    @Override
+    public boolean mouseDragged(final MouseButtonEvent event, final double dx, final double dy) {
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.drag(this.root, event.x(), event.y())) {
+            this.scrollAnimation(false);
+            this.refreshSafely();
+            return true;
+        }
+        return this.actionScope.subset() || super.mouseDragged(event, dx, dy);
+    }
+
+    @Override
+    public boolean mouseReleased(final MouseButtonEvent event) {
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.release()) {
+            this.scrollAnimation(true);
+            return true;
+        }
+        return this.actionScope.subset() || super.mouseReleased(event);
+    }
+
+    @Override
+    public boolean keyPressed(final KeyEvent event) {
+        if (!this.current()) return false;
+        if (!this.actionScope.subset()) return super.keyPressed(event);
+        if (event.key() == InputConstants.KEY_ESCAPE
+                || this.minecraft.options.keyInventory.matches(event)) this.onClose();
+        return true;
+    }
+
+    void fallback(final RuntimeException error) {
+        if (this.fallingBack) return;
+        this.fallingBack = true;
+        try {
+            this.deactivate();
+        } catch (final RuntimeException transportError) {
+            if (transportError != error) error.addSuppressed(transportError);
+        } finally {
+            ViaFabricPlusBedrock.impl()
+                    .logger()
+                    .warn(
+                            "Unsupported native inventory presentation; retaining ordinary menu"
+                                    + " controls",
+                            error);
+            if (this.current())
+                BedrockNativeContainers.replace(
+                        new ContainerScreen(
+                                this.menu, this.minecraft.player.getInventory(), this.title));
+        }
+    }
+
+    void discard() { if (this.renderer != null) this.renderer.close(); this.images.close(); }
+
+    @Override
+    public void removed() {
+        try {
+            this.deactivate();
+        } catch (final RuntimeException error) {
+            ViaFabricPlusBedrock.impl()
+                    .logger()
+                    .warn("Unable to retire native inventory activation", error);
+        } finally {
+            try {
+                this.discard();
+            } finally {
+                super.removed();
+            }
+        }
+    }
+}
