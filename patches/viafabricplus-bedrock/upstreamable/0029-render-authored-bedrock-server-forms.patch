@@ -0,0 +1,481 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.mojang.serialization.JsonOps;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.ComponentPath;
+import net.minecraft.client.gui.components.AbstractButton;
+import net.minecraft.client.gui.components.Tooltip;
+import net.minecraft.client.gui.narration.NarrationElementOutput;
+import net.minecraft.client.gui.navigation.FocusNavigationEvent;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.input.InputWithModifiers;
+import net.minecraft.client.input.KeyEvent;
+import net.minecraft.client.input.MouseButtonEvent;
+import net.minecraft.network.Connection;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.ComponentSerialization;
+import net.minecraft.network.chat.FontDescription;
+import net.minecraft.resources.Identifier;
+import com.mojang.blaze3d.platform.InputConstants;
+
+/** Draws the authored scene, with ordinary Java event, focus, narration and response handling. */
+final class BedrockNativeFormScreen extends Screen {
+    private final Connection owner;
+    private final int formId;
+    private final BedrockFormScene scene;
+    private final BedrockFormImages images = new BedrockFormImages();
+    private final BedrockFormAnimations animations = new BedrockFormAnimations();
+    private final Map<BedrockFormScene.Node, Float> scroll = new IdentityHashMap<>();
+    private final Map<BedrockFormScene.Node, Action> actions = new IdentityHashMap<>();
+    private final Map<BedrockFormScene.Node, Component> texts = new IdentityHashMap<>();
+    private BedrockFormLayout.Box root;
+    private boolean responded;
+    private Drag drag;
+    private long imageRevision;
+
+    BedrockNativeFormScreen(final Connection owner, final int formId, final BedrockFormScene scene) {
+        super(BedrockFormText.component(scene.fallback().title()));
+        this.owner = owner;
+        this.formId = formId;
+        this.scene = scene;
+    }
+
+    @Override
+    protected void init() {
+        this.actions.clear();
+        this.drag = null;
+        this.setDragging(false);
+        this.layout();
+        final List<BedrockFormLayout.Box> boxes = new ArrayList<>();
+        flatten(this.root, boxes);
+        boxes.sort(Comparator.comparingDouble(BedrockFormLayout.Box::layer).reversed());
+        for (final var box : boxes) if (box.node().interactive()) {
+            final Action action = this.addWidget(new Action(box));
+            this.actions.put(box.node(), action);
+        }
+        this.synchronize(this.draws(-1, -1));
+        if (!this.scene.fallback().buttons().isEmpty() && this.actions.values().stream()
+            .noneMatch(action -> action.visible && action.eligible && action.node.action() >= 0))
+            throw new IllegalArgumentException("Native form has no usable response controls");
+    }
+
+    private void layout() {
+        this.root = new BedrockFormLayout(new BedrockFormLayout.Metrics() {
+            @Override
+            public BedrockFormLayout.Size intrinsic(final BedrockFormScene.Node node) {
+                return BedrockNativeFormScreen.this.intrinsic(node);
+            }
+
+            @Override
+            public BedrockFormLayout.Size constrained(final BedrockFormScene.Node node, final float width) {
+                if (!node.type().equals("label")) return this.intrinsic(node);
+                final float scale = scale(node);
+                final int lines = BedrockNativeFormScreen.this.font.split(BedrockNativeFormScreen.this.text(node),
+                    Math.max(1, (int) (width / scale))).size();
+                return new BedrockFormLayout.Size(width, lines * BedrockNativeFormScreen.this.font.lineHeight * scale);
+            }
+        }).layout(this.scene.root(), this.width, this.height, this.scroll);
+        this.positionActions(this.root);
+    }
+
+    private BedrockFormLayout.Size intrinsic(final BedrockFormScene.Node node) {
+        return switch (node.type()) {
+            case "label" -> new BedrockFormLayout.Size(this.font.width(this.text(node)) * scale(node),
+                (node.string("text", "").split("\\n", -1).length * this.font.lineHeight) * scale(node));
+            case "image" -> {
+                if (node.string("texture", "").isEmpty()) yield new BedrockFormLayout.Size(0, 0);
+                final var image = this.images.image(node);
+                yield image == null ? new BedrockFormLayout.Size(16, 16) : new BedrockFormLayout.Size(image.width(), image.height());
+            }
+            case "button", "toggle" -> new BedrockFormLayout.Size(200, 20);
+            default -> new BedrockFormLayout.Size(0, 0);
+        };
+    }
+
+    private void positionActions(final BedrockFormLayout.Box box) {
+        final Action action = this.actions.get(box.node());
+        if (action != null) action.place(box);
+        for (final var child : box.children()) this.positionActions(child);
+    }
+
+    @Override
+    public void extractRenderState(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        this.extractTransparentBackground(graphics);
+        try {
+            final List<BedrockFormPresentation.Draw> draws = this.draws(mouseX, mouseY);
+            this.synchronize(draws);
+            draws.sort(Comparator.comparingDouble(draw -> draw.box().layer()));
+            BedrockFormScene.Node tooltip = null;
+            for (final BedrockFormPresentation.Draw draw : draws) {
+                final var box = draw.box();
+                final var clip = box.node().type().equals("label") ? box.visibleBounds() : box.clip();
+                if (draw.enabled() && draw.alpha() > 0 && box.node().type().equals("custom")
+                    && box.node().string("renderer", "").equals("hover_text_renderer")
+                    && !box.node().string("hover_text", "").isEmpty()) tooltip = box.node();
+                if (draw.alpha() <= 0 || box.visibleBounds().width() <= 0 || box.visibleBounds().height() <= 0) continue;
+                graphics.enableScissor(Math.round(clip.x()), Math.round(clip.y()),
+                    Math.round(clip.x() + clip.width()), Math.round(clip.y() + clip.height()));
+                try {
+                    final var node = box.node();
+                    if (node.type().equals("image") && !node.string("texture", "").isEmpty())
+                        this.images.draw(graphics, box, color(node, draw.alpha()));
+                    else if (node.type().equals("label")) this.label(graphics, box, draw.alpha());
+                    final Action action = this.actions.get(node);
+                    if (action != null) action.extractRenderState(graphics, mouseX, mouseY, delta);
+                } finally {
+                    graphics.disableScissor();
+                }
+            }
+            if (tooltip != null) {
+                final Component text = tooltip.properties().has("hover_text_component")
+                    ? ComponentSerialization.CODEC.parse(JsonOps.INSTANCE, tooltip.properties().get("hover_text_component")).getOrThrow()
+                    : BedrockFormText.component(tooltip.string("hover_text", ""));
+                final int maximum = Math.round(tooltip.number("hover_text_max_width", 0));
+                if (maximum > 0) graphics.setTooltipForNextFrame(this.font,
+                    this.font.split(text, Math.max(1, Math.min(maximum, this.width - 16))), mouseX, mouseY);
+                else graphics.setTooltipForNextFrame(this.font, text, mouseX, mouseY);
+            }
+            if (this.images.failed()) graphics.text(this.font,
+                Component.literal("Some menu images could not load."), 8, this.height - this.font.lineHeight - 8,
+                0xFFFFCCCC, true);
+        } catch (final RuntimeException error) {
+            ViaFabricPlusBedrock.impl().logger().warn("Could not draw native form; opening its ordinary controls", error);
+            this.minecraft.setScreenAndShow(new BedrockFallbackFormScreen(this.owner, this.formId, this.scene.fallback()));
+        }
+    }
+
+    private List<BedrockFormPresentation.Draw> draws(final int mouseX, final int mouseY) {
+        this.animations.beginFrame();
+        final long now = System.nanoTime();
+        return BedrockFormPresentation.draws(this.root, box -> {
+            final Action action = this.actions.get(box.node());
+            return action != null && (action.isFocused() || box.visibleBounds().contains(mouseX, mouseY));
+        }, node -> this.animations.opacity(node, now));
+    }
+
+    private void synchronize(final List<BedrockFormPresentation.Draw> draws) {
+        for (final Action action : this.actions.values()) action.visible = false;
+        for (final BedrockFormPresentation.Draw draw : draws) {
+            final Action action = this.actions.get(draw.box().node());
+            if (action != null) {
+                action.visible = true;
+                action.eligible = draw.enabled() && draw.box().bounds().width() > 0 && draw.box().bounds().height() > 0;
+                action.active = action.eligible && draw.alpha() > 0;
+                action.setAlpha(draw.alpha());
+            }
+        }
+    }
+
+    private void label(final GuiGraphicsExtractor graphics, final BedrockFormLayout.Box box, final float alpha) {
+        final var node = box.node();
+        final Component text = this.text(node);
+        final float scale = scale(node);
+        final int width = Math.max(1, (int) (box.bounds().width() / scale));
+        final var lines = this.font.split(text, width);
+        final String alignment = node.string("text_alignment", "left");
+        graphics.pose().pushMatrix();
+        try {
+            graphics.pose().translate(box.bounds().x(), box.bounds().y());
+            graphics.pose().scale(scale, scale);
+            int y = 0;
+            for (final var line : lines) {
+                final int lineWidth = this.font.width(line);
+                final int x = alignment.equals("center") ? (width - lineWidth) / 2 : alignment.equals("right") ? width - lineWidth : 0;
+                graphics.text(this.font, line, x, y, color(node, alpha), node.flag("shadow", false));
+                y += this.font.lineHeight;
+            }
+        } finally {
+            graphics.pose().popMatrix();
+        }
+    }
+
+    private Component text(final BedrockFormScene.Node node) {
+        return this.texts.computeIfAbsent(node, value -> {
+            final Component text = value.properties().has("text_component")
+                ? ComponentSerialization.CODEC.parse(JsonOps.INSTANCE,
+                    value.properties().get("text_component")).getOrThrow()
+                : value.flag("localize", false) ? Component.translatable(value.string("text", ""))
+                    : BedrockFormText.component(value.string("text", ""));
+            final String font = value.string("font", "");
+            if (font.isEmpty()) return text;
+            return text.copy().withStyle(style -> style.withFont(new FontDescription.Resource(Identifier.parse(font))));
+        });
+    }
+
+    private static float scale(final BedrockFormScene.Node node) {
+        return Math.clamp(node.number("font_scale_factor", 1), .125F, 8);
+    }
+
+    private static int color(final BedrockFormScene.Node node, final float alpha) {
+        final int red = Math.round(Math.clamp(BedrockFormLayout.vector(node, "color", 0, 1), 0, 1) * 255);
+        final int green = Math.round(Math.clamp(BedrockFormLayout.vector(node, "color", 1, 1), 0, 1) * 255);
+        final int blue = Math.round(Math.clamp(BedrockFormLayout.vector(node, "color", 2, 1), 0, 1) * 255);
+        return Math.round(alpha * 255) << 24 | red << 16 | green << 8 | blue;
+    }
+
+    private Map<BedrockFormScene.Node, Boolean> interactive(final double x, final double y) {
+        final Map<BedrockFormScene.Node, Boolean> result = new IdentityHashMap<>();
+        for (final var draw : this.draws((int) x, (int) y)) if (draw.enabled() && draw.alpha() > 0) result.put(draw.box().node(), true);
+        return result;
+    }
+
+    @Override
+    public boolean mouseScrolled(final double x, final double y, final double horizontal, final double vertical) {
+        final var target = scrolling(this.root, x, y, this.interactive(x, y));
+        if (target == null) return super.mouseScrolled(x, y, horizontal, vertical);
+        final double delta = BedrockFormScroll.horizontal(target) && horizontal != 0 ? horizontal : vertical;
+        this.scroll.put(target.node(), Math.clamp(this.scroll.getOrDefault(target.node(), 0F)
+            - (float) delta * target.node().number("scroll_speed", 18), 0, BedrockFormScroll.maximum(target)));
+        this.layout();
+        return true;
+    }
+
+    @Override
+    public boolean mouseClicked(final MouseButtonEvent event, final boolean doubleClick) {
+        if (event.button() == 0) {
+            final var target = scrollbar(this.root, event.x(), event.y(), this.interactive(event.x(), event.y()));
+            if (target != null) {
+                final var model = BedrockFormScroll.model(target, this.scroll.getOrDefault(target.node(), 0F));
+                final float pointer = model.pointer(event.x(), event.y());
+                final float grab = model.containsThumb(event.x(), event.y()) ? pointer - model.start() : model.extent() / 2;
+                this.drag = new Drag(target.node(), grab);
+                this.setDragging(true);
+                this.scroll.put(target.node(), model.offsetAt(pointer, grab));
+                this.layout();
+                return true;
+            }
+        }
+        return super.mouseClicked(event, doubleClick);
+    }
+
+    @Override
+    public boolean mouseDragged(final MouseButtonEvent event, final double deltaX, final double deltaY) {
+        if (this.drag != null && event.button() == 0) {
+            final var target = find(this.root, this.drag.node);
+            final var model = target == null ? null : BedrockFormScroll.model(target, this.scroll.getOrDefault(this.drag.node, 0F));
+            if (model != null) {
+                this.scroll.put(this.drag.node, model.offsetAt(model.pointer(event.x(), event.y()),
+                    Math.min(this.drag.grab, model.extent())));
+                this.layout();
+            }
+            return true;
+        }
+        return super.mouseDragged(event, deltaX, deltaY);
+    }
+
+    @Override
+    public boolean mouseReleased(final MouseButtonEvent event) {
+        if (this.drag != null && event.button() == 0) {
+            this.drag = null;
+            this.setDragging(false);
+            return true;
+        }
+        return super.mouseReleased(event);
+    }
+
+    private static BedrockFormLayout.Box find(final BedrockFormLayout.Box box, final BedrockFormScene.Node node) {
+        if (box.node() == node) return box;
+        for (final var child : box.children()) {
+            final var found = find(child, node);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    private BedrockFormLayout.Box scrollbar(final BedrockFormLayout.Box box, final double x, final double y,
+                                            final Map<BedrockFormScene.Node, Boolean> interactive) {
+        if (!interactive.containsKey(box.node()) || !box.clip().contains(x, y)) return null;
+        for (int i = box.children().size() - 1; i >= 0; i--) {
+            final var target = this.scrollbar(box.children().get(i), x, y, interactive);
+            if (target != null) return target;
+        }
+        if (box.node().scroll()) {
+            final var model = BedrockFormScroll.model(box, this.scroll.getOrDefault(box.node(), 0F));
+            if (model != null && model.maximum() > 0 && interactive.containsKey(model.originalThumb().node())
+                && model.containsTrack(x, y)) return box;
+        }
+        return null;
+    }
+
+    private static BedrockFormLayout.Box scrolling(final BedrockFormLayout.Box box, final double x, final double y,
+                                                   final Map<BedrockFormScene.Node, Boolean> interactive) {
+        if (!interactive.containsKey(box.node()) || !box.clip().contains(x, y)) return null;
+        for (int i = box.children().size() - 1; i >= 0; i--) {
+            final var target = scrolling(box.children().get(i), x, y, interactive);
+            if (target != null) return target;
+        }
+        return box.node().scroll() && box.bounds().contains(x, y) && BedrockFormScroll.maximum(box) > 0 ? box : null;
+    }
+
+    @Override
+    public boolean keyPressed(final KeyEvent event) {
+        if (event.key() == InputConstants.KEY_PAGEUP || event.key() == InputConstants.KEY_PAGEDOWN
+            || event.key() == InputConstants.KEY_HOME || event.key() == InputConstants.KEY_END) {
+            final var focused = this.getFocused() instanceof Action action ? action.node : null;
+            BedrockFormLayout.Box target = this.keyboardScroll(this.root, focused);
+            if (target == null) target = this.keyboardScroll(this.root, null);
+            if (target != null) {
+                final float page = BedrockFormScroll.horizontal(target) ? target.scrollViewport().width() : target.scrollViewport().height();
+                final float maximum = BedrockFormScroll.maximum(target);
+                final float previous = this.scroll.getOrDefault(target.node(), 0F);
+                final float value = switch (event.key()) {
+                    case InputConstants.KEY_HOME -> 0;
+                    case InputConstants.KEY_END -> maximum;
+                    case InputConstants.KEY_PAGEUP -> previous - page;
+                    default -> previous + page;
+                };
+                this.scroll.put(target.node(), Math.clamp(value, 0, maximum));
+                this.layout();
+                return true;
+            }
+        }
+        final boolean result = super.keyPressed(event);
+        if (this.getFocused() instanceof Action action) this.reveal(this.root, action.node);
+        return result;
+    }
+
+    private BedrockFormLayout.Box keyboardScroll(final BedrockFormLayout.Box box, final BedrockFormScene.Node focused) {
+        for (int i = box.children().size() - 1; i >= 0; i--) {
+            final var nested = this.keyboardScroll(box.children().get(i), focused);
+            if (nested != null) return nested;
+        }
+        if (!box.node().scroll() || BedrockFormScroll.maximum(box) == 0) return null;
+        if (focused != null) return find(box, focused) != null ? box : null;
+        return this.actions.values().stream().anyMatch(action -> action.visible && action.active && find(box, action.node) != null) ? box : null;
+    }
+
+    private boolean reveal(final BedrockFormLayout.Box box, final BedrockFormScene.Node focused) {
+        if (box.node() == focused) return true;
+        for (final var child : box.children()) if (this.reveal(child, focused)) {
+            if (box.node().scroll()) {
+                final var action = this.actions.get(focused);
+                final var bounds = action.box.bounds();
+                final var viewport = box.scrollViewport().intersect(box.clip());
+                final boolean horizontal = BedrockFormScroll.horizontal(box);
+                final float start = horizontal ? bounds.x() : bounds.y(), extent = horizontal ? bounds.width() : bounds.height();
+                final float viewportStart = horizontal ? viewport.x() : viewport.y(), viewportExtent = horizontal ? viewport.width() : viewport.height();
+                final float delta = start < viewportStart ? start - viewportStart
+                    : Math.max(0, start + extent - viewportStart - viewportExtent);
+                if (delta != 0) {
+                    this.scroll.put(box.node(), Math.clamp(this.scroll.getOrDefault(box.node(), 0F) + delta,
+                        0, BedrockFormScroll.maximum(box)));
+                    this.layout();
+                }
+            }
+            return true;
+        }
+        return false;
+    }
+
+    @Override
+    public void onClose() {
+        this.respond(-1);
+    }
+
+    private void respond(final int action) {
+        if (this.responded) return;
+        this.responded = true;
+        BedrockNativeForms.respond(this.owner, this.formId, action);
+        this.minecraft.setScreenAndShow(null);
+    }
+
+    @Override
+    public boolean isPauseScreen() {
+        return false;
+    }
+
+    @Override
+    public void tick() {
+        if (!BedrockNativeForms.current(this.owner)) this.minecraft.setScreenAndShow(null);
+        else if (this.imageRevision != this.images.revision()) {
+            this.imageRevision = this.images.revision();
+            try { this.layout(); }
+            catch (final RuntimeException error) {
+                ViaFabricPlusBedrock.impl().logger().warn("Could not update native form images; opening its ordinary controls", error);
+                this.minecraft.setScreenAndShow(new BedrockFallbackFormScreen(this.owner, this.formId, this.scene.fallback()));
+            }
+        }
+    }
+
+    @Override
+    public void removed() {
+        this.images.close();
+    }
+
+    private static void flatten(final BedrockFormLayout.Box box, final List<BedrockFormLayout.Box> result) {
+        result.add(box);
+        for (final var child : box.children()) flatten(child, result);
+    }
+
+    private record Drag(BedrockFormScene.Node node, float grab) {}
+
+    private final class Action extends AbstractButton {
+        private final BedrockFormScene.Node node;
+        private BedrockFormLayout.Box box;
+        private boolean eligible;
+
+        Action(final BedrockFormLayout.Box box) {
+            super(0, 0, 1, 1, BedrockFormText.component(caption(box.node())));
+            this.node = box.node();
+            this.place(box);
+            final String tooltip = this.node.string("tooltip", "");
+            if (!tooltip.isEmpty()) this.setTooltip(Tooltip.create(BedrockFormText.component(tooltip)));
+        }
+
+        void place(final BedrockFormLayout.Box box) {
+            this.box = box;
+            final var bounds = box.bounds();
+            this.setRectangle(Math.max(1, Math.round(bounds.width())), Math.max(1, Math.round(bounds.height())),
+                Math.round(bounds.x()), Math.round(bounds.y()));
+        }
+
+        @Override
+        public void onPress(final InputWithModifiers input) {
+            BedrockNativeFormScreen.this.respond(this.node.action());
+        }
+
+        @Override
+        protected void extractContents(final GuiGraphicsExtractor graphics, final int x, final int y, final float delta) {
+            if (this.node.string("default_control", "").isEmpty()) {
+                this.extractDefaultSprite(graphics);
+                this.extractDefaultLabel(graphics.textRendererForWidget(this, GuiGraphicsExtractor.HoveredTextEffects.TOOLTIP_AND_CURSOR));
+            }
+        }
+
+        @Override
+        public ComponentPath nextFocusPath(final FocusNavigationEvent event) {
+            return this.node.flag("focus_enabled", true) ? super.nextFocusPath(event) : null;
+        }
+
+        @Override
+        public boolean isMouseOver(final double x, final double y) {
+            return this.box.visibleBounds().contains(x, y) && super.isMouseOver(x, y);
+        }
+
+        @Override
+        protected void updateWidgetNarration(final NarrationElementOutput output) {
+            this.defaultButtonNarrationText(output);
+        }
+
+        private static String caption(final BedrockFormScene.Node node) {
+            final String text = node.string("text", "");
+            if (!text.isEmpty()) return text;
+            for (final var child : node.children()) {
+                final String value = caption(child);
+                if (!value.isEmpty()) return value;
+            }
+            return node.name();
+        }
+    }
+}
