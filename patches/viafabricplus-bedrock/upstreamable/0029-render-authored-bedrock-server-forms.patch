+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiPresentation;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeContainerGeometryTest {
+    @Test
+    void itemBoundsDoNotReplaceClippedSlotInputBounds() {
+        final var button = draw(0, true, 1, 10, 10, 18, new NativeUiLayout.Rect(12, 10, 16, 18), 1);
+        final var itemProperties = new JsonObject();
+        itemProperties.addProperty("inventory_slot", 0);
+        final var item = new NativeUiScene.Node("item", "custom", itemProperties, List.of(), -2);
+        final var rect = new NativeUiLayout.Rect(11, 11, 16, 16);
+        final var itemBox = new NativeUiLayout.Box(item, rect, rect, new NativeUiLayout.Size(16, 16), rect, 2, List.of());
+        final var geometry = new NativeContainerGeometry(List.of(button, new NativeUiPresentation.Draw(itemBox, 1, 1, true)), 1);
+        assertEquals(-1, geometry.hovered(11, 12));
+        assertEquals(0, geometry.hovered(12, 10));
+        assertEquals(0, geometry.hovered(27.5, 27.5));
+        assertEquals(-1, geometry.hovered(28, 28));
+        geometry.requireComplete(1);
+    }
+
+    @Test
+    void mirrorsOverlapAndInactiveSlotsShareOneHitPolicy() {
+        final var clip = new NativeUiLayout.Rect(0, 0, 100, 100);
+        final var geometry = new NativeContainerGeometry(List.of(
+            draw(0, true, 1, 0, 0, 18, clip, 1), draw(0, true, 1, 40, 0, 18, clip, 1),
+            draw(1, true, 1, 8, 0, 18, clip, 2), draw(2, false, 1, 70, 0, 18, clip, 3),
+            draw(3, true, 0, 90, 0, 18, clip, 4)), 5);
+        assertEquals(1, geometry.hovered(10, 2));
+        assertEquals(0, geometry.hovered(41, 2));
+        assertTrue(geometry.contains(0, 41, 2));
+        assertFalse(geometry.contains(2, 72, 2));
+        assertEquals(-1, geometry.hovered(95, 2));
+        assertThrows(IllegalArgumentException.class, () -> geometry.requireComplete(5));
+    }
+
+    @Test
+    void registeredScrolledRowsRemainCompleteWithoutPickingOutsideTheViewport() {
+        final var clip = new NativeUiLayout.Rect(0, 0, 18, 18);
+        final var geometry = new NativeContainerGeometry(List.of(
+            draw(0, true, 1, 0, 0, 18, clip, 1), draw(1, true, 1, 0, 36, 18, clip, 1)), 2);
+        geometry.requireComplete(2);
+        assertEquals(0, geometry.hovered(1, 1));
+        assertEquals(-1, geometry.hovered(1, 37));
+    }
+
+    @Test
+    void nativeSlotButtonDefaultsUseItsAuthoredCellWhileExplicitOverridesRemainIntact() {
+        final var props = new JsonObject();
+        props.add("inventory_actions", new JsonArray());
+        props.addProperty("inventory_slot", 0);
+        final var button = new NativeUiScene.Node("button", "button", props, List.of(), Integer.MIN_VALUE);
+        final var ownerProps = new JsonObject();
+        ownerProps.add("size", com.google.gson.JsonParser.parseString("[18,18]"));
+        final var owner = new NativeUiScene.Node("cell", "input_panel", ownerProps, List.of(button), Integer.MIN_VALUE);
+        final var solver = new NativeUiLayout(_ -> new NativeUiLayout.Size(200, 20));
+        final var box = solver.layout(owner, 18, 18, java.util.Map.of());
+        assertEquals(18, box.children().getFirst().bounds().width());
+        assertEquals(18, box.children().getFirst().bounds().height());
+        props.add("size", com.google.gson.JsonParser.parseString("[12,16]"));
+        final var explicit = solver.layout(owner, 18, 18, java.util.Map.of());
+        assertEquals(12, explicit.children().getFirst().bounds().width());
+        assertEquals(16, explicit.children().getFirst().bounds().height());
+        props.remove("inventory_actions");
+        props.remove("size");
+        final var ordinary = solver.layout(owner, 18, 18, java.util.Map.of());
+        assertEquals(18, ordinary.children().getFirst().bounds().width());
+        assertEquals(18, ordinary.children().getFirst().bounds().height());
+    }
+
+    @Test
+    void animatedSlotExtentUpdatesPickingWithoutLosingItsAuthoritativeAddress() {
+        final var props = new JsonObject();
+        props.add("inventory_actions", new JsonArray());
+        props.addProperty("inventory_slot", 0);
+        props.addProperty("anchor_from", "top_left");
+        props.addProperty("anchor_to", "top_left");
+        final var track = com.google.gson.JsonParser.parseString("""
+            {"anim_type":"size","from":[0,0],"to":[40,20],"duration":1,"play_event":"screen.entrance_push"}
+            """).getAsJsonObject();
+        final var program = new JsonObject();
+        final var roots = new JsonArray();
+        roots.add(0);
+        final var tracks = new JsonArray();
+        tracks.add(track);
+        program.add("roots", roots);
+        program.add("tracks", tracks);
+        props.add("animation_program", program);
+        final var scene = new NativeUiScene.Node("slot", "button", props, List.of(), Integer.MIN_VALUE);
+        final var lifecycle = new com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiAnimationLifecycle(scene);
+        final var animations = lifecycle.animations();
+        animations.event(scene, "screen.entrance_push", 0);
+        final var solver = new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0), animations);
+        final var initial = solver.layout(scene, 100, 100, java.util.Map.of());
+        final var empty = new NativeContainerGeometry(NativeUiPresentation.draws(initial, _ -> false, node -> animations.opacityAt(node, 0)), 1);
+        assertDoesNotThrow(() -> empty.requireComplete(1));
+        assertEquals(-1, empty.hovered(0, 0));
+        lifecycle.advance(500_000_000);
+        final var expanded = solver.layout(scene, 100, 100, java.util.Map.of());
+        final var geometry = new NativeContainerGeometry(NativeUiPresentation.draws(expanded, _ -> false, node -> animations.opacityAt(node, 500_000_000)), 1);
+        assertEquals(0, geometry.hovered(19, 9));
+        assertEquals(-1, geometry.hovered(21, 9));
+        assertDoesNotThrow(() -> geometry.requireComplete(1));
+        assertThrows(IllegalArgumentException.class, () -> geometry.requireComplete(2));
+    }
+
+    private static NativeUiPresentation.Draw draw(final int slot, final boolean enabled, final float alpha,
+            final float x, final float y, final float size, final NativeUiLayout.Rect clip, final float layer) {
+        final var properties = new JsonObject();
+        properties.addProperty("inventory_slot", slot);
+        properties.add("inventory_actions", new JsonArray());
+        final var node = new NativeUiScene.Node("slot", "button", properties, List.of(), -2);
+        final var rect = new NativeUiLayout.Rect(x, y, size, size);
+        return new NativeUiPresentation.Draw(new NativeUiLayout.Box(node, rect, clip, new NativeUiLayout.Size(size, size), rect, layer, List.of()), alpha, alpha, enabled);
+    }
+}
