--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiDimension.java
@@ -0,0 +1,93 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonElement;
+import java.util.ArrayList;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.regex.Pattern;
+
+/** Authored dimension coefficients, resolved against the current layout after animation sampling. */
+record NativeUiDimension(List<Term> terms) {
+    private static final Pattern EXPRESSION = Pattern.compile("([+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+))(%sm|%cm|%c|%x|%y|%|px)?");
+
+    NativeUiDimension { terms = List.copyOf(terms); }
+
+    static NativeUiDimension parse(final JsonElement value) {
+        if (!value.isJsonPrimitive()) throw new IllegalArgumentException("Unsupported native UI dimension");
+        if (value.getAsJsonPrimitive().isNumber()) return new NativeUiDimension(List.of(new Term(Unit.PIXELS, finite(value.getAsFloat()))));
+        final String expression = value.getAsString().replace(" ", "");
+        if (expression.equals("default")) return new NativeUiDimension(List.of(new Term(Unit.DEFAULT, 1)));
+        if (expression.equals("fill")) return new NativeUiDimension(List.of(new Term(Unit.FILL, 1)));
+        final var matcher = EXPRESSION.matcher(expression);
+        final var terms = new ArrayList<Term>();
+        int end = 0;
+        while (matcher.find()) {
+            if (matcher.start() != end || end != 0 && expression.charAt(end) != '+' && expression.charAt(end) != '-')
+                throw new IllegalArgumentException("Unsupported native UI dimension expression");
+            final String unit = matcher.group(2);
+            terms.add(new Term(switch (unit == null ? "px" : unit) {
+                case "%" -> Unit.PARENT;
+                case "%c" -> Unit.CHILDREN;
+                case "%cm" -> Unit.MAX_CHILD;
+                case "%x" -> Unit.WIDTH;
+                case "%y" -> Unit.HEIGHT;
+                case "%sm" -> Unit.SIBLING;
+                default -> Unit.PIXELS;
+            }, finite(Float.parseFloat(matcher.group(1)))));
+            end = matcher.end();
+        }
+        if (end == 0 || end != expression.length()) throw new IllegalArgumentException("Unsupported native UI dimension expression");
+        return new NativeUiDimension(List.copyOf(terms));
+    }
+
+    boolean uses(final Unit unit) { return this.terms.stream().anyMatch(term -> term.unit == unit); }
+
+    float resolve(final float parent, final float content, final float maximum, final float width,
+                  final float height, final float sibling, final float fallback) {
+        float result = 0;
+        for (final var term : this.terms) result += term.amount * switch (term.unit) {
+            case PIXELS -> 1;
+            case PARENT -> parent / 100;
+            case CHILDREN -> content / 100;
+            case MAX_CHILD -> maximum / 100;
+            case WIDTH -> width / 100;
+            case HEIGHT -> height / 100;
+            case SIBLING -> sibling / 100;
+            case DEFAULT -> Math.max(0, fallback);
+            case FILL -> Math.max(0, parent);
+        };
+        return finite(result);
+    }
+
+    NativeUiDimension interpolate(final NativeUiDimension to, final float factor) {
+        final var fromTerms = coefficients(this);
+        final var toTerms = coefficients(to);
+        final var result = new ArrayList<Term>();
+        // Native constructors merge the endpoint bases, inserting zero coefficients for missing units.
+        for (final var unit : Unit.values()) if (fromTerms.containsKey(unit) || toTerms.containsKey(unit)) {
+            final float from = fromTerms.getOrDefault(unit, 0F);
+            final float end = toTerms.getOrDefault(unit, 0F);
+            result.add(new Term(unit, finite(from + (end - from) * factor)));
+        }
+        return new NativeUiDimension(List.copyOf(result));
+    }
+
+    private static EnumMap<Unit, Float> coefficients(final NativeUiDimension dimension) {
+        final var result = new EnumMap<Unit, Float>(Unit.class);
+        for (final var term : dimension.terms) result.merge(term.unit, term.amount, Float::sum);
+        return result;
+    }
+
+    private static float finite(final float value) {
+        if (!Float.isFinite(value)) throw new IllegalArgumentException("Non-finite native UI dimension");
+        return value;
+    }
+
+    enum Unit { PIXELS, PARENT, CHILDREN, MAX_CHILD, WIDTH, HEIGHT, SIBLING, DEFAULT, FILL }
+    record Term(Unit unit, float amount) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiFlipbook.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiFlipbook.java
