+
+    @Test
+    void replacesZeroAuthoredAlphaWithRevealTrackAndMultipliesParentOpacity() {
+        final JsonObject root = node("panel", 120, 40);
+        root.addProperty("alpha", .5);
+        final JsonObject button = node("button", 100, 30);
+        button.addProperty("alpha", 0);
+        button.addProperty("action", 2);
+        final JsonObject track = new JsonObject();
+        track.addProperty("anim_type", "alpha");
+        track.addProperty("from", 0);
+        track.addProperty("to", 1);
+        track.addProperty("duration", .16);
+        track.addProperty("easing", "out_quad");
+        final JsonArray tracks = new JsonArray();
+        tracks.add(track);
+        button.add("animation_tracks", tracks);
