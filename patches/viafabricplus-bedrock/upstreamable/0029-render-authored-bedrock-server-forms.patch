+            width = constrain(node, 0, width, environment, width, height, content.width, maximumWidth);
+            final float intrinsicHeight = container || inventoryButton || stack || image ? intrinsic.height : this.metrics.constrained(node, width).height;
+            final float defaultHeight = ratioSize && defaultHeightAxis && !defaultWidthAxis && intrinsic.width > 0
+                ? width * intrinsic.height / intrinsic.width
+                : stack ? vertical ? content.height : environment.height
+                : node.type().equals("grid") && !node.string("grid_item_template", "").isEmpty() ? content.height : intrinsicHeight;
+            height = dimension(node, "size", 1, environment, width, height, content.height, maximumHeight, defaultHeight);
+            height = constrain(node, 1, height, environment, width, height, content.height, maximumHeight);
+            if (width == previousWidth && height == previousHeight) break;
+        }
+        final Size result = new Size(width, height);
+        cache.put(environment, result);
+        return result;
+    }
+
+    private boolean childDimension(final NativeUiScene.Node node, final int axis) {
+        for (final String key : List.of("size", "min_size", "max_size")) {
+            final var value = this.dimensionValue(node, key, axis);
+            if (value != null && (value.uses(NativeUiDimension.Unit.CHILDREN) || value.uses(NativeUiDimension.Unit.MAX_CHILD))) return true;
+        }
+        return false;
+    }
+
+    private boolean defaultSize(final NativeUiScene.Node node, final int axis) {
+        final var size = this.dimensionValue(node, "size", axis);
+        return size == null || size.uses(NativeUiDimension.Unit.DEFAULT);
+    }
+
+    private List<Size> children(final NativeUiScene.Node node, final float width, final float height) {
+        // Collection percentages use the complete grid, while default dimensions
+        // inherit a single cell. Nested controls then inherit that measured cell.
+        final float availableWidth = width;
+        final float availableHeight = height;
+        final List<Size> result = new ArrayList<>();
+        final Grid collection = node.type().equals("grid") && !node.string("grid_item_template", "").isEmpty()
+            ? this.grid(node, width, height) : null;
+        final float defaultWidth = collection == null ? width : width / collection.columns;
+        final float defaultHeight = collection == null ? height : height / collection.rows;
+        for (final var child : node.children())
+            result.add(this.measure(child, new Measurement(availableWidth, availableHeight, 0, 0, defaultWidth, defaultHeight)));
+        for (int i = 0; i < result.size(); i++) {
+            final var child = node.children().get(i);
+            if (!siblingDimension(child)) continue;
+            float siblingWidth = 0, siblingHeight = 0;
+            for (int other = 0; other < result.size(); other++) if (other != i) {
+                siblingWidth = Math.max(siblingWidth, result.get(other).width);
+                siblingHeight = Math.max(siblingHeight, result.get(other).height);
+            }
+            result.set(i, this.measure(child, new Measurement(availableWidth, availableHeight, siblingWidth, siblingHeight, defaultWidth, defaultHeight)));
+        }
+        if (node.type().equals("stack_panel")) {
+            final boolean vertical = !node.string("orientation", "vertical").equals("horizontal");
+            final int axis = vertical ? 1 : 0;
+            float used = 0;
+            int fills = 0;
+            for (int i = 0; i < result.size(); i++) {
+                if (!this.visibleNodes.getOrDefault(node.children().get(i), true)) continue;
+                if (fill(node.children().get(i), axis)) fills++;
