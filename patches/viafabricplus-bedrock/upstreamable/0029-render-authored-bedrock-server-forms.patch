+        assertEquals(box.bounds().x() + 100, box.children().get(2).bounds().x(), .001F);
+        assertEquals(box.bounds().y() + 49, box.children().get(4).bounds().y(), .001F);
+        assertEquals(49, box.children().get(4).bounds().width(), .001F);
