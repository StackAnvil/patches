+    private NativeUiLayout.Box keyboardScroll(final NativeUiLayout.Box box, final NativeUiScene.Node focused) {
+        for (int i = box.children().size() - 1; i >= 0; i--) {
+            final var nested = this.keyboardScroll(box.children().get(i), focused);
+            if (nested != null) return nested;
+        }
+        if (!box.node().scroll() || NativeUiScroll.maximum(box) == 0) return null;
+        if (focused != null) return find(box, focused) != null ? box : null;
+        return this.actions.values().stream().anyMatch(action -> action.visible && action.active && find(box, action.node) != null) ? box : null;
+    }
