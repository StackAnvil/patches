+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import java.util.UUID;
+import net.raphimc.viabedrock.api.model.NativeHudMessage;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeHudOverlayStateTest {
+    @Test
+    void retainsRenderedAnimationStateThroughBindingRefresh() {
+        final var state = new NativeHudOverlayState();
+        final var scene = com.google.gson.JsonParser.parseString(scene()).getAsJsonObject();
+        final var track = new JsonObject();
+        track.addProperty("anim_type", "alpha");
+        track.addProperty("from", 0);
+        track.addProperty("to", 1);
+        track.addProperty("duration", 1);
+        track.addProperty("wait_until_rendered_to_play", true);
+        final var tracks = new com.google.gson.JsonArray();
+        tracks.add(track);
+        AnimationPrograms.attach(scene.getAsJsonObject("root"), tracks, false);
+        state.accept(new NativeHudMessage(scene.toString(), true, NativeHudMessage.ANIMATION_LIFETIME));
+        for (int i = 0; i < 5; i++) state.tick();
+        state.animations().opacityAt(state.scene().root(), state.time(0));
+        for (int i = 0; i < 5; i++) state.tick();
+        assertEquals(.25F, state.animations().opacityAt(state.scene().root(), state.time(0)).current());
+        scene.getAsJsonObject("root").addProperty("text", UUID.randomUUID().toString());
+        state.accept(new NativeHudMessage(scene.toString(), false, NativeHudMessage.ANIMATION_LIFETIME));
+        assertEquals(.25F, state.animations().opacityAt(state.scene().root(), state.time(0)).current());
+        for (int i = 0; i < 5; i++) state.tick();
+        assertEquals(.5F, state.animations().opacityAt(state.scene().root(), state.time(0)).current(), .000001F);
+    }
+
+    @Test
+    void reusesStaticLayoutUntilMetricsViewportImagesOrSceneChange() {
+        final var state = new NativeHudOverlayState();
+        final var measurements = new java.util.concurrent.atomic.AtomicInteger();
+        final NativeUiLayout.Metrics metrics = node -> {
+            measurements.incrementAndGet();
+            return new NativeUiLayout.Size(40, 9);
+        };
+        state.accept(new NativeHudMessage(scene(), true, NativeHudMessage.ANIMATION_LIFETIME));
+        final var initial = state.layout(metrics, 640, 320, 0);
+        final int count = measurements.get();
+        for (int i = 0; i < 100; i++) {
+            state.tick();
+            assertSame(initial, state.layout(metrics, 640, 320, 0));
+        }
+        assertEquals(count, measurements.get());
+        final var resized = state.layout(metrics, 800, 400, 0);
+        assertNotSame(initial, resized);
+        final var imageReady = state.layout(metrics, 800, 400, 1);
+        assertNotSame(resized, imageReady);
+        final NativeUiLayout.Metrics newFont = node -> new NativeUiLayout.Size(45, 10);
+        final var reloaded = state.layout(newFont, 800, 400, 1);
+        assertNotSame(imageReady, reloaded);
+        state.accept(new NativeHudMessage(scene(), false, NativeHudMessage.ANIMATION_LIFETIME));
+        assertNotSame(reloaded, state.layout(newFont, 800, 400, 1));
+    }
+
+    @Test
+    void retainsStaticRootDecorationsAcrossTimedTitleExpirationAndClear() {
+        final var root = new NativeHudOverlayState();
+        final var title = new NativeHudOverlayState();
+        root.accept(new NativeHudMessage(scene(), true, NativeHudMessage.ANIMATION_LIFETIME));
+        title.accept(new NativeHudMessage(scene(), true, 20));
+        for (int i = 0; i < 1000; i++) { root.tick(); title.tick(); }
+        assertTrue(root.active());
+        assertFalse(title.active());
+        title.accept(new NativeHudMessage("", false, 0));
+        assertTrue(root.active());
+        assertEquals(50_000_000_000L, root.time(0));
+        root.accept(new NativeHudMessage("", false, 0));
+        assertFalse(root.active());
+    }
+
+    @Test
+    void keepsIndependentClocksThroughReplacementExpirationAndClear() {
+        final var title = new NativeHudOverlayState();
+        final var actionbar = new NativeHudOverlayState();
+        final String scene = scene();
+        assertFalse(title.accept(new NativeHudMessage(scene, false, 100)));
+        title.accept(new NativeHudMessage(scene, true, 100));
+        actionbar.accept(new NativeHudMessage(scene, true, 60));
+        for (int i = 0; i < 40; i++) { title.tick(); actionbar.tick(); }
+        assertEquals(2_025_000_000L, title.time(.5F));
+        title.accept(new NativeHudMessage(scene(), false, 100));
+        assertEquals(2_000_000_000L, title.time(0));
+        actionbar.accept(new NativeHudMessage(scene(), true, 60));
+        assertEquals(0, actionbar.time(0));
+        for (int i = 0; i < 60; i++) { title.tick(); actionbar.tick(); }
+        assertFalse(title.active());
+        assertFalse(actionbar.active());
+        assertFalse(title.accept(new NativeHudMessage(scene, false, 100)));
+        actionbar.accept(new NativeHudMessage(scene, true, 60));
+        title.accept(new NativeHudMessage("", false, 0));
+        assertTrue(actionbar.active());
+        actionbar.accept(new NativeHudMessage("", false, 0));
+        assertFalse(actionbar.active());
+        assertNull(actionbar.scene());
+        title.accept(new NativeHudMessage(scene, true, 0));
+        assertFalse(title.active());
+    }
+
+    @Test
+    void letsAuthoredDestructionControlExpirationAndRetainsPersistentScenes() {
+        final var state = new NativeHudOverlayState();
+        final var scene = com.google.gson.JsonParser.parseString(scene()).getAsJsonObject();
+        final var root = scene.getAsJsonObject("root");
+        final String name = UUID.randomUUID().toString();
+        root.addProperty("name", name);
+        final var sequence = new com.google.gson.JsonArray();
+        final var wait = new JsonObject();
+        wait.addProperty("anim_type", "wait");
+        wait.addProperty("duration", 2);
+        sequence.add(wait);
+        final var fade = new JsonObject();
+        fade.addProperty("anim_type", "alpha");
+        fade.addProperty("duration", 6);
+        fade.addProperty("destroy_at_end", name);
+        sequence.add(fade);
+        AnimationPrograms.attach(root, sequence, true);
+        state.accept(new NativeHudMessage(scene.toString(), true, NativeHudMessage.ANIMATION_LIFETIME));
+        for (int i = 0; i < 159; i++) state.tick();
+        assertTrue(state.active());
+        state.tick();
+        assertFalse(state.active());
+        fade.addProperty("destroy_at_end", "");
+        state.accept(new NativeHudMessage(scene.toString(), true, NativeHudMessage.ANIMATION_LIFETIME));
+        for (int i = 0; i < 1000; i++) state.tick();
+        assertTrue(state.active());
+        assertEquals(50_000_000_000L, state.time(0));
+        state.accept(new NativeHudMessage("", false, 0));
+        assertFalse(state.active());
+    }
+
+    private static String scene() {
+        final var root = new JsonObject();
+        root.addProperty("type", "label");
+        root.addProperty("text", UUID.randomUUID().toString());
+        final var scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.add("root", root);
+        return scene.toString();
+    }
+}
