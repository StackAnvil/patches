+/** Native presentation of an existing Java menu. All inventory mutations stay in vanilla menu dispatch. */
+public final class BedrockNativeContainerScreen extends AbstractContainerScreen<ChestMenu> {
+    static final Set<String> RENDERERS = Set.of("inventory_item_renderer", "hover_text_renderer", "progress_bar_renderer", "flying_item_renderer");
+    private final Connection owner;
+    private final ContainerUi program;
+    private final ContainerUi.Kind kind;
+    private final NativeUiImages images = new NativeUiImages();
+    private NativeUiRenderer renderer;
+    private NativeUiLayout.Box root;
+    private NativeContainerGeometry geometry;
+    private List<NativeUiPresentation.Draw> draws = List.of();
+    private List<ItemStack> previous = List.of();
+    private ItemStack previousCarried = ItemStack.EMPTY;
+    private boolean fallingBack;
+    private final NativeContainerScroll scroll = new NativeContainerScroll();
+    private final NativeInventoryFlights flights = new NativeInventoryFlights();
+    private final Map<Integer, Preview> previews = new HashMap<>();
+    private final Map<Integer, NativeInventoryFlights.Anchor> anchors = new HashMap<>();
+    private NativeUiScene.Node flightOwner;
+    private final Set<NativeUiScene.Node> vanillaCursor = Collections.newSetFromMap(new IdentityHashMap<>());
+    private Slot drawingSlot;
+    private long imageRevision;
+    private Boolean showTags;
+
+    BedrockNativeContainerScreen(final Connection owner, final ChestMenu menu, final Inventory inventory,
+            final Component title, final ContainerUi program, final ContainerUi.Kind kind) {
+        super(menu, inventory, title);
+        this.owner = owner;
+        this.program = program;
+        this.kind = kind;
+    }
+
+    void prepare(final Font font, final int width, final int height) {
+        this.width = width;
+        this.height = height;
+        this.renderer = new NativeUiRenderer(font, this.images);
+        this.refresh();
+    }
+
+    @Override
+    protected void init() {
+        super.init();
+        this.leftPos = 0;
+        this.topPos = 0;
+        this.renderer = new NativeUiRenderer(this.font, this.images);
+        this.refresh();
+    }
+
+    private boolean current() {
+        return BedrockNativeContainers.current(this.owner, this.menu);
+    }
+
+    private void refresh() {
+        if (!this.current()) throw new IllegalStateException("Native inventory no longer owns the current menu");
+        this.renderer.reset();
+        this.showTags = this.showTags();
+        final List<ContainerUi.Slot> slots = new ArrayList<>();
+        for (final Slot slot : this.menu.slots) slots.add(new ContainerUi.Slot(slot.index, NativeInventoryItemPresentation.values(slot.getItem(), false, this.showTags)));
+        final var view = new ContainerUi.MenuView(this.menu.containerId, this.kind, this.title.getString(),
+            slots, NativeInventoryItemPresentation.values(this.menu.getCarried(), true, this.showTags));
+        final var scene = NativeUiScene.parse(this.program.resolve(view).toString(), RENDERERS);
+        this.root = new NativeUiLayout(this.renderer).layout(scene.root(), this.width, this.height, this.scroll.offsets(scene.root()));
+        this.draws = NativeUiPresentation.draws(this.root, box -> false);
+        this.geometry = new NativeContainerGeometry(this.draws, this.menu.slots.size());
+        this.geometry.requireComplete(this.menu.slots.size());
+        for (final var draw : this.draws) {
+            final var node = draw.box().node();
+            final String custom = node.string("renderer", "");
+            if (custom.equals("inventory_item_renderer") && node.flag("disabled_filter_visible", false))
+                throw new IllegalArgumentException("Unsupported native inactive-item filter");
+            if ((custom.equals("inventory_item_renderer") || custom.equals("flying_item_renderer")) && draw.alpha() != 1)
+                throw new IllegalArgumentException("Unsupported native inventory item opacity");
+            if (custom.equals("progress_bar_renderer")) NativeInventoryProgress.quads(draw.box(), draw.alpha(), 1);
+        }
+        this.vanillaCursor.clear();
+        this.cursor(this.root, false);
+        this.anchors.clear();
+        this.flightOwner = null;
+        this.anchors(this.root);
+        final var current = this.menu.slots.stream().map(slot -> slot.getItem().copy()).toList();
+        if (!this.previous.isEmpty()) this.flights.update(this.previous, current, this.anchors, System.nanoTime());
+        this.previous = this.menu.slots.stream().map(slot -> slot.getItem().copy()).toList();
+        this.previousCarried = this.menu.getCarried().copy();
+        this.imageRevision = this.images.revision();
+    }
+
+    private Boolean showTags() {
+        if (!(this.owner instanceof IConnection connection)) return null;
+        final var user = connection.viaFabricPlus$getUserConnection();
+        final var storage = user == null ? null : user.get(GameRulesStorage.class);
+        final Object rule = storage == null ? null : storage.getGameRule("showTags");
+        return rule instanceof Boolean value ? value : null;
+    }
+
+    @Override
+    protected void containerTick() {
+        if (!this.current()) return;
+        boolean changed = this.previous.size() != this.menu.slots.size()
+            || !ItemStack.matches(this.previousCarried, this.menu.getCarried());
+        for (int i = 0; !changed && i < this.previous.size(); i++)
+            changed = !ItemStack.matches(this.previous.get(i), this.menu.slots.get(i).getItem());
+        if (changed || !Objects.equals(this.showTags, this.showTags()) || this.images.revision() != this.imageRevision) {
+            try { this.refresh(); }
+            catch (final RuntimeException error) { this.fallback(error); }
+        }
+    }
+
+    public Slot nativeHoveredSlot(final double x, final double y) {
+        if (!this.current() || this.geometry == null) return null;
+        final int index = this.geometry.hovered(x, y);
+        return index >= 0 && this.menu.slots.get(index).isActive() ? this.menu.slots.get(index) : null;
+    }
+
+    public boolean nativeIsHovering(final Slot slot, final double x, final double y) {
+        return this.current() && this.geometry != null && this.geometry.contains(slot.index, x, y);
+    }
+
+    @Override
+    public void extractContents(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        if (!this.current() || this.geometry == null) return;
+        try {
+            this.draws = NativeUiPresentation.draws(this.root, box -> box.visibleBounds().contains(mouseX, mouseY));
+            this.geometry = new NativeContainerGeometry(this.draws, this.menu.slots.size());
+            this.geometry.requireComplete(this.menu.slots.size());
+            this.hoveredSlot = this.nativeHoveredSlot(mouseX, mouseY);
+            final List<NativeUiPresentation.Draw> ordered = new ArrayList<>(this.draws);
+            ordered.sort(Comparator.comparingDouble(draw -> draw.box().layer()));
+            this.previews.clear();
+            for (final var draw : ordered) {
+                final var box = draw.box();
+                if (this.vanillaCursor.contains(box.node())) continue;
+                if (draw.alpha() <= 0 || box.visibleBounds().width() <= 0 || box.visibleBounds().height() <= 0) continue;
+                final var clip = box.node().type().equals("label") ? box.visibleBounds() : box.clip();
+                graphics.enableScissor(Math.round(clip.x()), Math.round(clip.y()),
+                    Math.round(clip.x() + clip.width()), Math.round(clip.y() + clip.height()));
+                try {
+                    final String custom = box.node().string("renderer", "");
+                    if (box.node().string("inventory_count", "").equals("slot")) this.count(graphics, box, draw.alpha());
+                    else if (box.node().string("inventory_count", "").equals("cursor")) { /* Vanilla carried decorations remain authoritative. */ }
+                    else if (custom.equals("inventory_item_renderer")) this.item(graphics, box, mouseX, mouseY, draw.alpha());
+                    else if (custom.equals("progress_bar_renderer")) this.progress(graphics, box, draw.alpha());
+                    else if (custom.equals("flying_item_renderer") && box.node() == this.flightOwner) this.flying(graphics, draw.alpha());
+                    else this.renderer.draw(graphics, draw);
+                } finally { graphics.disableScissor(); }
+            }
+        } catch (final RuntimeException error) { this.fallback(error); }
+    }
+
+    private void item(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final int mouseX, final int mouseY, final float alpha) {
+        if (alpha != 1) throw new IllegalArgumentException("Unsupported native inventory item opacity");
+        if (box.node().flag("disabled_filter_visible", false)) throw new IllegalArgumentException("Unsupported native inactive-item filter");
+        if (box.node().flag("inventory_cursor", false)) return; // Vanilla extractCarriedItem owns its actual quickcraft remainder.
+        if (!box.node().properties().has("inventory_slot")) throw new IllegalArgumentException("Inventory item has no actual slot");
+        final Slot slot = this.menu.slots.get(box.node().properties().get("inventory_slot").getAsInt());
+        this.drawingSlot = slot;
+        graphics.pose().pushMatrix();
+        try {
+            graphics.pose().translate(box.bounds().x(), box.bounds().y());
+            graphics.pose().scale(box.bounds().width() / 16, box.bounds().height() / 16);
+            graphics.pose().translate(-slot.x, -slot.y);
+            super.extractSlot(graphics, slot, mouseX, mouseY);
+        } finally { graphics.pose().popMatrix(); this.drawingSlot = null; }
+    }
+
+    /** Called only from the scoped vanilla decoration hook, preserving its computed quickcraft stack/count. */
+    public void nativeDecorations(final ItemStack stack, final String count) {
+        if (this.drawingSlot != null) this.previews.put(this.drawingSlot.index, new Preview(stack.copy(), count));
+    }
+
+    private void count(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final float alpha) {
+        final int slot = box.node().properties().get("inventory_slot").getAsInt();
+        final var preview = this.previews.getOrDefault(slot, new Preview(this.menu.slots.get(slot).getItem(), null));
+        final String count = preview.count != null ? preview.count : preview.stack.getCount() > 1 ? Integer.toString(preview.stack.getCount()) : "";
+        if (count.isEmpty()) return;
+        this.renderer.label(graphics, box, alpha, this.renderer.styled(box.node(), Component.literal(count)));
+    }
+
+    private void progress(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final float alpha) {
+        var progress = box;
+        final var bag = box.node().properties().getAsJsonObject("property_bag");
+        if (bag != null && bag.has("is_durability") && bag.get("is_durability").getAsBoolean()
+            && box.node().properties().has("inventory_slot")) {
+            final var preview = this.previews.get(box.node().properties().get("inventory_slot").getAsInt());
+            if (preview != null) {
+                final var props = box.node().properties().deepCopy();
+                props.addProperty("touch_progress_bar_visible", preview.stack.isDamageableItem() && preview.stack.isDamaged());
+                props.addProperty("progress_bar_total_amount", preview.stack.getMaxDamage());
+                props.addProperty("progress_bar_current_amount", preview.stack.getMaxDamage() - preview.stack.getDamageValue());
+                final var node = new NativeUiScene.Node(box.node().name(), box.node().type(), props, box.node().children(), box.node().action());
+                progress = new NativeUiLayout.Box(node, box.bounds(), box.clip(), box.content(), box.scrollViewport(), box.layer(), box.children());
+            }
+        }
+        for (final var quad : NativeInventoryProgress.quads(progress, alpha, (float) this.minecraft.getWindow().getGuiScale())) {
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(quad.bounds().x(), quad.bounds().y());
+                graphics.pose().scale(quad.bounds().width(), quad.bounds().height());
+                graphics.fill(0, 0, 1, 1, quad.color().argb());
+            } finally { graphics.pose().popMatrix(); }
+        }
+    }
+
+    private void flying(final GuiGraphicsExtractor graphics, final float alpha) {
+        if (alpha != 1) throw new IllegalArgumentException("Unsupported native inventory flight opacity");
+        for (final var frame : this.flights.frames(System.nanoTime())) {
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(frame.x(), frame.y());
+                graphics.pose().scale(frame.scale(), frame.scale());
+                graphics.item(frame.stack(), 0, 0);
+            } finally { graphics.pose().popMatrix(); }
+        }
+    }
+
+    private void cursor(final NativeUiLayout.Box box, final boolean inherited) {
+        final boolean cursor = inherited || box.node().flag("follows_cursor", false);
+        if (cursor) this.vanillaCursor.add(box.node());
+        for (final var child : box.children()) this.cursor(child, cursor);
+    }
+
+    private void anchors(final NativeUiLayout.Box box) {
+        final var node = box.node();
+        if (this.flightOwner == null && node.string("renderer", "").equals("flying_item_renderer")) this.flightOwner = node;
+        if (node.properties().has("inventory_slot") && node.properties().has("collection")
+            && box.bounds().width() > 0 && box.bounds().height() > 0)
+            this.anchors.putIfAbsent(node.properties().get("inventory_slot").getAsInt(),
+                new NativeInventoryFlights.Anchor(box.bounds().x(), box.bounds().y(), box.bounds().width() / 16));
+        for (final var child : box.children()) this.anchors(child);
+    }
+
+    @Override
+    protected void slotClicked(final Slot slot, final int index, final int button, final ContainerInput input) {
+        if (!this.current()) return;
+        super.slotClicked(slot, index, button, input);
+        try { this.refresh(); }
+        catch (final RuntimeException error) { this.fallback(error); }
+    }
+
+    private record Preview(ItemStack stack, String count) {}
+
+    @Override
+    public void extractBackground(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        this.extractTransparentBackground(graphics);
+    }
+
+    @Override
+    protected boolean hasClickedOutside(final double x, final double y, final int left, final int top) {
+        return this.root == null || !this.root.bounds().contains(x, y);
+    }
+
+    @Override
+    public boolean mouseScrolled(final double x, final double y, final double horizontal, final double vertical) {
+        if (!this.current()) return false;
+        if (!this.scroll.wheel(this.root, x, y, horizontal, vertical)) return super.mouseScrolled(x, y, horizontal, vertical);
+        this.refresh();
+        return true;
+    }
+
+    @Override
+    public boolean mouseClicked(final MouseButtonEvent event, final boolean doubleClick) {
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.press(this.root, event.x(), event.y())) {
+            this.refresh();
+            return true;
+        }
+        for (final var draw : this.draws.reversed()) if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && draw.enabled() && draw.alpha() > 0
+            && draw.box().node().string("inventory_command", "").equals("close")
+            && draw.box().visibleBounds().contains(event.x(), event.y())) { this.onClose(); return true; }
+        return super.mouseClicked(event, doubleClick);
+    }
+
+    @Override
+    public boolean mouseDragged(final MouseButtonEvent event, final double dx, final double dy) {
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.drag(this.root, event.x(), event.y())) {
+            this.refresh();
+            return true;
+        }
+        return super.mouseDragged(event, dx, dy);
+    }
+
+    @Override
+    public boolean mouseReleased(final MouseButtonEvent event) {
+        if (!this.current()) return false;
+        return event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.release() || super.mouseReleased(event);
+    }
+
+    @Override
+    public boolean keyPressed(final KeyEvent event) { return this.current() && super.keyPressed(event); }
+
+    private void fallback(final RuntimeException error) {
+        if (this.fallingBack) return;
+        this.fallingBack = true;
+        ViaFabricPlusBedrock.impl().logger().warn("Unsupported native inventory presentation; retaining ordinary menu controls", error);
+        if (this.current()) BedrockNativeContainers.replace(new ContainerScreen(this.menu, this.minecraft.player.getInventory(), this.title));
+    }
+
+    void discard() { this.images.close(); }
+
+    @Override
+    public void removed() { this.images.close(); super.removed(); }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/BedrockNativeContainers.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/BedrockNativeContainers.java
