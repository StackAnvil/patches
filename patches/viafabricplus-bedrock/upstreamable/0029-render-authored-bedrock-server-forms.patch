+        button.addProperty("action", Integer.MIN_VALUE);
+        assertThrows(IllegalArgumentException.class, () -> scene(button));
+        button.addProperty("action", -1);
+        assertEquals(-1, scene(button).root().action());
+        button.add("size", pair("100% + bogus", 20));
+        assertThrows(IllegalArgumentException.class, () -> layout(scene(button), 320, 200));
+    }
+
+    private static JsonObject json(final JsonObject root) {
+        final JsonObject value = new JsonObject(), fallback = new JsonObject();
+        value.addProperty("format", 1);
+        value.add("root", root);
+        final JsonArray buttons = new JsonArray();
+        for (int i = 0; i < 10; i++) {
+            final JsonObject button = new JsonObject();
+            button.addProperty("text", Integer.toString(i));
+            buttons.add(button);
+        }
+        fallback.add("buttons", buttons);
+        value.add("fallback", fallback);
+        return value;
+    }
+
+    private static BedrockFormScene scene(final JsonObject root) { return BedrockFormScene.parse(json(root).toString()); }
+    private static NativeUiLayout.Box layout(final BedrockFormScene scene, final int width, final int height) {
+        return new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0)).layout(scene.root(), width, height, Map.of());
+    }
+    private static JsonObject node(final String type, final Object width, final Object height) {
+        final JsonObject node = new JsonObject();
+        node.addProperty("type", type);
+        node.add("size", pair(width, height));
+        return node;
+    }
+    private static JsonArray pair(final Object first, final Object second) {
+        final var array = new JsonArray();
+        for (final Object value : new Object[] {first, second}) {
+            if (value instanceof Number number) array.add(number);
+            else array.add(value.toString());
+        }
+        return array;
+    }
+}
