+package com.viaversion.viafabricplus.bedrock.block;
+
+import com.viaversion.viafabricplus.ViaFabricPlus;
+import com.viaversion.viafabricplus.bedrock.render.light.BedrockRenderingMetadata;
+import net.minecraft.client.Minecraft;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.CrossCollisionBlock;
+import net.minecraft.world.level.block.FenceBlock;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.phys.shapes.Shapes;
+import net.minecraft.world.phys.shapes.VoxelShape;
+import net.raphimc.viabedrock.api.model.BedrockFenceGeometry;
+import net.raphimc.viabedrock.api.BedrockProtocolVersion;
+import org.jetbrains.annotations.Nullable;
+
+/** Adapts core fence bounds to Java's block-local shape interface. */
+public final class BedrockFenceShapes {
+    private BedrockFenceShapes() {
+    }
+
+    public static @Nullable BedrockFenceGeometry current(final BlockState state) {
+        if (!(state.getBlock() instanceof FenceBlock)) return null;
+        final Minecraft client = Minecraft.getInstance();
+        if (client == null || client.getConnection() == null) return null;
+        if (!BedrockRenderingMetadata.active() && !ViaFabricPlus.api().targetVersion().equals(BedrockProtocolVersion.BEDROCK_LATEST)) return null;
+        return geometry(state);
+    }
+
+    static BedrockFenceGeometry geometry(final BlockState state) {
+        return new BedrockFenceGeometry(state.getValue(CrossCollisionBlock.NORTH), state.getValue(CrossCollisionBlock.EAST),
+            state.getValue(CrossCollisionBlock.SOUTH), state.getValue(CrossCollisionBlock.WEST));
+    }
+
+    public static VoxelShape collision(final BedrockFenceGeometry geometry, final BlockPos pos) {
+        VoxelShape result = Shapes.empty();
+        for (final var box : geometry.collisionBoxes(pos.getX(), pos.getY(), pos.getZ())) {
+            result = Shapes.or(result, local(box, pos));
+        }
+        return result.optimize();
+    }
+
+    public static VoxelShape outline(final BedrockFenceGeometry geometry, final BlockPos pos) {
+        return local(geometry.outline(pos.getX(), pos.getY(), pos.getZ()), pos);
+    }
+
+    public static VoxelShape camera(final BedrockFenceGeometry geometry, final BlockPos pos) {
+        return local(geometry.cameraCollision(pos.getX(), pos.getY(), pos.getZ()), pos);
+    }
+
+    private static VoxelShape local(final BedrockFenceGeometry.Box box, final BlockPos pos) {
+        if (box.minX() >= box.maxX() || box.minY() >= box.maxY() || box.minZ() >= box.maxZ()) return Shapes.empty();
+        // Widen before subtracting the integer position so float rounding survives rebasing.
+        return Shapes.box((double) box.minX() - pos.getX(), (double) box.minY() - pos.getY(), (double) box.minZ() - pos.getZ(),
+            (double) box.maxX() - pos.getX(), (double) box.maxY() - pos.getY(), (double) box.maxZ() - pos.getZ());
+    }
+}
