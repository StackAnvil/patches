+package com.viaversion.viafabricplus.bedrock.block;
+
+import net.minecraft.SharedConstants;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.CrossCollisionBlock;
+import net.minecraft.world.phys.shapes.BooleanOp;
+import net.minecraft.world.phys.shapes.Shapes;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockFenceShapesTest {
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void adaptsEveryConnectionStateAndSeparatesPhysicalAndCameraHeight() {
+        for (int mask = 0; mask < 16; mask++) {
+            final var state = Blocks.OAK_FENCE.defaultBlockState()
+                .setValue(CrossCollisionBlock.NORTH, (mask & 1) != 0).setValue(CrossCollisionBlock.EAST, (mask & 2) != 0)
+                .setValue(CrossCollisionBlock.SOUTH, (mask & 4) != 0).setValue(CrossCollisionBlock.WEST, (mask & 8) != 0);
+            final var geometry = BedrockFenceShapes.geometry(state);
+            final var pos = new BlockPos(-11, 90, 12);
+            final var collision = BedrockFenceShapes.collision(geometry, pos);
+            final var outline = BedrockFenceShapes.outline(geometry, pos);
+            final var camera = BedrockFenceShapes.camera(geometry, pos);
+            assertEquals(1.5, collision.max(net.minecraft.core.Direction.Axis.Y));
+            assertEquals(1, outline.max(net.minecraft.core.Direction.Axis.Y));
+            assertEquals(1.5, camera.max(net.minecraft.core.Direction.Axis.Y));
+            assertEquals(outline.bounds().minX, collision.bounds().minX);
+            assertEquals(outline.bounds().maxZ, collision.bounds().maxZ);
+            assertEquals(outline.bounds().minX, camera.bounds().minX);
+            assertEquals(outline.bounds().maxZ, camera.bounds().maxZ);
+        }
+    }
+
+    @Test
+    void diagonalArmsKeepARealCollisionGapInsideTheOutlineAndCameraEnvelope() {
+        final var geometry = BedrockFenceShapes.geometry(Blocks.OAK_FENCE.defaultBlockState()
+            .setValue(CrossCollisionBlock.NORTH, true).setValue(CrossCollisionBlock.EAST, true));
+        final var gap = Shapes.box(0.75, 0.1, 0.1, 0.85, 0.9, 0.2);
+        assertFalse(Shapes.joinIsNotEmpty(BedrockFenceShapes.collision(geometry, BlockPos.ZERO), gap, BooleanOp.AND));
+        assertTrue(Shapes.joinIsNotEmpty(BedrockFenceShapes.outline(geometry, BlockPos.ZERO), gap, BooleanOp.AND));
+        assertTrue(Shapes.joinIsNotEmpty(BedrockFenceShapes.camera(geometry, BlockPos.ZERO), gap, BooleanOp.AND));
+    }
+
+    @Test
+    void preservesNativeWorldFloatRoundingWhenConvertingToLocalDoubles() {
+        final var geometry = BedrockFenceShapes.geometry(Blocks.OAK_FENCE.defaultBlockState());
+        assertTrue(BedrockFenceShapes.collision(geometry, new BlockPos(16_777_216, 0, 0)).isEmpty());
+        assertTrue(BedrockFenceShapes.camera(geometry, new BlockPos(16_777_216, 0, 0)).isEmpty());
+        final var pos = new BlockPos(-16_777_217, 0, 0);
+        final var connected = BedrockFenceShapes.geometry(Blocks.OAK_FENCE.defaultBlockState().setValue(CrossCollisionBlock.EAST, true));
+        final var bounds = BedrockFenceShapes.collision(connected, pos).bounds();
+        assertEquals(1, bounds.minX);
+        assertEquals(2, bounds.maxX);
+    }
+}
