From c04ee545ab9e23c186e14a5baf35db809b8fd908 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 25 Sep 2026 16:51:34 +0200
Subject: [PATCH] chore(branding): identify StackAnvil builds

Mark distributed artifacts with a StackAnvil version suffix and manifest vendor so testers can distinguish them from upstream builds.
---
 build.gradle.kts  | 4 ++++
 gradle.properties | 2 +-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/build.gradle.kts b/build.gradle.kts
index 442b2fa..3557dad 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -54,3 +54,7 @@ dependencies {
 }
 
 includeTransitiveJijDependencies()
+
+tasks.withType<Jar>().configureEach {
+    manifest.attributes["Implementation-Vendor"] = "StackAnvil"
+}
diff --git a/gradle.properties b/gradle.properties
index b958484..ec2855e 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -7,7 +7,7 @@ jvm_version=25
 
 project_group=com.viaversion
 project_name=viafabricplus-bedrock
-project_version=1.1.1-SNAPSHOT
+project_version=1.1.1-StackAnvil
 project_description=Minecraft: Bedrock Edition support for the ViaFabricPlus mod.
 
 publish_owner_id=florianreuth
-- 
2.55.0

