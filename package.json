{
  "name": "stackanvil-patches",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "bun scripts/prepare-effect.ts && effect-tsgo patch --no-typescript --oxlint",
    "stack": "bun src/cli.ts stack",
    "pr": "bun src/cli.ts pr",
    "build": "bun src/cli.ts stack build",
    "check": "bun run lint && bun run format:check && tsc --noEmit",
    "test": "bun test",
    "test:capture:native": "cargo test --locked --manifest-path native/capture-x11/Cargo.toml --target-dir .stackanvil/tools/capture-x11-build -- --include-ignored",
    "test:integration": "bun src/integration/cli.ts",
    "test:bedrock:gameplay": "bun src/integration/cli.ts --route java-bedrock --entity-probe --gameplay-probe",
    "test:bedrock:resources": "bun src/integration/cli.ts --route java-bedrock --resource-pack-probe",
    "test:geyser": "bun src/integration/cli.ts --route java-geyser --gameplay-probe --geyser-probe --negative-controls",
    "test-pack:java:build": "bun src/integration/geyser.ts",
    "integration:modpack:update": "bun src/integration/modpack.ts update",
    "integration:graphics:prepare": "bun src/integration/graphics.ts",
    "integration:entity-probe:generate": "bun src/integration/entity-probe-catalog.ts",
    "test-pack:build": "bun src/integration/entity-probe.ts",
    "dev:setup": "bun src/cli.ts dev setup",
    "capture": "bun src/capture/cli.ts",
    "server-replay": "bun src/replay/cli.ts",
    "lab": "bun src/lab/cli.ts",
    "bundle": "bun src/bundle.ts",
    "bedrock:version": "bun src/bedrock-version.ts",
    "mod:publish": "bun src/mod-publishing.ts",
    "lint": "oxlint --type-aware src scripts",
    "format": "oxfmt --write src scripts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src scripts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "fix": "oxlint --type-aware --fix src scripts && bun run format"
  },
  "dependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@minecraft/server": "2.9.0",
    "@types/bun": "^1.2.0",
    "json5": "^2.2.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "^7.0.0"
  }
}
